<!doctype html>
<html class="js" lang="{{ request.locale.iso_code }}" data-country="global" data-currency="GBP">
  <head>
    <!-- MA_THEME_SEO_MARKER_20260501 -->
    <meta name="google-site-verification" content="2NdyPeDWkILkAmKvQ7GghimIg8gmb3o9PmLHjIPu6ss" />
    <meta name="google-adsense-account" content="ca-pub-7994890501077122">
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="theme-color" content="">
    {%- liquid
      assign ma_canonical_url = canonical_url
      assign ma_location_seo_handles = '|missing-people-location|missing-people-location-live|missing-alerts-near-me|missing-person-search-guide|missing-cases-near|no-active-missing-cases|missing-people-near-me|recent-missing-cases|help-find-missing|missing-people-region|'
      assign ma_indexable_country_slugs = '|united-kingdom|ireland|australia|new-zealand|united-states|canada|'
      assign ma_request_page_handle = request.path | split: '/pages/' | last | split: '/' | first
      assign ma_location_page_lookup = '|' | append: ma_request_page_handle | append: '|'
      assign ma_location_query_key = ''
      assign ma_location_query_value = ''
      assign ma_query_parts = request.query_string | default: '' | split: '&'
      for ma_query_part in ma_query_parts
        assign ma_query_key = ma_query_part | split: '=' | first
        if ma_query_key == 'loc' or ma_query_key == 'region' or ma_query_key == 'country'
          assign ma_location_query_key = ma_query_key
          assign ma_location_query_value = ma_query_part | remove_first: ma_query_key | remove_first: '='
          break
        endif
      endfor
      assign ma_tagged_archive = false
      if current_tags != blank
        assign ma_tagged_archive = true
      endif
      if ma_tagged_archive and blog.url != blank
        assign ma_canonical_url = request.origin | append: blog.url
      endif
      if request.path == '/pages/country-search' or request.path == '/pages/country-intelligence' or request.path == '/pages/top-missing-locations'
        assign ma_canonical_url = request.origin | append: '/pages/country-intelligence'
      endif
      if request.path contains '/pages/' and ma_location_seo_handles contains ma_location_page_lookup and ma_location_query_value != blank
        assign ma_canonical_url = request.origin | append: request.path | append: '?' | append: ma_location_query_key | append: '=' | append: ma_location_query_value
      endif
      if request.path == '/pages/missing-people-location'
        assign ma_canonical_url = canonical_url | replace: '/pages/missing-people-location', '/pages/missing-people-location-live'
      endif
      assign ma_location_request_has_real_content = true
      assign ma_location_request_should_index = false
      assign ma_location_country_lookup = '|' | append: ma_location_query_value | append: '|'
      if ma_request_page_handle == 'missing-people-country' and ma_location_query_key == 'country' and ma_indexable_country_slugs contains ma_location_country_lookup
        assign ma_location_request_should_index = true
      endif
      if request.path contains '/pages/' and ma_location_seo_handles contains ma_location_page_lookup and ma_location_query_value == blank
        assign ma_location_request_has_real_content = false
      endif
    -%}
    <link rel="canonical" href="{{ ma_canonical_url | escape }}">
    {%- if request.path == '/pages/missing-people-location' -%}
      <script>
        (function () {
          try {
            if (window.location && window.location.pathname === '/pages/missing-people-location') {
              window.location.replace('/pages/missing-people-location-live' + (window.location.search || ''));
            }
          } catch (e) {}
        })();
      </script>
      <noscript>
        <meta http-equiv="refresh" content="0;url=/pages/missing-people-location-live{% if request.query_string != blank %}?{{ request.query_string | escape }}{% endif %}">
      </noscript>
    {%- endif -%}
    {%- if template.suffix == 'staff' -%}
      <meta name="robots" content="noindex,nofollow">
    {%- elsif request.page_type == '404' or template.name == '404' -%}
      <meta name="robots" content="noindex,follow">
    {%- elsif request.path == '/pages/country-search' or request.path == '/pages/top-missing-locations' -%}
      <meta name="robots" content="noindex,follow">
    {%- elsif ma_tagged_archive -%}
      <meta name="robots" content="noindex,follow">
    {%- elsif ma_location_request_has_real_content == false -%}
      <meta name="robots" content="noindex,follow">
    {%- elsif request.path contains '/pages/' and ma_location_seo_handles contains ma_location_page_lookup and ma_location_request_should_index == false -%}
      <meta name="robots" content="noindex,follow">
    {%- endif -%}

    {%- if settings.favicon != blank -%}
      <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 32, height: 32 }}">
    {%- endif -%}

    {%- liquid
      assign has_body_font = false
      assign has_header_font = false
      if settings.type_body_font.family != blank
        assign has_body_font = true
      endif
      if settings.type_header_font.family != blank
        assign has_header_font = true
      endif
    -%}

    {%- if has_header_font or has_body_font -%}
      <link rel="preconnect" href="https://fonts.shopifycdn.com" crossorigin>
    {%- endif -%}

    {%- liquid
      assign location_seo_handles = '|missing-people-location|missing-people-location-live|missing-alerts-near-me|missing-person-search-guide|missing-cases-near|no-active-missing-cases|missing-people-near-me|recent-missing-cases|help-find-missing|missing-people-region|missing-people-country|'
      assign request_page_handle = request.path | split: '/pages/' | last | split: '/' | first
      assign location_page_lookup = '|' | append: request_page_handle | append: '|'
      assign location_seo_param = ''
      assign query_parts = request.query_string | default: '' | split: '&'
      for query_part in query_parts
        assign query_key = query_part | split: '=' | first
        if query_key == 'loc' or query_key == 'region' or query_key == 'country'
          assign location_seo_param = query_part | remove_first: query_key | remove_first: '='
          break
        endif
      endfor
      assign is_location_seo_request = false
      if request.path contains '/pages/' and location_seo_handles contains location_page_lookup
        assign is_location_seo_request = true
      endif
      assign location_seo_label = location_seo_param | split: '/' | last | replace: '-', ' ' | replace: '+', ' ' | replace: '%20', ' ' | capitalize
      if location_seo_label == blank
        assign location_seo_label = 'this location'
      endif
      assign location_seo_title = 'Missing People in ' | append: location_seo_label | append: ' | Live Alerts & Cases'
      assign location_seo_description = 'View live missing person alerts, recent cases, and updates in ' | append: location_seo_label | append: '. Stay informed and help share information.'
      assign display_page_title = page_title
      if request.page_type == 'page' and page.handle == 'donate'
        assign display_page_title = 'Support'
      elsif request.page_type == 'page' and page.handle == 'support'
        assign display_page_title = 'Support'
      elsif request.page_type == 'page' and page.handle == 'country-search'
        assign display_page_title = 'Country Intelligence'
      elsif request.page_type == 'page' and page.handle == 'country-intelligence'
        assign display_page_title = 'Country Intelligence'
      elsif request.page_type == 'page' and page.handle == 'top-missing-locations'
        assign display_page_title = 'Country Intelligence'
      elsif request.page_type == 'blog' and blog.handle == 'missing-persons'
        assign display_page_title = 'Latest Missing Person Appeals'
      elsif request.page_type == 'blog' and blog.handle == 'found-safe'
        assign display_page_title = 'Found Safe Updates'
      elsif request.page_type == 'blog' and blog.handle == 'missing-person-advice'
        assign display_page_title = 'Missing Person Advice Articles'
      elsif is_location_seo_request
        assign display_page_title = location_seo_title
      endif
      assign ma_meta_description = page_description
      if request.path == '/'
        assign ma_meta_description = 'Missing Alerts publishes source-backed missing-person appeals, found-safe updates, country intelligence, and practical advice to help people share urgent public information safely.'
      elsif request.page_type == 'page' and page.handle == 'missing-person-advice'
        assign ma_meta_description = 'Practical Missing Alerts guidance for reporting a missing person, sharing appeals safely, preserving CCTV or sightings, supporting families, and finding official country links.'
      elsif request.page_type == 'page' and page.handle == 'country-search'
        assign ma_meta_description = 'Search Missing Alerts country intelligence for official reporting links, active case guidance, country-specific advice, and safe sharing information.'
      elsif request.page_type == 'page' and page.handle == 'country-intelligence'
        assign ma_meta_description = 'Missing Alerts Country Intelligence brings together country-specific missing-person guidance, official reporting links, active case context, and safe sharing advice.'
      elsif request.page_type == 'page' and page.handle == 'top-missing-locations'
        assign ma_meta_description = 'Use Missing Alerts Country Intelligence and the Global Location Checker for country and location guidance, active cases, official reporting links, and safe sharing advice.'
      elsif request.page_type == 'blog' and blog.handle == 'missing-persons'
        assign ma_meta_description = 'Browse active public missing-person appeals listed by Missing Alerts with source attribution, country information, location context, and safe sharing guidance.'
      elsif request.page_type == 'blog' and blog.handle == 'found-safe'
        assign ma_meta_description = 'View Missing Alerts found-safe updates with privacy-protected presentation, source attribution, and guidance on closing or updating public appeals.'
      elsif request.page_type == 'blog' and blog.handle == 'missing-person-advice'
        assign ma_meta_description = 'Read Missing Alerts advice articles covering first steps, reporting, safe sharing, sightings, CCTV, family support, and country-specific guidance.'
      elsif request.page_type == 'blog'
        assign ma_meta_description = 'Read Missing Alerts updates, public safety guidance, and source-backed information about missing-person appeals and response workflows.'
      endif
    -%}

    <title>
      {{ display_page_title }}
      {%- if current_tags %} &ndash; tagged "{{ current_tags | join: ', ' }}"{% endif -%}
      {%- if current_page != 1 %} &ndash; Page {{ current_page }}{% endif -%}
      {%- unless display_page_title contains shop.name or is_location_seo_request %} &ndash; {{ shop.name }}{% endunless -%}
    </title>

    {% if is_location_seo_request %}
      <meta name="description" content="{{ location_seo_description | escape }}">
    {% elsif ma_meta_description %}
      <meta name="description" content="{{ ma_meta_description | escape }}">
    {% endif %}

    {% render 'meta-tags' %}
    {% render 'country-mode-config' %}

    <script src="{{ 'constants.js' | asset_url }}" defer="defer"></script>
    <script src="{{ 'pubsub.js' | asset_url }}" defer="defer"></script>
    <script src="{{ 'global.js' | asset_url }}" defer="defer"></script>
    <script src="{{ 'details-disclosure.js' | asset_url }}" defer="defer"></script>
    <script src="{{ 'details-modal.js' | asset_url }}" defer="defer"></script>
    <script src="{{ 'search-form.js' | asset_url }}" defer="defer"></script>
    <script src="{{ 'country-mode-v20260506-final.js' | asset_url }}" defer="defer"></script>

    {%- if settings.animations_reveal_on_scroll -%}
      <script src="{{ 'animations.js' | asset_url }}" defer="defer"></script>
    {%- endif -%}

    {{ content_for_header }}

    {%- liquid
      if has_body_font
        assign body_font_bold = settings.type_body_font | font_modify: 'weight', 'bold'
        assign body_font_italic = settings.type_body_font | font_modify: 'style', 'italic'
        assign body_font_bold_italic = body_font_bold | font_modify: 'style', 'italic'
      endif
    %}

    {% style %}
      {% if has_body_font %}
        {{ settings.type_body_font | font_face: font_display: 'swap' }}
        {{ body_font_bold | font_face: font_display: 'swap' }}
        {{ body_font_italic | font_face: font_display: 'swap' }}
        {{ body_font_bold_italic | font_face: font_display: 'swap' }}
      {% endif %}
      {% if has_header_font %}
        {{ settings.type_header_font | font_face: font_display: 'swap' }}
      {% endif %}

      {% for scheme in settings.color_schemes -%}
        {% assign scheme_classes = scheme_classes | append: ', .color-' | append: scheme.id %}
        {% if forloop.index == 1 -%}
          :root,
        {%- endif %}
        .color-{{ scheme.id }} {
          --color-background: {{ scheme.settings.background.red }},{{ scheme.settings.background.green }},{{ scheme.settings.background.blue }};
        {% if scheme.settings.background_gradient != empty %}
          --gradient-background: {{ scheme.settings.background_gradient }};
        {% else %}
          --gradient-background: {{ scheme.settings.background }};
        {% endif %}

        {% liquid
          assign background_color = scheme.settings.background
          assign background_color_brightness = background_color | color_brightness
          if background_color_brightness <= 26
            assign background_color_contrast = background_color | color_lighten: 50
          elsif background_color_brightness <= 65
            assign background_color_contrast = background_color | color_lighten: 5
          else
            assign background_color_contrast = background_color | color_darken: 25
          endif
        %}

        --color-foreground: {{ scheme.settings.text.red }},{{ scheme.settings.text.green }},{{ scheme.settings.text.blue }};
        --color-background-contrast: {{ background_color_contrast.red }},{{ background_color_contrast.green }},{{ background_color_contrast.blue }};
        --color-shadow: {{ scheme.settings.shadow.red }},{{ scheme.settings.shadow.green }},{{ scheme.settings.shadow.blue }};
        --color-button: {{ scheme.settings.button.red }},{{ scheme.settings.button.green }},{{ scheme.settings.button.blue }};
        --color-button-text: {{ scheme.settings.button_label.red }},{{ scheme.settings.button_label.green }},{{ scheme.settings.button_label.blue }};
        --color-secondary-button: {{ scheme.settings.background.red }},{{ scheme.settings.background.green }},{{ scheme.settings.background.blue }};
        --color-secondary-button-text: {{ scheme.settings.secondary_button_label.red }},{{ scheme.settings.secondary_button_label.green }},{{ scheme.settings.secondary_button_label.blue }};
        --color-link: {{ scheme.settings.secondary_button_label.red }},{{ scheme.settings.secondary_button_label.green }},{{ scheme.settings.secondary_button_label.blue }};
        --color-badge-foreground: {{ scheme.settings.text.red }},{{ scheme.settings.text.green }},{{ scheme.settings.text.blue }};
        --color-badge-background: {{ scheme.settings.background.red }},{{ scheme.settings.background.green }},{{ scheme.settings.background.blue }};
        --color-badge-border: {{ scheme.settings.text.red }},{{ scheme.settings.text.green }},{{ scheme.settings.text.blue }};
        --payment-terms-background-color: rgb({{ scheme.settings.background.rgb }});
      }
      {% endfor %}

      {{ scheme_classes | prepend: 'body' }} {
        color: rgba(var(--color-foreground), 0.75);
        background-color: rgb(var(--color-background));
      }

      :root {
        {% if has_body_font %}
          --font-body-family: {{ settings.type_body_font.family }}, {{ settings.type_body_font.fallback_families }};
          --font-body-style: {{ settings.type_body_font.style }};
          --font-body-weight: {{ settings.type_body_font.weight }};
          --font-body-weight-bold: {{ settings.type_body_font.weight | plus: 300 | at_most: 1000 }};
        {% else %}
          --font-body-family: Arial, sans-serif;
          --font-body-style: normal;
          --font-body-weight: 400;
          --font-body-weight-bold: 700;
        {% endif %}

        {% if has_header_font %}
          --font-heading-family: {{ settings.type_header_font.family }}, {{ settings.type_header_font.fallback_families }};
          --font-heading-style: {{ settings.type_header_font.style }};
          --font-heading-weight: {{ settings.type_header_font.weight }};
        {% else %}
          --font-heading-family: Arial, sans-serif;
          --font-heading-style: normal;
          --font-heading-weight: 700;
        {% endif %}

        --font-body-scale: {{ settings.body_scale | divided_by: 100.0 }};
        --font-heading-scale: {{ settings.heading_scale | times: 1.0 | divided_by: settings.body_scale }};

        --media-padding: {{ settings.media_padding }}px;
        --media-border-opacity: {{ settings.media_border_opacity | divided_by: 100.0 }};
        --media-border-width: {{ settings.media_border_thickness }}px;
        --media-radius: {{ settings.media_radius }}px;
        --media-shadow-opacity: {{ settings.media_shadow_opacity | divided_by: 100.0 }};
        --media-shadow-horizontal-offset: {{ settings.media_shadow_horizontal_offset }}px;
        --media-shadow-vertical-offset: {{ settings.media_shadow_vertical_offset }}px;
        --media-shadow-blur-radius: {{ settings.media_shadow_blur }}px;
        --media-shadow-visible: {% if settings.media_shadow_opacity > 0 %}1{% else %}0{% endif %};

        --page-width: {{ settings.page_width | divided_by: 10 }}rem;
        --page-width-margin: {% if settings.page_width == '1600' %}2{% else %}0{% endif %}rem;

        --product-card-image-padding: {{ settings.card_image_padding | divided_by: 10.0 }}rem;
        --product-card-corner-radius: {{ settings.card_corner_radius | divided_by: 10.0 }}rem;
        --product-card-text-alignment: {{ settings.card_text_alignment }};
        --product-card-border-width: {{ settings.card_border_thickness | divided_by: 10.0 }}rem;
        --product-card-border-opacity: {{ settings.card_border_opacity | divided_by: 100.0 }};
        --product-card-shadow-opacity: {{ settings.card_shadow_opacity | divided_by: 100.0 }};
        --product-card-shadow-visible: {% if settings.card_shadow_opacity > 0 %}1{% else %}0{% endif %};
        --product-card-shadow-horizontal-offset: {{ settings.card_shadow_horizontal_offset | divided_by: 10.0 }}rem;
        --product-card-shadow-vertical-offset: {{ settings.card_shadow_vertical_offset | divided_by: 10.0 }}rem;
        --product-card-shadow-blur-radius: {{ settings.card_shadow_blur | divided_by: 10.0 }}rem;

        --collection-card-image-padding: {{ settings.collection_card_image_padding | divided_by: 10.0 }}rem;
        --collection-card-corner-radius: {{ settings.collection_card_corner_radius | divided_by: 10.0 }}rem;
        --collection-card-text-alignment: {{ settings.collection_card_text_alignment }};
        --collection-card-border-width: {{ settings.collection_card_border_thickness | divided_by: 10.0 }}rem;
        --collection-card-border-opacity: {{ settings.collection_card_border_opacity | divided_by: 100.0 }};
        --collection-card-shadow-opacity: {{ settings.collection_card_shadow_opacity | divided_by: 100.0 }};
        --collection-card-shadow-visible: {% if settings.collection_card_shadow_opacity > 0 %}1{% else %}0{% endif %};
        --collection-card-shadow-horizontal-offset: {{ settings.collection_card_shadow_horizontal_offset | divided_by: 10.0 }}rem;
        --collection-card-shadow-vertical-offset: {{ settings.collection_card_shadow_vertical_offset | divided_by: 10.0 }}rem;
        --collection-card-shadow-blur-radius: {{ settings.collection_card_shadow_blur | divided_by: 10.0 }}rem;

        --blog-card-image-padding: {{ settings.blog_card_image_padding | divided_by: 10.0 }}rem;
        --blog-card-corner-radius: {{ settings.blog_card_corner_radius | divided_by: 10.0 }}rem;
        --blog-card-text-alignment: {{ settings.blog_card_text_alignment }};
        --blog-card-border-width: {{ settings.blog_card_border_thickness | divided_by: 10.0 }}rem;
        --blog-card-border-opacity: {{ settings.blog_card_border_opacity | divided_by: 100.0 }};
        --blog-card-shadow-opacity: {{ settings.blog_card_shadow_opacity | divided_by: 100.0 }};
        --blog-card-shadow-visible: {% if settings.blog_card_shadow_opacity > 0 %}1{% else %}0{% endif %};
        --blog-card-shadow-horizontal-offset: {{ settings.blog_card_shadow_horizontal_offset | divided_by: 10.0 }}rem;
        --blog-card-shadow-vertical-offset: {{ settings.blog_card_shadow_vertical_offset | divided_by: 10.0 }}rem;
        --blog-card-shadow-blur-radius: {{ settings.blog_card_shadow_blur | divided_by: 10.0 }}rem;

        --badge-corner-radius: {{ settings.badge_corner_radius | divided_by: 10.0 }}rem;

        --popup-border-width: {{ settings.popup_border_thickness }}px;
        --popup-border-opacity: {{ settings.popup_border_opacity | divided_by: 100.0 }};
        --popup-corner-radius: {{ settings.popup_corner_radius }}px;
        --popup-shadow-opacity: {{ settings.popup_shadow_opacity | divided_by: 100.0 }};
        --popup-shadow-horizontal-offset: {{ settings.popup_shadow_horizontal_offset }}px;
        --popup-shadow-vertical-offset: {{ settings.popup_shadow_vertical_offset }}px;
        --popup-shadow-blur-radius: {{ settings.popup_shadow_blur }}px;

        --drawer-border-width: {{ settings.drawer_border_thickness }}px;
        --drawer-border-opacity: {{ settings.drawer_border_opacity | divided_by: 100.0 }};
        --drawer-shadow-opacity: {{ settings.drawer_shadow_opacity | divided_by: 100.0 }};
        --drawer-shadow-horizontal-offset: {{ settings.drawer_shadow_horizontal_offset }}px;
        --drawer-shadow-vertical-offset: {{ settings.drawer_shadow_vertical_offset }}px;
        --drawer-shadow-blur-radius: {{ settings.drawer_shadow_blur }}px;

        --spacing-sections-desktop: {{ settings.spacing_sections }}px;
        --spacing-sections-mobile: {% if settings.spacing_sections < 24 %}{{ settings.spacing_sections }}{% else %}{{ settings.spacing_sections | times: 0.7 | round | at_least: 20 }}{% endif %}px;

        --grid-desktop-vertical-spacing: {{ settings.spacing_grid_vertical }}px;
        --grid-desktop-horizontal-spacing: {{ settings.spacing_grid_horizontal }}px;
        --grid-mobile-vertical-spacing: {{ settings.spacing_grid_vertical | divided_by: 2 }}px;
        --grid-mobile-horizontal-spacing: {{ settings.spacing_grid_horizontal | divided_by: 2 }}px;

        --text-boxes-border-opacity: {{ settings.text_boxes_border_opacity | divided_by: 100.0 }};
        --text-boxes-border-width: {{ settings.text_boxes_border_thickness }}px;
        --text-boxes-radius: {{ settings.text_boxes_radius }}px;
        --text-boxes-shadow-opacity: {{ settings.text_boxes_shadow_opacity | divided_by: 100.0 }};
        --text-boxes-shadow-visible: {% if settings.text_boxes_shadow_opacity > 0 %}1{% else %}0{% endif %};
        --text-boxes-shadow-horizontal-offset: {{ settings.text_boxes_shadow_horizontal_offset }}px;
        --text-boxes-shadow-vertical-offset: {{ settings.text_boxes_shadow_vertical_offset }}px;
        --text-boxes-shadow-blur-radius: {{ settings.text_boxes_shadow_blur }}px;

        --buttons-radius: {{ settings.buttons_radius }}px;
        --buttons-radius-outset: {% if settings.buttons_radius > 0 %}{{ settings.buttons_radius | plus: settings.buttons_border_thickness }}{% else %}0{% endif %}px;
        --buttons-border-width: {% if settings.buttons_border_opacity > 0 %}{{ settings.buttons_border_thickness }}{% else %}0{% endif %}px;
        --buttons-border-opacity: {{ settings.buttons_border_opacity | divided_by: 100.0 }};
        --buttons-shadow-opacity: {{ settings.buttons_shadow_opacity | divided_by: 100.0 }};
        --buttons-shadow-visible: {% if settings.buttons_shadow_opacity > 0 %}1{% else %}0{% endif %};
        --buttons-shadow-horizontal-offset: {{ settings.buttons_shadow_horizontal_offset }}px;
        --buttons-shadow-vertical-offset: {{ settings.buttons_shadow_vertical_offset }}px;
        --buttons-shadow-blur-radius: {{ settings.buttons_shadow_blur }}px;
        --buttons-border-offset: {% if settings.buttons_radius > 0 or settings.buttons_shadow_opacity > 0 %}0.3{% else %}0{% endif %}px;

        --inputs-radius: {{ settings.inputs_radius }}px;
        --inputs-border-width: {{ settings.inputs_border_thickness }}px;
        --inputs-border-opacity: {{ settings.inputs_border_opacity | divided_by: 100.0 }};
        --inputs-shadow-opacity: {{ settings.inputs_shadow_opacity | divided_by: 100.0 }};
        --inputs-shadow-horizontal-offset: {{ settings.inputs_shadow_horizontal_offset }}px;
        --inputs-margin-offset: {% if settings.inputs_shadow_vertical_offset != 0 and settings.inputs_shadow_opacity > 0 %}{{ settings.inputs_shadow_vertical_offset | abs }}{% else %}0{% endif %}px;
        --inputs-shadow-vertical-offset: {{ settings.inputs_shadow_vertical_offset }}px;
        --inputs-shadow-blur-radius: {{ settings.inputs_shadow_blur }}px;
        --inputs-radius-outset: {% if settings.inputs_radius > 0 %}{{ settings.inputs_radius | plus: settings.inputs_border_thickness }}{% else %}0{% endif %}px;

        --variant-pills-radius: {{ settings.variant_pills_radius }}px;
        --variant-pills-border-width: {{ settings.variant_pills_border_thickness }}px;
        --variant-pills-border-opacity: {{ settings.variant_pills_border_opacity | divided_by: 100.0 }};
        --variant-pills-shadow-opacity: {{ settings.variant_pills_shadow_opacity | divided_by: 100.0 }};
        --variant-pills-shadow-horizontal-offset: {{ settings.variant_pills_shadow_horizontal_offset }}px;
        --variant-pills-shadow-vertical-offset: {{ settings.variant_pills_shadow_vertical_offset }}px;
        --variant-pills-shadow-blur-radius: {{ settings.variant_pills_shadow_blur }}px;
      }

      *,
      *::before,
      *::after {
        box-sizing: inherit;
      }

      html {
        box-sizing: border-box;
        font-size: calc(var(--font-body-scale) * 62.5%);
        height: 100%;
      }

      body {
        display: grid;
        grid-template-rows: auto auto 1fr auto;
        grid-template-columns: 100%;
        min-height: 100%;
        margin: 0;
        font-size: 1.5rem;
        letter-spacing: 0.06rem;
        line-height: calc(1 + 0.8 / var(--font-body-scale));
        font-family: var(--font-body-family);
        font-style: var(--font-body-style);
        font-weight: var(--font-body-weight);
      }

      @media screen and (min-width: 750px) {
        body {
          font-size: 1.6rem;
        }
      }
    {% endstyle %}

    {{ 'base.css' | asset_url | stylesheet_tag }}
    {{ 'country-mode.css' | asset_url | stylesheet_tag }}
    {{ 'case-notifications.css' | asset_url | stylesheet_tag }}
    {{ 'case-page-final-polish.css' | asset_url | stylesheet_tag }}
    <link rel="stylesheet" href="{{ 'component-cart-items.css' | asset_url }}" media="print" onload="this.media='all'">

    {%- if settings.cart_type == 'drawer' -%}
      {{ 'component-cart-drawer.css' | asset_url | stylesheet_tag }}
      {{ 'component-cart.css' | asset_url | stylesheet_tag }}
      {{ 'component-totals.css' | asset_url | stylesheet_tag }}
      {{ 'component-price.css' | asset_url | stylesheet_tag }}
      {{ 'component-discounts.css' | asset_url | stylesheet_tag }}
    {%- endif -%}

    {%- if has_body_font and settings.type_body_font.system? == false -%}
      {% comment %}theme-check-disable AssetPreload{% endcomment %}
      <link rel="preload" as="font" href="{{ settings.type_body_font | font_url }}" type="font/woff2" crossorigin>
      {% comment %}theme-check-enable AssetPreload{% endcomment %}
    {%- endif -%}
    {%- if has_header_font and settings.type_header_font.system? == false -%}
      {% comment %}theme-check-disable AssetPreload{% endcomment %}
      <link rel="preload" as="font" href="{{ settings.type_header_font | font_url }}" type="font/woff2" crossorigin>
      {% comment %}theme-check-enable AssetPreload{% endcomment %}
    {%- endif -%}

    {%- if localization.available_countries.size > 1 or localization.available_languages.size > 1 -%}
      {{ 'component-localization-form.css' | asset_url | stylesheet_tag: preload: true }}
      <script src="{{ 'localization-form.js' | asset_url }}" defer="defer"></script>
    {%- endif -%}

    {%- if settings.predictive_search_enabled -%}
      <link
        rel="stylesheet"
        href="{{ 'component-predictive-search.css' | asset_url }}"
        media="print"
        onload="this.media='all'"
      >
    {%- endif -%}
    {{ 'email-capture-modal.css' | asset_url | stylesheet_tag }}

    <script>
      if (Shopify.designMode) {
        document.documentElement.classList.add('shopify-design-mode');
      }
    </script>
    <style id="missing-alerts-final-polish">
      .card__heading,
      .article-card__title,
      .boosted-card h3,
      .boosted-sidebar-card h3,
      .mpa-found-title {
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
      }
      .article-card__excerpt,
      .card__information .rte,
      .boosted-card p,
      .boosted-sidebar-card p,
      .mpa-found-excerpt {
        display: -webkit-box;
        -webkit-line-clamp: 3;
        -webkit-box-orient: vertical;
        overflow: hidden;
      }
      .boosted-card,
      .boosted-sidebar-card,
      .mpa-found-card {
        min-height: 0;
      }
      .case-page-boost-config-note {
        margin-top: 14px;
        padding: 12px 14px;
        border-radius: 12px;
        background: rgba(255,255,255,.07);
        border: 1px solid rgba(255,255,255,.12);
        color: rgba(255,255,255,.82);
        font-size: 13px;
        line-height: 1.45;
        font-weight: 800;
      }
    </style>
  </head>

  <body class="gradient template-{{ template.name | handle }} page-type-{{ request.page_type | handle }}{% if template.name contains 'customers' or request.page_type contains 'customers' or request.page_type contains 'account' %} customer-area{% endif %}{% if settings.animations_hover_elements != 'none' %} animate--hover-{{ settings.animations_hover_elements }}{% endif %}">
    {% render 'email-capture-modal' %}

    <a class="skip-to-content-link button visually-hidden" href="#MainContent">
      {{ 'accessibility.skip_to_text' | t }}
    </a>

    {%- if settings.cart_type == 'drawer' -%}
      {%- render 'cart-drawer' -%}
    {%- endif -%}

    {% render 'country-top-bar' %}
    {% sections 'header-group' %}
    {% render 'country-selector-popup' %}

    {% liquid
      assign ma_is_public_home = false
      assign ma_tools_product = ''
      assign ma_route_probe = request.path | default: ''
      assign ma_route_canonical = canonical_url | default: ''
      if request.page_type == 'index'
        assign ma_is_public_home = true
      endif
      if template.name == 'index'
        assign ma_is_public_home = true
      endif
      if request.path == '/'
        assign ma_is_public_home = true
      endif
      if ma_route_probe == '/tools' or ma_route_probe == '/pages/tools' or ma_route_canonical contains '/tools' or ma_route_canonical contains '/pages/tools'
        assign ma_tools_product = 'overview'
      elsif ma_route_probe contains '/tools/findtrax' or ma_route_probe contains '/pages/findtrax' or ma_route_canonical contains '/tools/findtrax' or ma_route_canonical contains '/pages/findtrax'
        assign ma_tools_product = 'findtrax'
      elsif ma_route_probe contains '/tools/intelpro' or ma_route_probe contains '/pages/intelpro' or ma_route_canonical contains '/tools/intelpro' or ma_route_canonical contains '/pages/intelpro'
        assign ma_tools_product = 'intelpro'
      elsif ma_route_probe contains '/tools/mediareach' or ma_route_probe contains '/pages/mediareach' or ma_route_canonical contains '/tools/mediareach' or ma_route_canonical contains '/pages/mediareach'
        assign ma_tools_product = 'mediareach'
      endif
    %}
	    <main id="MainContent" class="content-for-layout focus-none" role="main" tabindex="-1">
			      <div style="display:none" data-ma-cache-marker="MA_HOME_SOURCE_VERIFIED_20260506_FINAL">Missing Alerts layout source marker</div>
			      {% if ma_is_public_home %}
			        <script id="ma-layout-live-proof-source">window.MA_LAYOUT_LIVE_PROOF="20260506_FINAL";</script>
			        <!-- MA_LAYOUT_LIVE_PROOF_20260506_FINAL -->
			        {% render 'homepage-inline-country-filter-final' %}
			      {% endif %}
		      {% if ma_tools_product != blank %}
	        {% render 'ma-tools-page', product: ma_tools_product %}
	      {% elsif ma_is_public_home %}
	        <!-- Missing Alerts active case visibility cache marker: 2026-05-06-country-homepage -->
	        {% capture ma_public_home_markup %}{% render 'restored-homepage-grid-compact' %}{% endcapture %}
	          {% assign ma_public_home_markup = ma_public_home_markup | replace_first: '<div class="mpa-cases-grid">', '<div class="mpa-cases-grid" data-ma-country-filter-version="20260506-final">' %}
	          {% assign ma_public_home_markup = ma_public_home_markup | replace: 'class="mpa-case-link"', 'class="mpa-case-link ma-home-case-card"' %}
	          {% assign ma_public_home_markup = ma_public_home_markup | replace: '<div class="mpa-case-card"', '<div class="mpa-case-card ma-home-case-card"' %}
	          <script id="ma-layout-live-proof-home">window.MA_LAYOUT_LIVE_PROOF="20260506_FINAL";</script>
	          <!-- MA_LAYOUT_LIVE_PROOF_20260506_FINAL -->
	          {{ ma_public_home_markup }}
	          <!-- MA_INLINE_COUNTRY_FILTER_20260506_FINAL -->
	          <script>
	            (function() {
	              var version = '20260506-final';
	              var aliases = {
	                gb: ['gb', 'uk', 'united-kingdom', 'unitedkingdom', 'england', 'scotland', 'wales', 'northern-ireland', 'northernireland'],
	                us: ['us', 'usa', 'united-states', 'unitedstates', 'united-states-of-america', 'unitedstatesofamerica'],
	                ca: ['ca', 'canada'],
	                au: ['au', 'australia'],
	                nz: ['nz', 'new-zealand', 'newzealand'],
	                ie: ['ie', 'ireland'],
	                sg: ['sg', 'singapore'],
	                za: ['za', 'south-africa', 'southafrica']
	              };
	              var names = { gb: 'United Kingdom', us: 'United States', ca: 'Canada', au: 'Australia', nz: 'New Zealand', ie: 'Ireland', sg: 'Singapore', za: 'South Africa' };
	              function normalize(value) {
	                var text = value || '';
	                if (typeof text === 'object') text = text.code || text.countryCode || text.slug || text.country || text.name || '';
	                text = String(text).trim().toLowerCase();
	                try {
	                  if (text.charAt(0) === '{' || text.charAt(0) === '[') return normalize(JSON.parse(text));
	                } catch (error) {}
	                return text.replace(/&/g, 'and').replace(/[^a-z0-9]+/g, '-').replace(/^-+|-+$/g, '');
	              }
	              function canonical(value) {
	                var normalized = normalize(value);
	                var compacted = normalized.replace(/-/g, '');
	                if (!normalized || ['all', 'global', 'worldwide', 'international'].indexOf(normalized) !== -1) return '';
	                for (var code in aliases) {
	                  if (aliases[code].indexOf(normalized) !== -1 || aliases[code].indexOf(compacted) !== -1) return code;
	                }
	                return normalized;
	              }
	              function cookie(name) {
	                var parts = document.cookie ? document.cookie.split(';') : [];
	                for (var i = 0; i < parts.length; i += 1) {
	                  var part = parts[i].trim();
	                  if (part.indexOf(name + '=') === 0) return decodeURIComponent(part.slice(name.length + 1));
	                }
	                return '';
	              }
	              function selectedCountry() {
	                var queryCountry = '';
	                var storedCountry = '';
	                try { queryCountry = new URLSearchParams(window.location.search).get('country') || ''; } catch (error) {}
	                try { storedCountry = window.localStorage.getItem('missingAlertsCountry') || ''; } catch (error) {}
	                return canonical(queryCountry || storedCountry || cookie('missing_alerts_country') || document.documentElement.getAttribute('data-country-code') || '');
	              }
	              function cardCountry(node) {
	                return canonical(node.getAttribute('data-country-code') || node.getAttribute('data-country-slug') || node.getAttribute('data-country-name') || node.getAttribute('data-country-scope') || '');
	              }
	              function isActive(item, card) {
	                var status = normalize((card && card.getAttribute('data-status')) || item.getAttribute('data-status') || '');
	                return status.indexOf('found') === -1 && status.indexOf('safe') === -1 && status.indexOf('resolved') === -1 && status.indexOf('located') === -1 && status.indexOf('closed') === -1;
	              }
	              function applyFilter() {
	                var grid = document.querySelector('.mpa-latest-layout .mpa-cases-grid');
	                if (!grid) return;
	                grid.setAttribute('data-ma-country-filter-version', version);
	                var selected = selectedCountry();
	                var visible = 0;
	                Array.prototype.slice.call(grid.children).forEach(function(item) {
	                  var card = item.matches('.mpa-case-card, .ma-home-case-card') ? item : item.querySelector('.mpa-case-card, .ma-home-case-card');
	                  if (!card) return;
	                  item.classList.add('ma-home-case-card');
	                  card.classList.add('ma-home-case-card');
	                  ['data-country-code', 'data-country-slug', 'data-country-name', 'data-country-scope', 'data-status'].forEach(function(attr) {
	                    if (!item.getAttribute(attr) && card.getAttribute(attr)) item.setAttribute(attr, card.getAttribute(attr));
	                    if (!card.getAttribute(attr) && item.getAttribute(attr)) card.setAttribute(attr, item.getAttribute(attr));
	                  });
	                  item.setAttribute('data-active-case', 'true');
	                  card.setAttribute('data-active-case', 'true');
	                  var matches = !selected || cardCountry(item) === selected || cardCountry(card) === selected;
	                  var show = isActive(item, card) && matches && visible < 6;
	                  if (show) visible += 1;
	                  item.hidden = !show;
	                  item.setAttribute('data-ma-home-filter-hidden', show ? 'false' : 'true');
	                  item.style.setProperty('display', show ? 'block' : 'none', show ? '' : 'important');
	                });
	                var wrap = grid.closest('.mpa-cases-wrap');
	                var empty = wrap && wrap.querySelector('.ma-home-country-empty');
	                var heading = wrap && wrap.querySelector('.mpa-cases-head h2');
	                if (heading) heading.textContent = selected && names[selected] ? 'LATEST MISSING CASES - ' + names[selected].toUpperCase() : 'LATEST MISSING CASES';
	                if (empty) {
	                  empty.hidden = visible !== 0;
	                  empty.style.display = visible === 0 ? 'block' : 'none';
	                }
	              }
	              window.maInlineCountryFilter20260506Final = applyFilter;
	              document.addEventListener('DOMContentLoaded', applyFilter);
	              window.addEventListener('pageshow', applyFilter);
	              window.addEventListener('storage', applyFilter);
	              window.addEventListener('missingAlertsCountryChanged', applyFilter);
	              if (document.readyState !== 'loading') applyFilter();
	              setTimeout(applyFilter, 100);
	              setTimeout(applyFilter, 800);
	            })();
	          </script>
	          {% render 'homepage-inline-country-filter-final' %}
	          {% render 'homepage-grid-compact-runtime' %}
	      {% else %}
	        {% capture ma_rendered_layout %}{{ content_for_layout }}{% endcapture %}
	      {% if ma_rendered_layout contains 'ma-safe-home' %}
	        {% capture ma_safe_home_markup %}{% render 'restored-homepage-grid-compact' %}{% endcapture %}
          {% assign ma_safe_home_markup = ma_safe_home_markup | replace_first: '<div class="mpa-cases-grid">', '<div class="mpa-cases-grid" data-ma-country-filter-version="20260506-final">' %}
          {% assign ma_safe_home_markup = ma_safe_home_markup | replace: 'class="mpa-case-link"', 'class="mpa-case-link ma-home-case-card"' %}
          {% assign ma_safe_home_markup = ma_safe_home_markup | replace: '<div class="mpa-case-card"', '<div class="mpa-case-card ma-home-case-card"' %}
          {{ ma_safe_home_markup }}
          {% render 'homepage-inline-country-filter-final' %}
          {% render 'homepage-grid-compact-runtime' %}
	        <div class="page-width">
	          {% render 'related-safety-products',
            heading: 'Safety product guides',
            limit: 3
          %}
        </div>
	      {% else %}
	        {% assign ma_old_location_cta = 'Follow alerts' | append: ' in this area' %}
        {% assign ma_old_location_email_id = 'LocationAlert' | append: 'SignupEmail' %}
        {% assign ma_old_location_universal_email_id = 'LocationUniversalAlert' | append: 'SignupEmail' %}
        {% assign ma_rendered_layout = ma_rendered_layout | replace: ma_old_location_cta, 'Follow this area for updates' %}
        {% assign ma_rendered_layout = ma_rendered_layout | replace: ma_old_location_email_id, 'LocationFollowSignupDeprecated' %}
        {% assign ma_rendered_layout = ma_rendered_layout | replace: ma_old_location_universal_email_id, 'LocationUniversalFollowSignupDeprecated' %}
        {{ ma_rendered_layout }}
        {% assign ma_is_old_location_page = false %}
        {% if page.handle == 'missing-people-location' or page.handle == 'missing-people-location-live' or request.path == '/pages/missing-people-location' or request.path == '/pages/missing-people-location-live' %}
          {% assign ma_is_old_location_page = true %}
	      {% endif %}
	      {% endif %}
        {% if ma_is_old_location_page %}
          <!-- MA_LOCATION_LAYOUT_SIGNUP_FALLBACK -->
          <script>
            (function() {
              try {
                var nextPath = '/pages/missing-people-location-live';
                var params = window.location.search || '';
                if (window.location.pathname === '/pages/missing-people-location') {
                  window.location.replace(nextPath + params);
                }
              } catch (e) {}
            })();
          </script>
          {% render 'missing-alerts-signup',
            page_type: 'location',
            location_slug: '',
            location_label: 'this location'
          %}
        {% endif %}
      {% endif %}
    </main>

    <nav class="ma-location-crawl-link" aria-label="Location browsing">
      <a href="/pages/country-intelligence">Open Country Intelligence</a>
    </nav>

    {% sections 'footer-group' %}

    <ul hidden>
      <li id="a11y-refresh-page-message">{{ 'accessibility.refresh_page' | t }}</li>
      <li id="a11y-new-window-message">{{ 'accessibility.link_messages.new_window' | t }}</li>
    </ul>

    <script>
      window.shopUrl = '{{ request.origin }}';
      window.routes = {
        cart_add_url: '{{ routes.cart_add_url }}',
        cart_change_url: '{{ routes.cart_change_url }}',
        cart_update_url: '{{ routes.cart_update_url }}',
        cart_url: '{{ routes.cart_url }}',
        predictive_search_url: '{{ routes.predictive_search_url }}',
      };

      window.cartStrings = {
        error: `{{ 'sections.cart.cart_error' | t }}`,
        quantityError: `{{ 'sections.cart.cart_quantity_error_html' | t: quantity: '[quantity]' }}`,
      };

      window.variantStrings = {
        addToCart: `{{ 'products.product.add_to_cart' | t }}`,
        soldOut: `{{ 'products.product.sold_out' | t }}`,
        unavailable: `{{ 'products.product.unavailable' | t }}`,
        unavailable_with_option: `{{ 'products.product.value_unavailable' | t: option_value: '[value]' }}`,
      };

      window.quickOrderListStrings = {
        itemsAdded: `{{ 'sections.quick_order_list.items_added.other' | t: quantity: '[quantity]' }}`,
        itemAdded: `{{ 'sections.quick_order_list.items_added.one' | t: quantity: '[quantity]' }}`,
        itemsRemoved: `{{ 'sections.quick_order_list.items_removed.other' | t: quantity: '[quantity]' }}`,
        itemRemoved: `{{ 'sections.quick_order_list.items_removed.one' | t: quantity: '[quantity]' }}`,
        viewCart: `{{- 'sections.quick_order_list.view_cart' | t -}}`,
        each: `{{- 'sections.quick_order_list.each' | t: money: '[money]' }}`,
        min_error: `{{- 'sections.quick_order_list.min_error' | t: min: '[min]' }}`,
        max_error: `{{- 'sections.quick_order_list.max_error' | t: max: '[max]' }}`,
        step_error: `{{- 'sections.quick_order_list.step_error' | t: step: '[step]' }}`,
      };

      window.accessibilityStrings = {
        imageAvailable: `{{ 'products.product.media.image_available' | t: index: '[index]' }}`,
        shareSuccess: `{{ 'general.share.success_message' | t }}`,
        pauseSlideshow: `{{ 'sections.slideshow.pause_slideshow' | t }}`,
        playSlideshow: `{{ 'sections.slideshow.play_slideshow' | t }}`,
        recipientFormExpanded: `{{ 'recipient.form.expanded' | t }}`,
        recipientFormCollapsed: `{{ 'recipient.form.collapsed' | t }}`,
        countrySelectorSearchCount: `{{ 'localization.country_results_count' | t: count: '[count]' }}`,
      };
    </script>

    {%- if settings.predictive_search_enabled -%}
      <script src="{{ 'predictive-search.js' | asset_url }}" defer="defer"></script>
    {%- endif -%}

    {%- if settings.cart_type == 'drawer' -%}
      <script src="{{ 'cart-drawer.js' | asset_url }}" defer="defer"></script>
    {%- endif -%}
    <script>
      window.MissingAlertsCustomer = {% if customer %}
        {
          loggedIn: true,
          id: "{{ customer.id }}",
          email: {{ customer.email | json }},
          tags: {{ customer.tags | json }}
        }
      {% else %}
        {
          loggedIn: false
        }
      {% endif %};
      window.MISSING_ALERTS_API_BASE = window.MISSING_ALERTS_API_BASE || 'https://project-155fd.vercel.app';
    </script>
    <script src="{{ 'missing-alerts-notifications.js' | asset_url }}" defer="defer"></script>
    <script src="{{ 'member-professional-help.js' | asset_url }}" defer="defer"></script>
    <script src="{{ 'case-notifications.js' | asset_url }}" defer="defer"></script>
    <script src="{{ 'case-page-final-polish.js' | asset_url }}" defer="defer"></script>
    <script src="{{ 'professional-profile-view.js' | asset_url }}" defer="defer"></script>
    <script src="{{ 'email-capture-modal.js' | asset_url }}" defer="defer"></script>
    <script src="{{ 'tools-countdown.js' | asset_url }}" defer="defer"></script>
    <script src="{{ 'tools-pages-router.js' | asset_url }}" defer="defer"></script>
    {% render 'case-notification-modal' %}
    <script id="ma-layout-live-proof">window.MA_LAYOUT_LIVE_PROOF="20260506_FINAL";</script>
    <!-- MA_LAYOUT_LIVE_PROOF_20260506_FINAL -->
  </body>
</html>
