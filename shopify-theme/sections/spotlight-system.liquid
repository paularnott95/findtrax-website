{% assign primary_case = nil %}
{% assign left_case = nil %}
{% assign right_case = nil %}
{% assign first_supporting_case = nil %}
{% assign second_supporting_case = nil %}
{% assign fallback_primary_case = nil %}
{% assign fallback_left_case = nil %}
{% assign fallback_right_case = nil %}
{% assign now_ts = 'now' | date: '%s' %}
{% assign primary_count = 0 %}
{% assign supporting_count = 0 %}
{% assign primary_json = '' %}
{% assign supporting_json = '' %}
{% assign primary_scope = 'all' %}
{% assign left_scope = 'all' %}
{% assign right_scope = 'all' %}
{% assign primary_is_fallback = false %}
{% assign left_is_fallback = false %}
{% assign right_is_fallback = false %}
{% assign spotlight_placeholder_image = 'missing-person-silhouette.svg' | asset_url %}
{% assign source_blog = blogs['missing-persons'] %}

{% comment %}
  DO NOT replace/remove without preserving fallback render.
  Spotlight data is dynamic; an empty or unavailable case blog must not hide or crash the homepage.
{% endcomment %}
{% if source_blog != blank and source_blog.articles_count > 0 %}
{% for article in source_blog.articles limit: 100 %}
  {% assign live = article.metafields.custom.spotlight_live.value | default: article.metafields.custom.spotlight_live %}
  {% assign level = article.metafields.custom.spotlight_level.value | default: article.metafields.custom.spotlight_level | downcase %}
  {% assign slot = article.metafields.custom.spotlight_slot.value | default: article.metafields.custom.spotlight_slot | downcase %}
  {% assign ends = article.metafields.custom.spotlight_ends.value | default: article.metafields.custom.spotlight_ends %}
  {% assign case_status = article.metafields.custom.case_status.value | default: article.metafields.custom.case_status | downcase %}
  {% assign owner_status = article.metafields.custom.case_owner_status.value | default: article.metafields.custom.case_owner_status | downcase %}
  {% assign article_blog_handle = article.blog.handle | default: '' | downcase %}
  {% assign public_case_handle = article.handle | downcase %}
  {% assign public_case_title = article.title | downcase %}
  {% assign hide_public_case = false %}
  {% if public_case_handle contains 'debug' or public_case_handle contains 'demo' or public_case_handle contains 'test-' or public_case_handle contains '-test' %}
    {% assign hide_public_case = true %}
  {% endif %}
  {% if public_case_handle contains 'pablo' or public_case_handle contains 'esobar' or public_case_handle contains 'escobar' or public_case_handle contains 'miss-123' or public_case_handle contains 'automatic-fallback' %}
    {% assign hide_public_case = true %}
  {% endif %}
  {% if public_case_title contains 'pablo' or public_case_title contains 'esobar' or public_case_title contains 'escobar' or public_case_title contains 'miss, 123' or public_case_title contains 'miss 123' or public_case_title contains 'automatic fallback' %}
    {% assign hide_public_case = true %}
  {% endif %}
  {% if public_case_title contains 'automatic' and public_case_title contains 'fallback' %}
    {% assign hide_public_case = true %}
  {% endif %}
  {% if public_case_title contains 'miss' and public_case_title contains '123' %}
    {% assign hide_public_case = true %}
  {% endif %}
  {% for article_tag in article.tags %}
    {% assign public_tag_downcase = article_tag | downcase | strip %}
    {% if public_tag_downcase == 'test' or public_tag_downcase == 'demo' or public_tag_downcase == 'debug' or public_tag_downcase == 'fake' or public_tag_downcase == 'dummy' or public_tag_downcase == 'fallback' or public_tag_downcase == 'placeholder' or public_tag_downcase contains 'test:' or public_tag_downcase contains 'demo:' or public_tag_downcase contains 'debug:' %}
      {% assign hide_public_case = true %}
    {% endif %}
  {% endfor %}
  {% if hide_public_case %}
    {% continue %}
  {% endif %}
  {% assign is_found_safe_case = false %}
  {% if article_blog_handle == 'found-safe' or case_status == 'found' or case_status == 'resolved' or owner_status == 'resolved' %}
    {% assign is_found_safe_case = true %}
  {% endif %}
  {% if ends != blank %}
    {% assign end_ts = ends | date: '%s' %}
  {% else %}
    {% assign end_ts = 0 %}
  {% endif %}

  {% assign spotlight_live_active = false %}
  {% if live == true or live == 'true' or live == 'True' or live == '1' or live contains 'true' %}
    {% if end_ts == 0 or end_ts > now_ts %}
      {% assign spotlight_live_active = true %}
    {% endif %}
  {% endif %}

  {% if is_found_safe_case == false %}
    {% if fallback_primary_case == nil %}
      {% assign fallback_primary_case = article %}
    {% elsif fallback_left_case == nil %}
      {% assign fallback_left_case = article %}
    {% elsif fallback_right_case == nil and article.id != fallback_left_case.id %}
      {% assign fallback_right_case = article %}
    {% endif %}
  {% endif %}

  {% if spotlight_live_active %}
      {% assign matches_primary = false %}
      {% if slot == 'primary' or level contains 'primary' %}
        {% assign matches_primary = true %}
      {% endif %}

      {% assign matches_supporting = false %}
      {% if slot == 'supporting' or slot == 'supporting_left' or slot == 'supporting_right' or level contains 'supporting' or level contains 'support' %}
        {% assign matches_supporting = true %}
      {% endif %}

      {% if matches_primary %}
        {% assign primary_count = primary_count | plus: 1 %}

        {% if primary_case == nil %}
          {% assign primary_case = article %}
        {% endif %}

        {% capture primary_json %}
          {{ primary_json }}{% if primary_count > 1 %},{% endif %}
          {
            "title": {{ article.title | json }},
            "url": {{ article.url | json }},
            "image": {% if article.image %}{{ article.image | image_url: width: 1600 | json }}{% else %}{{ spotlight_placeholder_image | json }}{% endif %},
            "meta": {{ article.published_at | date: '%d %b %Y' | json }},
            "text": {{ article.excerpt_or_content | strip_html | truncate: 220 | json }},
            "badge": "PRIMARY SPOTLIGHT",
            "kicker": "LIVE SPOTLIGHT",
            "foundSafe": {{ is_found_safe_case | json }},
            "countryScope": {% assign spotlight_scope = 'all' %}{% for article_tag in article.tags %}{% assign tag_downcase = article_tag | downcase | strip %}{% if tag_downcase contains 'country:' %}{% assign spotlight_scope = tag_downcase | split: ':' | last | strip %}{% if spotlight_scope == 'uk' %}{% assign spotlight_scope = 'gb' %}{% endif %}{% break %}{% endif %}{% endfor %}{{ spotlight_scope | json }}
          }
        {% endcapture %}
      {% endif %}

      {% if matches_supporting %}
        {% assign supporting_count = supporting_count | plus: 1 %}

        {% if first_supporting_case == nil %}
          {% assign first_supporting_case = article %}
        {% endif %}

        {% if second_supporting_case == nil and first_supporting_case != article %}
          {% assign second_supporting_case = article %}
        {% endif %}

        {% if slot == 'supporting_left' and left_case == nil %}
          {% assign left_case = article %}
        {% endif %}

        {% if slot == 'supporting_right' and right_case == nil %}
          {% assign right_case = article %}
        {% endif %}

        {% capture supporting_json %}
          {{ supporting_json }}{% if supporting_count > 1 %},{% endif %}
          {
            "title": {{ article.title | json }},
            "url": {{ article.url | json }},
            "image": {% if article.image %}{{ article.image | image_url: width: 1000 | json }}{% else %}{{ spotlight_placeholder_image | json }}{% endif %},
            "meta": {{ article.published_at | date: '%d %b %Y' | json }},
            "text": {{ article.excerpt_or_content | strip_html | truncate: 145 | json }},
            "slot": {{ slot | json }},
            "badge": "SUPPORTING SPOTLIGHT",
            "kicker": "LIVE SPOTLIGHT",
            "foundSafe": {{ is_found_safe_case | json }},
            "countryScope": {% assign spotlight_scope = 'all' %}{% for article_tag in article.tags %}{% assign tag_downcase = article_tag | downcase | strip %}{% if tag_downcase contains 'country:' %}{% assign spotlight_scope = tag_downcase | split: ':' | last | strip %}{% if spotlight_scope == 'uk' %}{% assign spotlight_scope = 'gb' %}{% endif %}{% break %}{% endif %}{% endfor %}{{ spotlight_scope | json }}
          }
        {% endcapture %}
      {% endif %}

  {% endif %}
{% endfor %}
{% endif %}

{% if left_case == nil and first_supporting_case != nil %}
  {% assign left_case = first_supporting_case %}
{% endif %}

{% if right_case == nil and second_supporting_case != nil %}
  {% assign right_case = second_supporting_case %}
{% endif %}

{% if primary_case == nil and fallback_primary_case != nil %}
  {% assign primary_case = fallback_primary_case %}
  {% assign primary_is_fallback = true %}
{% endif %}

{% if left_case == nil %}
  {% if fallback_left_case != nil and primary_case and fallback_left_case.id != primary_case.id %}
    {% assign left_case = fallback_left_case %}
    {% assign left_is_fallback = true %}
  {% elsif fallback_primary_case != nil and primary_case and fallback_primary_case.id != primary_case.id %}
    {% assign left_case = fallback_primary_case %}
    {% assign left_is_fallback = true %}
  {% endif %}
{% endif %}

{% if right_case == nil %}
  {% if fallback_right_case != nil and primary_case and fallback_right_case.id != primary_case.id and left_case and fallback_right_case.id != left_case.id %}
    {% assign right_case = fallback_right_case %}
    {% assign right_is_fallback = true %}
  {% elsif fallback_left_case != nil and primary_case and fallback_left_case.id != primary_case.id and left_case and fallback_left_case.id != left_case.id %}
    {% assign right_case = fallback_left_case %}
    {% assign right_is_fallback = true %}
  {% elsif fallback_primary_case != nil and primary_case and fallback_primary_case.id != primary_case.id and left_case and fallback_primary_case.id != left_case.id %}
    {% assign right_case = fallback_primary_case %}
    {% assign right_is_fallback = true %}
  {% endif %}
{% endif %}

{% if left_case %}
  {% for left_tag in left_case.tags %}
    {% assign left_tag_downcase = left_tag | downcase | strip %}
    {% if left_tag_downcase contains 'country:' %}
      {% assign left_scope = left_tag_downcase | split: ':' | last | strip %}
      {% if left_scope == 'uk' %}
        {% assign left_scope = 'gb' %}
      {% endif %}
      {% break %}
    {% endif %}
  {% endfor %}
{% endif %}

{% if primary_case %}
  {% for primary_tag in primary_case.tags %}
    {% assign primary_tag_downcase = primary_tag | downcase | strip %}
    {% if primary_tag_downcase contains 'country:' %}
      {% assign primary_scope = primary_tag_downcase | split: ':' | last | strip %}
      {% if primary_scope == 'uk' %}
        {% assign primary_scope = 'gb' %}
      {% endif %}
      {% break %}
    {% endif %}
  {% endfor %}
{% endif %}

{% if right_case %}
  {% for right_tag in right_case.tags %}
    {% assign right_tag_downcase = right_tag | downcase | strip %}
    {% if right_tag_downcase contains 'country:' %}
      {% assign right_scope = right_tag_downcase | split: ':' | last | strip %}
      {% if right_scope == 'uk' %}
        {% assign right_scope = 'gb' %}
      {% endif %}
      {% break %}
    {% endif %}
  {% endfor %}
{% endif %}

{% assign left_found_safe = false %}
{% if left_case %}
  {% assign left_case_status = left_case.metafields.custom.case_status.value | default: left_case.metafields.custom.case_status | downcase %}
  {% assign left_owner_status = left_case.metafields.custom.case_owner_status.value | default: left_case.metafields.custom.case_owner_status | downcase %}
  {% assign left_blog_handle = left_case.blog.handle | default: '' | downcase %}
  {% if left_blog_handle == 'found-safe' or left_case_status == 'found' or left_case_status == 'resolved' or left_owner_status == 'resolved' %}
    {% assign left_found_safe = true %}
  {% endif %}
{% endif %}

{% assign primary_found_safe = false %}
{% if primary_case %}
  {% assign primary_case_status = primary_case.metafields.custom.case_status.value | default: primary_case.metafields.custom.case_status | downcase %}
  {% assign primary_owner_status = primary_case.metafields.custom.case_owner_status.value | default: primary_case.metafields.custom.case_owner_status | downcase %}
  {% assign primary_blog_handle = primary_case.blog.handle | default: '' | downcase %}
  {% if primary_blog_handle == 'found-safe' or primary_case_status == 'found' or primary_case_status == 'resolved' or primary_owner_status == 'resolved' %}
    {% assign primary_found_safe = true %}
  {% endif %}
{% endif %}

{% assign right_found_safe = false %}
{% if right_case %}
  {% assign right_case_status = right_case.metafields.custom.case_status.value | default: right_case.metafields.custom.case_status | downcase %}
  {% assign right_owner_status = right_case.metafields.custom.case_owner_status.value | default: right_case.metafields.custom.case_owner_status | downcase %}
  {% assign right_blog_handle = right_case.blog.handle | default: '' | downcase %}
  {% if right_blog_handle == 'found-safe' or right_case_status == 'found' or right_case_status == 'resolved' or right_owner_status == 'resolved' %}
    {% assign right_found_safe = true %}
  {% endif %}
{% endif %}

<script>
window.primarySpotlightCases = [{{ primary_json | strip }}];
window.supportingSpotlightCases = [{{ supporting_json | strip }}];
window.primarySpotlightCount = {{ primary_count }};
window.supportingSpotlightCount = {{ supporting_count }};
</script>

<section class="spotlight-system" data-country-section data-country-scope="all">
  <div class="spotlight-shell">
    <div class="spotlight-shell-border-light"></div>
    <div class="spotlight-shell-glow"></div>
    <div class="spotlight-shell-noise"></div>
    <div class="spotlight-shell-vignette"></div>
    <div class="spotlight-shell-sweep"></div>
    <div class="spotlight-shell-inner-reflection"></div>

    <div class="spotlight-shell-corner spotlight-shell-corner-tl"></div>
    <div class="spotlight-shell-corner spotlight-shell-corner-tr"></div>
    <div class="spotlight-shell-corner spotlight-shell-corner-bl"></div>
    <div class="spotlight-shell-corner spotlight-shell-corner-br"></div>

    <div class="spotlight-shell-wall spotlight-shell-wall-left"></div>
    <div class="spotlight-shell-wall spotlight-shell-wall-right"></div>

    <div class="spotlight-strobes spotlight-strobes-left" aria-hidden="true">
      <span></span><span></span><span></span>
    </div>
    <div class="spotlight-strobes spotlight-strobes-right" aria-hidden="true">
      <span></span><span></span><span></span>
    </div>

    <div class="spotlight-alert-corner">
      <span class="spotlight-alert-dot"></span>
      {% if primary_count > 0 or supporting_count > 0 %}LIVE SPOTLIGHT{% else %}FEATURED CASES{% endif %}
    </div>

    <div class="spotlight-top-strip">
    <div class="spotlight-top-pill">SPOTLIGHT</div>
    <div class="spotlight-top-center">FEATURED MISSING PERSON CASES</div>
    <div class="spotlight-top-status">
      {% if primary_count > 0 or supporting_count > 0 %}
        PRIMARY {{ primary_count }} • SUPPORTING {{ supporting_count }}
      {% else %}
        FEATURED CASES
      {% endif %}
    </div>
  </div>

    <div class="spotlight-stage-floor"></div>
    <div class="spotlight-stage-floor-glow"></div>

    <div class="spotlight-stage">
      {% if primary_case == nil and left_case == nil and right_case == nil %}
        <div class="spotlight-card spotlight-card-main" style="min-height:220px;display:flex;align-items:center;justify-content:center;padding:20px;text-align:center;color:rgba(255,255,255,0.82);font-weight:700;">
          No verified live cases are currently available in this section.
        </div>
      {% else %}
      <article class="spotlight-card spotlight-card-side spotlight-card-left" id="spotlight-left" data-spotlight-card="left" data-country-scope="{{ left_scope }}">
        <div class="spotlight-card-ring"></div>
        <div class="spotlight-card-frame"></div>
        <div class="spotlight-card-depth-frame"></div>
        <div class="spotlight-card-corner hotspot-tl"></div>
        <div class="spotlight-card-corner hotspot-tr"></div>
        <div class="spotlight-card-corner hotspot-bl"></div>
        <div class="spotlight-card-corner hotspot-br"></div>
        <div class="spotlight-card-sheen"></div>
        <div class="spotlight-card-image-stage"></div>

        <div class="spotlight-card-image-wrap">
          {% if left_case and left_case.image %}
            <img src="{{ left_case.image | image_url: width: 1000 }}" alt="{{ left_case.title | escape }}" class="spotlight-card-image{% if left_found_safe %} spotlight-card-image--found-safe{% endif %}" data-spotlight-image width="{{ left_case.image.width }}" height="{{ left_case.image.height }}">
          {% else %}
            <img src="{{ spotlight_placeholder_image }}" alt="Missing person appeal image" class="spotlight-card-image" data-spotlight-image width="1200" height="1200">
          {% endif %}
          <div class="spotlight-card-image-overlay{% if left_found_safe %} spotlight-card-image-overlay--found-safe{% endif %}"></div>
          <div class="spotlight-card-image-rim"></div>
          <div class="spotlight-card-badge" data-spotlight-badge>{% if left_found_safe %}FOUND SAFE{% elsif left_is_fallback %}FEATURED CASE{% else %}SUPPORTING SPOTLIGHT{% endif %}</div>
        </div>

        <div class="spotlight-card-body">
          <div class="spotlight-card-mini-kicker">{% if left_is_fallback %}FEATURED CASE{% else %}SUPPORTING FEATURE{% endif %}</div>
          <h3 class="spotlight-card-name" data-spotlight-title>
            {% if left_case %}{{ left_case.title }}{% else %}FEATURED CASE{% endif %}
          </h3>
          <div class="spotlight-card-meta" data-spotlight-meta>
            {% if left_case %}{{ left_case.published_at | date: '%d %b %Y' }}{% else %}LIVE CASE{% endif %}
          </div>
          <p class="spotlight-card-text" data-spotlight-text>
            {% if left_case %}{{ left_case.excerpt_or_content | strip_html | truncate: 145 }}{% else %}Premium supporting placement designed to keep urgent missing person cases visible across the homepage.{% endif %}
          </p>
          <div class="spotlight-card-actions spotlight-card-actions-side">
            <a href="{% if left_case %}{{ left_case.url }}{% else %}#{% endif %}" class="spotlight-btn spotlight-btn-dark" data-spotlight-link>VIEW CASE</a>
          </div>
        </div>
      </article>

      <article class="spotlight-card spotlight-card-main" id="spotlight-primary" data-spotlight-card="main" data-country-scope="{{ primary_scope }}">
        <div class="spotlight-card-ring spotlight-card-ring-main"></div>
        <div class="spotlight-card-frame"></div>
        <div class="spotlight-card-depth-frame spotlight-card-depth-frame-main"></div>
        <div class="spotlight-card-corner hotspot-tl"></div>
        <div class="spotlight-card-corner hotspot-tr"></div>
        <div class="spotlight-card-corner hotspot-bl"></div>
        <div class="spotlight-card-corner hotspot-br"></div>
        <div class="spotlight-card-sheen spotlight-card-sheen-main"></div>

        <div class="spotlight-main-halo"></div>
        <div class="spotlight-main-rear-glow"></div>
        <div class="spotlight-main-sheen"></div>
        <div class="spotlight-main-cutout-shadow"></div>
        <div class="spotlight-main-cutout-edge"></div>
        <div class="spotlight-main-hover-floor"></div>

        <div class="spotlight-card-image-stage spotlight-card-image-stage-main"></div>
        <div class="spotlight-card-image-wrap spotlight-card-image-wrap-main">
          {% if primary_case and primary_case.image %}
            <img src="{{ primary_case.image | image_url: width: 1600 }}" alt="{{ primary_case.title | escape }}" class="spotlight-card-image spotlight-card-image-main{% if primary_found_safe %} spotlight-card-image--found-safe{% endif %}" data-spotlight-image width="{{ primary_case.image.width }}" height="{{ primary_case.image.height }}">
          {% else %}
            <img src="{{ spotlight_placeholder_image }}" alt="Missing person appeal image" class="spotlight-card-image spotlight-card-image-main" data-spotlight-image width="1200" height="1200">
          {% endif %}
          <div class="spotlight-card-image-overlay spotlight-card-image-overlay-main{% if primary_found_safe %} spotlight-card-image-overlay--found-safe{% endif %}"></div>
          <div class="spotlight-card-image-rim spotlight-card-image-rim-main"></div>
          <div class="spotlight-card-badge spotlight-card-badge-main" data-spotlight-badge>{% if primary_found_safe %}FOUND SAFE{% elsif primary_is_fallback %}FEATURED CASE{% else %}PRIMARY SPOTLIGHT{% endif %}</div>
          <div class="spotlight-main-image-glow"></div>
        </div>

        <div class="spotlight-card-body spotlight-card-body-main">
          <div class="spotlight-main-status-row">
            <div class="spotlight-main-status">{% if primary_is_fallback %}FEATURED CASE{% else %}PREMIUM HOMEPAGE PLACEMENT{% endif %}</div>
            <div class="spotlight-main-status">{% if primary_is_fallback %}FEATURED SELECTION{% else %}HIGH VISIBILITY{% endif %}</div>
          </div>

          <h3 class="spotlight-card-name spotlight-card-name-main" data-spotlight-title>
            {% if primary_case %}{{ primary_case.title }}{% else %}PRIMARY FEATURED CASE{% endif %}
          </h3>

          <div class="spotlight-card-meta spotlight-card-meta-main" data-spotlight-meta>
            {% if primary_case %}{{ primary_case.published_at | date: '%d %b %Y' }}{% else %}LIVE CASE{% endif %}
          </div>

          <p class="spotlight-card-text spotlight-card-text-main" data-spotlight-text>
            {% if primary_case %}{{ primary_case.excerpt_or_content | strip_html | truncate: 220 }}{% else %}The primary spotlight placement is designed to lead attention cleanly and keep one urgent case at the centre of the homepage.{% endif %}
          </p>

          <div class="spotlight-main-data-row">
            <div class="spotlight-main-data-pill">{% if primary_is_fallback %}FEATURED CASE{% else %}PRIORITY ACTIVE{% endif %}</div>
            <div class="spotlight-main-data-pill">{% if primary_is_fallback %}IMAGE READY{% else %}FIXED FEATURE POSITION{% endif %}</div>
            <div class="spotlight-main-data-pill">{% if primary_is_fallback %}AUTO SELECTED{% else %}ROTATION READY{% endif %}</div>
          </div>

          <div class="spotlight-card-actions">
            <a href="{% if primary_case %}{{ primary_case.url }}{% else %}#{% endif %}" class="spotlight-btn spotlight-btn-primary" data-spotlight-link>VIEW FULL CASE</a>
            <a href="{% if primary_case %}{{ primary_case.url }}{% else %}#{% endif %}" class="spotlight-btn spotlight-btn-dark" data-spotlight-link>SHARE THIS CASE</a>
            <a href="{% if primary_case %}{{ primary_case.url }}{% else %}#{% endif %}" class="spotlight-btn spotlight-btn-ghost" data-spotlight-link>SUPPORT / BOOST</a>
          </div>
        </div>
      </article>

      <article class="spotlight-card spotlight-card-side spotlight-card-right" id="spotlight-right" data-spotlight-card="right" data-country-scope="{{ right_scope }}">
        <div class="spotlight-card-ring"></div>
        <div class="spotlight-card-frame"></div>
        <div class="spotlight-card-depth-frame"></div>
        <div class="spotlight-card-corner hotspot-tl"></div>
        <div class="spotlight-card-corner hotspot-tr"></div>
        <div class="spotlight-card-corner hotspot-bl"></div>
        <div class="spotlight-card-corner hotspot-br"></div>
        <div class="spotlight-card-sheen"></div>
        <div class="spotlight-card-image-stage"></div>

        <div class="spotlight-card-image-wrap">
          {% if right_case and right_case.image %}
            <img src="{{ right_case.image | image_url: width: 1000 }}" alt="{{ right_case.title | escape }}" class="spotlight-card-image{% if right_found_safe %} spotlight-card-image--found-safe{% endif %}" data-spotlight-image width="{{ right_case.image.width }}" height="{{ right_case.image.height }}">
          {% else %}
            <img src="{{ spotlight_placeholder_image }}" alt="Missing person appeal image" class="spotlight-card-image" data-spotlight-image width="1200" height="1200">
          {% endif %}
          <div class="spotlight-card-image-overlay{% if right_found_safe %} spotlight-card-image-overlay--found-safe{% endif %}"></div>
          <div class="spotlight-card-image-rim"></div>
          <div class="spotlight-card-badge" data-spotlight-badge>{% if right_found_safe %}FOUND SAFE{% elsif right_is_fallback %}FEATURED CASE{% else %}SUPPORTING SPOTLIGHT{% endif %}</div>
        </div>

        <div class="spotlight-card-body">
          <div class="spotlight-card-mini-kicker">{% if right_is_fallback %}FEATURED CASE{% else %}SUPPORTING FEATURE{% endif %}</div>
          <h3 class="spotlight-card-name" data-spotlight-title>
            {% if right_case %}{{ right_case.title }}{% else %}FEATURED CASE{% endif %}
          </h3>
          <div class="spotlight-card-meta" data-spotlight-meta>
            {% if right_case %}{{ right_case.published_at | date: '%d %b %Y' }}{% else %}LIVE CASE{% endif %}
          </div>
          <p class="spotlight-card-text" data-spotlight-text>
            {% if right_case %}{{ right_case.excerpt_or_content | strip_html | truncate: 145 }}{% else %}Premium supporting placement designed to reinforce the main spotlight without competing with it.{% endif %}
          </p>
          <div class="spotlight-card-actions spotlight-card-actions-side">
	            <a href="{% if right_case %}{{ right_case.url }}{% else %}#{% endif %}" class="spotlight-btn spotlight-btn-dark" data-spotlight-link>VIEW CASE</a>
	          </div>
	        </div>
	      </article>
      {% endif %}
	    </div>
    <div class="spotlight-country-grid" data-country-surface="spotlight" hidden></div>
  </div>
</section>

<script>
(function() {
  var spotlightStarted = false;

  function setText(el, value) {
    if (el) el.textContent = value || '';
  }

  function setImage(el, src, alt) {
    if (!el) return;
    if (src) el.src = src;
    el.alt = alt || '';
  }

  function setFoundSafeState(card, item, type) {
    if (!card) return;
    var image = card.querySelector('[data-spotlight-image]');
    var overlay = card.querySelector('.spotlight-card-image-overlay');
    var badge = card.querySelector('[data-spotlight-badge]');
    var kicker = card.querySelector('.spotlight-card-mini-kicker');
    var isFoundSafe = !!(item && item.foundSafe);

    if (image) {
      image.classList.toggle('spotlight-card-image--found-safe', isFoundSafe);
    }

    if (overlay) {
      overlay.classList.toggle('spotlight-card-image-overlay--found-safe', isFoundSafe);
    }

    if (badge) {
      badge.textContent = isFoundSafe ? 'FOUND SAFE' : (item && item.badge ? item.badge : (type === 'main' ? 'PRIMARY SPOTLIGHT' : 'SUPPORTING SPOTLIGHT'));
    }

    if (kicker && item && item.kicker) {
      kicker.textContent = item.kicker;
    }
  }

  function setLinks(container, url) {
    if (!container) return;
    var links = container.querySelectorAll('[data-spotlight-link]');
    links.forEach(function(link) {
      link.href = url || '#';
    });
  }

  function transitionCard(card, updateFn) {
    if (!card || !updateFn) return;
    card.classList.add('is-transitioning');
    window.setTimeout(function() {
      updateFn();
      card.classList.remove('is-transitioning');
    }, 380);
  }

  function renderCard(card, item, type) {
    if (!card || !item) return;

    transitionCard(card, function() {
      card.setAttribute('data-country-scope', item.countryScope || 'all');
      setImage(card.querySelector('[data-spotlight-image]'), item.image, item.title);
      setText(card.querySelector('[data-spotlight-title]'), item.title);
      setText(card.querySelector('[data-spotlight-meta]'), item.meta);
      setText(card.querySelector('[data-spotlight-text]'), item.text);
      setLinks(card, item.url);
      setFoundSafeState(card, item, type);
      if (window.MissingAlertsCountryMode && typeof window.MissingAlertsCountryMode.refresh === 'function') {
        window.MissingAlertsCountryMode.refresh();
      }
    });
  }

  function initSpotlightRotation() {
    if (spotlightStarted) return;

    var primaryCases = Array.isArray(window.primarySpotlightCases) ? window.primarySpotlightCases : [];
    var supportingCases = Array.isArray(window.supportingSpotlightCases) ? window.supportingSpotlightCases : [];

    var leftCard = document.getElementById('spotlight-left');
    var rightCard = document.getElementById('spotlight-right');
    var mainCard = document.getElementById('spotlight-primary');

    if (!leftCard || !rightCard || !mainCard) return;

    spotlightStarted = true;

    if (supportingCases.length > 2) {
      var supportIndex = 0;
      window.setInterval(function() {
        supportIndex = (supportIndex + 1) % supportingCases.length;
        var leftItem = supportingCases[supportIndex];
        var rightItem = supportingCases[(supportIndex + 1) % supportingCases.length];
        renderCard(leftCard, leftItem, 'side');
        renderCard(rightCard, rightItem, 'side');
      }, 6400);
    }

    if (primaryCases.length > 1) {
      var primaryIndex = 0;
      window.setInterval(function() {
        primaryIndex = (primaryIndex + 1) % primaryCases.length;
        renderCard(mainCard, primaryCases[primaryIndex], 'main');
      }, 7200);
    }
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initSpotlightRotation);
  } else {
    initSpotlightRotation();
  }

  document.addEventListener('shopify:section:load', initSpotlightRotation);
})();
</script>

