{% liquid
  assign source_blog = blogs['missing-persons']
  assign now_ts = 'now' | date: '%s' | plus: 0
  assign placeholder_image = 'missing-person-silhouette.svg' | asset_url
  assign spotlight_product = all_products['primary-spotlight-24-hours']
  assign spotlight_cta_url = '/products/primary-spotlight-24-hours'
  if spotlight_product != blank
    assign spotlight_cta_url = spotlight_product.url
  endif
%}

<section class="ma-premium-spotlight" data-ma-premium-spotlight data-country-section data-country-scope="all">
  <div class="ma-premium-spotlight__shell">
    <div class="ma-premium-spotlight__glow" aria-hidden="true"></div>
    <header class="ma-premium-spotlight__header">
      <div>
        <p class="ma-premium-spotlight__eyebrow">Premium visibility placement</p>
        <h2>SPOTLIGHT CASES</h2>
        <p class="ma-premium-spotlight__copy">Spotlight placements give selected appeals maximum visibility across Missing Alerts.</p>
      </div>
      <a class="ma-premium-spotlight__cta" href="{{ spotlight_cta_url }}">Get Spotlight Placement</a>
    </header>

    <div class="ma-premium-spotlight__notice" data-ma-spotlight-mode>Loading selected-country spotlight cases.</div>

    <div class="ma-premium-spotlight__grid" data-ma-spotlight-grid>
      {% if source_blog != blank %}
        {% for article in source_blog.articles limit: 120 %}
          {% liquid
            assign tag_blob = article.tags | join: '|' | downcase
            assign case_status = article.metafields.custom.case_status.value | default: article.metafields.custom.case_status | downcase
            assign owner_status = article.metafields.custom.case_owner_status.value | default: article.metafields.custom.case_owner_status | downcase
            assign blog_handle = article.blog.handle | default: '' | downcase
            assign public_handle = article.handle | downcase
            assign public_title = article.title | downcase
            assign excluded = false
            if blog_handle == 'found-safe' or case_status contains 'found' or case_status contains 'safe' or case_status contains 'resolved' or case_status contains 'located' or case_status contains 'closed' or case_status contains 'private' or case_status contains 'review' or case_status contains 'draft' or owner_status contains 'resolved'
              assign excluded = true
            endif
            if tag_blob contains 'found-safe' or tag_blob contains 'found safe' or tag_blob contains 'located' or tag_blob contains 'closed' or tag_blob contains 'private' or tag_blob contains 'review' or tag_blob contains 'draft' or tag_blob contains 'debug' or tag_blob contains 'demo' or tag_blob contains 'placeholder'
              assign excluded = true
            endif
            if public_handle contains 'debug' or public_handle contains 'demo' or public_handle contains 'test-' or public_handle contains '-test' or public_handle contains 'pablo' or public_handle contains 'esobar' or public_handle contains 'escobar' or public_handle contains 'miss-123' or public_handle contains 'automatic-fallback'
              assign excluded = true
            endif
            if public_title contains 'pablo' or public_title contains 'esobar' or public_title contains 'escobar' or public_title contains 'miss, 123' or public_title contains 'miss 123' or public_title contains 'automatic fallback'
              assign excluded = true
            endif

            assign country_code = article.metafields.custom.country_code.value | default: article.metafields.custom.country_code | downcase | strip
            assign country_slug = article.metafields.custom.country_slug.value | default: article.metafields.custom.country_slug | downcase | strip
            assign country_name = article.metafields.custom.country_name.value | default: article.metafields.custom.country_name | default: article.metafields.custom.country.value | default: article.metafields.custom.country | strip
            if country_code == blank or country_code == 'all' or country_code == 'unknown'
              for article_tag in article.tags
                assign tag_downcase = article_tag | downcase | strip
                if tag_downcase contains 'country:'
                  assign country_code = tag_downcase | split: ':' | last | strip
                  break
                endif
              endfor
            endif
            if country_code == 'uk' or country_code == 'england' or country_code == 'scotland' or country_code == 'wales' or country_code == 'northern ireland'
              assign country_code = 'gb'
            elsif country_code == 'usa' or country_code == 'united-states' or country_code == 'united states'
              assign country_code = 'us'
            endif
            if country_slug == blank
              case country_code
                when 'gb'
                  assign country_slug = 'united-kingdom'
                  assign country_name = country_name | default: 'United Kingdom'
                when 'us'
                  assign country_slug = 'united-states'
                  assign country_name = country_name | default: 'United States'
                when 'ca'
                  assign country_slug = 'canada'
                  assign country_name = country_name | default: 'Canada'
                when 'au'
                  assign country_slug = 'australia'
                  assign country_name = country_name | default: 'Australia'
                when 'nz'
                  assign country_slug = 'new-zealand'
                  assign country_name = country_name | default: 'New Zealand'
                when 'ie'
                  assign country_slug = 'ireland'
                  assign country_name = country_name | default: 'Ireland'
                when 'sg'
                  assign country_slug = 'singapore'
                  assign country_name = country_name | default: 'Singapore'
              endcase
            endif
            if country_name == blank
              assign country_name = country_code | upcase
            endif

            assign spotlight_live = article.metafields.custom.spotlight_live.value | default: article.metafields.custom.spotlight_live | default: article.metafields.custom.spotlight_active.value | default: article.metafields.custom.spotlight_active
            assign spotlight_level = article.metafields.custom.spotlight_level.value | default: article.metafields.custom.spotlight_level | default: ''
            assign spotlight_slot = article.metafields.custom.spotlight_slot.value | default: article.metafields.custom.spotlight_slot | default: ''
            assign spotlight_started = article.metafields.custom.spotlight_started.value | default: article.metafields.custom.spotlight_started
            assign spotlight_order_id = article.metafields.custom.spotlight_order_id.value | default: article.metafields.custom.spotlight_order_id | default: ''
            assign spotlight_ends = article.metafields.custom.spotlight_ends.value | default: article.metafields.custom.spotlight_ends
            assign spotlight_end_ts = 0
            assign spotlight_started_ts = 0
            if spotlight_ends != blank
              assign spotlight_end_ts = spotlight_ends | date: '%s' | plus: 0
            endif
            if spotlight_started != blank
              assign spotlight_started_ts = spotlight_started | date: '%s' | plus: 0
            endif
            assign paid_spotlight = false
            if spotlight_live == true or spotlight_live == 'true' or spotlight_live == 'True' or spotlight_live == '1'
              if spotlight_end_ts == 0 or spotlight_end_ts > now_ts
                assign paid_spotlight = true
              endif
            endif
            assign source_verified = false
            if tag_blob contains 'source-verified' or tag_blob contains 'scanner-imported' or tag_blob contains 'official-source'
              assign source_verified = true
            endif
            assign urgent_case = false
            if tag_blob contains 'urgent' or case_status contains 'urgent'
              assign urgent_case = true
            endif
            assign has_image = false
            if article.image
              assign has_image = true
            endif
          %}
          {% if excluded == false and country_code != blank %}
            <article
              class="ma-premium-spotlight-card"
              data-ma-spotlight-card
              data-country-code="{{ country_code | escape }}"
              data-country-slug="{{ country_slug | escape }}"
              data-country-name="{{ country_name | escape }}"
              data-status="active"
              data-case-handle="{{ article.handle | escape }}"
              data-source-verified="{{ source_verified }}"
              data-has-image="{{ has_image }}"
              data-paid-spotlight="{{ paid_spotlight }}"
              data-spotlight-level="{{ spotlight_level | escape }}"
              data-spotlight-slot="{{ spotlight_slot | escape }}"
              data-spotlight-started="{{ spotlight_started_ts }}"
              data-spotlight-order-id="{{ spotlight_order_id | escape }}"
              data-fallback-priority="{% if urgent_case %}1{% elsif source_verified %}2{% elsif has_image %}3{% else %}4{% endif %}"
              hidden
            >
              <a class="ma-premium-spotlight-card__link" href="{{ article.url }}">
                <div class="ma-premium-spotlight-card__media">
                  {% if article.image %}
                    <img src="{{ article.image | image_url: width: 900, height: 620, crop: 'center' }}" alt="{{ article.title | escape }}" loading="lazy" width="900" height="620">
                  {% else %}
                    <img src="{{ placeholder_image }}" alt="Missing person appeal image" loading="lazy" width="900" height="620">
                  {% endif %}
                  <span class="ma-premium-spotlight-card__badge" data-ma-placement-label>{% if paid_spotlight %}Paid spotlight{% elsif urgent_case %}Urgent appeal{% elsif source_verified %}Source verified{% else %}Fallback spotlight{% endif %}</span>
                </div>
                <div class="ma-premium-spotlight-card__body">
                  <p class="ma-premium-spotlight-card__meta">{{ country_name | escape }}{% if source_verified %} / Source verified{% endif %}</p>
                  <h3>{{ article.title | escape }}</h3>
                  <p class="ma-premium-spotlight-card__summary">{{ article.excerpt_or_content | strip_html | truncate: 150 }}</p>
                  <span class="ma-premium-spotlight-card__action">View case</span>
                </div>
              </a>
            </article>
          {% endif %}
        {% endfor %}
      {% endif %}
    </div>

    <div class="ma-premium-spotlight__empty" data-ma-spotlight-empty hidden>
      <strong>No active spotlight cases are currently available for this country.</strong>
      <a href="/pages/country-intelligence">View country intelligence</a>
    </div>
  </div>
</section>

<script>
(function() {
  var section = document.querySelector('[data-ma-premium-spotlight]');
  if (!section) return;
  var grid = section.querySelector('[data-ma-spotlight-grid]');
  var notice = section.querySelector('[data-ma-spotlight-mode]');
  var empty = section.querySelector('[data-ma-spotlight-empty]');
  var countries = {
    gb: { code: 'gb', name: 'United Kingdom', aliases: ['gb', 'uk', 'united-kingdom', 'united kingdom', 'england', 'scotland', 'wales', 'northern ireland'] },
    us: { code: 'us', name: 'United States', aliases: ['us', 'usa', 'united-states', 'united states', 'united states of america'] },
    ca: { code: 'ca', name: 'Canada', aliases: ['ca', 'canada'] },
    au: { code: 'au', name: 'Australia', aliases: ['au', 'australia'] },
    nz: { code: 'nz', name: 'New Zealand', aliases: ['nz', 'new-zealand', 'new zealand'] },
    ie: { code: 'ie', name: 'Ireland', aliases: ['ie', 'ireland'] },
    sg: { code: 'sg', name: 'Singapore', aliases: ['sg', 'singapore'] }
  };

  function normalize(value) {
    return String(value || '').toLowerCase().trim().replace(/_/g, '-');
  }

  function canonical(value) {
    var normalized = normalize(value);
    if (!normalized) return 'gb';
    var parsed = null;
    if (normalized.charAt(0) === '{') {
      try { parsed = JSON.parse(value); } catch (error) {}
      if (parsed) normalized = normalize(parsed.code || parsed.slug || parsed.name || '');
    }
    var compact = normalized.replace(/\s+/g, '-');
    for (var key in countries) {
      if (countries[key].aliases.indexOf(normalized) !== -1 || countries[key].aliases.indexOf(compact) !== -1) return key;
    }
    return countries[compact] ? compact : 'gb';
  }

  function cookie(name) {
    return (document.cookie || '').split(';').reduce(function(found, part) {
      var trimmed = part.trim();
      return found || (trimmed.indexOf(name + '=') === 0 ? decodeURIComponent(trimmed.slice(name.length + 1)) : '');
    }, '');
  }

  function selectedCountry() {
    var params = new URLSearchParams(window.location.search || '');
    var query = params.get('country');
    var stored = '';
    try { stored = window.localStorage.getItem('missingAlertsCountry') || ''; } catch (error) {}
    var code = canonical(query || stored || cookie('missing_alerts_country') || document.documentElement.getAttribute('data-country-code') || 'gb');
    return countries[code] || countries.gb;
  }

  function seedFor(countryCode) {
    var today = new Date().toISOString().slice(0, 10);
    var seed = 0;
    (today + ':' + countryCode + ':' + window.location.pathname).split('').forEach(function(ch) {
      seed = ((seed << 5) - seed + ch.charCodeAt(0)) | 0;
    });
    return Math.abs(seed) || 1;
  }

  function seededShuffle(items, seed) {
    var copy = items.slice();
    function next() {
      seed = (seed * 1664525 + 1013904223) % 4294967296;
      return seed / 4294967296;
    }
    for (var i = copy.length - 1; i > 0; i -= 1) {
      var j = Math.floor(next() * (i + 1));
      var tmp = copy[i];
      copy[i] = copy[j];
      copy[j] = tmp;
    }
    return copy;
  }

  function paidRank(card) {
    var level = normalize(card.getAttribute('data-spotlight-level'));
    var slot = normalize(card.getAttribute('data-spotlight-slot'));
    var rank = 50;
    if (slot === 'primary' || level.indexOf('primary') !== -1) rank = 1;
    else if (slot.indexOf('supporting') !== -1 || level.indexOf('support') !== -1) rank = 2;
    var started = parseInt(card.getAttribute('data-spotlight-started') || '0', 10);
    return rank * 10000000000 - started;
  }

  function fallbackRank(card) {
    var priority = parseInt(card.getAttribute('data-fallback-priority') || '9', 10);
    return priority;
  }

  function applySpotlight() {
    var country = selectedCountry();
    var cards = Array.prototype.slice.call(grid.querySelectorAll('[data-ma-spotlight-card]')).filter(function(card) {
      return canonical(card.getAttribute('data-country-code') || card.getAttribute('data-country-slug') || card.getAttribute('data-country-name')) === country.code;
    });
    var paid = cards.filter(function(card) {
      return card.getAttribute('data-paid-spotlight') === 'true';
    }).sort(function(a, b) {
      return paidRank(a) - paidRank(b);
    });
    var selected = paid.slice(0, 3);
    if (!selected.length) {
      selected = seededShuffle(cards.slice().sort(function(a, b) {
        return fallbackRank(a) - fallbackRank(b);
      }), seedFor(country.code)).slice(0, 3);
    }
    var selectedHandles = selected.map(function(card) {
      return card.getAttribute('data-case-handle') || '';
    }).filter(Boolean);
    window.MA_SPOTLIGHT_SELECTED_HANDLES = selectedHandles;

    cards.forEach(function(card) {
      var show = selected.indexOf(card) !== -1;
      card.hidden = !show;
      card.classList.toggle('is-visible', show);
      card.classList.remove('is-primary');
      if (show) card.style.removeProperty('display');
      else card.style.display = 'none';
    });
    selected.forEach(function(card, index) {
      grid.appendChild(card);
      card.classList.toggle('is-primary', index === 0);
      card.querySelector('[data-ma-placement-label]').textContent = paid.length ? 'Paid spotlight' : 'Fallback spotlight';
    });
    if (notice) {
      notice.textContent = paid.length ?
        'Paid spotlight placements live for ' + country.name + '.' :
        (selected.length ? 'Fallback spotlight - no paid spotlight is live in ' + country.name + '.' : 'No selected-country spotlight cases are available.');
    }
    if (empty) empty.hidden = selected.length > 0;
    section.setAttribute('data-selected-country', country.code);
    section.setAttribute('data-paid-count', String(paid.length));
    section.setAttribute('data-visible-count', String(selected.length));
    window.dispatchEvent(new CustomEvent('ma:spotlight-rendered', { detail: { country: country.code, handles: selectedHandles } }));
  }

  window.MissingAlertsSpotlight = { refresh: applySpotlight };
  ['DOMContentLoaded', 'pageshow', 'missingAlertsCountryChanged', 'country-mode:change', 'storage'].forEach(function(eventName) {
    window.addEventListener(eventName, applySpotlight);
    document.addEventListener(eventName, applySpotlight);
  });
  applySpotlight();
  window.setTimeout(applySpotlight, 250);
  window.setTimeout(applySpotlight, 1200);
})();
</script>

<style>
.ma-premium-spotlight{max-width:1260px;margin:18px auto 12px;padding:0 14px;color:#fff}
.ma-premium-spotlight__shell{position:relative;overflow:hidden;border-radius:24px;padding:18px;background:radial-gradient(circle at 50% 0,rgba(255,49,70,.24),transparent 32%),linear-gradient(135deg,#150508,#08090d 58%,#120407);border:1px solid rgba(255,92,92,.22);box-shadow:0 24px 80px rgba(0,0,0,.45),0 0 42px rgba(185,20,32,.14)}
.ma-premium-spotlight__glow{position:absolute;inset:0;background:linear-gradient(110deg,transparent 0%,rgba(255,255,255,.08) 45%,transparent 62%);transform:translateX(-120%);animation:maSpotlightSweep 9s linear infinite;pointer-events:none}
.ma-premium-spotlight__header{position:relative;z-index:1;display:flex;align-items:flex-end;justify-content:space-between;gap:18px;margin-bottom:14px}
.ma-premium-spotlight__eyebrow{margin:0 0 6px;color:#ffb4b4;font-size:11px;font-weight:950;letter-spacing:.16em;text-transform:uppercase}
.ma-premium-spotlight h2{margin:0;color:#fff;font-size:clamp(28px,4vw,46px);line-height:.95;font-weight:950;letter-spacing:.02em}
.ma-premium-spotlight__copy{max-width:650px;margin:9px 0 0;color:rgba(255,255,255,.72);font-size:14px;line-height:1.45;font-weight:750}
.ma-premium-spotlight__cta{display:inline-flex;align-items:center;justify-content:center;min-height:42px;padding:0 16px;border-radius:999px;background:linear-gradient(180deg,#ff4b4b,#a80f1d);border:1px solid rgba(255,255,255,.14);color:#fff!important;text-decoration:none;font-size:12px;font-weight:950;letter-spacing:.06em;text-transform:uppercase;white-space:nowrap;box-shadow:0 12px 26px rgba(168,15,29,.34)}
.ma-premium-spotlight__notice{position:relative;z-index:1;display:inline-flex;margin:0 0 12px;padding:7px 10px;border-radius:999px;background:rgba(255,255,255,.07);border:1px solid rgba(255,255,255,.10);color:rgba(255,235,235,.9);font-size:11px;font-weight:900;letter-spacing:.04em}
.ma-premium-spotlight__grid{position:relative;z-index:1;display:grid;grid-template-columns:minmax(0,.85fr) minmax(0,1.25fr) minmax(0,.85fr);gap:14px;align-items:stretch}
.ma-premium-spotlight-card{min-width:0;display:block}
.ma-premium-spotlight-card[hidden]{display:none!important}
.ma-premium-spotlight-card.is-primary{grid-column:2;grid-row:1;transform:translateY(-3px)}
.ma-premium-spotlight-card.is-primary:first-child{grid-column:auto}
.ma-premium-spotlight-card__link{height:100%;min-height:320px;display:flex;flex-direction:column;overflow:hidden;border-radius:18px;background:linear-gradient(180deg,rgba(255,255,255,.07),rgba(255,255,255,.025));border:1px solid rgba(255,255,255,.10);color:#fff!important;text-decoration:none;box-shadow:0 16px 42px rgba(0,0,0,.32),inset 0 1px 0 rgba(255,255,255,.05);transition:transform .2s ease,border-color .2s ease,box-shadow .2s ease}
.ma-premium-spotlight-card.is-primary .ma-premium-spotlight-card__link{min-height:390px;border-color:rgba(255,92,92,.36);box-shadow:0 22px 56px rgba(0,0,0,.44),0 0 34px rgba(255,42,42,.18)}
.ma-premium-spotlight-card__link:hover{transform:translateY(-3px);border-color:rgba(255,120,120,.34)}
.ma-premium-spotlight-card__media{position:relative;aspect-ratio:16/10;background:#12070a;overflow:hidden}
.ma-premium-spotlight-card.is-primary .ma-premium-spotlight-card__media{aspect-ratio:16/11}
.ma-premium-spotlight-card__media img{width:100%;height:100%;display:block;object-fit:cover;object-position:center;filter:saturate(.96) contrast(1.03)}
.ma-premium-spotlight-card__media:after{content:"";position:absolute;inset:0;background:linear-gradient(180deg,rgba(0,0,0,0),rgba(0,0,0,.52))}
.ma-premium-spotlight-card__badge{position:absolute;left:10px;bottom:10px;z-index:2;display:inline-flex;padding:6px 9px;border-radius:999px;background:rgba(211,24,38,.88);color:#fff;font-size:10px;font-weight:950;letter-spacing:.08em;text-transform:uppercase}
.ma-premium-spotlight-card__body{display:flex;flex:1;flex-direction:column;padding:13px;min-width:0}
.ma-premium-spotlight-card__meta{margin:0 0 7px;color:#ffb4b4;font-size:11px;font-weight:900;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.ma-premium-spotlight-card h3{margin:0;color:#fff;font-size:18px;line-height:1.12;font-weight:950;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden}
.ma-premium-spotlight-card.is-primary h3{font-size:23px}
.ma-premium-spotlight-card__summary{margin:8px 0 12px;color:rgba(255,255,255,.74);font-size:12px;line-height:1.38;font-weight:700;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden}
.ma-premium-spotlight-card__action{margin-top:auto;color:#fff;font-size:11px;font-weight:950;letter-spacing:.08em;text-transform:uppercase}
.ma-premium-spotlight__empty{position:relative;z-index:1;margin-top:10px;padding:13px 14px;border-radius:12px;border:1px solid rgba(255,255,255,.12);background:rgba(255,255,255,.06);color:rgba(255,255,255,.84);font-size:13px;font-weight:800}
.ma-premium-spotlight__empty a{margin-left:8px;color:#ffb4b4!important}
@keyframes maSpotlightSweep{0%{transform:translateX(-120%)}55%,100%{transform:translateX(120%)}}
@media(max-width:980px){.ma-premium-spotlight__header{align-items:flex-start;flex-direction:column}.ma-premium-spotlight__grid{grid-template-columns:1fr}.ma-premium-spotlight-card.is-primary{grid-column:auto;grid-row:auto}.ma-premium-spotlight-card__link,.ma-premium-spotlight-card.is-primary .ma-premium-spotlight-card__link{min-height:0}.ma-premium-spotlight-card.is-primary h3{font-size:20px}}
@media(max-width:620px){.ma-premium-spotlight{padding:0 10px}.ma-premium-spotlight__shell{border-radius:18px;padding:14px}.ma-premium-spotlight__cta{width:100%}}
</style>

{% schema %}
{
  "name": "Spotlight System",
  "settings": [],
  "presets": [
    {
      "name": "Spotlight System"
    }
  ]
}
{% endschema %}
