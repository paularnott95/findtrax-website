{% assign professional_access_handle = section.settings.professional_access_handle | default: 'professional-access-membership' %}
{% assign professional_plus_handle = section.settings.professional_plus_handle | default: 'professional-plus-membership' %}
{% assign professional_elite_handle = section.settings.professional_elite_handle | default: 'professional-elite-membership' %}
{% assign professional_access_product = all_products[professional_access_handle] %}
{% assign professional_plus_product = all_products[professional_plus_handle] %}
{% assign professional_elite_product = all_products[professional_elite_handle] %}
{% assign professional_access_variant = professional_access_product.selected_or_first_available_variant %}
{% assign professional_plus_variant = professional_plus_product.selected_or_first_available_variant %}
{% assign professional_elite_variant = professional_elite_product.selected_or_first_available_variant %}
{% assign professional_access_monthly_selling_plan_id = '' %}
{% assign professional_plus_monthly_selling_plan_id = '' %}
{% assign professional_elite_monthly_selling_plan_id = '' %}
{% if professional_access_product and professional_access_variant and professional_access_product.selling_plan_groups.size > 0 %}
  {% for selling_plan_group in professional_access_product.selling_plan_groups %}
    {% for selling_plan in selling_plan_group.selling_plans %}
      {% assign selling_plan_name = selling_plan.name | downcase %}
      {% if selling_plan_name contains 'month' %}
        {% assign professional_access_monthly_selling_plan_id = selling_plan.id %}
        {% break %}
      {% endif %}
    {% endfor %}
    {% if professional_access_monthly_selling_plan_id != '' %}
      {% break %}
    {% endif %}
  {% endfor %}
{% endif %}
{% if professional_plus_product and professional_plus_variant and professional_plus_product.selling_plan_groups.size > 0 %}
  {% for selling_plan_group in professional_plus_product.selling_plan_groups %}
    {% for selling_plan in selling_plan_group.selling_plans %}
      {% assign selling_plan_name = selling_plan.name | downcase %}
      {% if selling_plan_name contains 'month' %}
        {% assign professional_plus_monthly_selling_plan_id = selling_plan.id %}
        {% break %}
      {% endif %}
    {% endfor %}
    {% if professional_plus_monthly_selling_plan_id != '' %}
      {% break %}
    {% endif %}
  {% endfor %}
{% endif %}
{% if professional_elite_product and professional_elite_variant and professional_elite_product.selling_plan_groups.size > 0 %}
  {% for selling_plan_group in professional_elite_product.selling_plan_groups %}
    {% for selling_plan in selling_plan_group.selling_plans %}
      {% assign selling_plan_name = selling_plan.name | downcase %}
      {% if selling_plan_name contains 'month' %}
        {% assign professional_elite_monthly_selling_plan_id = selling_plan.id %}
        {% break %}
      {% endif %}
    {% endfor %}
    {% if professional_elite_monthly_selling_plan_id != '' %}
      {% break %}
    {% endif %}
  {% endfor %}
{% endif %}
{% assign professional_login_return_separator = '?' %}
{% assign professional_register_return_separator = '?' %}
{% if routes.account_login_url contains '?' %}
  {% assign professional_login_return_separator = '&' %}
{% endif %}
{% if routes.account_register_url contains '?' %}
  {% assign professional_register_return_separator = '&' %}
{% endif %}
{% assign professional_login_url = routes.account_login_url | append: professional_login_return_separator | append: 'return_url=/pages/member-area' %}
{% assign professional_register_url = routes.account_register_url | append: professional_register_return_separator | append: 'return_url=/pages/member-area' %}
{% assign customer_tags_downcase = customer.tags | join: ',' | downcase %}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }

  .professional-membership-{{ section.id }} {
    max-width: 1320px;
    margin: 0 auto;
    padding-left: 1.5rem;
    padding-right: 1.5rem;
    color: #fff;
    display: block;
    min-height: 60vh;
    opacity: 1;
    visibility: visible;
  }

  .professional-membership-{{ section.id }} .membership-debug {
    display: block;
    margin: 0 0 1rem;
    padding: 0.85rem 1rem;
    border-radius: 14px;
    background: #e50914;
    color: #ffffff;
    font-size: 0.9rem;
    font-weight: 900;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .professional-membership__shell-{{ section.id }} {
    overflow: hidden;
    border-radius: 32px;
    padding: 1.5rem;
    background:
      radial-gradient(circle at top left, rgba(255, 49, 86, 0.24), transparent 26%),
      radial-gradient(circle at 80% 10%, rgba(76, 120, 255, 0.10), transparent 24%),
      linear-gradient(180deg, #090a0d 0%, #050506 100%);
    border: 1px solid rgba(255,255,255,0.08);
    box-shadow: 0 24px 80px rgba(0,0,0,0.36), inset 0 1px 0 rgba(255,255,255,0.04);
  }

  .professional-membership__hero-{{ section.id }},
  .professional-membership__card-{{ section.id }},
  .professional-membership__panel-{{ section.id }},
  .professional-membership__form-{{ section.id }} {
    background:
      linear-gradient(180deg, rgba(255,255,255,0.05), rgba(255,255,255,0.015)),
      linear-gradient(180deg, #15161a 0%, #0a0b0e 100%);
    border: 1px solid rgba(255,255,255,0.08);
    box-shadow: 0 18px 40px rgba(0,0,0,0.24);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
  }

  .professional-membership__hero-{{ section.id }},
  .professional-membership__panel-{{ section.id }},
  .professional-membership__form-{{ section.id }} {
    border-radius: 28px;
    padding: 2rem;
  }

  .professional-membership__eyebrow-{{ section.id }},
  .professional-membership__label-{{ section.id }},
  .professional-membership__pill-{{ section.id }} {
    font-size: 0.9rem;
    font-weight: 800;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .professional-membership__eyebrow-{{ section.id }} {
    margin: 0 0 0.55rem;
    color: #ffb4bf;
  }

  .professional-membership__heading-{{ section.id }},
  .professional-membership__title-{{ section.id }} {
    margin: 0;
    text-transform: uppercase;
  }

  .professional-membership__heading-{{ section.id }} {
    font-size: clamp(3rem, 5vw, 5rem);
    line-height: 0.95;
  }

  .professional-membership__intro-{{ section.id }},
  .professional-membership__copy-{{ section.id }},
  .professional-membership__note-{{ section.id }} {
    color: rgba(255,255,255,0.76);
    line-height: 1.7;
  }

  .professional-membership__intro-{{ section.id }} {
    max-width: 68rem;
    margin: 1rem 0 0;
    font-size: 1.15rem;
  }

  .professional-membership__actions-{{ section.id }} {
    display: flex;
    flex-wrap: wrap;
    gap: 0.9rem;
    margin-top: 1.5rem;
  }

  .professional-membership__button-{{ section.id }},
  .professional-membership__button-secondary-{{ section.id }},
  .professional-membership__cta-{{ section.id }} {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 3.4rem;
    padding: 0 1.35rem;
    border-radius: 999px;
    text-decoration: none;
    font-size: 0.9rem;
    font-weight: 900;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    transition: transform 180ms ease, box-shadow 180ms ease, filter 180ms ease;
  }

  .professional-membership__button-{{ section.id }},
  .professional-membership__cta-{{ section.id }} {
    border: 0;
    color: #fff;
    background: linear-gradient(135deg, #ff2f43 0%, #d90429 58%, #8f0016 100%);
    box-shadow: 0 14px 28px rgba(217,4,41,0.28);
  }

  .professional-membership__button-secondary-{{ section.id }} {
    color: #fff;
    background: rgba(255,255,255,0.05);
    border: 1px solid rgba(255,255,255,0.12);
  }

  .professional-membership__button-{{ section.id }}:hover,
  .professional-membership__button-secondary-{{ section.id }}:hover,
  .professional-membership__cta-{{ section.id }}:hover {
    transform: translateY(-2px);
    filter: brightness(1.05);
  }

  .professional-membership__grid-{{ section.id }},
  .professional-membership__meta-{{ section.id }} {
    display: grid;
    gap: 1rem;
    margin-top: 1.5rem;
  }

  .professional-membership__grid-{{ section.id }} {
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }

  .professional-membership__meta-{{ section.id }} {
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }

  .professional-membership__card-{{ section.id }} {
    border-radius: 26px;
    padding: 1.6rem;
    display: flex;
    flex-direction: column;
    gap: 1rem;
    position: relative;
    overflow: hidden;
  }

  .professional-membership__card-{{ section.id }}::before {
    content: '';
    position: absolute;
    inset: 0;
    background: radial-gradient(circle at top right, rgba(255, 43, 43, 0.14), transparent 36%);
    pointer-events: none;
  }

  .professional-membership__price-{{ section.id }} {
    font-size: 2.4rem;
    font-weight: 900;
    line-height: 1;
    text-transform: uppercase;
  }

  .professional-membership__list-{{ section.id }} {
    display: grid;
    gap: 0.75rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .professional-membership__list-{{ section.id }} li {
    color: rgba(255,255,255,0.76);
    line-height: 1.55;
  }

  .professional-membership__pill-{{ section.id }} {
    display: inline-flex;
    align-items: center;
    min-height: 2.2rem;
    padding: 0 0.85rem;
    border-radius: 999px;
    border: 1px solid rgba(255,255,255,0.1);
    background: rgba(255,255,255,0.05);
    color: rgba(255,255,255,0.84);
  }

  .professional-membership__admin-{{ section.id }} {
    border-radius: 18px;
    border: 1px solid rgba(251,191,36,0.2);
    background: rgba(251,191,36,0.08);
    padding: 0.9rem 1rem;
    color: #fde68a;
    line-height: 1.6;
  }

  .professional-membership__coming-soon-{{ section.id }} {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 3.4rem;
    padding: 0 1.35rem;
    border-radius: 999px;
    border: 1px solid rgba(255,255,255,0.12);
    background: rgba(255,255,255,0.04);
    color: rgba(255,255,255,0.72);
    font-size: 0.88rem;
    font-weight: 900;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .professional-membership__pricing-note-{{ section.id }} {
    margin: -0.35rem 0 0;
    color: rgba(255,255,255,0.58);
    line-height: 1.5;
    font-size: 0.85rem;
    text-transform: uppercase;
  }

  .professional-membership__form-grid-{{ section.id }} {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1rem;
    margin-top: 1.25rem;
  }

  .professional-membership__field-{{ section.id }} {
    display: grid;
    gap: 0.55rem;
  }

  .professional-membership__field-{{ section.id }}.is-wide {
    grid-column: 1 / -1;
  }

  .professional-membership__field-{{ section.id }} label {
    font-size: 0.88rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: rgba(255,255,255,0.68);
  }

  .professional-membership__field-{{ section.id }} input,
  .professional-membership__field-{{ section.id }} select,
  .professional-membership__field-{{ section.id }} textarea {
    width: 100%;
    min-height: 3.35rem;
    border-radius: 16px;
    border: 1px solid rgba(255,255,255,0.08);
    background: rgba(255,255,255,0.04);
    color: #fff;
    padding: 0.9rem 1rem;
  }

  .professional-membership__field-{{ section.id }} textarea {
    min-height: 8rem;
    resize: vertical;
  }

  .professional-membership__checkbox-{{ section.id }} {
    display: flex;
    align-items: flex-start;
    gap: 0.8rem;
    color: rgba(255,255,255,0.78);
  }

  .professional-membership__checkbox-{{ section.id }} input {
    margin-top: 0.2rem;
  }

  @media screen and (max-width: 989px) {
    .professional-membership__grid-{{ section.id }},
    .professional-membership__meta-{{ section.id }} {
      grid-template-columns: 1fr;
    }
  }

  @media screen and (max-width: 749px) {
    .professional-membership__shell-{{ section.id }} {
      padding: 1rem;
      border-radius: 24px;
    }

    .professional-membership__hero-{{ section.id }},
    .professional-membership__panel-{{ section.id }},
    .professional-membership__form-{{ section.id }},
    .professional-membership__card-{{ section.id }} {
      padding: 1.2rem;
      border-radius: 20px;
    }

    .professional-membership__form-grid-{{ section.id }} {
      grid-template-columns: 1fr;
    }
  }
{%- endstyle -%}

<section class="professional-membership-{{ section.id }} membership-section section-{{ section.id }}-padding">
  <div class="membership-debug">
    MEMBERSHIP PAGE LOADED
  </div>
  <div class="professional-membership__shell-{{ section.id }}">
    <div class="professional-membership__admin-{{ section.id }}" style="margin-bottom: 1.5rem;">
      PAGE ROUTE LOADED: professional-membership
    </div>
    <div class="professional-membership__hero-{{ section.id }}">
      <p class="professional-membership__eyebrow-{{ section.id }}">Professional Network</p>
      <h1 class="professional-membership__heading-{{ section.id }}">PROFESSIONAL MEMBERSHIP</h1>
      <p class="professional-membership__intro-{{ section.id }}">
        JOIN AS A VERIFIED PROFESSIONAL, CHOOSE THE RIGHT TIER, AND ENTER A SAFE CONTACT SYSTEM DESIGNED FOR CASE OWNERS, FAMILIES, AND APPROVED SPECIALISTS.
      </p>
      <div class="professional-membership__actions-{{ section.id }}">
        <a href="{{ professional_login_url }}" class="professional-membership__button-{{ section.id }}">PROFESSIONAL LOGIN</a>
        <a href="{{ professional_register_url }}" class="professional-membership__button-secondary-{{ section.id }}">PROFESSIONAL SIGN UP</a>
        <a href="/pages/professionals" class="professional-membership__button-secondary-{{ section.id }}">PROFESSIONALS DIRECTORY</a>
      </div>
    </div>

    {% if customer %}
      <div class="professional-membership__panel-{{ section.id }}" style="margin-top: 1.5rem;">
        <div class="professional-membership__label-{{ section.id }}">CURRENT ACCOUNT STATUS</div>
        <h2 class="professional-membership__title-{{ section.id }}" style="font-size: 1.9rem;">CURRENT PROFESSIONAL ACCESS VIEW</h2>
        <p class="professional-membership__copy-{{ section.id }}">
          {% if customer_tags_downcase contains 'professional_elite' %}
            PROFESSIONAL ELITE IS ACTIVE ON THIS CUSTOMER ACCOUNT.
          {% elsif customer_tags_downcase contains 'professional_plus' %}
            PROFESSIONAL PLUS IS ACTIVE ON THIS CUSTOMER ACCOUNT.
          {% elsif customer_tags_downcase contains 'professional_access' %}
            PROFESSIONAL ACCESS IS ACTIVE ON THIS CUSTOMER ACCOUNT.
          {% elsif customer_tags_downcase contains 'professional_pending_verification' %}
            THIS ACCOUNT IS PENDING PROFESSIONAL VERIFICATION.
          {% else %}
            THIS CUSTOMER ACCOUNT DOES NOT YET HAVE A PAID PROFESSIONAL MEMBERSHIP TAG.
          {% endif %}
        </p>
      </div>
    {% endif %}

    {% if request.design_mode %}
      <div class="professional-membership__admin-{{ section.id }}" style="margin-top: 1.5rem;">
        <strong>ADMIN CHECKLIST</strong><br>
        • PRODUCT ACTIVE<br>
        • ONLINE STORE ENABLED<br>
        • MONTHLY SELLING PLAN ATTACHED<br>
        • TEST CHECKOUT BEFORE LAUNCH
      </div>
    {% endif %}

    <div class="professional-membership__meta-{{ section.id }}">
      <article class="professional-membership__panel-{{ section.id }}">
        <div class="professional-membership__label-{{ section.id }}">SAFE CONTACT RULES</div>
        <h2 class="professional-membership__title-{{ section.id }}" style="font-size: 1.7rem;">LOCKED UNTIL APPROVED</h2>
        <p class="professional-membership__copy-{{ section.id }}">
          PROFESSIONAL MESSAGING IS LOCKED UNLESS THE USER IS LOGGED IN, ON A PAID PROFESSIONAL TIER, APPROVED, AND THE CONTACTED MEMBER OR CASE OWNER HAS PERMISSION ENABLED.
        </p>
      </article>
      <article class="professional-membership__panel-{{ section.id }}">
        <div class="professional-membership__label-{{ section.id }}">FAMILY HELP REQUESTS</div>
        <h2 class="professional-membership__title-{{ section.id }}" style="font-size: 1.7rem;">HELP FAMILIES WHO ASK FOR PROFESSIONAL SUPPORT</h2>
        <p class="professional-membership__copy-{{ section.id }}">
          APPROVED PROFESSIONALS CAN ACCESS PRIVATE HELP REQUESTS FROM FAMILIES WHO HAVE CHOSEN TO RECEIVE PROFESSIONAL HELP WITH A SUBMITTED CASE. MEDIUM MEMBERS CAN CONTACT UP TO 3 FAMILIES PER DAY. PREMIUM MEMBERS GET UNLIMITED FAMILY CONTACTS AND PRIORITY ACCESS TO NEW OPPORTUNITIES.
        </p>
      </article>
      <article class="professional-membership__panel-{{ section.id }}">
        <div class="professional-membership__label-{{ section.id }}">VERIFICATION</div>
        <h2 class="professional-membership__title-{{ section.id }}" style="font-size: 1.7rem;">REVIEW FIRST</h2>
        <p class="professional-membership__copy-{{ section.id }}">
          PROFESSIONAL APPLICATIONS REQUIRE REVIEW. VERIFICATION DOCUMENTS MAY BE REQUESTED BY EMAIL AFTER APPLICATION.
        </p>
      </article>
    </div>

    <div class="professional-membership__grid-{{ section.id }}">
      <article class="professional-membership__card-{{ section.id }}">
        <div class="professional-membership__pill-{{ section.id }}">PROFESSIONAL ACCESS</div>
        <div class="professional-membership__label-{{ section.id }}">ENTRY PAID TIER</div>
        <h2 class="professional-membership__title-{{ section.id }}" style="font-size: 2rem;">PROFESSIONAL ACCESS</h2>
        <div class="professional-membership__price-{{ section.id }}">
          {% if professional_access_monthly_selling_plan_id != '' %}£79.99/MONTH{% else %}PAID{% endif %}
        </div>
        <p class="professional-membership__pricing-note-{{ section.id }}">RECURRING MONTHLY MEMBERSHIP. CANCEL ACCORDING TO STORE SUBSCRIPTION TERMS.</p>
        <ul class="professional-membership__list-{{ section.id }}">
          <li>PROFESSIONAL PROFILE</li>
          <li>APPEAR IN PROFESSIONALS DIRECTORY</li>
          <li>ACCESS PROFESSIONAL CASE DISCUSSION AREAS</li>
          <li>VERIFIED BADGE AFTER APPROVAL</li>
          <li>PRIVATE PROFESSIONAL DASHBOARD FOR CASE OPPORTUNITIES</li>
          <li>BUILD TRUST WITH FAMILIES THROUGH VERIFIED PROFESSIONAL ACCESS</li>
        </ul>
        <div class="professional-membership__actions-{{ section.id }}">
          {% if professional_access_product and professional_access_variant and professional_access_monthly_selling_plan_id != '' %}
            <form method="post" action="{{ routes.cart_add_url }}">
              <input type="hidden" name="id" value="{{ professional_access_variant.id }}">
              <input type="hidden" name="selling_plan" value="{{ professional_access_monthly_selling_plan_id }}">
              <button type="submit" class="professional-membership__cta-{{ section.id }}">JOIN AS A PROFESSIONAL</button>
            </form>
          {% elsif professional_access_product and professional_access_variant %}
            <span class="professional-membership__coming-soon-{{ section.id }}">SUBSCRIPTION SETUP REQUIRED</span>
          {% else %}
            <span class="professional-membership__coming-soon-{{ section.id }}">COMING SOON</span>
          {% endif %}
        </div>
        {% if request.design_mode %}
          {% unless professional_access_product %}
            <div class="professional-membership__admin-{{ section.id }}">ADMIN: PRODUCT HANDLE NOT FOUND — {{ professional_access_handle }}</div>
          {% else %}
            {% if professional_access_monthly_selling_plan_id == '' %}
              <div class="professional-membership__admin-{{ section.id }}">ADMIN: ATTACH A MONTHLY SUBSCRIPTION SELLING PLAN TO THIS PRODUCT.</div>
            {% endif %}
          {% endunless %}
        {% endif %}
      </article>

      <article class="professional-membership__card-{{ section.id }}">
        <div class="professional-membership__pill-{{ section.id }}">PROFESSIONAL PLUS</div>
        <div class="professional-membership__label-{{ section.id }}">MID TIER</div>
        <h2 class="professional-membership__title-{{ section.id }}" style="font-size: 2rem;">PROFESSIONAL PLUS</h2>
        <div class="professional-membership__price-{{ section.id }}">
          {% if professional_plus_monthly_selling_plan_id != '' %}£149.99/MONTH{% else %}PAID{% endif %}
        </div>
        <p class="professional-membership__pricing-note-{{ section.id }}">RECURRING MONTHLY MEMBERSHIP. CANCEL ACCORDING TO STORE SUBSCRIPTION TERMS.</p>
        <ul class="professional-membership__list-{{ section.id }}">
          <li>EVERYTHING IN PROFESSIONAL ACCESS</li>
          <li>ACCESS PRIVATE FAMILY HELP REQUESTS</li>
          <li>CONTACT FAMILIES WHO HAVE ASKED FOR PROFESSIONAL SUPPORT</li>
          <li>MEDIUM TIER: CONTACT UP TO 3 FAMILIES PER DAY</li>
          <li>HELP REQUESTS ARE LINKED TO REAL SUBMITTED MISSING-PERSON CASES</li>
          <li>HIGHER DIRECTORY PLACEMENT</li>
          <li>ENHANCED PROFILE CARD</li>
          <li>FEATURED PROFESSIONAL BADGE</li>
          <li>UPGRADE PATH TO PREMIUM FOR UNLIMITED FAMILY CONTACTS</li>
        </ul>
        <div class="professional-membership__actions-{{ section.id }}">
          {% if professional_plus_product and professional_plus_variant and professional_plus_monthly_selling_plan_id != '' %}
            <form method="post" action="{{ routes.cart_add_url }}">
              <input type="hidden" name="id" value="{{ professional_plus_variant.id }}">
              <input type="hidden" name="selling_plan" value="{{ professional_plus_monthly_selling_plan_id }}">
              <button type="submit" class="professional-membership__cta-{{ section.id }}">JOIN AS A PROFESSIONAL</button>
            </form>
          {% elsif professional_plus_product and professional_plus_variant %}
            <span class="professional-membership__coming-soon-{{ section.id }}">SUBSCRIPTION SETUP REQUIRED</span>
          {% else %}
            <span class="professional-membership__coming-soon-{{ section.id }}">COMING SOON</span>
          {% endif %}
        </div>
        {% if request.design_mode %}
          {% unless professional_plus_product %}
            <div class="professional-membership__admin-{{ section.id }}">ADMIN: PRODUCT HANDLE NOT FOUND — {{ professional_plus_handle }}</div>
          {% else %}
            {% if professional_plus_monthly_selling_plan_id == '' %}
              <div class="professional-membership__admin-{{ section.id }}">ADMIN: ATTACH A MONTHLY SUBSCRIPTION SELLING PLAN TO THIS PRODUCT.</div>
            {% endif %}
          {% endunless %}
        {% endif %}
      </article>

      <article class="professional-membership__card-{{ section.id }}">
        <div class="professional-membership__pill-{{ section.id }}">PROFESSIONAL ELITE</div>
        <div class="professional-membership__label-{{ section.id }}">TOP TIER</div>
        <h2 class="professional-membership__title-{{ section.id }}" style="font-size: 2rem;">PROFESSIONAL ELITE</h2>
        <div class="professional-membership__price-{{ section.id }}">
          {% if professional_elite_monthly_selling_plan_id != '' %}£299.99/MONTH{% else %}PAID{% endif %}
        </div>
        <p class="professional-membership__pricing-note-{{ section.id }}">RECURRING MONTHLY MEMBERSHIP. CANCEL ACCORDING TO STORE SUBSCRIPTION TERMS.</p>
        <ul class="professional-membership__list-{{ section.id }}">
          <li>EVERYTHING IN PROFESSIONAL PLUS</li>
          <li>PREMIUM TIER: UNLIMITED FAMILY CONTACTS</li>
          <li>ACCESS PRIVATE FAMILY HELP REQUESTS</li>
          <li>CONTACT FAMILIES WHO HAVE ASKED FOR PROFESSIONAL SUPPORT</li>
          <li>PRIORITY ACCESS TO NEW CASE OPPORTUNITIES</li>
          <li>HELP REQUESTS ARE LINKED TO REAL SUBMITTED MISSING-PERSON CASES</li>
          <li>PREMIUM DIRECTORY PLACEMENT</li>
          <li>HIGHEST VISIBILITY</li>
          <li>SPOTLIGHT-STYLE PROFESSIONAL BADGE</li>
        </ul>
        <div class="professional-membership__actions-{{ section.id }}">
          {% if professional_elite_product and professional_elite_variant and professional_elite_monthly_selling_plan_id != '' %}
            <form method="post" action="{{ routes.cart_add_url }}">
              <input type="hidden" name="id" value="{{ professional_elite_variant.id }}">
              <input type="hidden" name="selling_plan" value="{{ professional_elite_monthly_selling_plan_id }}">
              <button type="submit" class="professional-membership__cta-{{ section.id }}">UPGRADE TO PREMIUM FOR UNLIMITED FAMILY CONTACTS</button>
            </form>
          {% elsif professional_elite_product and professional_elite_variant %}
            <span class="professional-membership__coming-soon-{{ section.id }}">SUBSCRIPTION SETUP REQUIRED</span>
          {% else %}
            <span class="professional-membership__coming-soon-{{ section.id }}">COMING SOON</span>
          {% endif %}
        </div>
        {% if request.design_mode %}
          {% unless professional_elite_product %}
            <div class="professional-membership__admin-{{ section.id }}">ADMIN: PRODUCT HANDLE NOT FOUND — {{ professional_elite_handle }}</div>
          {% else %}
            {% if professional_elite_monthly_selling_plan_id == '' %}
              <div class="professional-membership__admin-{{ section.id }}">ADMIN: ATTACH A MONTHLY SUBSCRIPTION SELLING PLAN TO THIS PRODUCT.</div>
            {% endif %}
          {% endunless %}
        {% endif %}
      </article>
    </div>

    <div class="professional-membership__form-{{ section.id }}" style="margin-top: 1.5rem;">
      <div class="professional-membership__label-{{ section.id }}">PROFESSIONAL APPLICATION</div>
      <h2 class="professional-membership__title-{{ section.id }}" style="font-size: 2rem;">APPLY FOR PROFESSIONAL ACCESS</h2>
      <p class="professional-membership__note-{{ section.id }}">
        USE THIS FORM TO START PROFESSIONAL REVIEW. IF YOU DO NOT YET HAVE A CUSTOMER ACCOUNT, CREATE ONE FIRST. VERIFICATION DOCUMENTS MAY BE REQUESTED BY EMAIL AFTER APPLICATION.
      </p>

      {% form 'contact', id: 'ProfessionalApplicationForm' %}
        {% if form.posted_successfully? %}
          <div class="professional-membership__admin-{{ section.id }}" style="margin-top: 1rem;">APPLICATION SENT. OUR TEAM WILL REVIEW YOUR DETAILS AND MAY REQUEST VERIFICATION DOCUMENTS BY EMAIL.</div>
        {% endif %}
        <input type="hidden" name="contact[subject]" value="PROFESSIONAL APPLICATION">
        <div class="professional-membership__form-grid-{{ section.id }}">
          <div class="professional-membership__field-{{ section.id }}"><label for="professional-full-name-{{ section.id }}">FULL NAME</label><input id="professional-full-name-{{ section.id }}" type="text" name="contact[FULL NAME]" required></div>
          <div class="professional-membership__field-{{ section.id }}"><label for="professional-business-name-{{ section.id }}">BUSINESS / PROFESSIONAL NAME</label><input id="professional-business-name-{{ section.id }}" type="text" name="contact[BUSINESS NAME]" required></div>
          <div class="professional-membership__field-{{ section.id }}"><label for="professional-email-{{ section.id }}">EMAIL</label><input id="professional-email-{{ section.id }}" type="email" name="contact[email]" required></div>
          <div class="professional-membership__field-{{ section.id }}"><label for="professional-phone-{{ section.id }}">PHONE</label><input id="professional-phone-{{ section.id }}" type="text" name="contact[PHONE]"></div>
          <div class="professional-membership__field-{{ section.id }}"><label for="professional-type-{{ section.id }}">PROFESSION TYPE</label><input id="professional-type-{{ section.id }}" type="text" name="contact[PROFESSION TYPE]" required></div>
          <div class="professional-membership__field-{{ section.id }} is-wide">
            {% render 'location-selector',
              id: 'professional-application',
              country_name: 'contact[COUNTRY]',
              region_name: 'contact[CITY REGION]',
              city_name: 'contact[CITY TOWN]'
            %}
          </div>
          <div class="professional-membership__field-{{ section.id }}"><label for="professional-website-{{ section.id }}">WEBSITE</label><input id="professional-website-{{ section.id }}" type="text" name="contact[WEBSITE]"></div>
          <div class="professional-membership__field-{{ section.id }} is-wide"><label for="professional-license-{{ section.id }}">LICENSE / REGISTRATION NUMBER</label><input id="professional-license-{{ section.id }}" type="text" name="contact[LICENSE REGISTRATION NUMBER]"></div>
          <div class="professional-membership__field-{{ section.id }} is-wide"><label for="professional-experience-{{ section.id }}">EXPERIENCE SUMMARY</label><textarea id="professional-experience-{{ section.id }}" name="contact[EXPERIENCE SUMMARY]" required></textarea></div>
          <div class="professional-membership__field-{{ section.id }} is-wide"><label for="professional-proof-{{ section.id }}">PROOF / ID PLACEHOLDER</label><input id="professional-proof-{{ section.id }}" type="text" name="contact[PROOF ID NOTE]" placeholder="VERIFICATION DOCUMENTS MAY BE REQUESTED BY EMAIL AFTER APPLICATION."></div>
          <div class="professional-membership__field-{{ section.id }} is-wide professional-membership__checkbox-{{ section.id }}"><input id="professional-agreement-{{ section.id }}" type="checkbox" required><label for="professional-agreement-{{ section.id }}">I AGREE TO SAFEGUARDING, PRIVACY, AND CASE-OWNER CONTACT RULES.</label></div>
          <div class="professional-membership__field-{{ section.id }} is-wide professional-membership__checkbox-{{ section.id }}"><input id="professional-privacy-{{ section.id }}" type="checkbox" required><label for="professional-privacy-{{ section.id }}">I UNDERSTAND THAT CONTACT ACCESS REMAINS LOCKED UNTIL MEMBERSHIP, APPROVAL, AND PERMISSION RULES ALLOW IT.</label></div>
        </div>
        <div class="professional-membership__actions-{{ section.id }}">
          <button type="submit" class="professional-membership__cta-{{ section.id }}">SEND PROFESSIONAL APPLICATION</button>
          <a href="{{ professional_register_url }}" class="professional-membership__button-secondary-{{ section.id }}">CREATE CUSTOMER ACCOUNT</a>
          <a href="/pages/professional-area" class="professional-membership__button-secondary-{{ section.id }}">PROFESSIONAL AREA</a>
        </div>
      {% endform %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Professional Membership",
  "settings": [
    {
      "type": "text",
      "id": "professional_access_handle",
      "label": "Professional Access product handle",
      "default": "professional-access-membership"
    },
    {
      "type": "text",
      "id": "professional_plus_handle",
      "label": "Professional Plus product handle",
      "default": "professional-plus-membership"
    },
    {
      "type": "text",
      "id": "professional_elite_handle",
      "label": "Professional Elite product handle",
      "default": "professional-elite-membership"
    },
    {
      "type": "header",
      "content": "Section padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Top padding",
      "default": 24
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding",
      "default": 36
    }
  ],
  "presets": [
    {
      "name": "Professional Membership"
    }
  ]
}
{% endschema %}
