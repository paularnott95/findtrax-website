<section class="ma-top-locations ma-top-locations--merged">
  <style>
    .ma-top-locations--merged{padding:56px 20px;background:#09090b;color:#fff}
    .ma-top-locations--merged .ma-top-locations__inner{max-width:960px;margin:0 auto}
    .ma-top-locations--merged h1{margin:0 0 14px;font-size:clamp(32px,5vw,56px);line-height:1.02;letter-spacing:0}
    .ma-top-locations--merged p{max-width:760px;color:#d1d5db;font-size:16px;line-height:1.7}
    .ma-top-locations--merged .ma-top-locations__actions{display:flex;flex-wrap:wrap;gap:12px;margin-top:24px}
    .ma-top-locations--merged a{display:inline-flex;align-items:center;min-height:44px;border-radius:8px;padding:0 16px;background:#e11d48;color:#fff;text-decoration:none;font-weight:800}
    .ma-top-locations--merged a.secondary{background:transparent;border:1px solid rgba(255,255,255,.22)}
  </style>
  <script>
    (function() {
      try {
        if (window.location.pathname === '/pages/top-missing-locations') {
          window.location.replace('/pages/country-intelligence#global-location-checker');
        }
      } catch (e) {}
    })();
  </script>
  <noscript>
    <meta http-equiv="refresh" content="0;url=/pages/country-intelligence#global-location-checker">
  </noscript>
  <div class="ma-top-locations__inner">
    <p class="seo-advice-section__eyebrow">Merged into Country Intelligence</p>
    <h1>Global Location Checker</h1>
    <p>Top Missing Alerts locations now live inside Country Intelligence. This prevents thin generated location pages from standing alone and keeps location guidance, country context, active cases, maps, source links, and safe sharing advice in one quality-gated public system.</p>
    <div class="ma-top-locations__actions">
      <a href="/pages/country-intelligence#global-location-checker">Open Global Location Checker</a>
      <a class="secondary" href="/pages/country-intelligence">Open Country Intelligence</a>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Top locations redirect",
  "tag": "section",
  "class": "section",
  "settings": []
}
{% endschema %}
