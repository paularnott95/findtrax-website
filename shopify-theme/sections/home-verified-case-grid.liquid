{% assign source_blog = blogs['missing-persons'] %}
{% assign rendered_count = 0 %}
{% assign max_items = 6 %}

{% comment %}
  DO NOT replace/remove without preserving fallback render.
  The homepage must still show its static shell when the dynamic case blog is empty or unavailable.
{% endcomment %}
<section class="home-verified-case-grid" data-home-verified-cases>
  <div class="page-width">
    <style>
      .home-verified-case-grid {
        margin: 22px 0 26px;
      }

      .home-verified-case-grid__header {
        display: flex;
        align-items: flex-end;
        justify-content: space-between;
        gap: 12px;
        flex-wrap: wrap;
        margin: 0 0 14px;
      }

      .home-verified-case-grid__cards {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 14px;
      }

      .home-verified-case-grid .ma-case-grid-card {
        min-height: 100%;
      }

      .home-verified-case-grid .ma-case-grid-card__media {
        aspect-ratio: 4 / 3;
      }

      .home-verified-case-grid .ma-case-grid-card__body {
        gap: 8px;
        padding: 14px 14px 10px;
      }

      .home-verified-case-grid .ma-case-grid-card__title {
        display: -webkit-box;
        -webkit-box-orient: vertical;
        -webkit-line-clamp: 2;
        overflow: hidden;
        min-height: calc(1.18em * 2);
        font-size: 18px;
      }

      .home-verified-case-grid .ma-case-grid-card__location,
      .home-verified-case-grid .ma-case-grid-card__excerpt,
      .home-verified-case-grid .ma-case-grid-card__meta span {
        display: -webkit-box;
        -webkit-box-orient: vertical;
        overflow: hidden;
      }

      .home-verified-case-grid .ma-case-grid-card__location {
        -webkit-line-clamp: 1;
      }

      .home-verified-case-grid .ma-case-grid-card__excerpt {
        -webkit-line-clamp: 2;
        min-height: calc(1.45em * 2);
      }

      .home-verified-case-grid .ma-case-grid-card__footer {
        padding: 12px 14px 14px;
      }

      @media (max-width: 989px) {
        .home-verified-case-grid__cards {
          grid-template-columns: repeat(2, minmax(0, 1fr));
        }
      }

      @media (max-width: 749px) {
        .home-verified-case-grid__cards {
          grid-template-columns: 1fr;
        }
      }
    </style>
    <div class="home-verified-case-grid__header">
      <h2 style="margin:0;color:#ffffff;font-size:26px;line-height:1.1;font-weight:900;text-transform:uppercase;letter-spacing:0.04em;">
        {{ section.settings.title | default: 'Latest verified cases' | escape }}
      </h2>
      <a href="/blogs/missing-persons" style="color:rgba(255,255,255,0.82);text-decoration:none;font-weight:800;letter-spacing:0.04em;">
        View all
      </a>
    </div>

    <div class="home-verified-case-grid__cards" data-country-surface="home-verified">
      {% if source_blog != blank and source_blog.articles_count > 0 %}
        {% for article in source_blog.articles limit: 20 %}
          {% capture card_markup %}
            {% render 'case-grid-card', article: article, listing_type: 'missing' %}
          {% endcapture %}
          {% if card_markup != blank %}
            {{ card_markup }}
            {% assign rendered_count = rendered_count | plus: 1 %}
            {% if rendered_count >= max_items %}
              {% break %}
            {% endif %}
          {% endif %}
        {% endfor %}
      {% endif %}
    </div>

    {% if rendered_count == 0 %}
      <div style="margin-top:14px;padding:14px 16px;border:1px solid rgba(255,255,255,0.08);border-radius:14px;background:rgba(0,0,0,0.20);color:rgba(255,255,255,0.82);font-weight:700;">
        No verified live cases are currently available in this section.
      </div>
    {% endif %}
  </div>
</section>

{% schema %}
{
  "name": "Home Verified Case Grid",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Title",
      "default": "Latest verified cases"
    },
    {
      "type": "range",
      "id": "max_items",
      "label": "Max items",
      "min": 1,
      "max": 24,
      "step": 1,
      "default": 6
    }
  ],
  "presets": [
    {
      "name": "Home Verified Case Grid"
    }
  ]
}
{% endschema %}
