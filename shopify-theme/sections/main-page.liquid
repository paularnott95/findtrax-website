  <script>
    window.addEventListener('DOMContentLoaded', function() {
      var locationCountry = document.querySelector('[data-location-country]');
      var locationQuery = document.querySelector('[data-location-query]');
      var locationCards = Array.prototype.slice.call(document.querySelectorAll('[data-location-card]'));
      var locationEmpty = document.querySelector('[data-location-empty]');
      function applyLocationSearch() {
        var countryValue = (locationCountry && locationCountry.value || '').toLowerCase();
        var queryValue = (locationQuery && locationQuery.value || '').toLowerCase();
        var count = 0;
        locationCards.forEach(function(card) {
          var countries = (card.getAttribute('data-location-country') || '').toLowerCase();
          var keywords = (card.getAttribute('data-location-keywords') || '').toLowerCase();
          var text = (card.textContent || '').toLowerCase();
          var visible = (!countryValue || countries.indexOf(countryValue) !== -1 || text.indexOf(countryValue) !== -1) && (!queryValue || keywords.indexOf(queryValue) !== -1 || text.indexOf(queryValue) !== -1);
          card.hidden = !visible;
          if (visible) count += 1;
        });
        if (locationEmpty) locationEmpty.hidden = count !== 0;
      }
      [locationCountry, locationQuery].forEach(function(input) {
        if (!input) return;
        input.addEventListener('input', applyLocationSearch);
        input.addEventListener('change', applyLocationSearch);
      });
      applyLocationSearch();
    });
  </script>
