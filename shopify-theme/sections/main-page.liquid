{%- liquid
  assign seo_location_handles = 'missing-people-location,missing-alerts-near-me,missing-person-search-guide,missing-people-region,missing-people-country,missing-cases-near,no-active-missing-cases,missing-people-near-me,recent-missing-cases,help-find-missing'
  assign request_page_handle = request.path | split: '/pages/' | last | split: '/' | first
  assign render_location_expansion = false
  if request.path contains '/pages/' and seo_location_handles contains request_page_handle
    assign render_location_expansion = true
  endif
-%}

{%- if request_page_handle == 'staff' -%}
  {% render 'staff-access-card' %}
{%- elsif render_location_expansion -%}
  {% render 'location-case-page-content' %}
{%- else -%}
{{ 'section-main-page.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }

  .main-page-case-intelligence-{{ section.id }} {
    max-width: 1320px;
    margin: 0 auto;
    padding-left: 1.5rem;
    padding-right: 1.5rem;
    color: #fff;
  }

  .main-page-case-intelligence__shell-{{ section.id }} {
    overflow: hidden;
    border-radius: 32px;
    padding: 1.5rem;
    background:
      radial-gradient(circle at top left, rgba(239, 68, 68, 0.24), transparent 24%),
      radial-gradient(circle at right top, rgba(251, 191, 36, 0.08), transparent 28%),
      linear-gradient(180deg, #170708 0%, #090203 100%);
    border: 1px solid rgba(255, 105, 120, 0.18);
    box-shadow: 0 24px 80px rgba(0, 0, 0, 0.28), inset 0 1px 0 rgba(255, 255, 255, 0.04);
  }

  .main-page-case-intelligence__hero-{{ section.id }},
  .main-page-case-intelligence__card-{{ section.id }},
  .main-page-case-intelligence__note-{{ section.id }} {
    background:
      linear-gradient(180deg, rgba(255, 255, 255, 0.05), rgba(255, 255, 255, 0.015)),
      linear-gradient(180deg, #180809 0%, #0b0203 100%);
    border: 1px solid rgba(255, 255, 255, 0.06);
    box-shadow: 0 18px 40px rgba(0, 0, 0, 0.22);
  }

  .main-page-case-intelligence__hero-{{ section.id }} {
    border-radius: 28px;
    padding: 2rem;
  }

  .main-page-case-intelligence__eyebrow-{{ section.id }} {
    margin: 0 0 0.55rem;
    color: #f4b8bf;
    font-size: 1rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .main-page-case-intelligence__heading-{{ section.id }} {
    margin: 0;
    font-size: clamp(3rem, 5vw, 5rem);
    line-height: 0.95;
    text-transform: uppercase;
  }

  .main-page-case-intelligence__intro-{{ section.id }} {
    max-width: 64rem;
    margin: 1rem 0 0;
    color: rgba(255, 255, 255, 0.78);
    font-size: 1.22rem;
    line-height: 1.7;
  }

  .main-page-case-intelligence__actions-{{ section.id }},
  .main-page-case-intelligence__chips-{{ section.id }} {
    display: flex;
    flex-wrap: wrap;
    gap: 0.9rem;
    margin-top: 1.4rem;
  }

  .main-page-case-intelligence__button-{{ section.id }},
  .main-page-case-intelligence__button-secondary-{{ section.id }},
  .main-page-case-intelligence__chip-{{ section.id }} {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 3.4rem;
    padding: 0 1.3rem;
    border-radius: 999px;
    text-decoration: none;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .main-page-case-intelligence__button-{{ section.id }} {
    background: linear-gradient(180deg, #ff3b3b 0%, #d61f1f 100%);
    color: #fff;
    box-shadow: 0 10px 22px rgba(173, 17, 17, 0.22);
  }

  .main-page-case-intelligence__button-secondary-{{ section.id }} {
    border: 1px solid rgba(255, 255, 255, 0.12);
    background: rgba(255, 255, 255, 0.04);
    color: #fff;
  }

  .main-page-case-intelligence__chip-{{ section.id }} {
    min-height: 3rem;
    border: 1px solid rgba(255, 255, 255, 0.08);
    background: rgba(255, 255, 255, 0.03);
    color: rgba(255, 255, 255, 0.8);
    font-size: 0.92rem;
  }

  .main-page-case-intelligence__grid-{{ section.id }} {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1rem;
    margin-top: 1.5rem;
  }

  .main-page-case-intelligence__network-{{ section.id }} {
    margin-top: 1.75rem;
  }

  .main-page-case-intelligence__network-nav-{{ section.id }},
  .main-page-case-intelligence__network-grid-{{ section.id }} {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1rem;
  }

  .main-page-case-intelligence__network-nav-{{ section.id }} {
    margin-top: 1.5rem;
  }

  .main-page-case-intelligence__card-{{ section.id }} {
    border-radius: 24px;
    padding: 1.5rem;
  }

  .main-page-case-intelligence__card-link-{{ section.id }} {
    display: block;
    color: inherit;
    text-decoration: none;
  }

  .main-page-case-intelligence__card-link-{{ section.id }}:hover,
  .main-page-case-intelligence__card-link-{{ section.id }}:focus-visible {
    transform: translateY(-2px);
    transition: transform 180ms ease;
  }

  .main-page-case-intelligence__section-anchor-{{ section.id }} {
    scroll-margin-top: 12rem;
  }

  .main-page-case-intelligence__label-{{ section.id }} {
    color: rgba(255, 255, 255, 0.62);
    font-size: 0.95rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .main-page-case-intelligence__title-{{ section.id }} {
    margin: 0.6rem 0 0;
    font-size: 1.65rem;
    text-transform: uppercase;
  }

  .main-page-case-intelligence__copy-{{ section.id }} {
    margin: 0.8rem 0 0;
    color: rgba(255, 255, 255, 0.72);
    line-height: 1.65;
  }

  .main-page-case-intelligence__note-{{ section.id }} {
    margin-top: 1.5rem;
    border-radius: 22px;
    padding: 1rem 1.15rem;
    color: #fde68a;
    line-height: 1.6;
    border-color: rgba(251, 191, 36, 0.18);
    background:
      linear-gradient(180deg, rgba(251, 191, 36, 0.12), rgba(251, 191, 36, 0.07)),
