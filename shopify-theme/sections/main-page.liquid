{% if page.handle == 'case-intelligence' %}
  <section class="main-page-case-intelligence-{{ section.id }} section-{{ section.id }}-padding">
    <div class="main-page-case-intelligence__shell-{{ section.id }}">
      <div class="main-page-case-intelligence__hero-{{ section.id }}">
        <p class="main-page-case-intelligence__eyebrow-{{ section.id }}">Missing Alerts Community</p>
        <h1 class="main-page-case-intelligence__heading-{{ section.id }}">COMMUNITY AREA</h1>
        <div class="main-page-case-intelligence__intro-{{ section.id }}">
          <p>General missing-person awareness, safety advice, volunteer guidance, family support, platform updates, and country community awareness.</p>
        </div>

        <div class="main-page-case-intelligence__actions-{{ section.id }}">
          <a href="/pages/member-area#case-intelligence-network" class="main-page-case-intelligence__button-{{ section.id }}">Browse Community Area</a>

