<script>
(function() {
  var sectionId = {{ section.id | json }};
  var shell = document.getElementById('case-dashboard-system-' + sectionId);
  if (!shell) return;

  var tabs = Array.prototype.slice.call(shell.querySelectorAll('[data-dashboard-tab]'));
  var panels = Array.prototype.slice.call(shell.querySelectorAll('[data-dashboard-panel]'));
  var updateModal = document.getElementById('case-update-modal-' + sectionId);
  var foundModal = document.getElementById('case-found-modal-' + sectionId);
  var updateCaseTitle = updateModal ? updateModal.querySelector('[data-update-case-title]') : null;
  var foundCaseTitle = foundModal ? foundModal.querySelector('[data-found-case-title]') : null;

  function switchTab(tabName) {
    tabs.forEach(function(tab) {
      tab.classList.toggle('is-active', tab.getAttribute('data-dashboard-tab') === tabName);
    });
    panels.forEach(function(panel) {
      panel.classList.toggle('is-active', panel.getAttribute('data-dashboard-panel') === tabName);
    });
  }

  tabs.forEach(function(tab) {
    tab.addEventListener('click', function() {
      switchTab(tab.getAttribute('data-dashboard-tab'));
    });
  });

  function setCounts() {
    var active = shell.querySelectorAll('[data-case-card="active"]').length;
    var pending = shell.querySelectorAll('[data-case-card="pending"]').length;
    var resolved = shell.querySelectorAll('[data-case-card="resolved"]').length;

    var activeEl = shell.querySelector('[data-count-active]');
    var pendingEl = shell.querySelector('[data-count-pending]');
    var resolvedEl = shell.querySelector('[data-count-resolved]');

    if (activeEl) activeEl.textContent = active;
    if (pendingEl) pendingEl.textContent = pending;
    if (resolvedEl) resolvedEl.textContent = resolved;
  }

  function openModal(modal) {
    if (!modal) return;
    modal.classList.add('is-open');
    modal.setAttribute('aria-hidden', 'false');
    document.documentElement.style.overflow = 'hidden';
  }

  function closeModal(modal) {
    if (!modal) return;
    modal.classList.remove('is-open');
    modal.setAttribute('aria-hidden', 'true');
    document.documentElement.style.overflow = '';
  }

  shell.querySelectorAll('[data-open-update-modal]').forEach(function(btn) {
    btn.addEventListener('click', function() {
      if (updateCaseTitle) updateCaseTitle.textContent = btn.getAttribute('data-case-title') || 'Selected case';
      openModal(updateModal);
    });
  });

  shell.querySelectorAll('[data-open-found-modal]').forEach(function(btn) {
    btn.addEventListener('click', function() {
      if (foundCaseTitle) foundCaseTitle.textContent = btn.getAttribute('data-case-title') || 'Selected case';
      openModal(foundModal);
    });
  });

  if (updateModal) {
    updateModal.querySelectorAll('[data-close-update-modal]').forEach(function(btn) {
      btn.addEventListener('click', function() { closeModal(updateModal); });
    });
  }

  if (foundModal) {
    foundModal.querySelectorAll('[data-close-found-modal]').forEach(function(btn) {
      btn.addEventListener('click', function() { closeModal(foundModal); });
    });
  }

  [updateModal, foundModal].forEach(function(modal) {
    if (!modal) return;
    modal.addEventListener('click', function(e) {
      if (e.target === modal) closeModal(modal);
    });
  });

  document.addEventListener('keydown', function(e) {
    if (e.key === 'Escape') {
      closeModal(updateModal);
      closeModal(foundModal);
    }
  });

  if (updateModal) {
    var updateForm = updateModal.querySelector('form');
    if (updateForm) {
      updateForm.addEventListener('submit', function(e) {
        e.preventDefault();
        alert('Next build stage will connect this update request to the real review queue.');
      });
    }
  }

  if (foundModal) {
    var foundForm = foundModal.querySelector('form');
    if (foundForm) {
      foundForm.addEventListener('submit', function(e) {
        e.preventDefault();
        alert('Next build stage will connect this found request to the review queue and archive automation.');
      });
    }
  }

  setCounts();
  switchTab('active');
})();
</script>

