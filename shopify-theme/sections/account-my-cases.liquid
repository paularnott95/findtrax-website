{% if customer %}
<script>
  (function() {
    var sectionId = {{ section.id | json }};
    var requestUrl = 'https://project-155fd.vercel.app/api/case-owner-request';
    var shell = document.querySelector('.account-my-cases-' + sectionId);
    if (!shell) return;

    var casePanel = document.getElementById('account-my-cases-panel-' + sectionId);
    var panelCaseTitle = casePanel ? casePanel.querySelector('[data-panel-case-title]') : null;
    var panelCaseHandle = casePanel ? casePanel.querySelector('[data-panel-case-handle]') : null;
    var panelCaseStatus = casePanel ? casePanel.querySelector('[data-panel-case-status]') : null;
    var panelCaseLocation = casePanel ? casePanel.querySelector('[data-panel-case-location]') : null;
    var panelCaseSummary = casePanel ? casePanel.querySelector('[data-panel-case-summary]') : null;
    var updateForm = casePanel ? casePanel.querySelector('[data-update-form]') : null;
    var foundForm = casePanel ? casePanel.querySelector('[data-found-form]') : null;
    var pendingClaimsList = shell.querySelector('#pending-claims-list');
    var pendingUpdateRequestsList = shell.querySelector('#member-update-requests-list-' + sectionId);
    var pendingFoundRequestsList = shell.querySelector('#member-found-requests-list-' + sectionId);
    var pendingRequestsValue = shell.querySelector('[data-pending-requests-value]');
    var updateRequestFallback = shell.querySelector('[data-update-request-fallback]');
    var foundRequestFallback = shell.querySelector('[data-found-request-fallback]');
    var customerId = {{ customer.id | append: '' | json }};
    var overlay = document.getElementById('hard-overlay');

    if (!overlay) {
      overlay = document.createElement('div');
      overlay.id = 'hard-overlay';
      document.body.appendChild(overlay);
    }

    overlay.style.position = 'fixed';
    overlay.style.top = '0';
    overlay.style.left = '0';
    overlay.style.width = '100%';
    overlay.style.height = '100%';
    overlay.style.background = 'rgba(0,0,0,0.96)';
    overlay.style.zIndex = '9998';
    overlay.style.display = 'none';

    if (casePanel && casePanel.parentNode !== document.body) {
      document.body.appendChild(casePanel);
    }

    if (casePanel) {
      casePanel.style.zIndex = '9999';
    }

    if (overlay && !overlay.hasAttribute('data-overlay-bound')) {
      overlay.setAttribute('data-overlay-bound', 'true');
      overlay.addEventListener('click', function() {
        closeModal(casePanel);
      });
    }

    function showOverlay() {
      overlay.style.display = 'block';
      document.body.style.overflow = 'hidden';
    }

    function hideOverlay() {
      overlay.style.display = 'none';
      document.body.style.overflow = '';
    }

    function getCaseData(button) {
      return {
        caseTitle: button.getAttribute('data-case-title') || '',
        caseHandle: button.getAttribute('data-case-handle') || '',
        requesterCustomerId: button.getAttribute('data-requester-customer-id') || '',
        requesterName: button.getAttribute('data-requester-name') || '',
        requesterEmail: button.getAttribute('data-requester-email') || '',
        caseStatus: button.getAttribute('data-case-status') || 'Active',
        caseLocation: button.getAttribute('data-case-location') || 'Not available',
        caseSummary: button.getAttribute('data-case-summary') || 'Not available'
      };
    }

    function setPanelCaseData(data) {
      [updateForm, foundForm].forEach(function(form) {
        if (!form) return;
        form.setAttribute('data-case-title', data.caseTitle || '');
        form.setAttribute('data-case-handle', data.caseHandle || '');
        form.setAttribute('data-requester-customer-id', data.requesterCustomerId || '');
        form.setAttribute('data-requester-name', data.requesterName || '');
        form.setAttribute('data-requester-email', data.requesterEmail || '');
      });

      if (panelCaseTitle) panelCaseTitle.textContent = data.caseTitle || 'Selected case';
      if (panelCaseHandle) panelCaseHandle.textContent = data.caseHandle || 'Not set';
      if (panelCaseStatus) panelCaseStatus.textContent = data.caseStatus || 'Not set';
      if (panelCaseLocation) panelCaseLocation.textContent = data.caseLocation || 'Not available';
      if (panelCaseSummary) panelCaseSummary.textContent = data.caseSummary || 'Not available';
    }

    function getFormCaseData(form) {
      return {
        caseTitle: form.getAttribute('data-case-title') || '',
        caseHandle: form.getAttribute('data-case-handle') || '',
        requesterCustomerId: form.getAttribute('data-requester-customer-id') || '',
        requesterName: form.getAttribute('data-requester-name') || '',
        requesterEmail: form.getAttribute('data-requester-email') || ''
      };
    }

    function setSubmitting(form, isSubmitting) {
      if (!form) return;
      var submitButton = form.querySelector('button[type="submit"]');
      if (!submitButton) return;

      if (!submitButton.hasAttribute('data-default-label')) {
        submitButton.setAttribute('data-default-label', submitButton.textContent);
      }

      submitButton.disabled = isSubmitting;
      submitButton.setAttribute('aria-disabled', isSubmitting ? 'true' : 'false');
      submitButton.textContent = isSubmitting ? 'Submitting...' : submitButton.getAttribute('data-default-label');
    }

    async function submitOwnerRequest(payload) {
      console.log('CASE OWNER REQUEST URL', requestUrl);
      console.log('CASE OWNER REQUEST PAYLOAD', payload);
      const res = await fetch(requestUrl, {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json'
        },
        body: JSON.stringify(payload)
      });
      const rawText = await res.text();
      console.log('CASE OWNER RESPONSE STATUS', res.status);
      console.log('CASE OWNER RAW RESPONSE', rawText);
      let data;
      try {
        data = JSON.parse(rawText);
      } catch (e) {
        alert('NON-JSON RESPONSE: ' + rawText.slice(0, 300));
        throw new Error('Endpoint returned non-JSON response');
      }
      if (!res.ok || !data.ok) {
        throw new Error(data.error || 'Request failed');
      }
      return data;
    }

    function getOwnerRequestSubmitMessage(error) {
      var message = error && error.message ? String(error.message) : 'Unable to submit request right now.';

      if (message.indexOf('Manual Shopify setup required:') !== -1) {
        return 'Owner request system is not yet bootstrapped in Shopify admin.';
      }

      return message;
    }

    function openModal(modal) {
      if (!modal) return;
      showOverlay();
      modal.classList.add('is-open');
      modal.setAttribute('aria-hidden', 'false');
      document.documentElement.style.overflow = 'hidden';
    }

    function closeModal(modal) {
      if (!modal) return;
      hideOverlay();
      modal.classList.remove('is-open');
      modal.setAttribute('aria-hidden', 'true');
      document.documentElement.style.overflow = '';
    }

    function resetPanelForms() {
      if (updateForm) updateForm.reset();
      if (foundForm) foundForm.reset();
    }

    function openCasePanel(button, preferredTarget) {
      var caseData = getCaseData(button);
      resetPanelForms();
      setPanelCaseData(caseData);
      openModal(casePanel);

      window.setTimeout(function() {
        if (preferredTarget === 'found' && foundForm && foundForm.elements.found_confirmation) {
          foundForm.elements.found_confirmation.focus();
          return;
        }
        if (updateForm && updateForm.elements.update_summary) {
          updateForm.elements.update_summary.focus();
        }
      }, 60);
    }

    function openCasePanelByHandle(caseHandle, preferredTarget) {
      if (!caseHandle) return false;

      var targetButton = null;
      shell.querySelectorAll('[data-open-case-panel]').forEach(function(button) {
        if (targetButton) return;
        if ((button.getAttribute('data-case-handle') || '') === caseHandle) {
          targetButton = button;
        }
      });

      if (!targetButton) return false;

      openCasePanel(targetButton, preferredTarget || targetButton.getAttribute('data-panel-target') || 'update');
      return true;
    }

    async function loadPendingClaims() {
      if (!pendingClaimsList) return;
      if (pendingClaimsList.getAttribute('data-api-pending-enabled') !== 'true') return;

      try {
        var res = await fetch('https://project-155fd.vercel.app/api/claims');
        var data = await res.json();
        var claims = Array.isArray(data) ? data : Array.isArray(data.claims) ? data.claims : [];

        var pending = claims.filter(function(claim) {
          return (
            String(claim.status || '').toLowerCase() === 'pending' &&
            String(claim.claimant_customer_id || '') === String(customerId)
          );
        });

        if (pending.length === 0) {
          pendingClaimsList.innerHTML = '<p>No pending claims</p>';
          return;
        }

        pendingClaimsList.innerHTML = pending
          .map(function(claim) {
            var submittedAt = claim.submitted_at ? new Date(claim.submitted_at) : null;
            var submittedLabel =
              submittedAt && !isNaN(submittedAt.getTime())
                ? submittedAt.toLocaleString()
                : 'Not available';
            return (
              '<div class="pending-card">' +
              '<strong>' + (claim.person_name || 'Claim Request') + '</strong>' +
              '<p>Handle: ' + (claim.linked_case_handle || 'Not available') + '</p>' +
              '<p>Status: Pending</p>' +
              '<p>Submitted: ' + submittedLabel + '</p>' +
              '</div>'
            );
          })
          .join('');

        if (pendingRequestsValue) {
          var baseCount = Number(pendingRequestsValue.getAttribute('data-base-pending-count') || '0');
          var claimsStorefrontExposed =
            pendingRequestsValue.getAttribute('data-claims-storefront-exposed') === 'true';
          pendingRequestsValue.textContent = String(claimsStorefrontExposed ? baseCount : baseCount + pending.length);
        }
      } catch (e) {
        console.error('Pending claims fetch failed', e);
      }
    }

    shell.querySelectorAll('[data-open-case-panel]').forEach(function(button) {
      button.addEventListener('click', function() {
        openCasePanel(button, button.getAttribute('data-panel-target') || 'update');
      });
    });

    shell.querySelectorAll('[data-open-first-case-panel]').forEach(function(button) {
      button.addEventListener('click', function() {
        var firstPanelButton = shell.querySelector('[data-open-case-panel]');
        if (firstPanelButton) {
          openCasePanel(firstPanelButton, button.getAttribute('data-panel-target') || 'update');
        } else {
          var casesSection = document.getElementById('member-portal-cases-' + sectionId);
          if (casesSection) {
            casesSection.scrollIntoView({ behavior: 'smooth', block: 'start' });
          }
        }
      });
    });

    if (casePanel) {
      casePanel.querySelectorAll('[data-close-case-panel]').forEach(function(button) {
        button.addEventListener('click', function() {
          closeModal(casePanel);
        });
      });
    }

    [casePanel].forEach(function(modal) {
      if (!modal) return;
      modal.addEventListener('click', function(event) {
        if (event.target === modal) {
          closeModal(modal);
        }
      });
    });

    document.addEventListener('keydown', function(event) {
      if (event.key === 'Escape') {
        closeModal(casePanel);
      }
    });

    var urlParams = new URLSearchParams(window.location.search);
    var editHandle = urlParams.get('edit');
    var panelTarget = urlParams.get('panel') || 'update';

    if (editHandle) {
      window.setTimeout(function() {
        openCasePanelByHandle(editHandle, panelTarget);
      }, 60);
    }

    function buildUpdateDetails(form) {
      var updateDetails = form.elements.update_details.value;
      var correctedDetails = form.elements.corrected_details.value;
      var locationBits = [
        form.elements.location_full_path && form.elements.location_full_path.value,
        form.elements.location_slug_path && form.elements.location_slug_path.value,
        form.elements.location_lat && form.elements.location_lat.value,
        form.elements.location_lng && form.elements.location_lng.value
      ].filter(function(value) {
        return value && String(value).trim();
      });

      if (!locationBits.length && (!correctedDetails || !String(correctedDetails).trim())) {
        return updateDetails;
      }

      var output = updateDetails;
      if (locationBits.length) output += '\n\nCorrected official location:\n' + locationBits.join('\n');
      if (correctedDetails && String(correctedDetails).trim()) output += '\n\nLast seen details / visible case notes:\n' + correctedDetails;
      return output;
    }

    function escapeHtml(value) {
      return String(value || '')
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;')
        .replace(/"/g, '&quot;')
        .replace(/'/g, '&#39;');
    }

    function formatSubmittedAt(value) {
      if (!value) return 'Not available';
      var date = new Date(value);
      if (isNaN(date.getTime())) return 'Not available';
      return date.toLocaleString();
    }

    function renderOwnerRequests(listEl, items, emptyTitle, emptyCopy, badgeLabel) {
      if (!listEl) return;

      if (!items.length) {
        listEl.innerHTML =
          '<div class="account-my-cases__empty-{{ section.id }}">' +
          '<h3 class="account-my-cases__empty-title-{{ section.id }}">' + escapeHtml(emptyTitle) + '</h3>' +
          '<p>' + escapeHtml(emptyCopy) + '</p>' +
          '</div>';
        return;
      }

      listEl.innerHTML = items.map(function(item) {
        return (
          '<article class="account-my-cases__request-card-{{ section.id }}">' +
            '<div class="account-my-cases__request-status-{{ section.id }}">' + escapeHtml(item.status || 'pending') + '</div>' +
            '<h3 class="account-my-cases__request-title-{{ section.id }}">' + escapeHtml(item.case_title || item.linked_case_handle || 'Member request') + '</h3>' +
            '<p class="account-my-cases__request-copy-{{ section.id }}">Handle: ' + escapeHtml(item.linked_case_handle || 'Not available') + '</p>' +
            '<p class="account-my-cases__request-copy-{{ section.id }}">' + escapeHtml(item.request_summary || item.request_details || 'No details supplied.') + '</p>' +
            '<p class="account-my-cases__request-copy-{{ section.id }}">Submitted: ' + escapeHtml(formatSubmittedAt(item.submitted_at)) + '</p>' +
            '<div class="account-my-cases__badge-{{ section.id }}">' + escapeHtml(badgeLabel) + '</div>' +
          '</article>'
        );
      }).join('');
    }

    async function loadOwnerRequests() {
      if (!customerId) return;

      try {
        var res = await fetch(
          requestUrl + '?customerId=' + encodeURIComponent(customerId) + '&status=pending',
          { headers: { 'Accept': 'application/json' } }
        );
        var rawText = await res.text();
        var data;

        try {
          data = JSON.parse(rawText);
        } catch (error) {
          console.error('OWNER REQUEST LIST NON_JSON', rawText);
          throw new Error('Owner request list returned non-JSON response');
        }

        if (!res.ok || !data.ok) {
          throw new Error(data.error || 'Failed to load owner requests');
        }

        var ownerRequests = Array.isArray(data.ownerRequests) ? data.ownerRequests : [];
        var updateItems = ownerRequests.filter(function(item) {
          return String(item.request_type || '').toLowerCase() === 'update';
        });
        var foundItems = ownerRequests.filter(function(item) {
          return String(item.request_type || '').toLowerCase() === 'found';
        });

        renderOwnerRequests(
          pendingUpdateRequestsList,
          updateItems,
          'No Pending Update Requests',
          'No update requests are currently awaiting moderation for this member account.',
          'UPDATE PENDING'
        );

        renderOwnerRequests(
          pendingFoundRequestsList,
          foundItems,
          'No Pending Found Requests',
          'No found or resolved requests are currently awaiting moderation for this member account.',
          'FOUND PENDING'
        );

        if (updateRequestFallback) {
          updateRequestFallback.style.display = updateItems.length ? 'none' : '';
        }

        if (foundRequestFallback) {
          foundRequestFallback.style.display = foundItems.length ? 'none' : '';
        }

        if (pendingRequestsValue) {
          var baseCount = Number(pendingRequestsValue.getAttribute('data-base-pending-count') || '0');
          var claimsStorefrontExposed =
            pendingRequestsValue.getAttribute('data-claims-storefront-exposed') === 'true';
          var ownerRequestCount = updateItems.length + foundItems.length;
          pendingRequestsValue.textContent = String((claimsStorefrontExposed ? baseCount : baseCount) + ownerRequestCount);
        }
      } catch (error) {
        console.error('Owner requests fetch failed', error);
      }
    }

    if (updateForm) {
      updateForm.addEventListener('submit', async function(event) {
        event.preventDefault();
        if (updateForm.getAttribute('data-submitting') === 'true') return;

        var caseData = getFormCaseData(updateForm);

        updateForm.setAttribute('data-submitting', 'true');
        setSubmitting(updateForm, true);

        try {
          await submitOwnerRequest({
            request_type: 'update',
            linked_case_handle: caseData.caseHandle,
            case_title: caseData.caseTitle,
            requester_customer_id: caseData.requesterCustomerId,
            requester_name: caseData.requesterName,
            requester_email: caseData.requesterEmail,
            request_summary: updateForm.elements.update_summary.value,
            request_details: buildUpdateDetails(updateForm),
            contact_note: updateForm.elements.contact_note.value
          });

          alert('Your case update has been submitted for review. It will be checked before any live changes are made.');
          updateForm.reset();
          closeModal(casePanel);
          Promise.all([loadOwnerRequests(), loadPendingClaims()]);
        } catch (error) {
          alert(getOwnerRequestSubmitMessage(error));
        } finally {
          updateForm.setAttribute('data-submitting', 'false');
          setSubmitting(updateForm, false);
        }
      });
    }

    if (foundForm) {
      foundForm.addEventListener('submit', async function(event) {
        event.preventDefault();
        if (foundForm.getAttribute('data-submitting') === 'true') return;

        var caseData = getFormCaseData(foundForm);

        foundForm.setAttribute('data-submitting', 'true');
        setSubmitting(foundForm, true);

        try {
          await submitOwnerRequest({
            request_type: 'found',
            linked_case_handle: caseData.caseHandle,
            case_title: caseData.caseTitle,
            requester_customer_id: caseData.requesterCustomerId,
            requester_name: caseData.requesterName,
            requester_email: caseData.requesterEmail,
            request_summary: 'Case marked as found request',
            request_details: foundForm.elements.found_confirmation.value,
            contact_note: foundForm.elements.found_note.value
          });

          alert('Your found-case request has been submitted for review. The live case will only change after review.');
          foundForm.reset();
          closeModal(casePanel);
          Promise.all([loadOwnerRequests(), loadPendingClaims()]);
        } catch (error) {
          alert(getOwnerRequestSubmitMessage(error));
        } finally {
          foundForm.setAttribute('data-submitting', 'false');
          setSubmitting(foundForm, false);
        }
      });
    }

    loadPendingClaims();
    loadOwnerRequests();
  })();
</script>
{% endif %}

