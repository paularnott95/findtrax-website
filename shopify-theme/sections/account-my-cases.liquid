{% assign account_login_return_separator = '?' %}
{% assign account_register_return_separator = '?' %}
{% if routes.account_login_url contains '?' %}
  {% assign account_login_return_separator = '&' %}
{% endif %}
{% if routes.account_register_url contains '?' %}
  {% assign account_register_return_separator = '&' %}
{% endif %}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }

  .account-my-cases-{{ section.id }} {
    max-width: 1320px;
    margin: 0 auto;
    padding-left: 1.5rem;
    padding-right: 1.5rem;
    color: #ffffff;
  }

  .account-my-cases__shell-{{ section.id }} {
    position: relative;
    overflow: hidden;
    border-radius: 32px;
    padding: 1.5rem;
    background:
      radial-gradient(circle at top, rgba(220, 40, 60, 0.18), transparent 22%),
      radial-gradient(circle at right top, rgba(255, 95, 120, 0.08), transparent 26%),
      linear-gradient(180deg, #160608 0%, #090203 100%);
    border: 1px solid rgba(255, 105, 120, 0.18);
    box-shadow:
      0 24px 80px rgba(0, 0, 0, 0.28),
      inset 0 1px 0 rgba(255, 255, 255, 0.04);
  }

  .account-my-cases__shell-{{ section.id }}::before {
    content: '';
    position: absolute;
    inset: 0;
    background:
      linear-gradient(135deg, rgba(255, 255, 255, 0.04), transparent 32%),
      linear-gradient(315deg, rgba(223, 64, 83, 0.06), transparent 30%);
    pointer-events: none;
  }

  .account-my-cases__content-{{ section.id }} {
    position: relative;
    z-index: 1;
  }

  .account-my-cases__eyebrow-{{ section.id }} {
    margin: 0 0 0.55rem;
    color: #e3aeb5;
    font-size: 1rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .account-my-cases__hero-{{ section.id }} {
    display: grid;
    grid-template-columns: minmax(0, 1.4fr) minmax(28rem, 0.8fr);
    gap: 1.5rem;
    align-items: stretch;
  }

  .account-my-cases__hero-panel-{{ section.id }},
  .account-my-cases__hero-side-{{ section.id }},
  .account-my-cases__section-{{ section.id }},
  .account-my-cases__membership-card-{{ section.id }},
  .account-my-cases__info-card-{{ section.id }},
  .account-my-cases__stat-card-{{ section.id }},
  .account-my-cases__card-{{ section.id }},
  .account-my-cases__modal-shell-{{ section.id }},
  .account-my-cases__login-panel-{{ section.id }} {
    background:
      linear-gradient(180deg, rgba(255, 255, 255, 0.05), rgba(255, 255, 255, 0.015)),
      linear-gradient(180deg, #170709 0%, #0b0203 100%);
    border: 1px solid rgba(255, 255, 255, 0.06);
    box-shadow: 0 18px 40px rgba(0, 0, 0, 0.22);
  }

  .account-my-cases__hero-panel-{{ section.id }},
  .account-my-cases__hero-side-{{ section.id }} {
    border-radius: 28px;
    padding: 2rem;
  }

  .account-my-cases__heading-{{ section.id }} {
    margin: 0;
    color: #ffffff;
    font-size: clamp(3.2rem, 5vw, 5.2rem);
    line-height: 0.95;
    text-transform: uppercase;
  }

  .account-my-cases__intro-{{ section.id }} {
    max-width: 66rem;
    margin: 1rem 0 0;
    color: rgba(255, 255, 255, 0.78);
    font-size: 1.55rem;
    line-height: 1.7;
  }

  .account-my-cases__hero-actions-{{ section.id }} {
    display: flex;
    flex-wrap: wrap;
    gap: 0.9rem;
    margin-top: 1.6rem;
  }

  .account-my-cases__portal-grid-{{ section.id }} {
    display: grid;
    gap: 1.5rem;
    margin-top: 1.5rem;
  }

  .account-my-cases__portal-nav-{{ section.id }} {
    display: flex;
    flex-wrap: wrap;
    gap: 0.8rem;
    margin-top: 1.5rem;
  }

  .account-my-cases__portal-chip-{{ section.id }} {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 4rem;
    padding: 0 1.4rem;
    border-radius: 999px;
    border: 1px solid rgba(255, 255, 255, 0.08);
    background: rgba(255, 255, 255, 0.03);
    color: rgba(255, 255, 255, 0.8);
    font-size: 1rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-decoration: none;
    text-transform: uppercase;
  }

  .account-my-cases__side-kicker-{{ section.id }} {
    color: rgba(255, 255, 255, 0.62);
    font-size: 1rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .account-my-cases__side-title-{{ section.id }} {
    margin: 0.8rem 0 0;
    font-size: 2rem;
    line-height: 1.15;
    text-transform: uppercase;
  }

  .account-my-cases__side-copy-{{ section.id }} {
    margin: 0.8rem 0 0;
    color: rgba(255, 255, 255, 0.72);
    line-height: 1.65;
  }

  .account-my-cases__section-{{ section.id }} {
    border-radius: 28px;
    padding: 1.75rem;
  }

  .account-my-cases__section-head-{{ section.id }} {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 1rem;
    align-items: end;
    margin-bottom: 1.5rem;
  }

  .account-my-cases__section-title-{{ section.id }} {
    margin: 0.45rem 0 0;
    font-size: clamp(2.2rem, 3.4vw, 3rem);
    line-height: 1;
    text-transform: uppercase;
  }

  .account-my-cases__section-copy-{{ section.id }} {
    max-width: 68rem;
    margin: 0;
    color: rgba(255, 255, 255, 0.74);
    line-height: 1.65;
  }

  .account-my-cases__stats-{{ section.id }} {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 1rem;
  }

  .account-my-cases__stat-card-{{ section.id }} {
    border-radius: 22px;
    padding: 1.4rem;
  }

  .account-my-cases__stat-label-{{ section.id }} {
    color: rgba(255, 255, 255, 0.62);
    font-size: 0.95rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .account-my-cases__stat-value-{{ section.id }} {
    margin-top: 0.7rem;
    font-size: clamp(2.2rem, 4vw, 3.2rem);
    font-weight: 800;
    line-height: 1;
    text-transform: uppercase;
  }

  .account-my-cases__stat-note-{{ section.id }} {
    margin-top: 0.55rem;
    color: rgba(255, 255, 255, 0.62);
    font-size: 1.05rem;
    line-height: 1.5;
  }

  .account-my-cases__overview-grid-{{ section.id }} {
    display: grid;
    grid-template-columns: minmax(0, 1.2fr) minmax(0, 0.8fr);
    gap: 1rem;
    margin-top: 1rem;
  }

  .account-my-cases__info-card-{{ section.id }} {
    border-radius: 22px;
    padding: 1.5rem;
  }

  .account-my-cases__info-title-{{ section.id }} {
    margin: 0;
    font-size: 1.6rem;
    text-transform: uppercase;
  }

  .account-my-cases__info-copy-{{ section.id }} {
    margin: 0.75rem 0 0;
    color: rgba(255, 255, 255, 0.72);
    line-height: 1.65;
  }

  .account-my-cases__checklist-{{ section.id }} {
    display: grid;
    gap: 0.8rem;
    margin-top: 1rem;
  }

  .account-my-cases__checklist-item-{{ section.id }} {
    display: flex;
    gap: 0.8rem;
    align-items: start;
    color: rgba(255, 255, 255, 0.78);
    line-height: 1.55;
  }

  .account-my-cases__checklist-dot-{{ section.id }} {
    flex: 0 0 0.8rem;
    width: 0.8rem;
    height: 0.8rem;
    margin-top: 0.45rem;
    border-radius: 999px;
    background: linear-gradient(180deg, #df4053 0%, #8f1421 100%);
    box-shadow: 0 0 16px rgba(223, 64, 83, 0.45);
  }

  .account-my-cases__grid-{{ section.id }} {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1.5rem;
    margin-top: 1.25rem;
  }

  .account-my-cases__card-{{ section.id }} {
    overflow: hidden;
    border-radius: 22px;
  }

  .account-my-cases__image-wrap-{{ section.id }} {
    position: relative;
    height: 220px;
    background: rgba(255, 255, 255, 0.04);
  }

  .account-my-cases__image-{{ section.id }},
  .account-my-cases__image-placeholder-{{ section.id }} {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .account-my-cases__image-{{ section.id }}.is-found {
    filter: blur(22px) saturate(0.88) brightness(0.78) contrast(0.9);
    transform: scale(1.1);
    transform-origin: center center;
    opacity: 0.78;
  }

  .account-my-cases__found-overlay-{{ section.id }} {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    background: linear-gradient(180deg, rgba(5, 12, 8, 0.28) 0%, rgba(5, 12, 8, 0.72) 100%);
    color: #ffffff;
    font-size: 1.3rem;
    font-weight: 800;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .account-my-cases__image-placeholder-{{ section.id }} {
    display: flex;
    align-items: center;
    justify-content: center;
    color: rgba(255, 255, 255, 0.7);
    font-size: 1.2rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .account-my-cases__body-{{ section.id }} {
    padding: 1.5rem;
  }

  .account-my-cases__title-{{ section.id }} {
    margin: 0 0 1rem;
    color: #ffffff;
    font-size: 2rem;
    line-height: 1.15;
    text-transform: uppercase;
  }

  .account-my-cases__meta-{{ section.id }} {
    display: grid;
    gap: 0.35rem;
    margin-bottom: 1.25rem;
  }

  .account-my-cases__meta-label-{{ section.id }} {
    color: rgba(255, 255, 255, 0.6);
    font-size: 1rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .account-my-cases__meta-value-{{ section.id }} {
    color: #ffffff;
    font-size: 1.4rem;
    line-height: 1.4;
  }

  .account-my-cases__badge-{{ section.id }} {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 1rem;
    padding: 0.45rem 0.9rem;
    border-radius: 999px;
    background: rgba(22, 163, 74, 0.18);
    border: 1px solid rgba(74, 222, 128, 0.35);
    color: #dcfce7;
    font-size: 1rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .account-my-cases__resolved-{{ section.id }} {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 4.4rem;
    padding: 0 1.8rem;
    border-radius: 999px;
    border: 1px solid rgba(74, 222, 128, 0.3);
    background: linear-gradient(180deg, rgba(22, 163, 74, 0.24), rgba(20, 83, 45, 0.3));
    color: #dcfce7;
    font-size: 1.1rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .account-my-cases__button-{{ section.id }} {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 4.4rem;
    padding: 0 1.8rem;
    border-radius: 999px;
    background: linear-gradient(180deg, #df4053 0%, #8f1421 100%);
    color: #ffffff;
    font-size: 1.1rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-decoration: none;
    text-transform: uppercase;
    box-shadow: 0 14px 28px rgba(124, 19, 29, 0.24);
    cursor: pointer;
  }

  .account-my-cases__button-secondary-{{ section.id }} {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 4.4rem;
    padding: 0 1.8rem;
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 999px;
    background: linear-gradient(180deg, #2a2527 0%, #161113 100%);
    color: #ffffff;
    font-size: 1.1rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    text-decoration: none;
    cursor: pointer;
    box-shadow: 0 10px 22px rgba(0, 0, 0, 0.18);
  }

  .account-my-cases__actions-{{ section.id }},
  .account-my-cases__cta-row-{{ section.id }} {
    display: flex;
    flex-wrap: wrap;
    gap: 0.9rem;
  }

  .account-my-cases__actions-{{ section.id }} .account-my-cases__button-{{ section.id }},
  .account-my-cases__actions-{{ section.id }} .account-my-cases__button-secondary-{{ section.id }},
  .account-my-cases__cta-row-{{ section.id }} .account-my-cases__button-{{ section.id }},
  .account-my-cases__cta-row-{{ section.id }} .account-my-cases__button-secondary-{{ section.id }} {
    flex: 1 1 18rem;
  }

  .account-my-cases__membership-grid-{{ section.id }},
  .account-my-cases__request-grid-{{ section.id }} {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1rem;
  }

  .account-my-cases__request-grid-{{ section.id }} {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .account-my-cases__membership-card-{{ section.id }},
  .account-my-cases__request-card-{{ section.id }} {
    border-radius: 22px;
    padding: 1.5rem;
  }

  .account-my-cases__membership-tier-{{ section.id }} {
    display: inline-flex;
    align-items: center;
    min-height: 3rem;
    padding: 0 0.9rem;
    border-radius: 999px;
    border: 1px solid rgba(223, 64, 83, 0.18);
    background: rgba(223, 64, 83, 0.08);
    color: #f4d6d9;
    font-size: 0.95rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .account-my-cases__membership-name-{{ section.id }},
  .account-my-cases__request-title-{{ section.id }} {
    margin: 1rem 0 0;
    font-size: 1.75rem;
    text-transform: uppercase;
  }

  .account-my-cases__membership-copy-{{ section.id }},
  .account-my-cases__request-copy-{{ section.id }} {
    margin: 0.8rem 0 0;
    color: rgba(255, 255, 255, 0.72);
    line-height: 1.65;
  }

  .account-my-cases__membership-foot-{{ section.id }} {
    margin-top: 1.2rem;
    color: rgba(255, 255, 255, 0.56);
    font-size: 1rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .account-my-cases__request-card-{{ section.id }} {
    background:
      linear-gradient(180deg, rgba(255, 255, 255, 0.05), rgba(255, 255, 255, 0.015)),
      linear-gradient(180deg, #170709 0%, #0b0203 100%);
    border: 1px solid rgba(255, 255, 255, 0.06);
    box-shadow: 0 18px 40px rgba(0, 0, 0, 0.22);
  }

  .account-my-cases__request-status-{{ section.id }} {
    color: rgba(255, 255, 255, 0.58);
    font-size: 0.95rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .pending-card {
    border-radius: 22px;
    padding: 1.5rem;
    background:
      linear-gradient(180deg, rgba(255, 255, 255, 0.05), rgba(255, 255, 255, 0.015)),
      linear-gradient(180deg, #170709 0%, #0b0203 100%);
    border: 1px solid rgba(255, 255, 255, 0.06);
    box-shadow: 0 18px 40px rgba(0, 0, 0, 0.22);
  }

  .pending-card strong {
    display: block;
    margin: 0;
    font-size: 1.75rem;
    text-transform: uppercase;
  }

  .pending-card p {
    margin: 0.8rem 0 0;
    color: rgba(255, 255, 255, 0.72);
    line-height: 1.65;
  }

  .account-my-cases__empty-{{ section.id }} {
    margin-top: 1rem;
    border-radius: 22px;
    padding: 1.75rem;
    background:
      linear-gradient(180deg, rgba(255, 255, 255, 0.05), rgba(255, 255, 255, 0.015)),
      linear-gradient(180deg, #1a090b 0%, #0c0304 100%);
    border: 1px solid rgba(255, 255, 255, 0.06);
    color: rgba(255, 255, 255, 0.8);
    text-align: center;
  }

  .account-my-cases__empty-title-{{ section.id }} {
    margin: 0 0 0.7rem;
    color: #ffffff;
    font-size: 1.8rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .account-my-cases__login-wrap-{{ section.id }} {
    min-height: 56rem;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .account-my-cases__login-panel-{{ section.id }} {
    width: min(68rem, 100%);
    border-radius: 30px;
    padding: 2.4rem;
    text-align: center;
  }

  .account-my-cases__lock-badge-{{ section.id }} {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 3.2rem;
    padding: 0 1rem;
    border-radius: 999px;
    border: 1px solid rgba(223, 64, 83, 0.18);
    background: rgba(223, 64, 83, 0.08);
    color: #f4d6d9;
    font-size: 0.95rem;
    font-weight: 800;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .account-my-cases__login-heading-{{ section.id }} {
    margin: 1.3rem 0 0;
    font-size: clamp(3rem, 5vw, 4.6rem);
    line-height: 0.98;
    text-transform: uppercase;
  }

  .account-my-cases__login-copy-{{ section.id }} {
    max-width: 52rem;
    margin: 1rem auto 0;
    color: rgba(255, 255, 255, 0.74);
    font-size: 1.55rem;
    line-height: 1.7;
  }

  .account-my-cases__login-actions-{{ section.id }} {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 1rem;
    margin-top: 1.8rem;
  }

  .account-my-cases__locked-grid-{{ section.id }} {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1rem;
    margin-top: 1.75rem;
  }

  .account-my-cases__locked-card-{{ section.id }} {
    border-radius: 22px;
    padding: 1.4rem;
    background:
      linear-gradient(180deg, rgba(255, 255, 255, 0.04), rgba(255, 255, 255, 0.015)),
      linear-gradient(180deg, #150607 0%, #080203 100%);
    border: 1px solid rgba(255, 255, 255, 0.05);
  }

  .account-my-cases__locked-title-{{ section.id }} {
    margin: 0;
    font-size: 1.3rem;
    text-transform: uppercase;
  }

  .account-my-cases__locked-copy-{{ section.id }} {
    margin: 0.7rem 0 0;
    color: rgba(255, 255, 255, 0.62);
    line-height: 1.55;
  }

  .account-my-cases__modal-{{ section.id }} {
    position: fixed;
    inset: 0;
    z-index: 9999;
    display: none;
  }

  .account-my-cases__modal-{{ section.id }}.is-open {
    display: block;
  }

  #global-modal-overlay {
    position: fixed;
    inset: 0;
    background: rgba(0, 0, 0, 0.96);
    z-index: 9998;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.2s ease;
  }

  #global-modal-overlay.active {
    opacity: 1;
    pointer-events: auto;
  }

  .account-my-cases__modal-backdrop-{{ section.id }} {
    display: none;
  }

  .account-my-cases__modal-dialog-{{ section.id }} {
    position: fixed;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    z-index: 9999;
    width: min(960px, 94vw);
    max-height: 90vh;
    overflow: hidden;
  }

  .account-my-cases__modal-shell-{{ section.id }} {
    position: relative;
    max-height: calc(90vh - 40px);
    overflow-y: auto;
    border-radius: 28px;
    padding: 2rem 2rem 24px;
  }

  .account-my-cases__modal-close-{{ section.id }} {
    position: absolute;
    top: 1.4rem;
    right: 1.4rem;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 4.2rem;
    height: 4.2rem;
    border: none;
    border-radius: 999px;
    cursor: pointer;
    background: linear-gradient(180deg, rgba(42, 15, 18, 0.96), rgba(18, 7, 8, 0.96));
    color: #ffffff;
    font-size: 2.6rem;
    line-height: 1;
  }

  .account-my-cases__modal-kicker-{{ section.id }} {
    margin: 0 0 0.6rem;
    color: #e3aeb5;
    font-size: 1rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .account-my-cases__modal-heading-{{ section.id }} {
    margin: 0;
    color: #ffffff;
    font-size: clamp(2.6rem, 4vw, 3.8rem);
    line-height: 1.04;
    text-transform: uppercase;
  }

  .account-my-cases__modal-copy-{{ section.id }} {
    margin: 1rem 0 0;
    color: rgba(255, 255, 255, 0.8);
    line-height: 1.6;
  }

  .account-my-cases__modal-selected-{{ section.id }} {
    margin: 1.8rem 0;
    padding: 1.6rem;
    border-radius: 20px;
    background: linear-gradient(180deg, rgba(255, 255, 255, 0.04), rgba(255, 255, 255, 0.015));
    border: 1px solid rgba(255, 255, 255, 0.05);
  }

  .account-my-cases__selected-label-{{ section.id }} {
    color: rgba(255, 255, 255, 0.6);
    font-size: 1rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .account-my-cases__selected-title-{{ section.id }} {
    margin-top: 0.6rem;
    color: #ffffff;
    font-size: 2rem;
    line-height: 1.2;
    text-transform: uppercase;
  }

  .account-my-cases__review-note-{{ section.id }} {
    margin: 0 0 1.8rem;
    padding: 1.4rem 1.6rem;
    border-radius: 18px;
    background: linear-gradient(180deg, rgba(223, 64, 83, 0.12), rgba(223, 64, 83, 0.04));
    border: 1px solid rgba(223, 64, 83, 0.16);
    color: rgba(255, 255, 255, 0.82);
    line-height: 1.6;
  }

  .account-my-cases__panel-grid-{{ section.id }} {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1rem;
    margin: 0 0 1.8rem;
  }

  .account-my-cases__panel-card-{{ section.id }} {
    padding: 1.35rem 1.5rem;
    border-radius: 20px;
    background: linear-gradient(180deg, rgba(255, 255, 255, 0.04), rgba(255, 255, 255, 0.015));
    border: 1px solid rgba(255, 255, 255, 0.05);
  }

  .account-my-cases__panel-card-{{ section.id }}.is-wide {
    grid-column: 1 / -1;
  }

  .account-my-cases__panel-label-{{ section.id }} {
    color: rgba(255, 255, 255, 0.58);
    font-size: 0.95rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .account-my-cases__panel-value-{{ section.id }} {
    margin-top: 0.65rem;
    color: #ffffff;
    font-size: 1.3rem;
    line-height: 1.6;
    word-break: break-word;
  }

  .account-my-cases__panel-section-{{ section.id }} + .account-my-cases__panel-section-{{ section.id }} {
    margin-top: 1.8rem;
    padding-top: 1.8rem;
    border-top: 1px solid rgba(255, 255, 255, 0.06);
  }

  .account-my-cases__panel-title-{{ section.id }} {
    margin: 0;
    color: #ffffff;
    font-size: 1.9rem;
    text-transform: uppercase;
  }

  .account-my-cases__panel-copy-{{ section.id }} {
    margin: 0.75rem 0 0;
    color: rgba(255, 255, 255, 0.74);
    line-height: 1.6;
  }

  .account-my-cases__form-{{ section.id }} {
    display: grid;
    gap: 1.4rem;
  }

  .account-my-cases__field-{{ section.id }} {
    display: flex;
    flex-direction: column;
    gap: 0.8rem;
  }

  .account-my-cases__field-{{ section.id }} label {
    color: #f4d6d9;
    font-size: 1rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .account-my-cases__field-{{ section.id }} input,
  .account-my-cases__field-{{ section.id }} textarea {
    width: 100%;
    min-height: 5rem;
    padding: 1.4rem 1.6rem;
    border-radius: 16px;
    border: 1px solid rgba(255, 255, 255, 0.08);
    background: linear-gradient(180deg, rgba(255, 255, 255, 0.06), rgba(255, 255, 255, 0.02));
    color: #ffffff;
    font-size: 1.4rem;
  }

  .account-my-cases__field-{{ section.id }} textarea {
    min-height: auto;
    resize: vertical;
  }

  .account-my-cases__modal-actions-{{ section.id }} {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    margin-top: 0.4rem;
  }

  @media screen and (max-width: 1199px) {
    .account-my-cases__hero-{{ section.id }},
    .account-my-cases__overview-grid-{{ section.id }} {
      grid-template-columns: 1fr;
    }

    .account-my-cases__stats-{{ section.id }} {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media screen and (max-width: 989px) {
    .account-my-cases__grid-{{ section.id }},
    .account-my-cases__membership-grid-{{ section.id }} {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .account-my-cases__request-grid-{{ section.id }},
    .account-my-cases__locked-grid-{{ section.id }} {
      grid-template-columns: 1fr;
    }
  }

  @media screen and (max-width: 749px) {
    .account-my-cases-{{ section.id }} {
      padding-left: 1rem;
      padding-right: 1rem;
    }

    .account-my-cases__shell-{{ section.id }},
    .account-my-cases__section-{{ section.id }},
    .account-my-cases__hero-panel-{{ section.id }},
    .account-my-cases__hero-side-{{ section.id }},
    .account-my-cases__login-panel-{{ section.id }} {
      padding: 1.4rem;
      border-radius: 24px;
    }

    .account-my-cases__stats-{{ section.id }},
    .account-my-cases__grid-{{ section.id }},
    .account-my-cases__membership-grid-{{ section.id }},
    .account-my-cases__locked-grid-{{ section.id }} {
      grid-template-columns: 1fr;
    }

    .account-my-cases__actions-{{ section.id }},
    .account-my-cases__cta-row-{{ section.id }},
    .account-my-cases__login-actions-{{ section.id }},
    .account-my-cases__modal-actions-{{ section.id }} {
      flex-direction: column;
    }

    .account-my-cases__button-{{ section.id }},
    .account-my-cases__button-secondary-{{ section.id }} {
      width: 100%;
    }

    .account-my-cases__modal-dialog-{{ section.id }} {
      width: min(95vw, 900px);
    }

    .account-my-cases__modal-shell-{{ section.id }} {
      padding: 1.8rem 1.4rem;
      border-radius: 22px;
    }

    .account-my-cases__panel-grid-{{ section.id }} {
      grid-template-columns: 1fr;
    }

    .account-my-cases__panel-card-{{ section.id }}.is-wide {
      grid-column: auto;
    }
  }
{%- endstyle -%}

<div class="account-my-cases-{{ section.id }} section-{{ section.id }}-padding member-area-page">
  <section class="account-my-cases__login-panel-{{ section.id }}" style="margin-bottom: 1.5rem;">
    <div class="account-my-cases__lock-badge-{{ section.id }}">MEMBER AREA</div>
    <h1 class="account-my-cases__login-heading-{{ section.id }} member-title">MEMBER AREA</h1>
    <p class="account-my-cases__login-copy-{{ section.id }} member-subtitle">
      CONTROL YOUR CASES, MEMBERSHIP ACCESS, FOLLOWED ALERTS, AND PROFESSIONAL ROUTING FROM THE STOREFRONT MEMBER AREA.
    </p>
  </section>

  {% if customer %}
    {% assign current_customer_id = customer.id | append: '' %}
    {% assign current_customer_email = customer.email | downcase | strip %}
    {% assign current_customer_tags = customer.tags | join: ',' | downcase %}
    {% assign professional_metafield_status = customer.metafields.custom.professional_verification_status.value | default: customer.metafields.custom.professional_verification_status | default: customer.metafields.custom.professional_status.value | default: customer.metafields.custom.professional_status | default: customer.metafields.missingalerts.professional_verification_status.value | default: customer.metafields.missingalerts.professional_verification_status | default: customer.metafields.missingalerts.professional_status.value | default: customer.metafields.missingalerts.professional_status | append: '' | downcase %}
    {% assign professional_metafield_account_type = customer.metafields.custom.account_type.value | default: customer.metafields.custom.account_type | default: customer.metafields.missingalerts.account_type.value | default: customer.metafields.missingalerts.account_type | append: '' | downcase %}
    {% assign membership_tier_meta = customer.metafields.custom.membership_tier.value | default: customer.metafields.custom.membership_tier | default: customer.metafields.custom.membership_type.value | default: customer.metafields.custom.membership_type | default: customer.metafields.missingalerts.membership_tier.value | default: customer.metafields.missingalerts.membership_tier | default: customer.metafields.missingalerts.membership_type.value | default: customer.metafields.missingalerts.membership_type | append: '' | downcase %}
    {% assign has_professional_tools = false %}
    {% assign has_member_access = false %}
    {% assign has_paid_professional_tier = false %}
    {% assign professional_verified = false %}
    {% assign professional_pending = false %}
    {% assign detected_tier = 'COMMUNITY' %}
    {% for customer_tag in customer.tags %}
      {% assign normalized_customer_tag = customer_tag | downcase | strip %}
      {% if normalized_customer_tag == 'professional' or normalized_customer_tag == 'pro' or normalized_customer_tag == 'professional_pending' or normalized_customer_tag == 'professional_premium' or normalized_customer_tag == 'professional_enterprise' or normalized_customer_tag == 'professional_access' or normalized_customer_tag == 'professional_plus' or normalized_customer_tag == 'professional_elite' or normalized_customer_tag == 'professional_pending_verification' or normalized_customer_tag == 'professional_verified' %}
        {% assign has_professional_tools = true %}
      {% endif %}
    {% endfor %}
    {% if professional_metafield_status contains 'professional' or professional_metafield_account_type contains 'professional' %}
      {% assign has_professional_tools = true %}
    {% endif %}
    {% if current_customer_tags contains 'professional_verified' or professional_metafield_status contains 'approved' or professional_metafield_status contains 'verified' %}
      {% assign professional_verified = true %}
    {% endif %}
    {% if current_customer_tags contains 'professional_pending_verification' or professional_metafield_status contains 'pending' %}
      {% assign professional_pending = true %}
    {% endif %}
    {% if current_customer_tags contains 'professional_elite' or membership_tier_meta contains 'professional_elite' %}
      {% assign detected_tier = 'PROFESSIONAL ELITE' %}
      {% assign has_member_access = true %}
      {% assign has_paid_professional_tier = true %}
      {% assign has_professional_tools = true %}
    {% elsif current_customer_tags contains 'professional_plus' or membership_tier_meta contains 'professional_plus' %}
      {% assign detected_tier = 'PROFESSIONAL PLUS' %}
      {% assign has_member_access = true %}
      {% assign has_paid_professional_tier = true %}
      {% assign has_professional_tools = true %}
    {% elsif current_customer_tags contains 'professional_access' or membership_tier_meta contains 'professional_access' %}
      {% assign detected_tier = 'PROFESSIONAL ACCESS' %}
      {% assign has_member_access = true %}
      {% assign has_paid_professional_tier = true %}
      {% assign has_professional_tools = true %}
    {% elsif current_customer_tags contains 'community_pro' or membership_tier_meta contains 'community_pro' %}
      {% assign detected_tier = 'COMMUNITY PRO' %}
      {% assign has_member_access = true %}
    {% elsif current_customer_tags contains 'community_plus' or membership_tier_meta contains 'community_plus' %}
      {% assign detected_tier = 'COMMUNITY+' %}
      {% assign has_member_access = true %}
    {% elsif current_customer_tags contains 'professional_verified' %}
      {% assign detected_tier = 'PROFESSIONAL VERIFIED' %}
      {% assign has_member_access = true %}
      {% assign has_professional_tools = true %}
    {% endif %}
    {% assign member_area_unlocked = has_member_access %}
    {% assign professional_access_status = 'Pending approval' %}
    {% assign professional_access_note = 'Professional tools stay locked behind approval, verification, and safe inbox rules.' %}
    {% if detected_tier == 'PROFESSIONAL ELITE' %}
      {% assign professional_access_status = 'Professional elite' %}
      {% assign professional_access_note = 'Elite professional access is present, but directory visibility and messaging stay locked until verification is approved.' %}
    {% elsif detected_tier == 'PROFESSIONAL PLUS' %}
      {% assign professional_access_status = 'Professional plus' %}
      {% assign professional_access_note = 'Professional Plus is active, but inbox and verified family contact remain locked until approval is complete.' %}
    {% elsif detected_tier == 'PROFESSIONAL ACCESS' %}
      {% assign professional_access_status = 'Professional access' %}
      {% assign professional_access_note = 'Professional Access is active, but direct contact and public listing still require verification approval.' %}
    {% elsif professional_pending %}
      {% assign professional_access_status = 'Professional pending' %}
      {% assign professional_access_note = 'This professional account is waiting for approval before public listing and direct contact access.' %}
    {% elsif professional_verified %}
      {% assign professional_access_status = 'Professional access detected' %}
      {% assign professional_access_note = 'Professional storefront tools are available here, but direct family contact stays locked until approval and verification checks pass.' %}
    {% endif %}
    {% assign owned_case_count = 0 %}
    {% assign active_case_count = 0 %}
    {% assign resolved_case_count = 0 %}
    {% assign pending_claim_count = 0 %}
    {% assign submitted_case_count = 0 %}
    {% assign pending_submission_count = 0 %}
    {% assign claims_storefront_exposed = false %}
    {% assign submissions_storefront_exposed = false %}
    {% assign member_verification_status = 'Upgrade required' %}
    {% assign member_verification_note = 'This logged-in customer does not yet have an active paid community or professional membership tag for the protected member area.' %}
    {% if current_customer_tags contains 'suspended' or current_customer_tags contains 'rejected' %}
      {% assign member_verification_status = 'Restricted' %}
      {% assign member_verification_note = 'This member account requires support review before protected features can be expanded.' %}
    {% elsif professional_verified %}
      {% assign member_verification_status = 'Approved' %}
      {% assign member_verification_note = 'Protected member features can route through moderated review and safe contact gates.' %}
    {% elsif member_area_unlocked %}
      {% assign member_verification_status = 'Active membership' %}
      {% assign member_verification_note = 'Protected storefront member access is active for this account.' %}
    {% endif %}
    {% capture submitted_case_cards_markup %}
      {% assign storefront_submissions = shop.metaobjects.missingalerts_case_submission.values %}
      {% if storefront_submissions != blank %}
        {% assign submissions_storefront_exposed = true %}
        {% for submission in storefront_submissions %}
          {% assign submission_email = submission.submitter_email.value | default: submission.submitter_email | downcase | strip %}
          {% assign submission_status = submission.status.value | default: submission.status | downcase %}
          {% assign submission_person_name = submission.person_name.value | default: submission.person_name %}
          {% assign submission_country = submission.country.value | default: submission.country %}
          {% assign submission_region = submission.state_region.value | default: submission.state_region %}
          {% assign submission_city = submission.city_town.value | default: submission.city_town %}
          {% assign submission_visibility = submission.visibility_option.value | default: submission.visibility_option %}
          {% if submission_email == current_customer_email %}
            {% assign submitted_case_count = submitted_case_count | plus: 1 %}
            {% if submission_status == 'submitted' or submission_status == 'pending' %}
              {% assign pending_submission_count = pending_submission_count | plus: 1 %}
            {% endif %}
            <article class="account-my-cases__request-card-{{ section.id }}">
              <div class="account-my-cases__request-status-{{ section.id }}">
                {% if submission_status != blank %}
                  {{ submission_status }}
                {% else %}
                  submitted
                {% endif %}
              </div>
              <h3 class="account-my-cases__request-title-{{ section.id }}">
                {% if submission_person_name != blank %}
                  {{ submission_person_name }}
                {% else %}
                  Submitted case
                {% endif %}
              </h3>
              <p class="account-my-cases__request-copy-{{ section.id }}">
                {% if submission_city != blank %}{{ submission_city }}{% endif %}
                {% if submission_region != blank %}
                  {% if submission_city != blank %}, {% endif %}{{ submission_region }}
                {% endif %}
                {% if submission_country != blank %}
                  {% if submission_city != blank or submission_region != blank %}, {% endif %}{{ submission_country }}
                {% endif %}
              </p>
              <p class="account-my-cases__request-copy-{{ section.id }}">
                Visibility:
                {% if submission_visibility != blank %}
                  {{ submission_visibility }}
                {% else %}
                  free
                {% endif %}
              </p>
            </article>
          {% endif %}
        {% endfor %}
      {% endif %}
    {% endcapture %}
    {% capture pending_claim_cards_markup %}
      {% assign storefront_claims = shop.metaobjects.missingalerts_case_claim.values %}
      {% if storefront_claims != blank %}
        {% assign claims_storefront_exposed = true %}
        {% for claim in storefront_claims %}
          {% assign claim_customer_id = claim.claimant_customer_id.value | default: claim.claimant_customer_id | append: '' %}
          {% assign claim_status = claim.status.value | default: claim.status | downcase %}
          {% assign claim_person_name = claim.person_name.value | default: claim.person_name %}
          {% assign claim_linked_case_handle = claim.linked_case_handle.value | default: claim.linked_case_handle %}
          {% assign claim_submitted_at = claim.submitted_at.value | default: claim.submitted_at %}
          {% if claim_customer_id == current_customer_id and claim_status == 'pending' %}
            {% assign pending_claim_count = pending_claim_count | plus: 1 %}
            <article class="account-my-cases__request-card-{{ section.id }}">
              <div class="account-my-cases__request-status-{{ section.id }}">Pending Review</div>
              <h3 class="account-my-cases__request-title-{{ section.id }}">
                {% if claim_person_name != blank %}
                  {{ claim_person_name }}
                {% else %}
                  Claim Request
                {% endif %}
              </h3>
              <p class="account-my-cases__request-copy-{{ section.id }}">
                linked_case_handle:
                {% if claim_linked_case_handle != blank %}
                  {{ claim_linked_case_handle }}
                {% else %}
                  not saved yet
                {% endif %}
              </p>
              <p class="account-my-cases__request-copy-{{ section.id }}">
                status:
                {% if claim_status != blank %}
                  {{ claim_status }}
                {% else %}
                  pending
                {% endif %}
              </p>
              <p class="account-my-cases__request-copy-{{ section.id }}">
                submitted:
                {% if claim_submitted_at != blank %}
                  {{ claim_submitted_at | date: '%d %b %Y %H:%M' }}
                {% else %}
                  not available
                {% endif %}
              </p>
              <div class="account-my-cases__badge-{{ section.id }}">PENDING REVIEW</div>
            </article>
          {% endif %}
        {% endfor %}
      {% endif %}
    {% endcapture %}
    {% assign pending_visible_count = pending_claim_count %}
    {% assign pending_count_uses_submission_fallback = false %}
    {% if claims_storefront_exposed == false and submissions_storefront_exposed and pending_submission_count > pending_visible_count %}
      {% assign pending_visible_count = pending_submission_count %}
      {% assign pending_count_uses_submission_fallback = true %}
    {% endif %}
    {% capture case_cards_markup %}
      {% for article in blogs['missing-persons'].articles %}
        {% assign assigned_member_id = article.metafields.custom.assigned_member_id.value | default: article.metafields.custom.assigned_member_id | append: '' %}
        {% assign owner_status = article.metafields.custom.case_owner_status.value | default: article.metafields.custom.case_owner_status %}
        {% assign case_status = article.metafields.custom.case_status.value | default: article.metafields.custom.case_status | downcase %}
        {% assign case_country = article.metafields.custom.country.value | default: article.metafields.custom.country %}
        {% assign case_region = article.metafields.custom.state_region.value | default: article.metafields.custom.state_region %}
        {% assign case_city = article.metafields.custom.city_town.value | default: article.metafields.custom.city_town %}
        {% assign found_safe = false %}
        {% if case_status == 'found' %}
          {% assign found_safe = true %}
        {% endif %}
        {% assign member_case_title = article.title %}
        {% assign member_case_summary = article.excerpt_or_content | strip_html | strip | truncate: 220 %}
        {% capture member_case_location %}
          {% if case_city != blank %}{{ case_city }}{% endif %}
          {% if case_region != blank %}
            {% if case_city != blank %}, {% endif %}{{ case_region }}
          {% endif %}
          {% if case_country != blank %}
            {% if case_city != blank or case_region != blank %}, {% endif %}{{ case_country }}
          {% endif %}
        {% endcapture %}
        {% assign member_case_location = member_case_location | strip %}
        {% if found_safe %}
          {% assign title_parts = article.title | split: '-' %}
          {% assign title_left = title_parts.first | strip %}
          {% assign title_right = title_parts.last | strip %}
          {% assign first_name = title_left | split: ' ' | first | strip %}
          {% if title_parts.size > 1 and title_right != blank %}
            {% assign member_case_title = first_name | append: ' - ' | append: title_right %}
          {% else %}
            {% assign member_case_title = first_name %}
          {% endif %}
        {% endif %}

        {% if assigned_member_id == current_customer_id %}
          {% assign owned_case_count = owned_case_count | plus: 1 %}
          {% if found_safe %}
            {% assign resolved_case_count = resolved_case_count | plus: 1 %}
          {% else %}
            {% assign active_case_count = active_case_count | plus: 1 %}
          {% endif %}
          <article class="account-my-cases__card-{{ section.id }}">
            <div class="account-my-cases__image-wrap-{{ section.id }}">
              {% if article.image %}
                <img
                  src="{{ article.image | image_url: width: 720 }}"
                  alt="{{ member_case_title | escape }}"
                  class="account-my-cases__image-{{ section.id }}{% if found_safe %} is-found{% endif %}"
                  width="{{ article.image.width }}"
                  height="{{ article.image.height }}"
                >
                {% if found_safe %}
                  <div class="account-my-cases__found-overlay-{{ section.id }}">FOUND SAFE</div>
                {% endif %}
              {% else %}
                <div class="account-my-cases__image-placeholder-{{ section.id }}">No Image</div>
              {% endif %}
            </div>

            <div class="account-my-cases__body-{{ section.id }}">
              {% if found_safe %}
                <div class="account-my-cases__badge-{{ section.id }}">FOUND SAFE</div>
              {% endif %}
              <h3 class="account-my-cases__title-{{ section.id }}">{{ member_case_title }}</h3>

              <div class="account-my-cases__meta-{{ section.id }}">
                <span class="account-my-cases__meta-label-{{ section.id }}">
                  {% if found_safe %}
                    Case Status
                  {% else %}
                    Owner Status
                  {% endif %}
                </span>
                <span class="account-my-cases__meta-value-{{ section.id }}">
                  {% if found_safe %}
                    CASE RESOLVED
                  {% elsif owner_status != blank %}
                    {{ owner_status }}
                  {% else %}
                    Not set
                  {% endif %}
                </span>
              </div>

              <div class="account-my-cases__actions-{{ section.id }}">
                <a href="{{ article.url }}" class="account-my-cases__button-secondary-{{ section.id }}">
                  View Case
                </a>
                {% if found_safe %}
                  <div class="account-my-cases__resolved-{{ section.id }}">CASE RESOLVED</div>
                {% else %}
                  <button
                    type="button"
                    class="account-my-cases__button-{{ section.id }}"
                    data-open-case-panel
                    data-panel-target="update"
                    data-case-title="{{ article.title | escape }}"
                    data-case-handle="{{ article.handle | escape }}"
                    data-requester-customer-id="{{ current_customer_id | escape }}"
                    data-requester-name="{{ customer.name | escape }}"
                    data-requester-email="{{ customer.email | escape }}"
                    data-case-status="{% if owner_status != blank %}{{ owner_status | escape }}{% else %}Active{% endif %}"
                    data-case-location="{{ member_case_location | escape }}"
                    data-case-summary="{{ member_case_summary | escape }}"
                  >
                    UPDATE THIS CASE
                  </button>
                  <button
                    type="button"
                    class="account-my-cases__button-secondary-{{ section.id }}"
                    data-open-case-panel
                    data-panel-target="found"
                    data-case-title="{{ article.title | escape }}"
                    data-case-handle="{{ article.handle | escape }}"
                    data-requester-customer-id="{{ current_customer_id | escape }}"
                    data-requester-name="{{ customer.name | escape }}"
                    data-requester-email="{{ customer.email | escape }}"
                    data-case-status="{% if owner_status != blank %}{{ owner_status | escape }}{% else %}Active{% endif %}"
                    data-case-location="{{ member_case_location | escape }}"
                    data-case-summary="{{ member_case_summary | escape }}"
                  >
                    MARK CASE AS FOUND
                  </button>
                {% endif %}
              </div>
            </div>
          </article>
        {% endif %}
      {% endfor %}
    {% endcapture %}

    {% if request.design_mode %}
      <section class="account-my-cases__login-panel-{{ section.id }}" style="margin-bottom: 1rem;">
        <div class="account-my-cases__lock-badge-{{ section.id }}">THEME EDITOR CHECK</div>
        <h2 class="account-my-cases__login-heading-{{ section.id }}" style="font-size: 1.5rem;">MEMBER ACCESS DETECTION</h2>
        <div class="account-my-cases__locked-grid-{{ section.id }}">
          <article class="account-my-cases__locked-card-{{ section.id }}"><strong>LOGGED IN</strong><p class="account-my-cases__locked-copy-{{ section.id }}">{% if customer %}YES{% else %}NO{% endif %}</p></article>
          <article class="account-my-cases__locked-card-{{ section.id }}"><strong>CUSTOMER EMAIL</strong><p class="account-my-cases__locked-copy-{{ section.id }}">{{ customer.email | default: 'BLANK' }}</p></article>
          <article class="account-my-cases__locked-card-{{ section.id }}"><strong>CUSTOMER TAGS</strong><p class="account-my-cases__locked-copy-{{ section.id }}">{{ current_customer_tags | default: 'NONE' }}</p></article>
          <article class="account-my-cases__locked-card-{{ section.id }}"><strong>DETECTED TIER</strong><p class="account-my-cases__locked-copy-{{ section.id }}">{{ detected_tier }}</p></article>
          <article class="account-my-cases__locked-card-{{ section.id }}"><strong>PROFESSIONAL VERIFIED</strong><p class="account-my-cases__locked-copy-{{ section.id }}">{% if professional_verified %}YES{% else %}NO{% endif %}</p></article>
