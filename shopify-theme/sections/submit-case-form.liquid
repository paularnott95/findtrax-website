</style>
<script>
(function() {
  var sectionId = {{ section.id | json }};
  var form = document.getElementById('case-submit-form-' + sectionId);
  if (!form) return;

  var modeInput = form.querySelector('[data-submission-mode]');
  var selectedClaimInput = form.querySelector('[data-selected-claim-case]');
  var claimantCustomerIdInput = form.querySelector('[data-claimant-customer-id]');
  var steps = Array.prototype.slice.call(form.querySelectorAll('[data-step]'));
  var stepBackBtn = form.querySelector('[data-step-back]');
  var stepNextBtn = form.querySelector('[data-step-next]');
  var progressFill = form.closest('.case-submit-shell').querySelector('[data-progress-fill]');
  var progressSteps = Array.prototype.slice.call(
    form.closest('.case-submit-shell').querySelectorAll('[data-progress-step]')
  );
  var modeButtons = Array.prototype.slice.call(
    form.closest('.case-submit-shell').querySelectorAll('[data-case-mode]')
  );
  var matchNameInput = form.querySelector('[data-match-name]');
  var matchAgeInput = form.querySelector('[data-match-age]');
  var matchCountryInput = form.querySelector('[data-match-country]');
  var matchRegionInput = form.querySelector('[data-match-region]');
  var matchCityInput = form.querySelector('[data-match-city]');
  var matchEmpty = form.querySelector('[data-submit-match-empty]');
  var matchResults = form.querySelector('[data-submit-match-results]');
  var matchCards = Array.prototype.slice.call(form.querySelectorAll('[data-submit-match-card]'));
  var claimSelectedUI = form.querySelector('[data-claim-selected-ui]');
  var claimSelectedTitle = form.querySelector('[data-claim-selected-title]');
  var upsellCards = Array.prototype.slice.call(form.querySelectorAll('[data-upsell-card]'));

  var reviewMode = form.querySelector('[data-review-mode]');
  var reviewName = form.querySelector('[data-review-name]');
  var reviewLocation = form.querySelector('[data-review-location]');
  var reviewVisibility = form.querySelector('[data-review-visibility]');
  var reviewProfessional = form.querySelector('[data-review-professional]');

  var currentStep = 1;
  var maxStep = 6;
  var claimLoginRequired = {% if customer %}false{% else %}true{% endif %};

  function normalize(str) {
    return (str || '').toString().trim().toLowerCase();
  }

  function getFieldValue(name) {
    var field = form.querySelector('[name="' + name + '"]');
    return field && field.value ? field.value : '';
  }

  function getFileName(name) {
    var field = form.querySelector('[name="' + name + '"]');
    if (field && field.files && field.files[0] && field.files[0].name) {
      return field.files[0].name;
    }
    return '';
  }

  function setInputValueAndNotify(input, selectedValue) {
    if (!input) return;

    input.value = selectedValue;
    input.dispatchEvent(new Event('input', { bubbles: true }));
    input.dispatchEvent(new Event('change', { bubbles: true }));
  }

  function resolveSuggestionTarget(targetKey) {
    if (!targetKey) return null;

    var selectorMatch = null;

    try {
      selectorMatch = form.querySelector(targetKey);
    } catch (error) {
      selectorMatch = null;
    }

    return (
      selectorMatch ||
      form.querySelector('[name="' + targetKey + '"]') ||
      form.querySelector('[data-suggestion-field="' + targetKey + '"]')
    );
  }

  function findClaimCardByHandleOrTitle(value) {
    var normalizedValue = normalize(value);
    if (!normalizedValue) return null;

    for (var i = 0; i < matchCards.length; i++) {
      var card = matchCards[i];
      var cardHandle = normalize(card.getAttribute('data-match-handle'));
      var cardTitle = normalize(card.getAttribute('data-match-title'));

      if (cardHandle === normalizedValue || cardTitle === normalizedValue) {
        return card;
      }
    }

    return null;
  }

  function updateMode(mode) {
    if (mode === 'claim_case' && claimLoginRequired) {
      mode = 'new_case';
    }

    if (modeInput) modeInput.value = mode;
    if (claimantCustomerIdInput && mode === 'claim_case') {
      claimantCustomerIdInput.value = String(claimantCustomerIdInput.value || '').trim();
    }

    modeButtons.forEach(function(btn) {
      btn.classList.toggle('is-active', btn.getAttribute('data-case-mode') === mode);
    });

    if (reviewMode) {
      reviewMode.textContent = mode === 'claim_case'
        ? 'Claim existing case request'
        : 'New case submission';
    }
  }

  function updateStepFieldState() {
    steps.forEach(function(step) {
      var isActive = step.classList.contains('is-active');
      var fields = step.querySelectorAll('input, select, textarea, button');

      fields.forEach(function(field) {
        if (field.type === 'hidden') return;
        if (field.hasAttribute('data-step-back') || field.hasAttribute('data-step-next')) return;

        if (!isActive && field.tagName !== 'BUTTON') {
          field.setAttribute('data-was-disabled-by-step', 'true');
          field.disabled = true;
        } else if (isActive && field.hasAttribute('data-was-disabled-by-step')) {
          field.disabled = false;
          field.removeAttribute('data-was-disabled-by-step');
        }
      });
    });
  }

  function showStep(stepNumber) {
    currentStep = Math.max(1, Math.min(maxStep, stepNumber));

    steps.forEach(function(step) {
      step.classList.toggle(
        'is-active',
        parseInt(step.getAttribute('data-step'), 10) === currentStep
      );
    });

    progressSteps.forEach(function(stepEl, index) {
      stepEl.classList.toggle('is-active', index < currentStep);
    });

    if (progressFill) {
      progressFill.style.width = ((currentStep / maxStep) * 100) + '%';
    }

    if (stepBackBtn) {
      stepBackBtn.classList.toggle('is-hidden', currentStep === 1);
    }

    if (stepNextBtn) {
      stepNextBtn.classList.toggle('is-hidden', currentStep === maxStep);
    }

    updateStepFieldState();

    if (currentStep === 6) {
      updateReview();
    }
  }

  function runMatchCheck() {
    var nameVal = normalize(matchNameInput && matchNameInput.value);
    var ageVal = normalize(matchAgeInput && matchAgeInput.value);
    var countryVal = normalize(matchCountryInput && matchCountryInput.value);
    var regionVal = normalize(matchRegionInput && matchRegionInput.value);
    var cityVal = normalize(matchCityInput && matchCityInput.value);

    if (!nameVal || nameVal.length < 3) {
      if (matchEmpty) matchEmpty.classList.remove('is-hidden');
      if (matchResults) matchResults.classList.add('is-hidden');
      matchCards.forEach(function(card) {
        card.classList.add('is-hidden');
      });
      return;
    }

    var visibleCount = 0;

    matchCards.forEach(function(card) {
      var cardTitle = normalize(card.getAttribute('data-match-title'));
      var cardAge = normalize(card.getAttribute('data-match-age'));
      var cardCountry = normalize(card.getAttribute('data-match-country'));
      var cardRegion = normalize(card.getAttribute('data-match-region'));
      var cardCity = normalize(card.getAttribute('data-match-city'));

      var nameMatch = cardTitle.indexOf(nameVal) !== -1 || nameVal.indexOf(cardTitle) !== -1;
      var ageMatch = !ageVal || !cardAge || cardAge === ageVal;
      var countryMatch = !countryVal || !cardCountry || cardCountry.indexOf(countryVal) !== -1 || countryVal.indexOf(cardCountry) !== -1;
      var regionMatch = !regionVal || !cardRegion || cardRegion.indexOf(regionVal) !== -1 || regionVal.indexOf(cardRegion) !== -1;
      var cityMatch = !cityVal || !cardCity || cardCity.indexOf(cityVal) !== -1 || cityVal.indexOf(cardCity) !== -1;

      if (nameMatch && ageMatch && countryMatch && regionMatch && cityMatch) {
        card.classList.remove('is-hidden');
        visibleCount += 1;
      } else {
        card.classList.add('is-hidden');
      }
    });

    if (visibleCount > 0) {
      if (matchEmpty) matchEmpty.classList.add('is-hidden');
      if (matchResults) matchResults.classList.remove('is-hidden');
    } else {
      if (matchEmpty) {
        matchEmpty.classList.remove('is-hidden');
        var title = matchEmpty.querySelector('.case-submit-match-empty-title');
        var text = matchEmpty.querySelector('p');
        if (title) title.textContent = 'NO LIKELY MATCH FOUND';
        if (text) {
          text.textContent = 'No likely manual unassigned case was found from the details entered. You can continue with a new case submission.';
        }
      }
      if (matchResults) matchResults.classList.remove('is-hidden');
    }
  }

  function updateReview() {
    if (reviewMode) {
      reviewMode.textContent = modeInput && modeInput.value === 'claim_case'
        ? 'Claim existing case request'
        : 'New case submission';
    }

    if (reviewName) {
      var personName = form.querySelector('[name="person_name"]');
      reviewName.textContent = (personName && personName.value) ? personName.value : '—';
    }

    if (reviewLocation) {
      var country = form.querySelector('[name="country"]');
      var region = form.querySelector('[name="state_region"]');
      var city = form.querySelector('[name="city_town"]');
      var bits = [];

      if (city && city.value) bits.push(city.value);
      if (region && region.value) bits.push(region.value);
      if (country && country.value) bits.push(country.value);

      reviewLocation.textContent = bits.length ? bits.join(', ') : '—';
    }

    if (reviewVisibility) {
      var selectedVisibility = form.querySelector('input[name="visibility_option"]:checked');
      var map = {
        free: 'Free listing',
        boost: 'Boosted appeal',
        spotlight: 'Spotlight feature'
      };
      reviewVisibility.textContent = selectedVisibility
        ? (map[selectedVisibility.value] || selectedVisibility.value)
        : 'Free listing';
    }

    if (reviewProfessional) {
      var professional = form.querySelector('[name="professional_contact_opt_in"]');
      reviewProfessional.textContent = professional && professional.value === 'yes'
        ? 'Requested — remains locked until verification approval'
        : 'Not requested';
    }
  }

  function normalizeClaimHandle(value) {
    var normalized = String(value || '').trim().toLowerCase();

    if (normalized.indexOf('missing-persons/') === 0) {
      normalized = normalized.slice('missing-persons/'.length);
    }

    return normalized;
  }

  function prefillFromUrl() {
    var params = new URLSearchParams(window.location.search);
    if (!params.toString()) return;

    var mode = params.get('mode');
    var personName = params.get('person_name');
    var personAge = params.get('person_age');
    var country = params.get('country');
    var stateRegion = params.get('state_region');
    var cityTown = params.get('city_town');

    if (mode === 'claim_case' || mode === 'new_case') {
      updateMode(mode);
    }

    if (personName) {
      var personNameField = form.querySelector('[name="person_name"]');
      if (personNameField) personNameField.value = personName;
    }

    if (personAge) {
      var personAgeField = form.querySelector('[name="person_age"]');
      if (personAgeField) personAgeField.value = personAge;
    }

    if (country) {
      var countryField = form.querySelector('[name="country"]');
      if (countryField) countryField.value = country;
    }

    if (stateRegion) {
      var stateRegionField = form.querySelector('[name="state_region"]');
      if (stateRegionField) stateRegionField.value = stateRegion;
    }

    if (cityTown) {
      var cityTownField = form.querySelector('[name="city_town"]');
      if (cityTownField) cityTownField.value = cityTown;
    }

    runMatchCheck();
    updateReview();
  }

  function validateCurrentFlow() {
    var requiredFields = [
      { name: 'person_name', label: 'missing person full name' },
      { name: 'submitter_email', label: 'email address' }
    ];

    if (modeInput && modeInput.value !== 'claim_case') {
      requiredFields.push({ name: 'person_age', label: 'age' });
    }

    if (modeInput && modeInput.value === 'claim_case') {
      requiredFields.push({ name: 'selected_claim_case', label: 'an existing case to claim' });
      requiredFields.push({ name: 'claimant_customer_id', label: 'your logged-in member account' });
    }

    for (var i = 0; i < requiredFields.length; i++) {
      var fieldInfo = requiredFields[i];
      var field = form.querySelector('[name="' + fieldInfo.name + '"]');

      if (!field || !field.value || !String(field.value).trim()) {
        alert('Please complete ' + fieldInfo.label + '.');
        return false;
      }
    }

    var finalConfirm = form.querySelector('[name="final_confirm"]');
    if (finalConfirm && !finalConfirm.checked) {
      alert('Please tick the final confirmation box.');
      return false;
    }

    return true;
  }

  modeButtons.forEach(function(btn) {
    btn.addEventListener('click', function() {
      updateMode(btn.getAttribute('data-case-mode'));
    });
  });

  [matchNameInput, matchAgeInput, matchCountryInput, matchRegionInput, matchCityInput].forEach(function(input) {
    if (!input) return;
    input.addEventListener('input', runMatchCheck);
    input.addEventListener('change', runMatchCheck);
  });

  form.addEventListener('click', function(event) {
    var button = event.target.closest(
      '[data-suggestion-target][data-suggestion-value], [data-fill-target][data-fill-value], [data-input-target][data-input-value]'
    );

    if (!button || !form.contains(button)) return;

    var targetKey =
      button.getAttribute('data-suggestion-target') ||
      button.getAttribute('data-fill-target') ||
      button.getAttribute('data-input-target') ||
      '';
    var selectedValue =
      button.getAttribute('data-suggestion-value') ||
      button.getAttribute('data-fill-value') ||
      button.getAttribute('data-input-value') ||
      '';
    var input = resolveSuggestionTarget(targetKey);

    if (!input) return;

    event.preventDefault();
    setInputValueAndNotify(input, selectedValue);
  });

  form.querySelectorAll('[data-select-claim-case]').forEach(function(btn) {
    btn.addEventListener('click', function() {
      var rawHandle = btn.getAttribute('data-claim-handle') || btn.getAttribute('data-select-claim-case') || '';
      var claimHandle = normalizeClaimHandle(rawHandle);
      var claimTitle = btn.getAttribute('data-claim-title') || 'Selected existing case';

      if (!claimHandle) {
        alert('No claim case was selected. Click CLAIM THIS CASE on a case card first.');
        return;
      }

      updateMode('claim_case');

      if (selectedClaimInput) {
        selectedClaimInput.value = claimHandle;
      }

      if (claimSelectedTitle) {
        claimSelectedTitle.textContent = claimTitle;
      }

      if (claimSelectedUI) {
        claimSelectedUI.classList.remove('is-hidden');
      }
    });
  });

  upsellCards.forEach(function(card) {
    card.addEventListener('click', function() {
      upsellCards.forEach(function(c) {
        c.classList.remove('is-selected');
      });
      card.classList.add('is-selected');
      var radio = card.querySelector('input[type="radio"]');
      if (radio) radio.checked = true;
    });
  });

  if (stepBackBtn) {
    stepBackBtn.addEventListener('click', function() {
      showStep(currentStep - 1);
    });
  }

  if (stepNextBtn) {
    stepNextBtn.addEventListener('click', function() {
      showStep(currentStep + 1);
    });
  }

  form.addEventListener('submit', async function(e) {
    e.preventDefault();
    updateReview();

    if (!validateCurrentFlow()) {
      return;
    }

    var temporarilyEnabled = [];
    var disabledFields = form.querySelectorAll('input:disabled, select:disabled, textarea:disabled');

    disabledFields.forEach(function(field) {
      if (field.type === 'hidden') return;
      field.disabled = false;
      temporarilyEnabled.push(field);
    });

    var formData = new FormData(form);
    var payload = {};
    var currentMode = modeInput && modeInput.value ? modeInput.value : 'new_case';

    if (currentMode === 'claim_case') {
      payload.submission_mode = 'claim_case';
      payload.selected_claim_case = normalizeClaimHandle(selectedClaimInput ? selectedClaimInput.value : '');
      payload.linked_case_handle = payload.selected_claim_case;
      payload.claimant_customer_id = String(claimantCustomerIdInput ? claimantCustomerIdInput.value : '').trim();
      payload.person_name = getFieldValue('person_name');
      payload.submitter_name = getFieldValue('submitter_name');
      payload.submitter_email = getFieldValue('submitter_email');
      payload.submitter_phone = getFieldValue('submitter_phone');
      payload.relationship_to_person = getFieldValue('relationship_to_person');
      payload.circumstances = getFieldValue('circumstances');
      payload.no_reference_reason = getFieldValue('no_reference_reason');
      payload.claim_proof = getFileName('claim_proof');
      console.log('CLAIM FINAL SUBMIT PAYLOAD', payload);

      if (!payload.selected_claim_case) {
        temporarilyEnabled.forEach(function(field) {
          field.disabled = true;
        });
        alert('No claim case was selected. Click CLAIM THIS CASE on a case card first.');
        return;
      }

      if (!String(payload.claimant_customer_id || '').trim()) {
        temporarilyEnabled.forEach(function(field) {
          field.disabled = true;
        });
        alert('You must be logged in to claim an existing case.');
        return;
      }

      if (!/^[a-z0-9-]+$/.test(payload.selected_claim_case)) {
        temporarilyEnabled.forEach(function(field) {
          field.disabled = true;
        });
        alert('Claim handle is invalid. It must be a raw article handle only.');
        return;
      }

      if (!/^\d+$/.test(payload.claimant_customer_id)) {
        temporarilyEnabled.forEach(function(field) {
          field.disabled = true;
        });
        alert('Claim customer id is missing or invalid.');
        return;
      }
    } else {
      formData.forEach(function(value, key) {
        if (value instanceof File) {
          if (value && value.name) {
            payload[key] = value.name;
          }
        } else {
          payload[key] = value;
        }
      });
    }

    temporarilyEnabled.forEach(function(field) {
      field.disabled = true;
    });

    try {
      var response = await fetch('https://dashboard-ui-snowy-eight.vercel.app/api/case-submit', {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json'
        },
        body: JSON.stringify(payload)
      });

      var result = await response.json();

      if (!response.ok || !result.ok) {
        console.error('API response error:', result);
        throw new Error(result.error || 'Submission failed');
      }

      var successMessage = 'Case submitted successfully. Reference: ' + result.id;
      if (result.professionalHelpMessage) {
        successMessage += '\n\n' + result.professionalHelpMessage;
      }
      alert(successMessage);
      form.reset();

      if (selectedClaimInput) selectedClaimInput.value = '';
      if (claimSelectedUI) claimSelectedUI.classList.add('is-hidden');
      if (claimSelectedTitle) claimSelectedTitle.textContent = 'Selected existing case';

      showStep(1);
      updateMode('new_case');
    } catch (error) {
      console.error(error);
      alert('Submission error: ' + (error.message || 'Unknown error'));
    }
  });

  showStep(1);
  updateMode('new_case');
  prefillFromUrl();
})();
</script>

