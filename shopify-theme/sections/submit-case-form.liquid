{% comment %}
UNIT 2 — FULL SUBMIT / CLAIM CASE MULTI-STEP FORM

WHAT THIS BUILDS
- Full premium multi-step submission page section
- Supports two modes:
  1) New case submission
  2) Claim an existing manual case
- Includes structured location fields for worldwide future alert segmentation
- Includes verification gate and professional contact lock wording
- Includes Boost / Spotlight upsell after details are entered
- Includes review step before submit

IMPORTANT
- This is frontend structure + data fields + UX flow.
- Real submission saving, member linking, review queue, payments, and admin workflows come next.
- For now this gives you the full guided UI as one complete section.

RECOMMENDED USE
- Put this on a dedicated page template, e.g. page.submit-case
- Link the modal from Unit 1 to this page later, or embed this directly if preferred
{% endcomment %}

<section class="case-submit-system" id="case-submit-system-{{ section.id }}">
  <div class="case-submit-shell">
    <div class="case-submit-shell-border"></div>
    <div class="case-submit-shell-glow"></div>
    <div class="case-submit-shell-noise"></div>

    <div class="case-submit-topbar">
      <div class="case-submit-top-pill">SUBMIT A CASE</div>
      <div class="case-submit-top-status">REVIEWED BEFORE PUBLICATION</div>
    </div>

    <div class="case-submit-header">
      <div class="case-submit-header-copy">
        <div class="case-submit-kicker">MISSING ALERTS CASE SUBMISSION</div>
        <h1>SUBMIT OR CLAIM A CASE</h1>
        <p>
          Submit a missing person case for review, or request ownership of an existing case already published on the website.
          Please report the case to police first where possible.
        </p>
      </div>

      <div class="case-submit-help-card">
        <div class="case-submit-help-title">IMPORTANT</div>
        <p>Only verified direct family, guardians, or authorised case owners can unlock professional contact features. Public uploaders can still submit cases for review.</p>
      </div>
    </div>

    <div class="case-submit-mode-row">
      <button type="button" class="case-submit-mode-btn is-active" data-case-mode="new_case">SUBMIT A NEW CASE</button>
      {% if customer %}
        <button type="button" class="case-submit-mode-btn" data-case-mode="claim_case">CLAIM AN EXISTING CASE</button>
      {% else %}
        <button type="button" class="case-submit-mode-btn" disabled aria-disabled="true">CLAIM AN EXISTING CASE</button>
      {% endif %}
    </div>
    {% unless customer %}
      <p class="case-submit-intro">Login required to claim an existing case. You can still submit a new case for review.</p>
    {% endunless %}

    <div class="case-submit-progress">
      <div class="case-submit-progress-bar">
        <span data-progress-fill></span>
      </div>
      <div class="case-submit-progress-steps">
        <span class="is-active" data-progress-step="1">BASIC INFO</span>
        <span data-progress-step="2">LOCATION</span>
        <span data-progress-step="3">DETAILS</span>
        <span data-progress-step="4">VERIFICATION</span>
        <span data-progress-step="5">VISIBILITY</span>
        <span data-progress-step="6">REVIEW</span>
      </div>
    </div>

    <form class="case-submit-form" id="case-submit-form-{{ section.id }}" novalidate>
      <input type="hidden" name="submission_mode" value="new_case" data-submission-mode>
      <input type="hidden" name="selected_claim_case" value="" data-selected-claim-case>
      <input type="hidden" name="claimant_customer_id" value="{% if customer %}{{ customer.id | append: '' }}{% endif %}" data-claimant-customer-id>

      <!-- STEP 1 -->
      <div class="case-submit-step is-active" data-step="1">
        <div class="case-submit-step-grid">
          <div class="case-submit-card case-submit-main-card">
            <div class="case-submit-kicker">STEP 1 OF 6</div>
            <h2>BASIC CASE INFORMATION</h2>
            <p class="case-submit-intro">Start with the key details we need to identify the person and check for possible existing matches.</p>

            <div class="case-submit-grid two-up">
              <div class="case-submit-field full">
                <label for="person_name_{{ section.id }}">MISSING PERSON FULL NAME *</label>
                <input type="text" id="person_name_{{ section.id }}" name="person_name" placeholder="Enter full name" required data-match-name>
              </div>

              <div class="case-submit-field">
                <label for="person_age_{{ section.id }}">AGE *</label>
          <input type="number" id="person_age_{{ section.id }}" name="person_age" min="0" max="120" placeholder="Age" required data-match-age>
              </div>

              <div class="case-submit-field">
                <label for="person_gender_{{ section.id }}">GENDER / DESCRIPTOR</label>
                <select id="person_gender_{{ section.id }}" name="person_gender">
                  <option value="">Select option</option>
                  <option>Boy</option>
                  <option>Girl</option>
                  <option>Man</option>
                  <option>Woman</option>
                  <option>Male</option>
                  <option>Female</option>
                  <option>Non-binary</option>
                  <option>Prefer not to say</option>
                </select>
              </div>

              <div class="case-submit-field">
                <label for="main_photo_{{ section.id }}">MAIN PHOTO *</label>
                <input type="file" id="main_photo_{{ section.id }}" name="main_photo" accept="image/*" required>
                <small>One main image keeps the upload process fast and easier to review.</small>
              </div>

              <div class="case-submit-field">
                <label for="last_seen_date_{{ section.id }}">DATE LAST SEEN *</label>
                <input type="date" id="last_seen_date_{{ section.id }}" name="last_seen_date" required>
              </div>

              <div class="case-submit-field">
                <label for="last_seen_time_{{ section.id }}">TIME LAST SEEN</label>
                <input type="time" id="last_seen_time_{{ section.id }}" name="last_seen_time">
              </div>
            </div>
          </div>

          <div class="case-submit-card case-submit-side-card">
            <div class="case-submit-kicker">MATCH CHECK</div>
            <h3>POSSIBLE EXISTING CASES</h3>
            <p>When a likely existing case is found, the user can claim it instead of creating a duplicate.</p>

            <div class="case-submit-match-empty" data-submit-match-empty>
              <div class="case-submit-match-empty-icon">⌕</div>
              <div class="case-submit-match-empty-title">NO MATCH CHECK YET</div>
              <p>Start typing the person’s name to look for existing manual unassigned cases.</p>
            </div>

            <div class="case-submit-match-results is-hidden" data-submit-match-results>
              {% assign unit2_claim_count = 0 %}
              {% for article in blogs['missing-persons'].articles limit: 18 %}
                {% assign source = article.metafields.custom.case_source.value | default: article.metafields.custom.case_source | downcase %}
                {% assign owner_status = article.metafields.custom.case_owner_status.value | default: article.metafields.custom.case_owner_status | downcase %}
                {% assign assigned_member_id = article.metafields.custom.assigned_member_id.value | default: article.metafields.custom.assigned_member_id | append: '' %}
                {% assign case_status = article.metafields.custom.case_status.value | default: article.metafields.custom.case_status | downcase %}
                {% assign case_age = article.metafields.custom.age.value | default: article.metafields.custom.age %}
                {% assign country = article.metafields.custom.country.value | default: article.metafields.custom.country %}
                {% assign state_region = article.metafields.custom.state_region.value | default: article.metafields.custom.state_region %}
                {% assign city = article.metafields.custom.city_town.value | default: article.metafields.custom.city_town %}

                {% assign candidate_allowed = true %}

                {% if case_status == 'found' or case_status == 'resolved' %}
                  {% assign candidate_allowed = false %}
                {% endif %}

                {% if assigned_member_id != blank %}
                  {% assign candidate_allowed = false %}
                {% endif %}

                {% if owner_status contains 'assigned' or owner_status contains 'claimed' or owner_status contains 'verified' or owner_status contains 'resolved' %}
                  {% assign candidate_allowed = false %}
                {% endif %}

                {% if candidate_allowed == true and unit2_claim_count < 4 %}
                  {% assign unit2_claim_count = unit2_claim_count | plus: 1 %}
                  <div class="case-submit-match-card is-hidden"
                       data-submit-match-card
                       data-match-title="{{ article.title | strip_html | escape }}"
                       data-match-handle="{{ article.handle | escape }}"
                       data-match-age="{{ case_age | escape }}"
                       data-match-country="{{ country | escape }}"
                       data-match-region="{{ state_region | escape }}"
                       data-match-city="{{ city | escape }}"
                       data-match-url="{{ article.url | escape }}">
                    <div class="case-submit-match-image-wrap">
                      {% if article.image %}
                        <img src="{{ article.image | image_url: width: 420 }}" alt="{{ article.title | escape }}" class="case-submit-match-image" width="{{ article.image.width }}" height="{{ article.image.height }}">
                      {% else %}
                        <div class="case-submit-match-image-placeholder">NO IMAGE</div>
                      {% endif %}
                    </div>
                    <div class="case-submit-match-body">
                      <div class="case-submit-match-tag">LIKELY MATCH</div>
                      <h4>{{ article.title }}</h4>
                      <div class="case-submit-match-meta">
                        {% if case_age != blank %}<span>AGE {{ case_age }}</span>{% endif %}
                        {% if country != blank %}<span>{{ country }}</span>{% endif %}
                        {% if city != blank %}<span>{{ city }}</span>{% endif %}
                      </div>
                      <div class="case-submit-match-actions">
                        {% if customer %}
                          <button type="button" class="case-submit-claim-select" data-select-claim-case="{{ article.handle | escape }}" data-claim-title="{{ article.title | escape }}" data-claim-handle="{{ article.handle | escape }}">CLAIM THIS CASE</button>
                        {% else %}
                          <a href="{{ routes.account_login_url }}" class="case-submit-claim-select">LOGIN REQUIRED</a>
                        {% endif %}
                        <a href="{{ article.url }}" target="_blank" rel="noopener">VIEW</a>
                      </div>
                    </div>
                  </div>
                {% endif %}
              {% endfor %}
            </div>

            <div class="case-submit-claim-selected is-hidden" data-claim-selected-ui>
              <div class="case-submit-claim-selected-label">CLAIM MODE ACTIVE</div>
              <div class="case-submit-claim-selected-title" data-claim-selected-title>Selected existing case</div>
              <p>This existing manual case will be linked to the account after review instead of creating a duplicate.</p>
            </div>
          </div>
        </div>
      </div>

      <!-- STEP 2 -->
      <div class="case-submit-step" data-step="2">
        <div class="case-submit-card case-submit-main-card">
          <div class="case-submit-kicker">STEP 2 OF 6</div>
          <h2>STRUCTURED LOCATION DETAILS</h2>
          <p class="case-submit-intro">These fields are important for future country, region, and city-based alert systems.</p>

          <div class="case-submit-grid two-up">
            <div class="case-submit-field full">
              {% render 'location-selector',
                id: 'submit-case-form',
                country_name: 'country',
                region_name: 'state_region',
                city_name: 'city_town',
                country_data_attr: 'data-match-country',
                region_data_attr: 'data-match-region',
                city_data_attr: 'data-match-city'
              %}
            </div>

            <div class="case-submit-field">
              <label for="last_seen_area_{{ section.id }}">LAST SEEN AREA *</label>
              <input type="text" id="last_seen_area_{{ section.id }}" name="last_seen_area" placeholder="Street, district, station, park, centre, etc." required>
            </div>

            <div class="case-submit-field">
              <label for="postcode_zip_{{ section.id }}">POSTCODE / ZIP</label>
              <input type="text" id="postcode_zip_{{ section.id }}" name="postcode_zip" placeholder="Optional">
            </div>

            <div class="case-submit-field full">
              <label for="linked_locations_{{ section.id }}">LINKED LOCATIONS / TRAVEL LINKS</label>
              <textarea id="linked_locations_{{ section.id }}" name="linked_locations" rows="4" placeholder="List any other towns, cities, countries, transport routes or areas the person may be linked to."></textarea>
            </div>
          </div>
        </div>
      </div>

      <!-- STEP 3 -->
      <div class="case-submit-step" data-step="3">
        <div class="case-submit-card case-submit-main-card">
          <div class="case-submit-kicker">STEP 3 OF 6</div>
          <h2>PERSON AND CASE DETAILS</h2>
          <p class="case-submit-intro">Small details can matter and may help someone recognise the person faster.</p>

          <div class="case-submit-grid two-up">
            <div class="case-submit-field full">
              <label for="physical_description_{{ section.id }}">PHYSICAL DESCRIPTION</label>
              <textarea id="physical_description_{{ section.id }}" name="physical_description" rows="4" placeholder="Height, build, hair, eyes, distinguishing features, glasses, tattoos, accent, etc."></textarea>
            </div>

            <div class="case-submit-field full">
              <label for="clothing_last_seen_{{ section.id }}">CLOTHING WHEN LAST SEEN</label>
              <textarea id="clothing_last_seen_{{ section.id }}" name="clothing_last_seen" rows="4" placeholder="What were they wearing when last seen?"></textarea>
            </div>

            <div class="case-submit-field full">
              <label for="circumstances_{{ section.id }}">WHAT HAPPENED? *</label>
              <textarea id="circumstances_{{ section.id }}" name="circumstances" rows="5" placeholder="Explain the situation and any urgent circumstances." required></textarea>
            </div>

            <div class="case-submit-field">
              <label for="transport_info_{{ section.id }}">TRANSPORT / VEHICLE INFO</label>
              <input type="text" id="transport_info_{{ section.id }}" name="transport_info" placeholder="Train, bus, car, registration, etc.">
            </div>

            <div class="case-submit-field">
              <label for="languages_spoken_{{ section.id }}">LANGUAGES SPOKEN</label>
              <input type="text" id="languages_spoken_{{ section.id }}" name="languages_spoken" placeholder="Optional">
            </div>

            <div class="case-submit-field">
              <label for="welfare_concern_{{ section.id }}">WELFARE / VULNERABILITY CONCERN</label>
              <select id="welfare_concern_{{ section.id }}" name="welfare_concern">
                <option value="">Select option</option>
                <option>High concern</option>
                <option>Concern for welfare</option>
                <option>Medical vulnerability</option>
                <option>Mental health concern</option>
                <option>Child / young person concern</option>
                <option>Other concern</option>
              </select>
            </div>

            <div class="case-submit-field">
              <label for="with_belongings_{{ section.id }}">PHONE / MONEY / BELONGINGS LEFT BEHIND?</label>
              <input type="text" id="with_belongings_{{ section.id }}" name="with_belongings" placeholder="Optional details">
            </div>
          </div>
        </div>
      </div>

      <!-- STEP 4 -->
      <div class="case-submit-step" data-step="4">
        <div class="case-submit-step-grid single-wide">
          <div class="case-submit-card case-submit-main-card">
            <div class="case-submit-kicker">STEP 4 OF 6</div>
            <h2>VERIFICATION AND CONTACT DETAILS</h2>
            <p class="case-submit-intro">This helps protect the platform and ensures professional contact features are only unlocked for verified case owners.</p>

            <div class="case-submit-grid two-up">
              <div class="case-submit-field">
                <label for="submitter_name_{{ section.id }}">YOUR FULL NAME *</label>
                <input type="text" id="submitter_name_{{ section.id }}" name="submitter_name" required>
              </div>

              <div class="case-submit-field">
                <label for="submitter_email_{{ section.id }}">EMAIL ADDRESS *</label>
              <input type="email" id="submitter_email_{{ section.id }}" name="submitter_email" required>
              </div>

              <div class="case-submit-field">
                <label for="submitter_phone_{{ section.id }}">PHONE NUMBER *</label>
                <input type="tel" id="submitter_phone_{{ section.id }}" name="submitter_phone" required>
              </div>

              <div class="case-submit-field">
                <label for="relationship_to_person_{{ section.id }}">RELATIONSHIP TO THE MISSING PERSON *</label>
                <select id="relationship_to_person_{{ section.id }}" name="relationship_to_person" required>
                  <option value="">Select relationship</option>
                  <option>Parent</option>
                  <option>Guardian</option>
                  <option>Close family member</option>
                  <option>Authorised by family</option>
                  <option>Concerned member of the public</option>
                  <option>Friend</option>
                  <option>Other</option>
                </select>
              </div>

              <div class="case-submit-field">
                <label for="police_reference_{{ section.id }}">POLICE REFERENCE NUMBER *</label>
                <input type="text" id="police_reference_{{ section.id }}" name="police_reference" placeholder="Enter police reference number" required>
              </div>

              <div class="case-submit-field">
                <label for="police_force_{{ section.id }}">POLICE FORCE / AGENCY *</label>
                <input type="text" id="police_force_{{ section.id }}" name="police_force" placeholder="Police force or agency name" required>
              </div>

              <div class="case-submit-field full">
                <label for="no_reference_reason_{{ section.id }}">IF NO REFERENCE IS AVAILABLE, EXPLAIN WHY</label>
                <textarea id="no_reference_reason_{{ section.id }}" name="no_reference_reason" rows="3" placeholder="If you do not have a police reference number yet, explain why."></textarea>
              </div>

              <div class="case-submit-field full">
                <label for="claim_proof_{{ section.id }}">OPTIONAL PROOF / SUPPORTING IMAGE</label>
                <input type="file" id="claim_proof_{{ section.id }}" name="claim_proof" accept="image/*,application/pdf">
                <small>This can help with review if you are claiming an existing case or requesting professional contact.</small>
              </div>
            </div>

            <div class="case-submit-verify-boxes">
              <label class="case-submit-check-box">
                <input type="checkbox" name="confirm_true" required>
                <span>I confirm the information provided is true to the best of my knowledge.</span>
              </label>

              <label class="case-submit-check-box">
                <input type="checkbox" name="confirm_direct_connection">
                <span>I confirm I am directly connected to this case or have permission from the family.</span>
              </label>
            </div>

            <div class="case-submit-professional-box">
              <div class="case-submit-professional-copy">
                <div class="case-submit-professional-kicker">PROFESSIONAL CONTACT REQUEST</div>
                <h3>WOULD YOU LIKE TO BE CONTACTED BY TRUSTED PROFESSIONALS WHO MAY BE ABLE TO HELP?</h3>
                <p>Professional contact is only enabled after verification for direct family, guardians, or authorised case owners. It is not automatically available to random public uploaders.</p>
              </div>

              <div class="case-submit-professional-fields">
                <div class="case-submit-field">
                  <label for="professional_contact_opt_in_{{ section.id }}">PROFESSIONAL CONTACT</label>
                  <select id="professional_contact_opt_in_{{ section.id }}" name="professional_contact_opt_in" data-professional-opt-in>
                    <option value="no">No</option>
                    <option value="yes">Yes</option>
                  </select>
                </div>

                <div class="case-submit-field">
                  <label for="preferred_contact_method_{{ section.id }}">PREFERRED CONTACT METHOD</label>
                  <select id="preferred_contact_method_{{ section.id }}" name="preferred_contact_method">
                    <option value="">Select option</option>
                    <option>Email</option>
                    <option>Phone</option>
                    <option>Either</option>
                  </select>
                </div>

                <div class="case-submit-field full">
                  <label for="best_contact_times_{{ section.id }}">BEST CONTACT TIMES</label>
                  <input type="text" id="best_contact_times_{{ section.id }}" name="best_contact_times" placeholder="Optional">
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- STEP 5 -->
      <div class="case-submit-step" data-step="5">
        <div class="case-submit-card case-submit-main-card">
          <div class="case-submit-kicker">STEP 5 OF 6</div>
          <h2>CHOOSE YOUR VISIBILITY OPTION</h2>
          <p class="case-submit-intro">Submitting a case is free. Extra visibility options can be selected after details are entered and activated after approval.</p>

          <div class="case-submit-upsell-grid">
            <label class="case-submit-upsell-card is-selected" data-upsell-card>
              <input type="radio" name="visibility_option" value="free" checked>
              <div class="case-submit-upsell-kicker">FREE</div>
              <h3>FREE LISTING</h3>
              <p>Standard review and listing if approved.</p>
              <ul>
                <li>Reviewed submission</li>
                <li>Standard website placement</li>
                <li>Updates supported later</li>
              </ul>
            </label>

            <label class="case-submit-upsell-card" data-upsell-card>
              <input type="radio" name="visibility_option" value="boost">
              <div class="case-submit-upsell-kicker">MORE VISIBILITY</div>
              <h3>BOOSTED APPEAL</h3>
              <p>Increase homepage visibility and stronger placement once approved.</p>
              <ul>
                <li>Higher visibility</li>
                <li>More prominent exposure</li>
                <li>Good option when time matters</li>
              </ul>
            </label>

            <label class="case-submit-upsell-card spotlight-tier" data-upsell-card>
              <input type="radio" name="visibility_option" value="spotlight">
              <div class="case-submit-upsell-kicker">PREMIUM</div>
              <h3>SPOTLIGHT FEATURE</h3>
              <p>Top premium placement for the strongest homepage attention once approved.</p>
              <ul>
                <li>Highest-value placement</li>
                <li>Top featured exposure</li>
                <li>Designed for maximum attention</li>
              </ul>
            </label>
          </div>

          <div class="case-submit-psychology-strip">
            <div class="case-submit-psychology-box">
              <div class="case-submit-psychology-title">FREE UPLOAD</div>
              <p>You can always submit for review without paying.</p>
            </div>
            <div class="case-submit-psychology-box">
              <div class="case-submit-psychology-title">BOOSTED APPEAL</div>
              <p>More people may see the case sooner through stronger placement.</p>
            </div>
            <div class="case-submit-psychology-box">
              <div class="case-submit-psychology-title">SPOTLIGHT</div>
              <p>Premium homepage focus designed to attract the strongest attention.</p>
            </div>
          </div>
        </div>
      </div>

      <!-- STEP 6 -->
      <div class="case-submit-step" data-step="6">
        <div class="case-submit-step-grid single-wide">
          <div class="case-submit-card case-submit-main-card">
            <div class="case-submit-kicker">STEP 6 OF 6</div>
            <h2>REVIEW YOUR SUBMISSION</h2>
            <p class="case-submit-intro">Review the summary below before submitting. All cases are reviewed before publication.</p>

            <div class="case-submit-review-grid">
              <div class="case-submit-review-box">
                <div class="case-submit-review-title">SUBMISSION TYPE</div>
                <div class="case-submit-review-value" data-review-mode>New case submission</div>
              </div>

              <div class="case-submit-review-box">
                <div class="case-submit-review-title">PERSON</div>
                <div class="case-submit-review-value" data-review-name>—</div>
              </div>

              <div class="case-submit-review-box">
                <div class="case-submit-review-title">LOCATION</div>
                <div class="case-submit-review-value" data-review-location>—</div>
              </div>

              <div class="case-submit-review-box">
                <div class="case-submit-review-title">VISIBILITY OPTION</div>
                <div class="case-submit-review-value" data-review-visibility>Free listing</div>
              </div>

              <div class="case-submit-review-box">
                <div class="case-submit-review-title">PROFESSIONAL CONTACT</div>
                <div class="case-submit-review-value" data-review-professional>Not requested</div>
              </div>

              <div class="case-submit-review-box">
                <div class="case-submit-review-title">VERIFICATION NOTE</div>
                <div class="case-submit-review-value">Professional contact features remain locked until verification is approved.</div>
              </div>
            </div>

            <label class="case-submit-check-box final-confirm">
              <input type="checkbox" name="final_confirm" required>
              <span>I understand this submission will be reviewed before publication and that any professional contact request requires verification approval.</span>
            </label>

            <div class="case-submit-final-actions">
              <button type="submit" class="case-submit-submit-btn">SUBMIT CASE FOR REVIEW</button>
            </div>
          </div>
        </div>
      </div>

      <div class="case-submit-nav">
        <button type="button" class="case-submit-nav-btn dark" data-step-back>BACK</button>
        <button type="button" class="case-submit-nav-btn primary" data-step-next>NEXT STEP</button>
      </div>
    </form>
  </div>
</section>

<style>
.case-submit-system{
  max-width:1280px;
  margin:24px auto;
  padding:0 10px;
}

.case-submit-shell{
  position:relative;
  overflow:hidden;
  min-height:760px;
  border-radius:34px;
  padding:18px;
  background:
    radial-gradient(circle at 50% 10%, rgba(220,40,60,0.20) 0%, transparent 24%),
    radial-gradient(circle at 10% 50%, rgba(255,70,90,0.12) 0%, transparent 20%),
    radial-gradient(circle at 90% 50%, rgba(255,70,90,0.12) 0%, transparent 20%),
