{% assign professional_login_return_separator = '?' %}
{% assign professional_register_return_separator = '?' %}
{% if routes.account_login_url contains '?' %}
  {% assign professional_login_return_separator = '&' %}
{% endif %}
{% if routes.account_register_url contains '?' %}
  {% assign professional_register_return_separator = '&' %}
{% endif %}
{% assign professional_login_url = routes.account_login_url | append: professional_login_return_separator | append: 'return_url=/pages/professional-area' %}
{% assign professional_register_url = routes.account_register_url | append: professional_register_return_separator | append: 'return_url=/pages/professional-area' %}
{% assign current_professional_tags = '' %}
{% assign professional_metafield_status = '' %}
{% assign professional_metafield_account_type = '' %}
{% assign membership_tier_meta = '' %}
{% if customer %}
  {% assign current_professional_tags = customer.tags | join: ',' | downcase %}
  {% assign professional_metafield_status = customer.metafields.custom.professional_verification_status.value | default: customer.metafields.custom.professional_verification_status | default: customer.metafields.custom.professional_status.value | default: customer.metafields.custom.professional_status | default: customer.metafields.missingalerts.professional_verification_status.value | default: customer.metafields.missingalerts.professional_verification_status | default: customer.metafields.missingalerts.professional_status.value | default: customer.metafields.missingalerts.professional_status | append: '' | downcase %}
  {% assign professional_metafield_account_type = customer.metafields.custom.account_type.value | default: customer.metafields.custom.account_type | default: customer.metafields.missingalerts.account_type.value | default: customer.metafields.missingalerts.account_type | append: '' | downcase %}
  {% assign membership_tier_meta = customer.metafields.custom.membership_tier.value | default: customer.metafields.custom.membership_tier | default: customer.metafields.custom.membership_type.value | default: customer.metafields.custom.membership_type | default: customer.metafields.missingalerts.membership_tier.value | default: customer.metafields.missingalerts.membership_tier | default: customer.metafields.missingalerts.membership_type.value | default: customer.metafields.missingalerts.membership_type | append: '' | downcase %}
{% endif %}

{% assign has_professional_tag = false %}
{% assign has_paid_professional_tier = false %}
{% assign professional_verified = false %}
{% assign professional_inbox_allowed = false %}
{% assign detected_professional_tier = 'COMMUNITY' %}
{% assign professional_contact_limit_label = 'LOCKED' %}

{% if customer %}
  {% for customer_tag in customer.tags %}
    {% assign normalized_customer_tag = customer_tag | downcase | strip %}
    {% if normalized_customer_tag == 'professional'
      or normalized_customer_tag == 'pro'
      or normalized_customer_tag == 'professional_pending'
      or normalized_customer_tag == 'professional_premium'
      or normalized_customer_tag == 'professional_enterprise'
      or normalized_customer_tag == 'professional_access'
      or normalized_customer_tag == 'professional_plus'
      or normalized_customer_tag == 'professional_elite'
      or normalized_customer_tag == 'professional_pending_verification'
      or normalized_customer_tag == 'professional_verified'
    %}
      {% assign has_professional_tag = true %}
    {% endif %}
    {% if normalized_customer_tag == 'professional_access'
      or normalized_customer_tag == 'professional_plus'
      or normalized_customer_tag == 'professional_elite'
      or normalized_customer_tag == 'professional_premium'
      or normalized_customer_tag == 'professional_enterprise'
    %}
      {% assign has_paid_professional_tier = true %}
    {% endif %}
    {% if normalized_customer_tag == 'professional_verified'
      or normalized_customer_tag == 'verified-professional'
      or normalized_customer_tag == 'approved-professional'
    %}
      {% assign professional_verified = true %}
    {% endif %}
    {% if normalized_customer_tag == 'professional_inbox_enabled'
      or normalized_customer_tag == 'professional_messaging_enabled'
      or normalized_customer_tag == 'direct_inbox_enabled'
    %}
      {% assign professional_inbox_allowed = true %}
    {% endif %}
  {% endfor %}

  {% if professional_metafield_status contains 'professional' or professional_metafield_account_type contains 'professional' %}
    {% assign has_professional_tag = true %}
  {% endif %}
  {% if membership_tier_meta contains 'professional_access'
    or membership_tier_meta contains 'professional_plus'
    or membership_tier_meta contains 'professional_elite'
    or membership_tier_meta contains 'professional_premium'
    or membership_tier_meta contains 'professional_enterprise'
  %}
    {% assign has_paid_professional_tier = true %}
  {% endif %}
  {% if professional_metafield_status contains 'approved' or professional_metafield_status contains 'verified' %}
    {% assign professional_verified = true %}
  {% endif %}
  {% if current_professional_tags contains 'professional_inbox_enabled'
    or current_professional_tags contains 'professional_messaging_enabled'
    or current_professional_tags contains 'direct_inbox_enabled'
    or professional_metafield_status contains 'inbox_enabled'
  %}
    {% assign professional_inbox_allowed = true %}
  {% endif %}

  {% if current_professional_tags contains 'professional_premium' or membership_tier_meta contains 'professional_premium' %}
    {% assign detected_professional_tier = 'PROFESSIONAL PREMIUM' %}
    {% assign professional_contact_limit_label = 'Unlimited family contacts' %}
  {% elsif current_professional_tags contains 'professional_elite' or membership_tier_meta contains 'professional_elite' %}
    {% assign detected_professional_tier = 'PROFESSIONAL ELITE' %}
    {% assign professional_contact_limit_label = 'Unlimited family contacts' %}
  {% elsif current_professional_tags contains 'professional_plus' or membership_tier_meta contains 'professional_plus' or current_professional_tags contains 'professional_medium' or membership_tier_meta contains 'professional_medium' %}
    {% assign detected_professional_tier = 'PROFESSIONAL PLUS' %}
    {% assign professional_contact_limit_label = '3 family contacts per day' %}
  {% elsif current_professional_tags contains 'professional_access' or membership_tier_meta contains 'professional_access' or current_professional_tags contains 'professional_enterprise' or membership_tier_meta contains 'professional_enterprise' %}
    {% assign detected_professional_tier = 'PROFESSIONAL ACCESS' %}
    {% assign professional_contact_limit_label = '3 family contacts per day' %}
  {% endif %}
{% endif %}

{% assign professional_area_state = 'logged_out' %}
{% if customer %}
  {% assign professional_area_state = 'upgrade_required' %}
  {% if has_paid_professional_tier == true and professional_verified == false %}
    {% assign professional_area_state = 'pending_verification' %}
  {% endif %}
  {% if has_paid_professional_tier == true and professional_verified == true %}
    {% assign professional_area_state = 'approved_dashboard' %}
  {% endif %}
{% endif %}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }

  .professional-area-{{ section.id }} {
    max-width: 1320px;
    margin: 0 auto;
    padding: 0 1.5rem;
    color: #fff;
  }

  .professional-area__shell-{{ section.id }} {
    overflow: hidden;
    border-radius: 32px;
    padding: 1.35rem;
    background:
      radial-gradient(circle at top left, rgba(255, 49, 86, 0.2), transparent 28%),
      radial-gradient(circle at 85% 15%, rgba(255, 255, 255, 0.06), transparent 20%),
      linear-gradient(180deg, #0b0c10 0%, #050608 100%);
    border: 1px solid rgba(255, 255, 255, 0.08);
    box-shadow: 0 24px 80px rgba(0, 0, 0, 0.34), inset 0 1px 0 rgba(255, 255, 255, 0.03);
  }

  .professional-area__hero-{{ section.id }},
  .professional-area__section-{{ section.id }},
  .professional-area__state-{{ section.id }},
  .professional-area__summary-{{ section.id }},
  .professional-area__card-{{ section.id }} {
    background:
      linear-gradient(180deg, rgba(255,255,255,0.05), rgba(255,255,255,0.015)),
      linear-gradient(180deg, #15161a 0%, #0a0b0e 100%);
    border: 1px solid rgba(255,255,255,0.08);
    box-shadow: 0 18px 40px rgba(0,0,0,0.24);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    border-radius: 24px;
  }

  .professional-area__hero-{{ section.id }},
  .professional-area__section-{{ section.id }},
  .professional-area__state-{{ section.id }},
  .professional-area__summary-{{ section.id }} {
    padding: 1.45rem;
  }

  .professional-area__eyebrow-{{ section.id }},
  .professional-area__label-{{ section.id }} {
    margin: 0 0 0.45rem;
    color: #ffb4bf;
    font-size: 0.9rem;
    font-weight: 800;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .professional-area__heading-{{ section.id }},
  .professional-area__title-{{ section.id }},
  .professional-area__card-title-{{ section.id }} {
    margin: 0;
    text-transform: uppercase;
  }

  .professional-area__heading-{{ section.id }} {
    font-size: clamp(2.8rem, 5vw, 4.8rem);
    line-height: 0.95;
  }

  .professional-area__intro-{{ section.id }},
  .professional-area__copy-{{ section.id }},
  .professional-area__section-copy-{{ section.id }} {
    color: rgba(255,255,255,0.74);
    line-height: 1.7;
  }

  .professional-area__hero-{{ section.id }} {
    display: grid;
    gap: 1rem;
  }

  .professional-area__actions-{{ section.id }},
  .professional-area__tabs-{{ section.id }},
  .professional-area__cta-row-{{ section.id }} {
    display: flex;
    flex-wrap: wrap;
    gap: 0.85rem;
  }

  .professional-area__button-{{ section.id }},
  .professional-area__button-secondary-{{ section.id }},
  .professional-area__tab-{{ section.id }},
  .professional-area__disabled-{{ section.id }} {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 3.35rem;
    padding: 0 1.25rem;
    border-radius: 999px;
    text-decoration: none;
    font-size: 0.9rem;
    font-weight: 900;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .professional-area__button-{{ section.id }} {
    color: #fff;
    background: linear-gradient(135deg, #ff2f43 0%, #d90429 58%, #8f0016 100%);
    box-shadow: 0 14px 28px rgba(217,4,41,0.28);
  }

  .professional-area__button-secondary-{{ section.id }},
  .professional-area__tab-{{ section.id }},
  .professional-area__disabled-{{ section.id }} {
    color: #fff;
    background: rgba(255,255,255,0.05);
    border: 1px solid rgba(255,255,255,0.1);
  }

  .professional-area__tab-{{ section.id }}.is-active {
    background: rgba(255, 43, 43, 0.2);
    border-color: rgba(255, 43, 43, 0.35);
  }

  .professional-area__disabled-{{ section.id }} {
    opacity: 0.55;
    pointer-events: none;
  }

  .professional-area__summary-grid-{{ section.id }},
  .professional-area__card-grid-{{ section.id }},
  .professional-area__profile-grid-{{ section.id }} {
    display: grid;
    gap: 1rem;
  }

  .professional-area__summary-grid-{{ section.id }} {
    grid-template-columns: repeat(4, minmax(0, 1fr));
    margin-top: 1rem;
  }

  .professional-area__card-grid-{{ section.id }},
  .professional-area__profile-grid-{{ section.id }} {
    grid-template-columns: repeat(3, minmax(0, 1fr));
    margin-top: 1rem;
  }

  .professional-area__summary-card-{{ section.id }},
  .professional-area__card-{{ section.id }} {
    padding: 1.2rem;
  }

  .professional-area__summary-card-{{ section.id }} {
    border-radius: 20px;
    background: rgba(255,255,255,0.035);
    border: 1px solid rgba(255,255,255,0.06);
  }

  .professional-area__summary-value-{{ section.id }} {
    margin-top: 0.55rem;
    font-size: clamp(1.6rem, 2.3vw, 2rem);
    font-weight: 700;
    line-height: 1.2;
    text-transform: uppercase;
    word-break: break-word;
  }

  .professional-area__summary-note-{{ section.id }} {
    margin-top: 0.5rem;
    color: rgba(255,255,255,0.58);
    font-size: 0.95rem;
    line-height: 1.5;
  }

  .professional-area__help-list-{{ section.id }} {
    display: grid;
    gap: 1rem;
    margin-top: 1rem;
  }

  .professional-area__help-filters-{{ section.id }} {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 0.75rem;
    margin-top: 1rem;
  }

  .professional-area__help-filters-{{ section.id }} input,
  .professional-area__help-filters-{{ section.id }} select {
    min-height: 44px;
    border: 1px solid rgba(255,255,255,0.12);
    border-radius: 8px;
    background: rgba(0,0,0,0.24);
    color: #fff;
    padding: 0 0.85rem;
  }

  .professional-area__help-card-{{ section.id }} {
    display: grid;
    gap: 0.9rem;
    padding: 1rem;
    border-radius: 16px;
    background: rgba(255,255,255,0.045);
    border: 1px solid rgba(255,255,255,0.09);
  }

  .professional-area__help-meta-{{ section.id }} {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
    color: rgba(255,255,255,0.66);
    font-size: 0.88rem;
    line-height: 1.5;
  }

  .professional-area__help-form-{{ section.id }} {
    display: none;
    gap: 0.75rem;
  }

  .professional-area__help-form-{{ section.id }}.is-active {
    display: grid;
  }

  .professional-area__help-form-{{ section.id }} textarea {
    width: 100%;
    min-height: 7rem;
    resize: vertical;
    border-radius: 14px;
    padding: 0.85rem;
    color: #fff;
    background: rgba(0,0,0,0.34);
    border: 1px solid rgba(255,255,255,0.14);
  }

  .professional-area__help-form-{{ section.id }} select {
    width: 100%;
    min-height: 3.3rem;
    border-radius: 14px;
    padding: 0 0.85rem;
    color: #fff;
    background: rgba(0,0,0,0.34);
    border: 1px solid rgba(255,255,255,0.14);
  }

  .professional-area__modal-{{ section.id }} {
    position: fixed;
    inset: 0;
    z-index: 80;
    display: grid;
    place-items: center;
    padding: 1.2rem;
    background: rgba(0,0,0,0.72);
  }

  .professional-area__modal-dialog-{{ section.id }} {
    width: min(100%, 680px);
    display: grid;
    gap: 1rem;
    border-radius: 22px;
    padding: 1.35rem;
    background: linear-gradient(180deg, #17191f 0%, #090a0d 100%);
    border: 1px solid rgba(255,255,255,0.12);
    box-shadow: 0 24px 80px rgba(0,0,0,0.46);
  }

  .professional-area__status-line-{{ section.id }} {
    margin-top: 1rem;
    color: rgba(255,255,255,0.68);
    line-height: 1.6;
  }

  .professional-area__section-{{ section.id }} {
    margin-top: 1rem;
  }

  .professional-area__section-head-{{ section.id }} {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 1rem;
    align-items: end;
  }

  .professional-area__card-{{ section.id }} {
    border-radius: 22px;
  }

  .professional-area__badge-{{ section.id }} {
    display: inline-flex;
    align-items: center;
    min-height: 2.1rem;
    padding: 0 0.8rem;
    border-radius: 999px;
    background: rgba(255,255,255,0.05);
    border: 1px solid rgba(255,255,255,0.08);
    color: rgba(255,255,255,0.88);
    font-size: 0.84rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .professional-area__dashboard [data-professional-tab-panel] {
    display: none;
  }

  .professional-area__dashboard [data-professional-tab-panel].is-active {
    display: block;
  }

  .professional-area__state-{{ section.id }} {
    display: grid;
    gap: 1rem;
  }

  .professional-area__state-badge-{{ section.id }} {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: fit-content;
    min-height: 2.3rem;
    padding: 0 0.9rem;
    border-radius: 999px;
    background: rgba(251,191,36,0.12);
    border: 1px solid rgba(251,191,36,0.2);
    color: #fde68a;
    font-size: 0.84rem;
    font-weight: 900;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .ma-program-panel,
  .ma-control-card,
  .ma-control-stat,
  .ma-control-list,
  .ma-control-empty {
    background: linear-gradient(180deg, #ffffff 0%, #f9fafb 100%);
    border: 1px solid rgba(17, 24, 39, 0.08);
    border-radius: 20px;
    box-shadow:
      0 20px 45px rgba(15, 23, 42, 0.10),
      0 2px 6px rgba(15, 23, 42, 0.06),
      inset 0 1px 0 rgba(255,255,255,0.9);
  }

  .ma-control-shell {
    display: grid;
    grid-template-columns: 240px minmax(0, 1fr);
    gap: 1.4rem;
    max-width: 1300px;
    margin: 0 auto;
    padding: 1.2rem;
    background: #eef1f5;
    border-radius: 28px;
  }

  .ma-control-sidebar {
    position: sticky;
    top: 1.6rem;
    align-self: start;
    padding: 1rem;
  }

  .ma-control-main {
    min-width: 0;
  }

  .ma-program-toolbar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.8rem;
    margin-bottom: 1rem;
    padding: 1rem 1.15rem;
    color: #111827;
  }

  .ma-program-toolbar__title,
  .ma-control-sidebar__brand {
    color: #111827;
    font-size: 1.35rem;
    font-weight: 800;
    letter-spacing: 0;
  }

  .ma-program-toolbar__meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.55rem;
    color: #64748b;
    font-size: 1rem;
    font-weight: 700;
  }

  .ma-program-status-dot {
    width: 0.7rem;
    height: 0.7rem;
    border-radius: 999px;
    background: #16a34a;
    box-shadow: 0 0 0 4px rgba(22, 163, 74, 0.12);
  }

  .ma-control-sidebar__nav {
    display: grid;
    gap: 0.45rem;
    margin-top: 1.1rem;
  }

  .ma-control-sidebar__link {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    min-height: 3.6rem;
    padding: 0 0.85rem;
    border-radius: 14px;
    color: #475569;
    font-size: 1rem;
    font-weight: 800;
    text-decoration: none;
  }

  .ma-control-sidebar__link.is-active {
    background: rgba(220, 38, 38, 0.08);
    color: #991b1b;
  }

  .ma-control-sidebar__icon {
    width: 1.55rem;
    color: #94a3b8;
    text-align: center;
  }

  .professional-area-{{ section.id }} {
    max-width: none;
    background: #eef1f5;
    color: #111827;
  }

  .professional-area__shell-{{ section.id }} {
    overflow: visible;
    color: #111827;
  }

  .professional-area__main-{{ section.id }} {
    grid-column: 2;
    min-width: 0;
  }

  .professional-area__hero-{{ section.id }},
  .professional-area__section-{{ section.id }},
  .professional-area__state-{{ section.id }},
  .professional-area__summary-{{ section.id }},
  .professional-area__summary-card-{{ section.id }},
  .professional-area__card-{{ section.id }},
  .professional-area__help-card-{{ section.id }},
  .ma-owner-inbox,
  .ma-owner-inbox__list,
  .professional-area__modal-dialog-{{ section.id }} {
    background: linear-gradient(180deg, #ffffff 0%, #f9fafb 100%);
    border: 1px solid rgba(17, 24, 39, 0.08);
    color: #111827;
    box-shadow:
      0 20px 45px rgba(15, 23, 42, 0.10),
      0 2px 6px rgba(15, 23, 42, 0.06),
      inset 0 1px 0 rgba(255,255,255,0.9);
  }

  .professional-area__eyebrow-{{ section.id }},
  .professional-area__label-{{ section.id }},
  .professional-area__summary-note-{{ section.id }},
  .professional-area__help-meta-{{ section.id }},
  .professional-area__section-copy-{{ section.id }},
  .professional-area__status-line-{{ section.id }} {
    color: #64748b;
  }

  .professional-area__heading-{{ section.id }},
  .professional-area__title-{{ section.id }},
  .professional-area__card-title-{{ section.id }},
  .professional-area__summary-value-{{ section.id }} {
    color: #111827;
  }

  .professional-area__intro-{{ section.id }},
  .professional-area__copy-{{ section.id }} {
    color: #475569;
  }

  .professional-area__button-{{ section.id }} {
    background: #b91c1c;
    color: #ffffff;
    box-shadow: 0 12px 24px rgba(185, 28, 28, 0.18);
  }

  .professional-area__button-secondary-{{ section.id }},
  .professional-area__tab-{{ section.id }},
  .professional-area__disabled-{{ section.id }} {
    background: #ffffff;
    border: 1px solid rgba(15, 23, 42, 0.10);
    color: #334155;
    box-shadow: 0 8px 22px rgba(15, 23, 42, 0.06);
  }

  .professional-area__tab-{{ section.id }}.is-active {
    background: rgba(220, 38, 38, 0.08);
    border-color: rgba(220, 38, 38, 0.20);
    color: #991b1b;
    box-shadow: none;
  }

  .professional-area__help-filters-{{ section.id }} input,
  .professional-area__help-filters-{{ section.id }} select,
  .professional-area__help-form-{{ section.id }} textarea,
  .professional-area__help-form-{{ section.id }} select {
    background: #ffffff;
    border: 1px solid rgba(15, 23, 42, 0.12);
    color: #111827;
  }

  @media screen and (max-width: 989px) {
    .professional-area__summary-grid-{{ section.id }},
    .professional-area__card-grid-{{ section.id }},
    .professional-area__profile-grid-{{ section.id }} {
      grid-template-columns: 1fr 1fr;
    }
  }

  @media screen and (max-width: 749px) {
    .ma-control-shell {
      display: block;
      padding: 1rem;
      border-radius: 24px;
    }

    .ma-control-sidebar {
      position: static;
      margin-bottom: 1rem;
    }

    .ma-control-sidebar__nav {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .professional-area__main-{{ section.id }} {
      grid-column: auto;
    }

    .professional-area-{{ section.id }} {
      padding: 0 1rem;
    }

    .professional-area__shell-{{ section.id }} {
      padding: 1rem;
      border-radius: 24px;
    }

    .professional-area__hero-{{ section.id }},
    .professional-area__section-{{ section.id }},
    .professional-area__state-{{ section.id }},
    .professional-area__summary-{{ section.id }} {
      padding: 1.2rem;
      border-radius: 20px;
    }

    .professional-area__summary-grid-{{ section.id }},
    .professional-area__card-grid-{{ section.id }},
    .professional-area__profile-grid-{{ section.id }},
    .professional-area__help-filters-{{ section.id }} {
      grid-template-columns: 1fr;
    }

    .professional-area__button-{{ section.id }},
    .professional-area__button-secondary-{{ section.id }},
    .professional-area__tab-{{ section.id }},
    .professional-area__disabled-{{ section.id }} {
      width: 100%;
    }
  }
{%- endstyle -%}

