<script>
  (function() {
    var root = document.querySelector('[data-professional-help-root]');
    if (!root) return;

    var apiBase = String(window.MISSING_ALERTS_API_BASE || 'https://project-155fd.vercel.app').replace(/\/+$/, '');
    var triggers = root.querySelectorAll('[data-professional-tab-trigger]');
    var panels = root.querySelectorAll('[data-professional-tab-panel]');
    var helpStatus = root.querySelector('[data-help-status]');
    var helpList = root.querySelector('[data-help-list]');
    var helpFilters = root.querySelector('[data-help-filters]');
    var waitingCountNodes = root.querySelectorAll('[data-help-waiting-count]');
    var customerId = root.getAttribute('data-customer-id') || '';
    var customerEmail = root.getAttribute('data-customer-email') || '';
    var helpRequestsLoaded = false;
    var activeHelpCase = null;

    function escapeText(value) {
      return String(value || '').replace(/[&<>"']/g, function(character) {
        return {
          '&': '&amp;',
          '<': '&lt;',
          '>': '&gt;',
          '"': '&quot;',
          "'": '&#39;'
        }[character];
      });
    }

    function setHelpStatus(message) {
      if (helpStatus) helpStatus.textContent = message;
    }

    function buildCaseLink(handle) {
      if (!handle) return '';
      return '/blogs/missing-persons/' + encodeURIComponent(handle);
    }

    function formatDate(value) {
      var date = value ? new Date(value) : null;
      if (!date || isNaN(date.getTime())) return 'Recently enabled';
      return date.toLocaleDateString(undefined, { year: 'numeric', month: 'short', day: 'numeric' });
    }

    function updateWaitingCount(count) {
      Array.prototype.forEach.call(waitingCountNodes, function(node) {
        node.textContent = String(Number(count || 0));
      });
    }

    function renderHelpRequests(payload) {
      var liveCount = payload.live_count || payload.total_waiting_count || 0;
      updateWaitingCount(liveCount);
      if (!helpList) return;

      if (payload.locked) {
        setHelpStatus(liveCount + ' people need help.');
        helpList.innerHTML = [
          '<article class="professional-area__help-card-{{ section.id }}">',
          '<span class="professional-area__badge-{{ section.id }}">LOCKED</span>',
          '<h3 class="professional-area__card-title-{{ section.id }}">Families asking for professional help</h3>',
          '<p class="professional-area__copy-{{ section.id }}">' + escapeText(liveCount) + ' people need help.</p>',
          '<p class="professional-area__copy-{{ section.id }}">Families are actively asking for verified professional support. Upgrade to contact families directly through Missing Alerts.</p>',
          '<a class="professional-area__button-{{ section.id }}" href="/pages/professional-membership">Upgrade Professional Access</a>',
          '</article>'
        ].join('');
        return;
      }

      var requests = Array.isArray(payload.leads) ? payload.leads : (Array.isArray(payload.cases) ? payload.cases : []);
      setHelpStatus(requests.length ? liveCount + ' approved professional help requests available.' : 'No approved professional help requests are available right now.');

      helpList.innerHTML = requests.map(function(item) {
        var location = [item.city, item.region, item.country].filter(Boolean).join(' / ');
        var summary = String(item.summary || item.short_summary || '').slice(0, 220);
        var caseLink = item.case_url || buildCaseLink(item.case_handle || '');

        return [
          '<article class="professional-area__help-card-{{ section.id }}" data-help-case data-lead-id="' + escapeText(item.id || '') + '" data-case-id="' + escapeText(item.case_id || '') + '" data-case-handle="' + escapeText(item.case_handle || '') + '" data-case-title="' + escapeText(item.professional_help_type || item.case_title || 'Professional help request') + '">',
          '<span class="professional-area__badge-{{ section.id }}">' + escapeText(item.status || 'approved') + '</span>',
          '<h3 class="professional-area__card-title-{{ section.id }}">' + escapeText(item.professional_help_type || item.case_title || 'Professional help request') + '</h3>',
          '<div class="professional-area__help-meta-{{ section.id }}">',
          location ? '<span>' + escapeText(location) + '</span>' : '',
          '<span>' + escapeText(formatDate(item.created_at || item.help_enabled_at)) + '</span>',
          '<span>Secure inbox only</span>',
          '</div>',
          '<p class="professional-area__copy-{{ section.id }}">' + escapeText(summary || 'Professional help requested.') + '</p>',
          '<div class="professional-area__cta-row-{{ section.id }}">',
          caseLink ? '<a class="professional-area__button-secondary-{{ section.id }}" href="' + escapeText(caseLink) + '">VIEW CASE</a>' : '',
          '<button type="button" class="professional-area__button-{{ section.id }}" data-open-help-contact>Contact through Missing Alerts Inbox</button>',
          '</div>',
          '</article>'
        ].join('');
      }).join('');
    }

    function openMessageModal(caseData) {
      closeMessageModal();
      activeHelpCase = caseData;
      var modal = document.createElement('div');
      modal.className = 'professional-area__modal-{{ section.id }}';
      modal.setAttribute('data-help-message-modal', '');
      modal.innerHTML = [
        '<section class="professional-area__modal-dialog-{{ section.id }}" role="dialog" aria-modal="true" aria-labelledby="professional-help-message-title-{{ section.id }}">',
        '<div>',
        '<p class="professional-area__eyebrow-{{ section.id }}">PROTECTED CONTACT</p>',
        '<h3 id="professional-help-message-title-{{ section.id }}" class="professional-area__card-title-{{ section.id }}">CONTACT FAMILY</h3>',
        '<p class="professional-area__copy-{{ section.id }}">' + escapeText(caseData.caseTitle || 'Selected case') + '</p>',
        '</div>',
        '<form class="professional-area__help-form-{{ section.id }} is-active" data-help-contact-form>',
        '<select name="service_type" required>',
        '<option value="">Service type</option>',
        '<option value="search_advice">Search advice</option>',
        '<option value="investigation_help">Investigation help</option>',
        '<option value="legal_guidance">Legal guidance</option>',
        '<option value="practical_services">Practical services</option>',
        '<option value="support">Support</option>',
        '</select>',
        '<textarea name="message_body" placeholder="Write a private message to this family request." required></textarea>',
        '<input type="hidden" name="contact_reason" value="professional_help_requests">',
        '<div class="professional-area__cta-row-{{ section.id }}">',
        '<button type="submit" class="professional-area__button-{{ section.id }}">SEND MESSAGE</button>',
        '<button type="button" class="professional-area__button-secondary-{{ section.id }}" data-close-help-message>CANCEL</button>',
        '</div>',
        '</form>',
        '</section>'
      ].join('');
      document.body.appendChild(modal);
    }

    function closeMessageModal() {
      var modal = document.querySelector('[data-help-message-modal]');
      if (modal && modal.parentNode) modal.parentNode.removeChild(modal);
    }

    async function loadHelpRequests() {
      if (helpRequestsLoaded) return;
      helpRequestsLoaded = true;
      setHelpStatus('Loading professional help requests...');

      try {
        if (!helpList) {
          var countResponse = await fetch(apiBase + '/api/pro-help/count', {
            method: 'GET',
            credentials: 'omit'
          });
          var countPayload = await countResponse.json();
          if (!countResponse.ok || !countPayload.ok) {
            throw new Error(countPayload.error || 'Unable to load professional help count.');
          }
          updateWaitingCount(countPayload.live_count || 0);
          return;
        }
        var params = new URLSearchParams({
          customer_id: customerId,
          customer_email: customerEmail
        });
        if (helpFilters) {
          var formData = new FormData(helpFilters);
          ['country', 'region', 'service_type', 'urgency'].forEach(function(key) {
            var value = String(formData.get(key) || '').trim();
            if (value) params.set(key, value);
          });
        }
        var response = await fetch(apiBase + '/api/pro-help/leads?' + params.toString(), {
          method: 'GET',
          credentials: 'omit'
        });
        var payload = await response.json();

        if (!response.ok || !payload.ok) {
          throw new Error(payload.error || 'Unable to load professional help requests.');
        }

        renderHelpRequests(payload);
      } catch (error) {
        setHelpStatus(error.message || 'Unable to load professional help requests.');
      }
    }

    if (helpList) {
      helpList.addEventListener('click', function(event) {
        var button = event.target.closest('[data-open-help-contact]');
        if (!button) return;

        var card = button.closest('[data-help-case]');
        openMessageModal({
          leadId: card ? card.getAttribute('data-lead-id') : '',
          caseId: card ? card.getAttribute('data-case-id') : '',
          caseHandle: card ? card.getAttribute('data-case-handle') : '',
          caseTitle: card ? card.getAttribute('data-case-title') : ''
        });
      });
    }

    if (helpFilters) {
      helpFilters.addEventListener('input', function() {
        helpRequestsLoaded = false;
        loadHelpRequests();
      });
      helpFilters.addEventListener('change', function() {
        helpRequestsLoaded = false;
        loadHelpRequests();
      });
    }

    document.addEventListener('click', function(event) {
      var closeButton = event.target.closest('[data-close-help-message]');
      if (closeButton || event.target.matches('[data-help-message-modal]')) {
        event.preventDefault();
        closeMessageModal();
      }
    });

    document.addEventListener('submit', async function(event) {
      var form = event.target.closest('[data-help-contact-form]');
      if (!form) return;
      event.preventDefault();

        var serviceType = form.querySelector('select[name="service_type"]');
        var textarea = form.querySelector('textarea[name="message_body"]');
        var contactReason = form.querySelector('input[name="contact_reason"]');
        var messageBody = textarea ? textarea.value : '';
        var submitButton = form.querySelector('button[type="submit"]');

        if (submitButton) submitButton.disabled = true;
        setHelpStatus('Sending private contact message...');

        try {
          var response = await fetch(apiBase + '/api/pro-help/contact', {
            method: 'POST',
            credentials: 'omit',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
              pro_customer_id: customerId,
              pro_customer_email: customerEmail,
              lead_id: activeHelpCase ? activeHelpCase.leadId : '',
              case_id: activeHelpCase ? activeHelpCase.caseId : '',
              case_handle: activeHelpCase ? activeHelpCase.caseHandle : '',
              message: messageBody,
              service_type: serviceType ? serviceType.value : '',
              contact_reason: contactReason ? contactReason.value : 'professional_help_requests'
            })
          });
          var payload = await response.json();

          if (!response.ok || !payload.ok) {
            throw new Error(payload.error || 'Unable to contact this family.');
          }

          setHelpStatus('Contact attempt logged. The help request remains visible unless it is closed.');
          if (textarea) textarea.value = '';
          closeMessageModal();
          helpRequestsLoaded = false;
          loadHelpRequests();
        } catch (error) {
          setHelpStatus(error.message || 'Unable to contact this family.');
        } finally {
          if (submitButton) submitButton.disabled = false;
        }
    });

    function activateTab(tabName) {
      if (!tabName) return;

      Array.prototype.forEach.call(triggers, function(trigger) {
        var isActive = trigger.getAttribute('data-professional-tab-trigger') === tabName;
        trigger.classList.toggle('is-active', isActive);
        trigger.setAttribute('aria-pressed', isActive ? 'true' : 'false');
      });

      Array.prototype.forEach.call(panels, function(panel) {
        var isActive = panel.getAttribute('data-professional-tab-panel') === tabName;
        panel.classList.toggle('is-active', isActive);
      });

      if (tabName === 'families') {
        loadHelpRequests();
      }
    }

    Array.prototype.forEach.call(triggers, function(trigger) {
      trigger.addEventListener('click', function() {
        activateTab(trigger.getAttribute('data-professional-tab-trigger'));
      });
    });

    if (triggers.length) {
      var requestedTab = '';
      try {
        requestedTab = new URLSearchParams(window.location.search).get('tab') || '';
      } catch (error) {
        requestedTab = '';
      }
      if (requestedTab === 'inbox') requestedTab = 'messaging';
      activateTab(requestedTab || 'overview');
    }
    if (waitingCountNodes.length && !helpList) {
      loadHelpRequests();
    }
  })();
</script>

{% schema %}
{
  "name": "Professional Area",
  "settings": [
    {
      "type": "header",
      "content": "Section padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Top padding",
      "default": 24
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding",
      "default": 36
    }
  ],
  "presets": [
    {
      "name": "Professional Area"
    }
  ]
}
{% endschema %}
