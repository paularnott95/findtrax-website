{{ 'seo-advice-blog.css' | asset_url | stylesheet_tag }}
<script src="{{ 'country-profiles.js' | asset_url }}" defer="defer"></script>

{% liquid
  assign ci_gb_count = 0
  assign ci_us_count = 0
  assign ci_ca_count = 0
  assign ci_au_count = 0
  assign ci_nz_count = 0
  assign ci_ie_count = 0
  assign ci_sg_count = 0
  assign ci_source_blog = blogs['missing-persons']
  if ci_source_blog != blank
    for ci_article in ci_source_blog.articles
      assign ci_tags = ci_article.tags | join: ',' | downcase
      assign ci_status = ci_article.metafields.custom.case_status.value | default: ci_article.metafields.custom.case_status | default: ci_article.metafields.custom.status.value | default: ci_article.metafields.custom.status | downcase
      assign ci_hidden = false
      if ci_tags contains 'found-safe' or ci_tags contains 'closed' or ci_tags contains 'located' or ci_tags contains 'private' or ci_tags contains 'draft' or ci_status contains 'found' or ci_status contains 'closed' or ci_status contains 'located' or ci_status contains 'resolved'
        assign ci_hidden = true
      endif
      unless ci_hidden
        assign ci_country = ci_article.metafields.custom.country_code.value | default: ci_article.metafields.custom.country_code | downcase | strip
        if ci_country == blank or ci_country == 'all'
          for ci_tag in ci_article.tags
            assign ci_tag_downcase = ci_tag | downcase | strip
            if ci_tag_downcase contains 'country:'
              assign ci_country = ci_tag_downcase | split: ':' | last | strip
              break
            endif
          endfor
        endif
        if ci_country == 'uk' or ci_country == 'england' or ci_country == 'scotland' or ci_country == 'wales' or ci_country == 'northern-ireland'
          assign ci_country = 'gb'
        endif
        if ci_country == 'gb'
          assign ci_gb_count = ci_gb_count | plus: 1
        elsif ci_country == 'us'
          assign ci_us_count = ci_us_count | plus: 1
        elsif ci_country == 'ca'
          assign ci_ca_count = ci_ca_count | plus: 1
        elsif ci_country == 'au'
          assign ci_au_count = ci_au_count | plus: 1
        elsif ci_country == 'nz'
          assign ci_nz_count = ci_nz_count | plus: 1
        elsif ci_country == 'ie'
          assign ci_ie_count = ci_ie_count | plus: 1
        elsif ci_country == 'sg'
          assign ci_sg_count = ci_sg_count | plus: 1
        endif
      endunless
    endfor
  endif
%}

<section class="seo-advice-hub country-search-page page-width">
  <div class="seo-advice-hub__hero country-search-page__hero">
    <div class="seo-advice-hub__eyebrow">Missing Alerts country intelligence</div>
    <h1 class="seo-advice-hub__title">COUNTRY INTELLIGENCE</h1>
    <p class="seo-advice-hub__copy">Search country-specific missing-person guidance, official reporting links, safe sharing advice, active Missing Alerts cases, and the Global Location Checker for high-value local guidance.</p>
    <div class="seo-advice-hub__actions">
      <a class="seo-advice-button" href="/pages/missing-person-advice">Open Advice Hub</a>
      <a class="seo-advice-button seo-advice-button--secondary" href="/blogs/missing-persons">View public cases</a>
    </div>

    <div class="seo-advice-hub__filters country-search-page__filters">
      <input class="seo-advice-hub__input" type="search" placeholder="Search by country, region, language, or official source" data-country-search-input>
      <select class="seo-advice-hub__select" data-country-region-filter>
        <option value="">All regions</option>
        <option value="Europe">Europe</option>
        <option value="North America">North America</option>
        <option value="Oceania">Oceania</option>
      </select>
      <select class="seo-advice-hub__select" data-country-index-filter>
        <option value="">All page states</option>
        <option value="complete">Complete and indexable</option>
        <option value="enrichment">Being enriched</option>
      </select>
    </div>
  </div>

  <div class="country-search-page__notice">
    <strong>Urgent safety note:</strong>
    If someone may be in immediate danger, contact local emergency services or police first. Missing Alerts supports public visibility and source-backed guidance; it does not replace an official report.
  </div>

  <section class="seo-advice-section country-search-page__location-checker" id="global-location-checker" data-global-location-checker>
    <div class="seo-advice-section__eyebrow">Global Location Checker</div>
    <h2>Check country and location guidance before sharing an appeal</h2>
    <p>Choose a country, then search for a city, county, region, state, province, or town. Missing Alerts will show the country profile, official reporting route, source coverage status, and whether the location has enough verified case or local context to support an indexable page.</p>
    <div class="seo-advice-hub__filters">
      <select class="seo-advice-hub__select" data-location-country>
        <option value="">Choose country</option>
        <option value="England">England</option>
        <option value="United Kingdom">United Kingdom</option>
        <option value="Ireland">Ireland</option>
        <option value="United States">United States</option>
        <option value="Canada">Canada</option>
        <option value="Australia">Australia</option>
        <option value="New Zealand">New Zealand</option>
        <option value="Singapore">Singapore</option>
      </select>
      <input class="seo-advice-hub__input" type="search" placeholder="Search London, Glasgow, Dublin, Sydney, Toronto..." data-location-query>
    </div>
    <div class="country-search-page__grid" data-location-results>
      <article class="country-search-card" data-location-card data-location-country="England United Kingdom" data-location-keywords="london greater london england uk united kingdom">
        <div class="country-search-card__top"><span>GB</span><strong>Indexable with case/local context</strong></div>
        <h3>London, England</h3>
        <p>Use the United Kingdom profile for official reporting guidance. London location pages should only be indexable when active cases or verified local context are present.</p>
        <div class="country-search-card__actions"><a href="/pages/country-intelligence#united-kingdom">United Kingdom intelligence</a><a href="/pages/missing-people-location-live?loc=united-kingdom/england/london">Check location</a></div>
      </article>
      <article class="country-search-card" data-location-card data-location-country="United Kingdom" data-location-keywords="glasgow scotland united kingdom uk croftfoot">
        <div class="country-search-card__top"><span>GB</span><strong>Active case signal</strong></div>
        <h3>Glasgow, Scotland</h3>
        <p>Connected to active public case context where source-backed data exists. Use map or polished fallback panels and link to Police Scotland/source guidance.</p>
        <div class="country-search-card__actions"><a href="/pages/country-intelligence#united-kingdom">United Kingdom intelligence</a><a href="/blogs/missing-persons/jan-hussain">Related case</a></div>
      </article>
      <article class="country-search-card" data-location-card data-location-country="Ireland" data-location-keywords="dublin sligo ireland garda">
        <div class="country-search-card__top"><span>IE</span><strong>Source coverage building</strong></div>
        <h3>Dublin and Sligo, Ireland</h3>
        <p>Use Garda reporting routes and Missing Alerts review status. Local pages stay noindex unless verified case data or official local context is available.</p>
        <div class="country-search-card__actions"><a href="/pages/country-intelligence#ireland">Ireland intelligence</a><a href="/pages/missing-people-ireland">Country page</a></div>
      </article>
      <article class="country-search-card" data-location-card data-location-country="United States Canada Australia New Zealand Singapore" data-location-keywords="new york los angeles toronto vancouver sydney melbourne auckland wellington singapore">
        <div class="country-search-card__top"><span>GLOBAL</span><strong>Quality-gated location directory</strong></div>
        <h3>International locations</h3>
        <p>Country and location results are available as search suggestions first. Missing Alerts indexes only locations with useful official guidance, active cases, or substantial local context.</p>
        <div class="country-search-card__actions"><a href="/blogs/missing-persons">View public cases</a><a href="/pages/missing-person-advice">Advice Hub</a></div>
      </article>
    </div>
    <p class="seo-advice-empty" data-location-empty hidden>No high-quality location result matches that search yet. Use the country profile while Missing Alerts enriches this location.</p>
  </section>

  <div class="country-search-page__grid" data-country-search-results>
    <article class="country-search-card" data-country-card data-country-name="England" data-region="Europe" data-index-state="complete">
      <div class="country-search-card__top">
        <span>ENG</span>
        <strong>Complete and indexable</strong>
      </div>
