{% assign community_plus_handle = section.settings.community_plus_handle | default: 'community-plus-membership' %}
{% assign community_pro_handle = section.settings.community_pro_handle | default: 'community-pro-membership' %}
{% assign community_plus_product = all_products[community_plus_handle] %}
{% assign community_pro_product = all_products[community_pro_handle] %}
{% assign community_plus_variant = community_plus_product.selected_or_first_available_variant %}
{% assign community_pro_variant = community_pro_product.selected_or_first_available_variant %}
{% assign community_plus_monthly_selling_plan_id = '' %}
{% assign community_pro_monthly_selling_plan_id = '' %}
{% if community_plus_product and community_plus_variant and community_plus_product.selling_plan_groups.size > 0 %}
  {% for selling_plan_group in community_plus_product.selling_plan_groups %}
    {% for selling_plan in selling_plan_group.selling_plans %}
      {% assign selling_plan_name = selling_plan.name | downcase %}
      {% if selling_plan_name contains 'month' %}
        {% assign community_plus_monthly_selling_plan_id = selling_plan.id %}
        {% break %}
      {% endif %}
    {% endfor %}
    {% if community_plus_monthly_selling_plan_id != '' %}
      {% break %}
    {% endif %}
  {% endfor %}
{% endif %}
{% if community_pro_product and community_pro_variant and community_pro_product.selling_plan_groups.size > 0 %}
  {% for selling_plan_group in community_pro_product.selling_plan_groups %}
    {% for selling_plan in selling_plan_group.selling_plans %}
      {% assign selling_plan_name = selling_plan.name | downcase %}
      {% if selling_plan_name contains 'month' %}
        {% assign community_pro_monthly_selling_plan_id = selling_plan.id %}
        {% break %}
      {% endif %}
    {% endfor %}
    {% if community_pro_monthly_selling_plan_id != '' %}
      {% break %}
    {% endif %}
  {% endfor %}
{% endif %}
{% assign customer_tags_downcase = customer.tags | join: ',' | downcase %}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }

  .community-membership-{{ section.id }} {
    max-width: 1320px;
    margin: 0 auto;
    padding-left: 1.5rem;
    padding-right: 1.5rem;
    color: #fff;
    display: block;
    min-height: 60vh;
    opacity: 1;
    visibility: visible;
  }

  .community-membership-{{ section.id }} .membership-debug {
    display: block;
    margin: 0 0 1rem;
    padding: 0.85rem 1rem;
    border-radius: 14px;
    background: #e50914;
    color: #ffffff;
    font-size: 0.9rem;
    font-weight: 900;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .community-membership__shell-{{ section.id }} {
    overflow: hidden;
    border-radius: 32px;
    padding: 1.5rem;
    background:
      radial-gradient(circle at top left, rgba(255, 51, 92, 0.24), transparent 24%),
      radial-gradient(circle at right top, rgba(255, 153, 0, 0.10), transparent 28%),
      linear-gradient(180deg, #090a0d 0%, #050506 100%);
    border: 1px solid rgba(255, 255, 255, 0.08);
    box-shadow: 0 24px 80px rgba(0, 0, 0, 0.36), inset 0 1px 0 rgba(255, 255, 255, 0.04);
  }

  .community-membership__hero-{{ section.id }},
  .community-membership__card-{{ section.id }},
  .community-membership__trust-{{ section.id }} {
    background:
      linear-gradient(180deg, rgba(255,255,255,0.05), rgba(255,255,255,0.015)),
      linear-gradient(180deg, #15161a 0%, #0a0b0e 100%);
    border: 1px solid rgba(255,255,255,0.08);
    box-shadow: 0 18px 40px rgba(0, 0, 0, 0.24);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
  }

  .community-membership__hero-{{ section.id }},
  .community-membership__trust-{{ section.id }} {
    border-radius: 28px;
    padding: 2rem;
  }

  .community-membership__eyebrow-{{ section.id }},
  .community-membership__label-{{ section.id }},
  .community-membership__pill-{{ section.id }} {
    font-size: 0.9rem;
    font-weight: 800;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .community-membership__eyebrow-{{ section.id }} {
    margin: 0 0 0.55rem;
    color: #ffb4bf;
  }

  .community-membership__heading-{{ section.id }},
  .community-membership__title-{{ section.id }} {
    margin: 0;
    text-transform: uppercase;
  }

  .community-membership__heading-{{ section.id }} {
    font-size: clamp(3rem, 5vw, 5rem);
    line-height: 0.95;
  }

  .community-membership__intro-{{ section.id }},
  .community-membership__copy-{{ section.id }},
  .community-membership__note-{{ section.id }} {
    color: rgba(255,255,255,0.76);
    line-height: 1.7;
  }

  .community-membership__intro-{{ section.id }} {
    max-width: 66rem;
    margin: 1rem 0 0;
    font-size: 1.15rem;
  }

  .community-membership__actions-{{ section.id }} {
    display: flex;
    flex-wrap: wrap;
    gap: 0.9rem;
    margin-top: 1.5rem;
  }

  .community-membership__button-{{ section.id }},
  .community-membership__button-secondary-{{ section.id }},
  .community-membership__cta-{{ section.id }} {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 3.4rem;
    padding: 0 1.35rem;
    border-radius: 999px;
    text-decoration: none;
    font-size: 0.9rem;
    font-weight: 900;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    transition: transform 180ms ease, box-shadow 180ms ease, filter 180ms ease;
  }

  .community-membership__button-{{ section.id }},
  .community-membership__cta-{{ section.id }} {
    border: 0;
    color: #fff;
    background: linear-gradient(135deg, #ff2f43 0%, #d90429 58%, #8f0016 100%);
    box-shadow: 0 14px 28px rgba(217, 4, 41, 0.28);
  }

  .community-membership__button-secondary-{{ section.id }} {
    color: #fff;
    background: rgba(255,255,255,0.05);
    border: 1px solid rgba(255,255,255,0.12);
  }

  .community-membership__button-{{ section.id }}:hover,
  .community-membership__button-secondary-{{ section.id }}:hover,
  .community-membership__cta-{{ section.id }}:hover {
    transform: translateY(-2px);
    filter: brightness(1.05);
  }

  .community-membership__grid-{{ section.id }} {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1rem;
    margin-top: 1.5rem;
  }

  .community-membership__card-{{ section.id }} {
    border-radius: 26px;
    padding: 1.6rem;
    display: flex;
    flex-direction: column;
    gap: 1rem;
    position: relative;
    overflow: hidden;
  }

  .community-membership__card-{{ section.id }}::before {
    content: '';
    position: absolute;
    inset: 0;
    background: radial-gradient(circle at top right, rgba(255, 43, 43, 0.14), transparent 36%);
    pointer-events: none;
  }

  .community-membership__label-{{ section.id }} {
    color: rgba(255,255,255,0.54);
  }

  .community-membership__price-{{ section.id }} {
    font-size: 2.4rem;
    font-weight: 900;
    line-height: 1;
    text-transform: uppercase;
  }

  .community-membership__list-{{ section.id }} {
    display: grid;
    gap: 0.75rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .community-membership__list-{{ section.id }} li {
    color: rgba(255,255,255,0.76);
    line-height: 1.55;
  }

  .community-membership__pill-{{ section.id }} {
    display: inline-flex;
    align-items: center;
    min-height: 2.2rem;
    padding: 0 0.85rem;
    border-radius: 999px;
    border: 1px solid rgba(255,255,255,0.1);
    background: rgba(255,255,255,0.05);
    color: rgba(255,255,255,0.84);
  }

  .community-membership__admin-{{ section.id }} {
    border-radius: 18px;
    border: 1px solid rgba(251, 191, 36, 0.2);
    background: rgba(251, 191, 36, 0.08);
    padding: 0.9rem 1rem;
    color: #fde68a;
    line-height: 1.6;
  }

  .community-membership__coming-soon-{{ section.id }} {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 3.4rem;
    padding: 0 1.35rem;
    border-radius: 999px;
    border: 1px solid rgba(255,255,255,0.12);
    background: rgba(255,255,255,0.04);
    color: rgba(255,255,255,0.72);
    font-size: 0.88rem;
    font-weight: 900;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .community-membership__pricing-note-{{ section.id }} {
    margin: -0.35rem 0 0;
    color: rgba(255,255,255,0.58);
    line-height: 1.5;
    font-size: 0.85rem;
    text-transform: uppercase;
  }

  @media screen and (max-width: 989px) {
    .community-membership__grid-{{ section.id }} {
      grid-template-columns: 1fr;
    }
  }

  @media screen and (max-width: 749px) {
    .community-membership__shell-{{ section.id }} {
      padding: 1rem;
      border-radius: 24px;
    }

    .community-membership__hero-{{ section.id }},
    .community-membership__trust-{{ section.id }},
    .community-membership__card-{{ section.id }} {
      padding: 1.2rem;
      border-radius: 20px;
    }
  }
{%- endstyle -%}

<section class="community-membership-{{ section.id }} membership-section section-{{ section.id }}-padding">
  <div class="membership-debug">
    MEMBERSHIP PAGE LOADED
  </div>
  <div class="community-membership__shell-{{ section.id }}">
    <div class="community-membership__admin-{{ section.id }}" style="margin-bottom: 1.5rem;">
      PAGE ROUTE LOADED: community-membership
    </div>
    <div class="community-membership__hero-{{ section.id }}">
      <p class="community-membership__eyebrow-{{ section.id }}">Community Membership</p>
      <h1 class="community-membership__heading-{{ section.id }}">COMMUNITY MEMBERSHIP</h1>
      <p class="community-membership__intro-{{ section.id }}">
        CHOOSE THE COMMUNITY TIER THAT FITS HOW YOU WANT TO FOLLOW CASES, SUPPORT FAMILIES, AND STAY CLOSER TO MISSING ALERTS UPDATES.
      </p>
      <div class="community-membership__actions-{{ section.id }}">
        <a href="{{ routes.account_login_url }}" class="community-membership__button-{{ section.id }}">MEMBER LOGIN</a>
        <a href="{{ routes.account_register_url }}" class="community-membership__button-secondary-{{ section.id }}">COMMUNITY SIGN UP</a>
        <a href="/pages/member-area" class="community-membership__button-secondary-{{ section.id }}">MEMBER AREA</a>
      </div>
    </div>

    {% if customer %}
      <div class="community-membership__trust-{{ section.id }}" style="margin-top: 1.5rem;">
        <div class="community-membership__label-{{ section.id }}">CURRENT ACCOUNT STATUS</div>
        <h2 class="community-membership__title-{{ section.id }}" style="font-size: 1.9rem;">CURRENT MEMBERSHIP VIEW</h2>
        <p class="community-membership__copy-{{ section.id }}">
          {% if customer_tags_downcase contains 'community_pro' %}
            COMMUNITY PRO IS ACTIVE ON THIS CUSTOMER ACCOUNT.
          {% elsif customer_tags_downcase contains 'community_plus' %}
            COMMUNITY+ IS ACTIVE ON THIS CUSTOMER ACCOUNT.
          {% else %}
            THIS ACCOUNT IS CURRENTLY USING COMMUNITY ACCESS OR HAS NOT BEEN UPGRADED YET.
          {% endif %}
        </p>
      </div>
    {% endif %}

    {% if request.design_mode %}
      <div class="community-membership__admin-{{ section.id }}" style="margin-top: 1.5rem;">
        <strong>ADMIN CHECKLIST</strong><br>
        • PRODUCT ACTIVE<br>
        • ONLINE STORE ENABLED<br>
        • MONTHLY SELLING PLAN ATTACHED<br>
        • TEST CHECKOUT BEFORE LAUNCH
      </div>
    {% endif %}

    <div class="community-membership__grid-{{ section.id }}">
      <article class="community-membership__card-{{ section.id }}">
        <div class="community-membership__pill-{{ section.id }}">COMMUNITY</div>
        <div class="community-membership__label-{{ section.id }}">FREE</div>
        <h2 class="community-membership__title-{{ section.id }}" style="font-size: 2rem;">COMMUNITY</h2>
        <div class="community-membership__price-{{ section.id }}">FREE</div>
        <p class="community-membership__copy-{{ section.id }}">FOLLOW CASES, STAY INFORMED, AND TAKE PART IN SAFE COMMUNITY SUPPORT.</p>
        <ul class="community-membership__list-{{ section.id }}">
          <li>FOLLOW MISSING CASES</li>
          <li>SAVE AND FOLLOW UPDATES</li>
          <li>JOIN PUBLIC CASE DISCUSSIONS</li>
          <li>SUBMIT HELPFUL INFORMATION</li>
          <li>ACCESS COMMUNITY ALERTS</li>
        </ul>
        <div class="community-membership__actions-{{ section.id }}">
          <a href="{{ routes.account_register_url }}" class="community-membership__button-{{ section.id }}">BECOME A MEMBER</a>
        </div>
      </article>

      <article class="community-membership__card-{{ section.id }}">
        <div class="community-membership__pill-{{ section.id }}">COMMUNITY+</div>
        <div class="community-membership__label-{{ section.id }}">PAID SUPPORTER TIER</div>
        <h2 class="community-membership__title-{{ section.id }}" style="font-size: 2rem;">COMMUNITY+</h2>
        <div class="community-membership__price-{{ section.id }}">
          {% if community_plus_monthly_selling_plan_id != '' %}
            £12.99/MONTH
          {% else %}
            PAID
          {% endif %}
        </div>
        <p class="community-membership__pricing-note-{{ section.id }}">RECURRING MONTHLY MEMBERSHIP. CANCEL ACCORDING TO STORE SUBSCRIPTION TERMS.</p>
        <p class="community-membership__copy-{{ section.id }}">MORE ALERTS, STRONGER VISIBILITY, AND A CLEARER SUPPORTER PRESENCE.</p>
        <ul class="community-membership__list-{{ section.id }}">
          <li>ALL COMMUNITY FEATURES</li>
          <li>PRIORITY LOCAL ALERTS</li>
          <li>CASE UPDATE NOTIFICATIONS</li>
          <li>SUPPORTER BADGE</li>
          <li>EARLY ACCESS TO NEW FEATURES</li>
          <li>BETTER VISIBILITY IN COMMUNITY SPACES</li>
        </ul>
        <div class="community-membership__actions-{{ section.id }}">
          {% if community_plus_product and community_plus_variant and community_plus_monthly_selling_plan_id != '' %}
            <form method="post" action="{{ routes.cart_add_url }}">
              <input type="hidden" name="id" value="{{ community_plus_variant.id }}">
              <input type="hidden" name="selling_plan" value="{{ community_plus_monthly_selling_plan_id }}">
              <button type="submit" class="community-membership__cta-{{ section.id }}">JOIN COMMUNITY+</button>
            </form>
          {% elsif community_plus_product and community_plus_variant %}
            <span class="community-membership__coming-soon-{{ section.id }}">SUBSCRIPTION SETUP REQUIRED</span>
          {% else %}
            <span class="community-membership__coming-soon-{{ section.id }}">COMING SOON</span>
          {% endif %}
        </div>
        {% if request.design_mode %}
          {% unless community_plus_product %}
            <div class="community-membership__admin-{{ section.id }}">ADMIN: PRODUCT HANDLE NOT FOUND — {{ community_plus_handle }}</div>
          {% else %}
            {% if community_plus_monthly_selling_plan_id == '' %}
              <div class="community-membership__admin-{{ section.id }}">ADMIN: ATTACH A MONTHLY SUBSCRIPTION SELLING PLAN TO THIS PRODUCT.</div>
            {% endif %}
          {% endunless %}
        {% endif %}
      </article>

      <article class="community-membership__card-{{ section.id }}">
        <div class="community-membership__pill-{{ section.id }}">COMMUNITY PRO</div>
        <div class="community-membership__label-{{ section.id }}">ADVANCED SUPPORTER TIER</div>
        <h2 class="community-membership__title-{{ section.id }}" style="font-size: 2rem;">COMMUNITY PRO</h2>
        <div class="community-membership__price-{{ section.id }}">
          {% if community_pro_monthly_selling_plan_id != '' %}
            £19.99/MONTH
          {% else %}
            PAID
          {% endif %}
        </div>
        <p class="community-membership__pricing-note-{{ section.id }}">RECURRING MONTHLY MEMBERSHIP. CANCEL ACCORDING TO STORE SUBSCRIPTION TERMS.</p>
        <p class="community-membership__copy-{{ section.id }}">DEEPER ALERT TOOLS, BETTER TRACKING, AND STRONGER SUPPORTER PRESENCE.</p>
        <ul class="community-membership__list-{{ section.id }}">
          <li>ALL COMMUNITY+ FEATURES</li>
          <li>ADVANCED CASE FOLLOWING TOOLS</li>
          <li>ENHANCED ALERT PREFERENCES</li>
          <li>MORE DETAILED UPDATE TRACKING</li>
          <li>PRIORITY SUPPORT</li>
          <li>SUPPORTER IMPACT PROFILE</li>
        </ul>
        <div class="community-membership__actions-{{ section.id }}">
          {% if community_pro_product and community_pro_variant and community_pro_monthly_selling_plan_id != '' %}
            <form method="post" action="{{ routes.cart_add_url }}">
              <input type="hidden" name="id" value="{{ community_pro_variant.id }}">
              <input type="hidden" name="selling_plan" value="{{ community_pro_monthly_selling_plan_id }}">
              <button type="submit" class="community-membership__cta-{{ section.id }}">JOIN COMMUNITY PRO</button>
            </form>
          {% elsif community_pro_product and community_pro_variant %}
            <span class="community-membership__coming-soon-{{ section.id }}">SUBSCRIPTION SETUP REQUIRED</span>
          {% else %}
            <span class="community-membership__coming-soon-{{ section.id }}">COMING SOON</span>
          {% endif %}
        </div>
        {% if request.design_mode %}
          {% unless community_pro_product %}
            <div class="community-membership__admin-{{ section.id }}">ADMIN: PRODUCT HANDLE NOT FOUND — {{ community_pro_handle }}</div>
          {% else %}
            {% if community_pro_monthly_selling_plan_id == '' %}
              <div class="community-membership__admin-{{ section.id }}">ADMIN: ATTACH A MONTHLY SUBSCRIPTION SELLING PLAN TO THIS PRODUCT.</div>
            {% endif %}
          {% endunless %}
        {% endif %}
      </article>
    </div>

    <div class="community-membership__trust-{{ section.id }}" style="margin-top: 1.5rem;">
      <div class="community-membership__label-{{ section.id }}">TRUST AND SAFETY</div>
      <h2 class="community-membership__title-{{ section.id }}" style="font-size: 1.9rem;">SAFE COMMUNITY ACCESS</h2>
      <p class="community-membership__note-{{ section.id }}">
        COMMUNITY MEMBERSHIP NEVER OVERRIDES CASE SAFETY. CONTACT, CLAIMS, AND SENSITIVE SUPPORT TOOLS REMAIN SUBJECT TO CASE-OWNER RULES, VERIFICATION, AND MODERATION CONTROLS.
      </p>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Community Membership",
  "settings": [
    {
      "type": "text",
      "id": "community_plus_handle",
      "label": "Community+ product handle",
      "default": "community-plus-membership"
    },
    {
      "type": "text",
      "id": "community_pro_handle",
      "label": "Community Pro product handle",
      "default": "community-pro-membership"
    },
    {
      "type": "header",
      "content": "Section padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Top padding",
      "default": 24
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding",
      "default": 36
    }
  ],
  "presets": [
    {
      "name": "Community Membership"
    }
  ]
}
{% endschema %}
