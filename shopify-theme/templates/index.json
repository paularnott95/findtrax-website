    "custom_liquid_fbppYX": {
      "type": "custom-liquid",
      "name": "t:sections.custom-liquid.presets.name",
      "settings": {
        "custom_liquid": "<div style=\"padding:70px 20px;background:radial-gradient(circle at top,#111827 0%,#05070b 55%,#02040a 100%);position:relative;overflow:hidden;\">\n\n  <div style=\"position:absolute;top:-120px;left:-120px;width:320px;height:320px;background:rgba(37,99,235,0.10);filter:blur(120px);border-radius:50%;pointer-events:none;\"></div>\n  <div style=\"position:absolute;bottom:-140px;right:-100px;width:340px;height:340px;background:rgba(217,4,41,0.12);filter:blur(130px);border-radius:50%;pointer-events:none;\"></div>\n\n  <div style=\"max-width:980px;margin:0 auto;position:relative;z-index:2;\">\n\n    <div style=\"background:linear-gradient(145deg,rgba(255,255,255,0.06),rgba(255,255,255,0.02));border:1px solid rgba(255,255,255,0.08);border-radius:26px;padding:48px 28px;box-shadow:0 30px 80px rgba(0,0,0,0.45), inset 0 1px 0 rgba(255,255,255,0.05);backdrop-filter:blur(6px);-webkit-backdrop-filter:blur(6px);position:relative;overflow:hidden;\">\n\n      <div style=\"position:absolute;top:0;left:-35%;width:28%;height:100%;background:linear-gradient(90deg,rgba(255,255,255,0) 0%,rgba(255,255,255,0.10) 50%,rgba(255,255,255,0) 100%);transform:skewX(-20deg);animation:mpaDonateShine 5s linear infinite;pointer-events:none;\"></div>\n\n      <div style=\"max-width:760px;margin:0 auto;text-align:center;position:relative;z-index:2;\">\n\n        <div style=\"display:inline-block;margin-bottom:16px;padding:8px 14px;border-radius:999px;background:rgba(217,4,41,0.12);border:1px solid rgba(217,4,41,0.25);color:#ff8da1;font-size:12px;font-weight:800;letter-spacing:0.7px;text-transform:uppercase;\">\n          SUPPORT THE MISSION\n        </div>\n\n        <h2 style=\"margin:0 0 14px 0;font-size:38px;line-height:1.1;font-weight:900;letter-spacing:0.4px;color:#ffffff;\">\n          SUPPORT THIS PLATFORM\n        </h2>\n\n        <p style=\"margin:0 auto 30px auto;max-width:700px;font-size:17px;line-height:1.7;color:rgba(255,255,255,0.78);\">\n          This platform helps raise awareness for missing people, push urgent cases further, and keep vital appeals in front of more eyes. Your support helps increase reach, improve the website, and keep important cases visible.\n        </p>\n\n        <div style=\"display:flex;justify-content:center;gap:14px;flex-wrap:wrap;margin-bottom:18px;\">\n\n          <div style=\"padding:10px 16px;border-radius:14px;background:rgba(255,255,255,0.04);border:1px solid rgba(255,255,255,0.08);color:#d1d5db;font-size:13px;font-weight:700;\">\n            🔁 More reach\n          </div>\n\n          <div style=\"padding:10px 16px;border-radius:14px;background:rgba(255,255,255,0.04);border:1px solid rgba(255,255,255,0.08);color:#d1d5db;font-size:13px;font-weight:700;\">\n            📢 Stronger awareness\n          </div>\n\n          <div style=\"padding:10px 16px;border-radius:14px;background:rgba(255,255,255,0.04);border:1px solid rgba(255,255,255,0.08);color:#d1d5db;font-size:13px;font-weight:700;\">\n            🌍 Bigger impact\n          </div>\n\n        </div>\n\n        <a href=\"/pages/donate\"\n           style=\"display:inline-block;background:linear-gradient(135deg,#ff1744 0%,#d90429 58%,#a3001e 100%);color:#ffffff;padding:16px 34px;text-decoration:none;border-radius:16px;font-weight:900;font-size:14px;letter-spacing:0.8px;box-shadow:0 16px 36px rgba(217,4,41,0.35), inset 0 1px 0 rgba(255,255,255,0.18);transition:transform .2s ease, box-shadow .2s ease, filter .2s ease;\"\n           onmouseover=\"this.style.transform='translateY(-3px) scale(1.03)';this.style.boxShadow='0 22px 44px rgba(217,4,41,0.45), inset 0 1px 0 rgba(255,255,255,0.18)';this.style.filter='brightness(1.05)'\"\n           onmouseout=\"this.style.transform='none';this.style.boxShadow='0 16px 36px rgba(217,4,41,0.35), inset 0 1px 0 rgba(255,255,255,0.18)';this.style.filter='none'\">\n          DONATE NOW\n        </a>\n\n      </div>\n    </div>\n  </div>\n\n  <style>\n    @keyframes mpaDonateShine {\n      0% { left: -35%; }\n      100% { left: 125%; }\n    }\n  </style>\n</div>",
        "color_scheme": "",
