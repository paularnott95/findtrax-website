    "custom_liquid_VjWcwq": {
      "type": "custom-liquid",
      "name": "TRUST BANNER",
      "settings": {
        "custom_liquid": "<style>\n  .mp-banner-deck{\n    position:relative;\n    margin:0 auto 18px;\n    padding:14px;\n    border-radius:26px;\n    overflow:hidden;\n    background:\n      linear-gradient(180deg, rgba(17,8,8,.97), rgba(8,8,8,.99));\n    border:1px solid rgba(255,255,255,.07);\n    box-shadow:\n      0 18px 44px rgba(0,0,0,.38),\n      inset 0 1px 0 rgba(255,255,255,.04);\n  }\n\n  .mp-banner-deck::before{\n    content:\"\";\n    position:absolute;\n    inset:0;\n    pointer-events:none;\n    background:\n      radial-gradient(circle at 12% 20%, rgba(255,70,70,.10), transparent 24%),\n      radial-gradient(circle at 85% 80%, rgba(255,130,90,.08), transparent 24%);\n    z-index:0;\n  }\n\n  .mp-banner-deck__inner{\n    position:relative;\n    z-index:2;\n  }\n\n  .mp-banner-deck__top{\n    display:flex;\n    justify-content:center;\n    margin-bottom:14px;\n  }\n\n  .mp-banner-deck__badge{\n    display:inline-flex;\n    align-items:center;\n    gap:8px;\n    padding:9px 16px;\n    border-radius:999px;\n    background:linear-gradient(180deg, rgba(68,18,18,.96), rgba(28,10,10,.98));\n    border:1px solid rgba(255,110,110,.18);\n    color:#ffe8d0;\n    font-size:11px;\n    font-weight:900;\n    letter-spacing:.14em;\n    text-transform:uppercase;\n    box-shadow:\n      inset 0 1px 0 rgba(255,255,255,.04),\n      0 10px 20px rgba(0,0,0,.22);\n  }\n\n  .mp-banner-deck__badge-dot{\n    width:8px;\n    height:8px;\n    border-radius:50%;\n    background:#ff4f4f;\n    box-shadow:0 0 12px rgba(255,79,79,.85);\n    animation:mpBannerPulse 1.8s ease-in-out infinite;\n  }\n\n  .mp-banner-deck__grid{\n    display:grid;\n    grid-template-columns:repeat(5, minmax(0,1fr));\n    gap:14px;\n  }\n\n  .mp-banner-card{\n    position:relative;\n    min-height:235px;\n    border-radius:22px;\n    overflow:hidden;\n    display:flex;\n    align-items:flex-end;\n    background:\n      linear-gradient(180deg, rgba(255,255,255,.02), rgba(255,255,255,.00) 20%, rgba(0,0,0,.68) 100%),\n      linear-gradient(135deg, rgba(78,18,18,.88), rgba(19,10,10,.96) 58%, rgba(7,7,7,.98));\n    border:1px solid rgba(255,120,120,.13);\n    box-shadow:\n      inset 0 1px 0 rgba(255,255,255,.04),\n      0 10px 28px rgba(0,0,0,.28);\n    transition:transform .28s ease, box-shadow .28s ease, border-color .28s ease;\n    isolation:isolate;\n  }\n\n  .mp-banner-card:hover{\n    transform:translateY(-4px);\n    border-color:rgba(255,170,120,.28);\n    box-shadow:\n      inset 0 1px 0 rgba(255,255,255,.06),\n      0 16px 34px rgba(0,0,0,.36),\n      0 0 18px rgba(255,70,70,.10);\n  }\n\n  .mp-banner-card::before{\n    content:\"\";\n    position:absolute;\n    inset:-1px;\n    border-radius:22px;\n    padding:1px;\n    background:linear-gradient(120deg,\n      rgba(255,60,60,.10),\n      rgba(255,180,120,.30),\n      rgba(255,60,60,.12),\n      rgba(255,180,120,.20),\n      rgba(255,60,60,.10)\n    );\n    background-size:220% 220%;\n    animation:mpBorderMove 6s linear infinite;\n    -webkit-mask:\n      linear-gradient(#fff 0 0) content-box,\n      linear-gradient(#fff 0 0);\n    -webkit-mask-composite:xor;\n            mask-composite:exclude;\n    pointer-events:none;\n    z-index:3;\n  }\n\n  .mp-banner-card::after{\n    content:\"\";\n    position:absolute;\n    top:0;\n    left:-160%;\n    width:58%;\n    height:100%;\n    transform:skewX(-24deg);\n    background:linear-gradient(90deg, transparent, rgba(255,255,255,.08), transparent);\n    animation:mpBannerSweep 6.8s ease-in-out infinite;\n    pointer-events:none;\n    z-index:2;\n  }\n\n  .mp-banner-card__art{\n    position:absolute;\n    inset:0;\n    z-index:1;\n    pointer-events:none;\n    overflow:hidden;\n  }\n\n  .mp-banner-card__content{\n    position:relative;\n    z-index:4;\n    width:100%;\n    padding:18px 16px 16px;\n    background:linear-gradient(180deg, rgba(0,0,0,0), rgba(9,9,9,.08) 10%, rgba(8,8,8,.68) 100%);\n  }\n\n  .mp-banner-card__eyebrow{\n    display:inline-flex;\n    align-items:center;\n    gap:7px;\n    margin-bottom:10px;\n    padding:6px 10px;\n    border-radius:999px;\n    background:rgba(255,70,70,.10);\n    border:1px solid rgba(255,120,120,.14);\n    color:#ffd8c7;\n    font-size:10px;\n    font-weight:900;\n    letter-spacing:.12em;\n    text-transform:uppercase;\n  }\n\n  .mp-banner-card__eyebrow-dot{\n    width:7px;\n    height:7px;\n    border-radius:50%;\n    background:#ff5959;\n    box-shadow:0 0 10px rgba(255,89,89,.78);\n    flex:0 0 auto;\n  }\n\n  .mp-banner-card__title{\n    margin:0 0 8px;\n    color:#fff2df;\n    font-size:20px;\n    line-height:1.02;\n    font-weight:900;\n    letter-spacing:.03em;\n    text-transform:uppercase;\n    text-shadow:0 2px 10px rgba(0,0,0,.30);\n  }\n\n  .mp-banner-card__text{\n    margin:0 0 14px;\n    color:rgba(255,235,220,.84);\n    font-size:13px;\n    line-height:1.35;\n    font-weight:700;\n  }\n\n  .mp-banner-card__btn{\n    display:inline-flex;\n    align-items:center;\n    justify-content:center;\n    min-height:42px;\n    padding:11px 16px;\n    border-radius:999px;\n    text-decoration:none;\n    background:linear-gradient(180deg, #ff4b4b, #b91515);\n    color:#fff;\n    font-size:12px;\n    font-weight:900;\n    letter-spacing:.08em;\n    text-transform:uppercase;\n    border:1px solid rgba(255,255,255,.10);\n    box-shadow:\n      inset 0 1px 0 rgba(255,255,255,.14),\n      0 8px 18px rgba(185,22,22,.32);\n    transition:transform .22s ease, box-shadow .22s ease, filter .22s ease;\n  }\n\n  .mp-banner-card__btn:hover{\n    transform:translateY(-1px);\n    filter:brightness(1.06);\n    box-shadow:\n      inset 0 1px 0 rgba(255,255,255,.16),\n      0 10px 22px rgba(185,22,22,.40);\n  }\n\n  /* DRAWN BACKGROUNDS */\n\n  .mp-banner-card--one .mp-banner-card__art{\n    background:\n      radial-gradient(circle at 25% 30%, rgba(255,120,120,.16), transparent 20%),\n      linear-gradient(90deg, transparent 48%, rgba(255,180,120,.10) 50%, transparent 52%),\n      linear-gradient(0deg, transparent 48%, rgba(255,180,120,.07) 50%, transparent 52%);\n  }\n\n  .mp-banner-card--one .mp-banner-card__art::before,\n  .mp-banner-card--one .mp-banner-card__art::after{\n    content:\"\";\n    position:absolute;\n    border-radius:50%;\n    border:1px solid rgba(255,190,140,.14);\n    animation:mpRadar 5.5s linear infinite;\n  }\n\n  .mp-banner-card--one .mp-banner-card__art::before{\n    width:120px;\n    height:120px;\n    top:18px;\n    right:18px;\n  }\n\n  .mp-banner-card--one .mp-banner-card__art::after{\n    width:170px;\n    height:170px;\n    top:-7px;\n    right:-7px;\n    animation-delay:1.2s;\n  }\n\n  .mp-banner-card--two .mp-banner-card__art{\n    background:\n      linear-gradient(120deg, transparent 0 28%, rgba(255,120,120,.08) 29% 31%, transparent 32%),\n      linear-gradient(140deg, transparent 0 55%, rgba(255,190,140,.07) 56% 58%, transparent 59%),\n      radial-gradient(circle at 78% 24%, rgba(255,95,95,.18), transparent 22%);\n  }\n\n  .mp-banner-card--two .mp-banner-card__art::before{\n    content:\"\";\n    position:absolute;\n    width:160px;\n    height:2px;\n    background:linear-gradient(90deg, transparent, rgba(255,190,140,.26), transparent);\n    top:42px;\n    left:-30px;\n    transform:rotate(-25deg);\n    animation:mpSignalMove 4.8s ease-in-out infinite;\n  }\n\n  .mp-banner-card--three .mp-banner-card__art{\n    background:\n      radial-gradient(circle at 18% 22%, rgba(255,170,120,.15), transparent 16%),\n      radial-gradient(circle at 76% 28%, rgba(255,90,90,.16), transparent 18%),\n      linear-gradient(90deg, rgba(255,255,255,.03) 1px, transparent 1px),\n      linear-gradient(0deg, rgba(255,255,255,.02) 1px, transparent 1px);\n    background-size:auto, auto, 24px 24px, 24px 24px;\n  }\n\n  .mp-banner-card--three .mp-banner-card__art::before,\n  .mp-banner-card--three .mp-banner-card__art::after{\n    content:\"\";\n    position:absolute;\n    background:rgba(255,190,140,.18);\n    border-radius:999px;\n  }\n\n  .mp-banner-card--three .mp-banner-card__art::before{\n    width:90px;\n    height:1px;\n    top:44px;\n    left:28px;\n    box-shadow:\n      55px 26px 0 rgba(255,120,120,.16),\n      115px 8px 0 rgba(255,190,140,.14);\n  }\n\n  .mp-banner-card--three .mp-banner-card__art::after{\n    width:8px;\n    height:8px;\n    top:40px;\n    left:22px;\n    box-shadow:\n      56px 26px 0 0 rgba(255,120,120,.84),\n      114px 8px 0 0 rgba(255,190,140,.84);\n  }\n\n  .mp-banner-card--four .mp-banner-card__art{\n    background:\n      linear-gradient(135deg, transparent 0 62%, rgba(255,120,120,.06) 63% 65%, transparent 66%),\n      radial-gradient(circle at 24% 24%, rgba(255,180,120,.18), transparent 22%);\n  }\n\n  .mp-banner-card--four .mp-banner-card__art::before{\n    content:\"\";\n    position:absolute;\n    inset:16px;\n    border-radius:18px;\n    border:1px solid rgba(255,190,140,.08);\n    box-shadow:\n      inset 0 0 0 1px rgba(255,120,120,.04);\n  }\n\n  .mp-banner-card--four .mp-banner-card__art::after{\n    content:\"\";\n    position:absolute;\n    width:170px;\n    height:170px;\n    border-radius:50%;\n    border:1px solid rgba(255,190,140,.10);\n    right:-40px;\n    top:-30px;\n    animation:mpRadarSlow 8s linear infinite;\n  }\n\n  .mp-banner-card--five .mp-banner-card__art{\n    background:\n      radial-gradient(circle at 22% 25%, rgba(255,120,120,.18), transparent 18%),\n      radial-gradient(circle at 70% 35%, rgba(255,180,120,.12), transparent 20%),\n      linear-gradient(90deg, transparent 20%, rgba(255,255,255,.03) 20.5%, transparent 21%, transparent 60%, rgba(255,255,255,.03) 60.5%, transparent 61%);\n  }\n\n  .mp-banner-card--five .mp-banner-card__art::before{\n    content:\"\";\n    position:absolute;\n    width:190px;\n    height:190px;\n    border-radius:50%;\n    border:1px dashed rgba(255,190,140,.14);\n    bottom:-70px;\n    right:-25px;\n    animation:mpRotate 15s linear infinite;\n  }\n\n  .mp-banner-card--five .mp-banner-card__art::after{\n    content:\"\";\n    position:absolute;\n    width:88px;\n    height:2px;\n    background:linear-gradient(90deg, transparent, rgba(255,190,140,.30), transparent);\n    bottom:62px;\n    right:36px;\n    transform:rotate(-28deg);\n    animation:mpSignalMove 5.5s ease-in-out infinite;\n  }\n\n  @keyframes mpBannerSweep{\n    0%{ left:-160%; }\n    55%{ left:170%; }\n    100%{ left:170%; }\n  }\n\n  @keyframes mpBorderMove{\n    0%{ background-position:0% 50%; }\n    100%{ background-position:200% 50%; }\n  }\n\n  @keyframes mpBannerPulse{\n    0%,100%{ transform:scale(1); opacity:1; }\n    50%{ transform:scale(1.18); opacity:.74; }\n  }\n\n  @keyframes mpRadar{\n    0%{ transform:scale(.94); opacity:.55; }\n    50%{ transform:scale(1); opacity:.9; }\n    100%{ transform:scale(1.06); opacity:.55; }\n  }\n\n  @keyframes mpRadarSlow{\n    0%{ transform:rotate(0deg); opacity:.65; }\n    50%{ opacity:.9; }\n    100%{ transform:rotate(360deg); opacity:.65; }\n  }\n\n  @keyframes mpSignalMove{\n    0%,100%{ transform:translateX(0) rotate(-25deg); opacity:.45; }\n    50%{ transform:translateX(10px) rotate(-25deg); opacity:.95; }\n  }\n\n  @keyframes mpRotate{\n    0%{ transform:rotate(0deg); }\n    100%{ transform:rotate(360deg); }\n  }\n\n  @media screen and (max-width: 1200px){\n    .mp-banner-deck__grid{\n      grid-template-columns:repeat(3, minmax(0,1fr));\n    }\n  }\n\n  @media screen and (max-width: 989px){\n    .mp-banner-deck{\n      padding:12px 10px;\n      border-radius:22px;\n    }\n\n    .mp-banner-deck__grid{\n      display:flex;\n      gap:12px;\n      overflow-x:auto;\n      scroll-snap-type:x mandatory;\n      -webkit-overflow-scrolling:touch;\n      padding-bottom:4px;\n    }\n\n    .mp-banner-deck__grid::-webkit-scrollbar{\n      height:6px;\n    }\n\n    .mp-banner-deck__grid::-webkit-scrollbar-thumb{\n      background:rgba(255,255,255,.15);\n      border-radius:999px;\n    }\n\n    .mp-banner-card{\n      min-width:280px;\n      min-height:220px;\n      scroll-snap-align:start;\n    }\n\n    .mp-banner-card__title{\n      font-size:18px;\n    }\n  }\n\n  @media screen and (max-width: 749px){\n    .mp-banner-card{\n      min-width:260px;\n      min-height:212px;\n    }\n\n    .mp-banner-card__content{\n      padding:16px 14px 14px;\n    }\n\n    .mp-banner-card__title{\n      font-size:17px;\n    }\n\n    .mp-banner-card__text{\n      font-size:12px;\n    }\n  }\n</style>\n\n<div class=\"mp-banner-deck\">\n  <div class=\"mp-banner-deck__inner\">\n    <div class=\"mp-banner-deck__top\">\n      <div class=\"mp-banner-deck__badge\">\n        <span class=\"mp-banner-deck__badge-dot\"></span>\n        TRUSTED GLOBAL MISSING PERSON PLATFORM\n      </div>\n    </div>\n\n    <div class=\"mp-banner-deck__grid\">\n      <div class=\"mp-banner-card mp-banner-card--one\">\n        <div class=\"mp-banner-card__art\"></div>\n        <div class=\"mp-banner-card__content\">\n          <div class=\"mp-banner-card__eyebrow\">\n            <span class=\"mp-banner-card__eyebrow-dot\"></span>\n            GLOBAL TRUST\n          </div>\n          <h3 class=\"mp-banner-card__title\">TRUSTED AROUND THE WORLD</h3>\n          <p class=\"mp-banner-card__text\">A public-led platform built for fast visibility, wider reach and stronger missing person awareness.</p>\n          <a href=\"/blogs/missing-persons\" class=\"mp-banner-card__btn\">VIEW CASES</a>\n        </div>\n      </div>\n\n      <div class=\"mp-banner-card mp-banner-card--two\">\n        <div class=\"mp-banner-card__art\"></div>\n        <div class=\"mp-banner-card__content\">\n          <div class=\"mp-banner-card__eyebrow\">\n            <span class=\"mp-banner-card__eyebrow-dot\"></span>\n            ALERT REACH\n          </div>\n          <h3 class=\"mp-banner-card__title\">INSTANT GLOBAL ALERTS</h3>\n          <p class=\"mp-banner-card__text\">Designed to push urgent missing person visibility faster and help important cases spread wider.</p>\n          <a href=\"/pages/alerts\" class=\"mp-banner-card__btn\">GET ALERTS</a>\n        </div>\n      </div>\n\n      <div class=\"mp-banner-card mp-banner-card--three\">\n        <div class=\"mp-banner-card__art\"></div>\n        <div class=\"mp-banner-card__content\">\n          <div class=\"mp-banner-card__eyebrow\">\n            <span class=\"mp-banner-card__eyebrow-dot\"></span>\n            FREE SUBMISSION\n          </div>\n          <h3 class=\"mp-banner-card__title\">FREE CASE UPLOADS</h3>\n          <p class=\"mp-banner-card__text\">Simple submission tools designed to help missing person cases get seen and shared quickly.</p>\n          <a href=\"/pages/report-a-missing-person\" class=\"mp-banner-card__btn\">SUBMIT CASE</a>\n        </div>\n      </div>\n\n      <div class=\"mp-banner-card mp-banner-card--four\">\n        <div class=\"mp-banner-card__art\"></div>\n        <div class=\"mp-banner-card__content\">\n          <div class=\"mp-banner-card__eyebrow\">\n            <span class=\"mp-banner-card__eyebrow-dot\"></span>\n            LIVE TRACKING\n          </div>\n          <h3 class=\"mp-banner-card__title\">LIVE CASE UPDATES</h3>\n          <p class=\"mp-banner-card__text\">Follow important developments, major changes and found safe updates in one central place.</p>\n          <a href=\"/blogs/found-safe\" class=\"mp-banner-card__btn\">VIEW UPDATES</a>\n        </div>\n      </div>\n\n      <div class=\"mp-banner-card mp-banner-card--five\">\n        <div class=\"mp-banner-card__art\"></div>\n        <div class=\"mp-banner-card__content\">\n          <div class=\"mp-banner-card__eyebrow\">\n            <span class=\"mp-banner-card__eyebrow-dot\"></span>\n            TAKE ACTION\n          </div>\n          <h3 class=\"mp-banner-card__title\">HELP BRING THEM HOME</h3>\n          <p class=\"mp-banner-card__text\">Support visibility, share urgent alerts and help more missing people get seen faster.</p>\n          <a href=\"/pages/donate\" class=\"mp-banner-card__btn\">SUPPORT NOW</a>\n        </div>\n      </div>\n    </div>\n  </div>\n</div>",
