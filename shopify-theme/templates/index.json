    "custom_liquid_Grnzaj": {
      "type": "custom-liquid",
      "name": "t:sections.custom-liquid.presets.name",
      "settings": {
        "custom_liquid": "<style>\n.mpa-found-wrap{\n  max-width:1200px;\n  margin:20px auto 20px auto;\n  padding:20px;\n  background:#101214;\n  border:1px solid rgba(255,255,255,0.05);\n  border-radius:18px;\n}\n\n.mpa-found-head{\n  display:flex;\n  align-items:center;\n  justify-content:space-between;\n  margin-bottom:18px;\n}\n\n.mpa-found-grid{\n  display:grid;\n  grid-template-columns:repeat(auto-fit,minmax(260px,1fr));\n  gap:20px;\n}\n\n.mpa-found-link{\n  text-decoration:none;\n  color:inherit;\n  display:block;\n  height:100%;\n}\n\n.mpa-found-card{\n  background:#17191c;\n  border:1px solid rgba(255,255,255,0.06);\n  border-radius:16px;\n  overflow:hidden;\n  box-shadow:0 10px 24px rgba(0,0,0,0.22);\n  transition:transform .2s ease, box-shadow .2s ease;\n  height:100%;\n  display:flex;\n  flex-direction:column;\n}\n\n.mpa-found-card:hover{\n  transform:translateY(-6px) scale(1.02);\n  box-shadow:0 20px 40px rgba(0,0,0,0.35);\n}\n\n.mpa-found-image-wrap{\n  position:relative;\n  overflow:hidden;\n}\n\n.mpa-found-image{\n  width:100%;\n  height:220px;\n  object-fit:cover;\n  display:block;\n  transition:transform .3s ease;\n}\n\n.mpa-found-image--protected{\n  position:relative;\n  display:flex;\n  align-items:center;\n  justify-content:center;\n  background:linear-gradient(135deg, rgba(17,24,39,.96), rgba(20,83,45,.94));\n  color:#dcfce7;\n  font-size:18px;\n  font-weight:900;\n  letter-spacing:.16em;\n  text-transform:uppercase;\n  isolation:isolate;\n}\n\n.mpa-found-image__blur{\n  position:absolute;\n  inset:-34px;\n  background-size:cover;\n  background-position:center;\n  filter:blur(42px);\n  transform:scale(1.2);\n  opacity:.72;\n  z-index:-2;\n}\n\n.mpa-found-image__overlay{\n  position:absolute;\n  inset:0;\n  background:linear-gradient(135deg, rgba(3,7,18,.76), rgba(20,83,45,.84));\n  z-index:-1;\n}\n\n.mpa-found-image__label{\n  padding:10px 14px;\n  border-radius:999px;\n  background:rgba(15,23,42,.74);\n  border:1px solid rgba(255,255,255,.22);\n  box-shadow:0 12px 30px rgba(0,0,0,.34);\n}\n\n.mpa-found-card:hover .mpa-found-image{\n  transform:scale(1.05);\n}\n\n.mpa-found-badge{\n  position:absolute;\n  top:10px;\n  left:10px;\n  background:linear-gradient(135deg,#32c96b,#15803d);\n  color:#fff;\n  padding:6px 12px;\n  font-size:12px;\n  font-weight:800;\n  border-radius:8px;\n  box-shadow:0 4px 10px rgba(0,0,0,0.4);\n  border:1px solid rgba(255,255,255,0.15);\n  letter-spacing:.5px;\n}\n\n.mpa-found-text{\n  padding:16px;\n  min-height:120px;\n  display:flex;\n  flex-direction:column;\n  justify-content:flex-start;\n}\n\n.mpa-found-meta-row{\n  display:flex;\n  justify-content:space-between;\n  align-items:center;\n  gap:10px;\n  margin:0 0 10px 0;\n  flex-wrap:wrap;\n}\n\n.mpa-found-meta{\n  margin:0;\n  color:#b8ffd2;\n  font-size:12px;\n  font-weight:800;\n  letter-spacing:.6px;\n  text-transform:uppercase;\n}\n\n.mpa-found-date{\n  margin:0;\n  color:#9ad0ff;\n  font-size:12px;\n  font-weight:700;\n  letter-spacing:.4px;\n  text-transform:uppercase;\n}\n\n.mpa-found-title{\n  margin:0 0 8px 0;\n  color:#fff;\n  font-size:18px;\n  line-height:1.3;\n  font-weight:700;\n}\n\n.mpa-found-excerpt{\n  margin:0;\n  color:rgba(255,255,255,0.78);\n  font-size:14px;\n  line-height:1.5;\n}\n\n@media (min-width:1100px){\n  .mpa-found-grid{\n    grid-template-columns:repeat(4,1fr);\n  }\n}\n</style>\n\n<div class=\"mpa-found-wrap\">\n\n  <div class=\"mpa-found-head\">\n    <h2 style=\"margin:0;color:#ffffff;font-size:28px;font-weight:700;\">\n      FOUND SAFE UPDATES\n    </h2>\n    <a href=\"/blogs/found-safe\" style=\"color:#ffffff;text-decoration:none;font-weight:600;\">\n      View all\n    </a>\n  </div>\n\n  <div class=\"mpa-found-grid\">\n\n   {% if blogs['found-safe'].articles_count > 0 %}\n  {% for article in blogs['found-safe'].articles limit:4 %}\n\n    <a href=\"{{ article.url }}\" class=\"mpa-found-link\">\n      <div class=\"mpa-found-card\">\n\n        <div class=\"mpa-found-image-wrap\">\n          <div class=\"mpa-found-image mpa-found-image--protected\" aria-label=\"Found safe photo protected\">\n            {% if article.image %}\n              <span class=\"mpa-found-image__blur\" style=\"background-image:url('{{ article.image | image_url: width: 800 }}');\"></span>\n            {% endif %}\n            <span class=\"mpa-found-image__overlay\"></span>\n            <span class=\"mpa-found-image__label\">FOUND SAFE</span>\n          </div>\n\n          <div class=\"mpa-found-badge\">✅ FOUND SAFE</div>\n        </div>\n\n        <div class=\"mpa-found-text\">\n          <div class=\"mpa-found-meta-row\">\n            <div class=\"mpa-found-meta\">GOOD NEWS</div>\n            <div class=\"mpa-found-date\">{{ article.published_at | date: \"%d %b %Y\" }}</div>\n          </div>\n\n          <h3 class=\"mpa-found-title\">{{ article.title }}</h3>\n\n          <p class=\"mpa-found-excerpt\">\n            {{ article.excerpt | strip_html | truncate: 95 }}\n          </p>\n        </div>\n\n      </div>\n    </a>\n\n      {% endfor %}\n{% else %}\n  <div style=\"background:#17191c;border:1px solid rgba(255,255,255,0.06);border-radius:16px;padding:24px;color:rgba(255,255,255,0.78);\">\n    No found safe updates yet.\n  </div>\n{% endif %}\n\n  </div>\n\n</div>",
        "color_scheme": "",
        "padding_top": 40,
        "padding_bottom": 52
      }
    },
    "custom_liquid_yhPyMe": {
      "type": "custom-liquid",
      "name": "t:sections.custom-liquid.presets.name",
      "settings": {
        "custom_liquid": "<div style=\"padding:28px 20px;background:linear-gradient(135deg,#05070b 0%,#0f1117 45%,#111827 100%);position:relative;overflow:hidden;border-top:1px solid rgba(255,255,255,0.06);border-bottom:1px solid rgba(255,255,255,0.06);\">\n\n  <div style=\"position:absolute;inset:0;pointer-events:none;overflow:hidden;\">\n    <div style=\"position:absolute;top:0;left:-35%;width:30%;height:100%;background:linear-gradient(90deg,rgba(255,255,255,0) 0%,rgba(255,255,255,0.08) 50%,rgba(255,255,255,0) 100%);transform:skewX(-20deg);animation:mpaShine 4.5s linear infinite;\"></div>\n  </div>\n\n  <div style=\"max-width:980px;margin:0 auto;position:relative;z-index:2;\">\n    <div style=\"display:flex;align-items:center;justify-content:space-between;gap:20px;flex-wrap:wrap;\">\n\n      <div style=\"flex:1 1 320px;min-width:260px;text-align:left;\">\n        <h2 style=\"margin:0 0 6px 0;font-size:24px;line-height:1.1;font-weight:800;color:#ffffff;letter-spacing:0.4px;\">\n          GET MISSING PERSON ALERTS\n        </h2>\n\n        <p style=\"margin:0;color:rgba(255,255,255,0.72);font-size:14px;line-height:1.4;\">\n          Be the first to see urgent cases and major updates.\n        </p>\n      </div>\n\n      <div style=\"flex:1 1 460px;min-width:280px;\">\n        <form method=\"post\" action=\"/contact#contact_form\" accept-charset=\"UTF-8\" style=\"margin:0;\">\n          <input type=\"hidden\" name=\"form_type\" value=\"customer\">\n          <input type=\"hidden\" name=\"utf8\" value=\"✓\">\n\n          <div style=\"display:flex;gap:10px;align-items:center;justify-content:flex-end;flex-wrap:wrap;\">\n\n            <input\n              type=\"email\"\n              name=\"contact[email]\"\n              aria-label=\"Email address\"\n              required\n              style=\"flex:1 1 280px;min-width:240px;height:48px;padding:0 16px;background:linear-gradient(135deg,rgba(255,255,255,0.96),rgba(240,240,240,0.98));color:#111827;border:1px solid rgba(255,255,255,0.5);border-radius:14px;outline:none;font-size:14px;font-weight:600;box-shadow:inset 0 1px 0 rgba(255,255,255,0.6),0 6px 18px rgba(0,0,0,0.18);transition:border-color .25s ease, box-shadow .25s ease, transform .25s ease;\"\n              onfocus=\"this.style.borderColor='#9ca3af';this.style.boxShadow='0 0 0 3px rgba(255,255,255,0.10), 0 10px 24px rgba(0,0,0,0.25)';this.style.transform='translateY(-1px)'\"\n              onblur=\"this.style.borderColor='rgba(255,255,255,0.5)';this.style.boxShadow='inset 0 1px 0 rgba(255,255,255,0.6),0 6px 18px rgba(0,0,0,0.18)';this.style.transform='none'\"\n            >\n\n            <button\n              type=\"submit\"\n              style=\"height:48px;padding:0 22px;background:linear-gradient(135deg,#ff1744 0%,#d90429 55%,#a3001e 100%);color:#ffffff;border:none;border-radius:14px;font-size:13px;font-weight:800;letter-spacing:0.6px;cursor:pointer;box-shadow:0 10px 24px rgba(217,4,41,0.35), inset 0 1px 0 rgba(255,255,255,0.16);transition:transform .2s ease, box-shadow .2s ease, filter .2s ease;\"\n              onmouseover=\"this.style.transform='translateY(-2px) scale(1.02)';this.style.boxShadow='0 14px 30px rgba(217,4,41,0.45), inset 0 1px 0 rgba(255,255,255,0.16)';this.style.filter='brightness(1.05)'\"\n              onmouseout=\"this.style.transform='none';this.style.boxShadow='0 10px 24px rgba(217,4,41,0.35), inset 0 1px 0 rgba(255,255,255,0.16)';this.style.filter='none'\">\n              SIGN UP\n            </button>\n\n          </div>\n        </form>\n      </div>\n\n    </div>\n  </div>\n\n  <style>\n    @keyframes mpaShine {\n      0% { left: -35%; }\n      100% { left: 125%; }\n    }\n\n    @media (max-width: 749px) {\n      .mpa-alert-stack {\n        flex-direction: column;\n      }\n    }\n  </style>\n</div>",
        "color_scheme": "",
        "padding_top": 0,
        "padding_bottom": 48
      }
    },
