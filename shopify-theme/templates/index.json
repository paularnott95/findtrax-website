      "name": "t:sections.custom-liquid.presets.name",
      "settings": {
        "custom_liquid": "<div style=\"max-width:1200px;margin:20px auto;padding:0 20px;\">\n  <div style=\"\n    background:linear-gradient(135deg,#1a1d21,#111315);\n    border:1px solid rgba(255,255,255,0.06);\n    border-radius:18px;\n    padding:22px;\n    display:flex;\n    justify-content:space-between;\n    align-items:center;\n    gap:16px;\n    flex-wrap:wrap;\n  \">\n    <div>\n      <div style=\"color:#ffffff;font-size:22px;font-weight:800;margin-bottom:6px;\">SUPPORT THE WEBSITE</div>\n      <div style=\"color:rgba(255,255,255,0.78);font-size:14px;\">\n        Help keep urgent missing person alerts visible, updated, and shared.\n      </div>\n    </div>\n\n    <a href=\"/pages/donate\" style=\"\n      display:inline-block;\n      padding:14px 22px;\n      border-radius:999px;\n      background:linear-gradient(180deg,#c21c1c 0%,#6e0f0f 100%);\n      color:#ffffff;\n      text-decoration:none;\n      font-weight:800;\n      box-shadow:0 10px 24px rgba(0,0,0,0.28);\n    \">\n      ❤️ DONATE NOW\n    </a>\n  </div>\n</div>",
