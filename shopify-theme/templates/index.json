        "custom_liquid": "{% assign active_blog = blogs['missing-persons'] %}\n{% assign found_blog = blogs['found-safe'] %}\n{% assign active_count = active_blog.articles_count | default: 0 %}\n{% assign found_count = found_blog.articles_count | default: 0 %}\n\n<div style=\"max-width:1200px;margin:0 auto 12px auto;padding:12px 16px;border:1px solid rgba(255,255,255,0.08);border-radius:14px;background:linear-gradient(180deg,#0c0c0e,#09090b);display:flex;gap:12px;align-items:center;justify-content:space-between;flex-wrap:wrap;\">\n  <div style=\"display:flex;flex-direction:column;align-items:flex-start;justify-content:center;color:#ffffff;font-weight:900;letter-spacing:0.12em;text-transform:uppercase;white-space:nowrap;line-height:1.1;\">\n    MISSING ALERTS\n    <small style=\"font-size:9px;font-weight:900;letter-spacing:1px;opacity:0.78;margin-top:2px;\">VERIFIED APPEALS</small>\n  </div>\n\n  <div style=\"flex:1 1 340px;min-width:240px;color:rgba(255,255,255,0.72);font-weight:700;font-size:13px;line-height:1.35;\">\n    Helping people find verified missing person appeals, safety advice, and local alert information.\n  </div>\n\n  <div style=\"white-space:nowrap;color:#ffffff;font-weight:900;font-size:13px;letter-spacing:0.3px;\">\n    {{ active_count }} ACTIVE • {{ found_count }} FOUND SAFE\n  </div>\n</div>",
