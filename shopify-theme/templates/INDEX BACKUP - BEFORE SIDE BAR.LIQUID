gba(255,255,255,0.5);border-radius:14px;outline:none;font-size:14px;font-weight:600;box-shadow:inset 0 1px 0 rgba(255,255,255,0.6),0 6px 18px rgba(0,0,0,0.18);transition:border-color .25s ease, box-shadow .25s ease, transform .25s ease;\"\n              onfocus=\"this.style.borderColor='#9ca3af';this.style.boxShadow='0 0 0 3px rgba(255,255,255,0.10), 0 10px 24px rgba(0,0,0,0.25)';this.style.transform='translateY(-1px)'\"\n              onblur=\"this.style.borderColor='rgba(255,255,255,0.5)';this.style.boxShadow='inset 0 1px 0 rgba(255,255,255,0.6),0 6px 18px rgba(0,0,0,0.18)';this.style.transform='none'\"\n            >\n\n            <button\n              type=\"submit\"\n              style=\"height:48px;padding:0 22px;background:linear-gradient(135deg,#ff1744 0%,#d90429 55%,#a3001e 100%);color:#ffffff;border:none;border-radius:14px;font-size:13px;font-weight:800;letter-spacing:0.6px;cursor:pointer;box-shadow:0 10px 24px rgba(217,4,41,0.35), inset 0 1px 0 rgba(255,255,255,0.16);transition:transform .2s ease, box-shadow .2s ease, filter .2s ease;\"\n              onmouseover=\"this.style.transform='translateY(-2px) scale(1.02)';this.style.boxShadow='0 14px 30px rgba(217,4,41,0.45), inset 0 1px 0 rgba(255,255,255,0.16)';this.style.filter='brightness(1.05)'\"\n              onmouseout=\"this.style.transform='none';this.style.boxShadow='0 10px 24px rgba(217,4,41,0.35), inset 0 1px 0 rgba(255,255,255,0.16)';this.style.filter='none'\">\n              SIGN UP\n            </button>\n\n          </div>\n        </form>\n      </div>\n\n    </div>\n  </div>\n\n  <style>\n    @keyframes mpaShine {\n      0% { left: -35%; }\n      100% { left: 125%; }\n    }\n\n    @media (max-width: 749px) {\n      .mpa-alert-stack {\n        flex-direction: column;\n      }\n    }\n  </style>\n</div>",
