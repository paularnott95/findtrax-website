        "custom_liquid": "<style>\n.mpa-found-wrap{\n  max-width:1200px;\n  margin:20px auto 20px auto;\n  padding:20px;\n  background:#101214;\n  border:1px solid rgba(255,255,255,0.05);\n  border-radius:18px;\n}\n\n.mpa-found-head{\n  display:flex;\n  align-items:center;\n  justify-content:space-between;\n  margin-bottom:18px;\n}\n\n.mpa-found-grid{\n  display:grid;\n  grid-template-columns:repeat(auto-fit,minmax(260px,1fr));\n  gap:20px;\n}\n\n.mpa-found-link{\n  text-decoration:none;\n  color:inherit;\n  display:block;\n  height:100%;\n}\n\n.mpa-found-card{\n  background:#17191c;\n  border:1px solid rgba(255,255,255,0.06);\n  border-radius:16px;\n  overflow:hidden;\n  box-shadow:0 10px 24px rgba(0,0,0,0.22);\n  transition:transform .2s ease, box-shadow .2s ease;\n  height:100%;\n  display:flex;\n  flex-direction:column;\n}\n\n.mpa-found-card:hover{\n  transform:translateY(-6px) scale(1.02);\n  box-shadow:0 20px 40px rgba(0,0,0,0.35);\n}\n\n.mpa-found-image-wrap{\n  position:relative;\n  overflow:hidden;\n}\n\n.mpa-found-image{\n  width:100%;\n  height:220px;\n  object-fit:cover;\n  display:block;\n  transition:transform .3s ease;\n}\n\n.mpa-found-card:hover .mpa-found-image{\n  transform:scale(1.05);\n}\n\n.mpa-found-badge{\n  position:absolute;\n  top:10px;\n  left:10px;\n  background:linear-gradient(135deg,#32c96b,#15803d);\n  color:#fff;\n  padding:6px 12px;\n  font-size:12px;\n  font-weight:800;\n  border-radius:8px;\n  box-shadow:0 4px 10px rgba(0,0,0,0.4);\n  border:1px solid rgba(255,255,255,0.15);\n  letter-spacing:.5px;\n}\n\n.mpa-found-text{\n  padding:16px;\n  min-height:120px;\n  display:flex;\n  flex-direction:column;\n  justify-content:flex-start;\n}\n\n.mpa-found-meta-row{\n  display:flex;\n  justify-content:space-between;\n  align-items:center;\n  gap:10px;\n  margin:0 0 10px 0;\n  flex-wrap:wrap;\n}\n\n.mpa-found-meta{\n  margin:0;\n  color:#b8ffd2;\n  font-size:12px;\n  font-weight:800;\n  letter-spacing:.6px;\n  text-transform:uppercase;\n}\n\n.mpa-found-date{\n  margin:0;\n  color:#9ad0ff;\n  font-size:12px;\n  font-weight:700;\n  letter-spacing:.4px;\n  text-transform:uppercase;\n}\n\n.mpa-found-title{\n  margin:0 0 8px 0;\n  color:#fff;\n  font-size:18px;\n  line-height:1.3;\n  font-weight:700;\n}\n\n.mpa-found-excerpt{\n  margin:0;\n  color:rgba(255,255,255,0.78);\n  font-size:14px;\n  line-height:1.5;\n}\n\n@media (min-width:1100px){\n  .mpa-found-grid{\n    grid-template-columns:repeat(4,1fr);\n  }\n}\n</style>\n\n<div class=\"mpa-found-wrap\">\n\n  <div class=\"mpa-found-head\">\n    <h2 style=\"margin:0;color:#ffffff;font-size:28px;font-weight:700;\">\n      FOUND SAFE UPDATES\n    </h2>\n    <a href=\"/blogs/found-safe\" style=\"color:#ffffff;text-decoration:none;font-weight:600;\">\n      View all\n    </a>\n  </div>\n\n  <div class=\"mpa-found-grid\">\n\n   {% if blogs['found-safe'].articles_count > 0 %}\n  {% for article in blogs['found-safe'].articles limit:4 %}\n\n    <a href=\"{{ article.url }}\" class=\"mpa-found-link\">\n      <div class=\"mpa-found-card\">\n\n        <div class=\"mpa-found-image-wrap\">\n          {% if article.image %}\n            <img\n              src=\"{{ article.image | image_url: width: 700 }}\"\n              alt=\"{{ article.title | escape }}\"\n              class=\"mpa-found-image\"\n            >\n          {% endif %}\n\n          <div class=\"mpa-found-badge\">✅ FOUND SAFE</div>\n        </div>\n\n        <div class=\"mpa-found-text\">\n          <div class=\"mpa-found-meta-row\">\n            <div class=\"mpa-found-meta\">GOOD NEWS</div>\n            <div class=\"mpa-found-date\">{{ article.published_at | date: \"%d %b %Y\" }}</div>\n          </div>\n\n          <h3 class=\"mpa-found-title\">{{ article.title }}</h3>\n\n          <p class=\"mpa-found-excerpt\">\n            {{ article.excerpt | strip_html | truncate: 95 }}\n          </p>\n        </div>\n\n      </div>\n    </a>\n\n      {% endfor %}\n{% else %}\n  <div style=\"background:#17191c;border:1px solid rgba(255,255,255,0.06);border-radius:16px;padding:24px;color:rgba(255,255,255,0.78);\">\n    No found safe updates yet.\n  </div>\n{% endif %}\n\n  </div>\n\n</div>",
