le(1); box-shadow:0 0 10px rgba(255,0,0,0.6); }\n  50%{ transform:scale(1.08); box-shadow:0 0 18px rgba(255,0,0,1); }\n  100%{ transform:scale(1); box-shadow:0 0 10px rgba(255,0,0,0.6); }\n}\n\n@media screen and (max-width: 989px){\n  .mpa-status-bar{\n    flex-direction:column;\n    align-items:stretch;\n    gap:10px;\n  }\n\n  .mpa-status-title,\n  .mpa-status-right{\n    justify-content:center;\n    text-align:center;\n  }\n\n  .mpa-status-right{\n    flex-wrap:wrap;\n  }\n}\n</style>\n\n{% assign active_blog = blogs['missing-persons'] %}\n{% assign found_blog = blogs['found-safe'] %}\n\n{% assign active_count = active_blog.articles_count %}\n{% assign found_count = found_blog.articles_count %}\n\n<div class=\"mpa-status-bar\">\n\n  <div class=\"mpa-status-title\">\n    GLOBAL MISSING LIVE\n    <small>DAILY TOTAL</small>\n  </div>\n\n  <div class=\"mpa-ticker\">\n    <div class=\"mpa-ticker-track\" id=\"mpaTickerTrack\">\n      <span data-label=\"UK\" data-base=\"465\">UK: <b>465+</b></span>\n      <span data-label=\"USA\" data-base=\"2100\">USA: <b>2,100+</b></span>\n      <span data-label=\"Germany\" data-base=\"300\">Germany: <b>300+</b></span>\n      <span data-label=\"France\" data-base=\"220\">France: <b>220+</b></span>\n      <span data-label=\"Spain\" data-base=\"180\">Spain: <b>180+</b></span>\n      <span data-label=\"Italy\" data-base=\"210\">Italy: <b>210+</b></span>\n      <span data-label=\"Netherlands\" data-base=\"90\">Netherlands: <b>90+</b></span>\n      <span data-label=\"Belgium\" data-base=\"70\">Belgium: <b>70+</b></span>\n      <span data-label=\"Sweden\" data-base=\"60\">Sweden: <b>60+</b></span>\n      <span data-label=\"Norway\" data-base=\"40\">Norway: <b>40+</b></span>\n      <span data-label=\"Poland\" data-base=\"160\">Poland: <b>160+</b></span>\n      <span data-label=\"Ireland\" data-base=\"55\">Ireland: <b>55+</b></span>\n      <span data-label=\"Australia\" data-base=\"95\">Australia: <b>95+</b></span>\n      <span data-label=\"Canada\" data-base=\"120\">Canada: <b>120+</b></span>\n      <span data-label=\"New Zealand\" data-base=\"35\">New Zealand: <b>35+</b></span>\n      <span data-label=\"India\" data-base=\"3000\">India: <b>3,000+</b></span>\n      <span data-label=\"Brazil\" data-base=\"1200\">Brazil: <b>1,200+</b></span>\n      <span data-label=\"Mexico\" data-base=\"900\">Mexico: <b>900+</b></span>\n      <span data-label=\"South Africa\" data-base=\"500\">South Africa: <b>500+</b></span>\n      <span data-label=\"Japan\" data-base=\"80\">Japan: <b>80+</b></span>\n\n      <span data-label=\"UK\" data-base=\"465\">UK: <b>465+</b></span>\n      <span data-label=\"USA\" data-base=\"2100\">USA: <b>2,100+</b></span>\n      <span data-label=\"Germany\" data-base=\"300\">Germany: <b>300+</b></span>\n      <span data-label=\"France\" data-base=\"220\">France: <b>220+</b></span>\n      <span data-label=\"Spain\" data-base=\"180\">Spain: <b>180+</b></span>\n      <span data-label=\"Italy\" data-base=\"210\">Italy: <b>210+</b></span>\n      <span data-label=\"Netherlands\" data-base=\"90\">Netherlands: <b>90+</b></span>\n      <span data-label=\"Belgium\" data-base=\"70\">Belgium: <b>70+</b></span>\n      <span data-label=\"Sweden\" data-base=\"60\">Sweden: <b>60+</b></span>\n      <span data-label=\"Norway\" data-base=\"40\">Norway: <b>40+</b></span>\n      <span data-label=\"Poland\" data-base=\"160\">Poland: <b>160+</b></span>\n      <span data-label=\"Ireland\" data-base=\"55\">Ireland: <b>55+</b></span>\n      <span data-label=\"Australia\" data-base=\"95\">Australia: <b>95+</b></span>\n      <span data-label=\"Canada\" data-base=\"120\">Canada: <b>120+</b></span>\n      <span data-label=\"New Zealand\" data-base=\"35\">New Zealand: <b>35+</b></span>\n      <span data-label=\"India\" data-base=\"3000\">India: <b>3,000+</b></span>\n      <span data-label=\"Brazil\" data-base=\"1200\">Brazil: <b>1,200+</b></span>\n      <span data-label=\"Mexico\" data-base=\"900\">Mexico: <b>900+</b></span>\n      <span data-label=\"South Africa\" data-base=\"500\">South Africa: <b>500+</b></span>\n      <span data-label=\"Japan\" data-base=\"80\">Japan: <b>80+</b></span>\n    </div>\n  </div>\n\n  <div class=\"mpa-status-right\">\n    <div class=\"mpa-live-badge\">\n      <div class=\"mpa-live-dot\"></div>\n      LIVE\n    </div>\n\n    <div class=\"mpa-status-stats\">\n      {{ active_count }} ACTIVE • {{ found_count }} FOUND SAFE\n    </div>\n  </div>\n\n</div>\n\n<script>\ndocument.addEventListener('DOMContentLoaded', function () {\n  var ticker = document.getElementById('mpaTickerTrack');\n  if (!ticker) return;\n\n  function formatNumber(num){\n    return num.toLocaleString('en-GB') + '+';\n  }\n\n  function randomOffset(base){\n    if (base >= 2000) return Math.floor(Math.random() * 121) - 60;\n    if (base >= 1000) return Math.floor(Math.random() * 81) - 40;\n    if (base >= 500) return Math.floor(Math.random() * 41) - 20;\n    if (base >= 100) return Math.floor(Math.random() * 21) - 10;\n    return Math.floor(Math.random() * 11) - 5;\n  }\n\n  function updateTicker(){\n    var items = ticker.querySelectorAll('span[data-base]');\n\n    items.forEach(function(item){\n      var label = item.getAttribute('data-label') || '';\n      var base = parseInt(item.getAttribute('data-base'), 10);\n      if (!base) return;\n\n      var value = Math.max(1, base + randomOffset(base));\n      item.innerHTML = label + ': <b>' + formatNumber(value) + '</b>';\n    });\n  }\n\n  updateTicker();\n  setInterval(updateTicker, 5000);\n});\n</script>",
