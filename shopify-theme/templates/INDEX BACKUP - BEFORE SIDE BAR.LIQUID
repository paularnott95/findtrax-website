        "custom_liquid": "<style>\n.mpa-cases-wrap{\n  max-width:1200px;\n  margin:-35px auto 20px auto;\n  padding:20px;\n  background:#101214;\n  border:1px solid rgba(255,255,255,0.05);\n  border-radius:18px;\n}\n\n.mpa-cases-head{\n  display:flex;\n  align-items:center;\n  justify-content:space-between;\n  gap:12px;\n  margin-bottom:18px;\n  flex-wrap:wrap;\n}\n\n.mpa-cases-grid{\n  display:grid;\n  grid-template-columns:repeat(auto-fit,minmax(280px,360px));\n  gap:20px;\n  justify-content:start;\n}\n\n.mpa-case-link{\n  text-decoration:none;\n  color:inherit;\n  display:block;\n}\n\n.mpa-case-card{\n  background:#17191c;\n  border:1px solid rgba(255,255,255,0.06);\n  border-radius:16px;\n  overflow:hidden;\n  box-shadow:0 10px 24px rgba(0,0,0,0.22);\n  transition:transform .2s ease, box-shadow .2s ease;\n  display:flex;\n  flex-direction:column;\n  height:100%;\n}\n\n.mpa-case-card:hover{\n  transform:translateY(-6px) scale(1.02);\n  box-shadow:0 20px 40px rgba(0,0,0,0.35);\n}\n\n.mpa-case-image-wrap{\n  position:relative;\n  overflow:hidden;\n}\n\n.mpa-case-image{\n  width:100%;\n  height:220px;\n  object-fit:cover;\n  display:block;\n  transition:transform .3s ease;\n}\n\n.mpa-case-card:hover .mpa-case-image{\n  transform:scale(1.05);\n}\n\n.mpa-case-badge{\n  position:absolute;\n  top:10px;\n  left:10px;\n  background:linear-gradient(135deg,#ff4b4b,#b30000);\n  color:#fff;\n  padding:6px 12px;\n  font-size:12px;\n  font-weight:800;\n  border-radius:8px;\n  box-shadow:0 4px 10px rgba(0,0,0,0.4);\n  border:1px solid rgba(255,255,255,0.15);\n  letter-spacing:.5px;\n  z-index:2;\n}\n\n.mpa-case-share-top{\n  position:absolute;\n  top:10px;\n  right:10px;\n  display:inline-block;\n  padding:6px 12px;\n  border-radius:8px;\n  background:rgba(15,17,20,0.82);\n  backdrop-filter:blur(4px);\n  -webkit-backdrop-filter:blur(4px);\n  color:#ffffff;\n  font-size:12px;\n  font-weight:800;\n  text-decoration:none;\n  letter-spacing:.4px;\n  border:1px solid rgba(255,255,255,0.14);\n  box-shadow:0 4px 10px rgba(0,0,0,0.28);\n  transition:transform .2s ease, background .2s ease, box-shadow .2s ease;\n  z-index:2;\n}\n\n.mpa-case-share-top:hover{\n  background:#d90429;\n  transform:scale(1.05);\n  box-shadow:0 8px 18px rgba(0,0,0,0.34);\n}\n\n.mpa-case-text{\n  padding:16px;\n  min-height:150px;\n  display:flex;\n  flex-direction:column;\n}\n\n.mpa-case-topline{\n  display:flex;\n  justify-content:space-between;\n  align-items:center;\n  gap:10px;\n  margin:0 0 10px 0;\n  flex-wrap:wrap;\n}\n\n.mpa-case-meta{\n  margin:0;\n  color:#ffb3b3;\n  font-size:12px;\n  font-weight:800;\n  letter-spacing:.6px;\n  text-transform:uppercase;\n}\n\n.mpa-case-location{\n  margin:0;\n  color:#8fd3ff;\n  font-size:12px;\n  font-weight:700;\n  letter-spacing:.4px;\n  text-transform:uppercase;\n}\n\n.mpa-case-title{\n  margin:0 0 8px 0;\n  color:#fff;\n  font-size:18px;\n  line-height:1.3;\n  font-weight:700;\n}\n\n.mpa-case-excerpt{\n  margin:0;\n  color:rgba(255,255,255,0.78);\n  font-size:14px;\n  line-height:1.5;\n}\n\n@media (max-width:700px){\n  .mpa-cases-grid{\n    grid-template-columns:1fr;\n  }\n}\n</style>\n\n<div class=\"mpa-cases-wrap\">\n\n  <div class=\"mpa-cases-head\">\n    <h2 style=\"margin:0;color:#ffffff;font-size:28px;font-weight:700;\">\n      LATEST MISSING CASES\n    </h2>\n    <a href=\"/blogs/missing-persons\" style=\"color:#ffffff;text-decoration:none;font-weight:600;\">\n      View all\n    </a>\n  </div>\n\n  <div class=\"mpa-cases-grid\">\n\n    {% for article in blogs['missing-persons'].articles limit:6 %}\n\n      {% assign last_seen_location = '' %}\n      {% assign clean_title = article.title | strip %}\n\n      {% if clean_title contains 'Last Seen in ' %}\n        {% assign last_seen_location = clean_title | split: 'Last Seen in ' | last | strip %}\n      {% elsif clean_title contains ' – ' %}\n        {% assign last_seen_location = clean_title | split: ' – ' | last | strip %}\n      {% elsif clean_title contains ' — ' %}\n        {% assign last_seen_location = clean_title | split: ' — ' | last | strip %}\n      {% elsif clean_title contains ' - ' %}\n        {% assign last_seen_location = clean_title | split: ' - ' | last | strip %}\n      {% elsif clean_title contains '–' %}\n        {% assign last_seen_location = clean_title | split: '–' | last | strip %}\n      {% elsif clean_title contains '—' %}\n        {% assign last_seen_location = clean_title | split: '—' | last | strip %}\n      {% elsif clean_title contains '-' %}\n        {% assign last_seen_location = clean_title | split: '-' | last | strip %}\n      {% endif %}\n\n      <div class=\"mpa-case-card\">\n\n        <div class=\"mpa-case-image-wrap\">\n          <a href=\"{{ article.url }}\" class=\"mpa-case-link\">\n            {% if article.image %}\n              <img\n                src=\"{{ article.image | image_url: width: 700 }}\"\n                alt=\"{{ article.title | escape }}\"\n                class=\"mpa-case-image\"\n              >\n            {% endif %}\n          </a>\n\n          <div class=\"mpa-case-badge\">⚠️ URGENT</div>\n\n          <a href=\"{{ article.url }}\" class=\"mpa-case-share-top\">\n            🔁 SHARE\n          </a>\n        </div>\n\n        <div class=\"mpa-case-text\">\n          <div class=\"mpa-case-topline\">\n            <div class=\"mpa-case-meta\">RECENT CASE</div>\n\n            {% if last_seen_location != '' %}\n              <div class=\"mpa-case-location\">📍 LAST SEEN: {{ last_seen_location }}</div>\n            {% endif %}\n          </div>\n\n          <a href=\"{{ article.url }}\" class=\"mpa-case-link\">\n            <h3 class=\"mpa-case-title\">{{ article.title }}</h3>\n          </a>\n\n          <p class=\"mpa-case-excerpt\">\n            {{ article.excerpt | strip_html | truncate: 95 }}\n          </p>\n        </div>\n\n      </div>\n\n    {% endfor %}\n\n  </div>\n\n</div>",
