{{ 'case-listing-grid.css' | asset_url | stylesheet_tag }}
{{ 'missing-alerts-location-page.css' | asset_url | stylesheet_tag }}
{{ 'seo-advice-blog.css' | asset_url | stylesheet_tag }}
{%- liquid
  assign location_seo_param = ''
  assign location_seo_query_key = ''
  assign query_parts = request.query_string | default: '' | split: '&'
  for query_part in query_parts
    assign query_key = query_part | split: '=' | first
    if query_key == 'loc' or query_key == 'region' or query_key == 'country'
      assign location_seo_query_key = query_key
      assign location_seo_param = query_part | remove_first: query_key | remove_first: '='
      break
    endif
  endfor
  assign location_seo_label = location_seo_param | split: '/' | last | replace: '-', ' ' | replace: '+', ' ' | replace: '%20', ' ' | capitalize
  if location_seo_label == blank
    assign location_seo_label = 'this location'
  endif
  assign location_seo_description = 'View live missing person alerts, recent cases, and updates in ' | append: location_seo_label | append: '. Stay informed and help share information.'
  assign location_path_parts = location_seo_param | split: '/'
  assign location_country_slug = location_path_parts[0] | default: ''
  assign location_region_slug = ''
  if location_path_parts.size > 1
    assign location_region_slug = location_path_parts[1]
  endif
  assign location_country_label = location_country_slug | replace: '-', ' ' | replace: '+', ' ' | replace: '%20', ' ' | capitalize
  assign location_region_label = location_region_slug | replace: '-', ' ' | replace: '+', ' ' | replace: '%20', ' ' | capitalize
  assign location_country_loc = location_country_slug
  assign location_region_loc = ''
  assign location_seo_url = canonical_url
  if location_seo_param != blank
    assign location_seo_url = request.origin | append: request.path | append: '?' | append: location_seo_query_key | append: '=' | append: location_seo_param
  endif
  if location_country_slug != blank and location_region_slug != blank
    assign location_region_loc = location_country_slug | append: '/' | append: location_region_slug
  endif
-%}
<script src="{{ 'missing-alerts-location-registry.js' | asset_url }}" defer="defer"></script>
<script src="{{ 'missing-alerts-location-seo.js' | asset_url }}" defer="defer"></script>
<script src="{{ 'priority-locations.js' | asset_url }}" defer="defer"></script>
<script src="{{ 'missing-alerts-location-page.js' | asset_url }}" defer="defer"></script>

<section
  class="ma-location-page"
  data-missing-alerts-location-page
  data-customer-id="{% if customer %}{{ customer.id | append: '' | escape }}{% endif %}"
>
  <script type="application/ld+json" data-location-jsonld-fallback>
    {
      "@context": "https://schema.org",
      "@graph": [
        {
          "@type": "CollectionPage",
          "name": "Missing People in {{ location_seo_label | escape }}",
          "headline": "Missing People in {{ location_seo_label | escape }}",
          "description": {{ location_seo_description | json }},
          "url": {{ location_seo_url | json }}
        },
        {
          "@type": "BreadcrumbList",
          "itemListElement": [
            { "@type": "ListItem", "position": 1, "name": "Home", "item": {{ shop.url | append: routes.root_url | json }} },
            { "@type": "ListItem", "position": 2, "name": "{{ location_seo_label | escape }}", "item": {{ location_seo_url | json }} }
          ]
        },
        {
          "@type": "FAQPage",
          "mainEntity": [
            {
              "@type": "Question",
              "name": "Are there missing people in {{ location_seo_label | escape }}?",
              "acceptedAnswer": { "@type": "Answer", "text": "This page shows active Missing Alerts cases matched to {{ location_seo_label | escape }}, plus monitored nearby areas when there are no exact local cases." }
            },
            {
              "@type": "Question",
              "name": "How many missing people are reported in {{ location_seo_label | escape }}?",
              "acceptedAnswer": { "@type": "Answer", "text": "Missing Alerts only shows verified public appeals and local monitoring information. Official totals should be confirmed with police or the relevant public authority." }
            },
            {
              "@type": "Question",
              "name": "Where are missing people usually found in {{ location_seo_label | escape }}?",
              "acceptedAnswer": { "@type": "Answer", "text": "Search activity can involve transport routes, parks, shops, schools, workplaces, hospitals and nearby communities, depending on official appeal details." }
            },
            {
              "@type": "Question",
              "name": "What should I do if I see a missing person?",
              "acceptedAnswer": { "@type": "Answer", "text": "Do not approach if there is risk. Note the time, place and direction of travel, then contact police or the official appeal contact route." }
            }
          ]
        }
      ]
    }
  </script>
  <script type="application/ld+json" data-location-jsonld></script>
  <div class="ma-location-page__shell">
    <header class="ma-location-page__hero">
      <nav class="ma-location-page__breadcrumb" aria-label="Breadcrumb" data-location-breadcrumb>
        <a href="{{ routes.root_url }}">Home</a>
        <span>/</span>
        <a href="/pages/missing-people-location" data-location-country-crumb><span data-location-country-name>Country</span></a>
        <span data-location-parent-separator>/</span>
        <a href="/pages/missing-people-location" data-location-parent-crumb hidden>Parent</a>
        <span>/</span>
        <span data-location-name>Location</span>
      </nav>
      <p class="ma-location-page__eyebrow"><span data-location-type>location</span> intelligence hub</p>
      <h1 class="ma-location-page__heading" data-location-heading>Missing People in {{ location_seo_label | escape }}</h1>
      <p class="ma-location-page__intro" data-location-intro>Live alerts, nearby areas, and how to help</p>
      <p class="ma-location-page__search-intent" data-location-search-intent>Looking for missing people in {{ location_seo_label | escape }}? This page shows alerts, nearby areas, and guidance on how to help.</p>
      {% if location_seo_param != blank %}
        <div class="ma-location-page__quick-links" aria-label="Location hierarchy">
          {% if location_country_loc != blank %}
            <a href="/pages/missing-people-location?loc={{ location_country_loc | escape }}">missing people in {{ location_country_label | escape }}</a>
          {% endif %}
          {% if location_region_loc != blank %}
            <a href="/pages/missing-people-location?loc={{ location_region_loc | escape }}">missing people in {{ location_region_label | escape }}</a>
          {% endif %}
          <a href="/pages/missing-people-location?loc={{ location_seo_param | escape }}">missing people in {{ location_seo_label | escape }}</a>
          <a href="/pages/missing-cases-near?loc={{ location_seo_param | escape }}">nearby missing cases around {{ location_seo_label | escape }}</a>
        </div>
      {% endif %}
      <div class="location-status" data-location-status>Live monitoring active in this area</div>
      <div class="ma-location-page__hero-meta" aria-label="Location summary">
        <span><strong data-location-case-count>0</strong> active appeals</span>
        <span><strong data-location-nearby-active-count>0</strong> nearby active</span>
        <span><strong data-location-resolved-count>0</strong> resolved nearby</span>
        <span>Updated <strong data-location-last-updated>Today</strong></span>
      </div>
      <div class="ma-location-page__hero-actions">
        <button class="ma-location-page__cta ma-location-page__cta--button" type="button" data-location-follow-button>Follow this area for updates</button>
        <button class="ma-location-page__cta ma-location-page__cta--button" type="button" data-location-share-button>Share This Page</button>
      </div>
      <div class="ma-location-page__authority" aria-label="Missing Alerts network">
        <span>Trusted global Missing Alerts network</span>
        <span>Public awareness platform</span>
        <span>Always contact police first</span>
        <span>Covering <span data-location-country-name>{{ location_seo_label | escape }}</span> and surrounding regions</span>
        <a href="/pages/country-intelligence">Explore the global location hub</a>
      </div>
      {% if location_seo_param != blank %}
        <div class="ma-location-page__quick-links" aria-label="Key location links">
          <a href="/pages/missing-people-location?loc={{ location_seo_param | escape }}">missing people in {{ location_seo_label | escape }}</a>
          <a href="/pages/missing-alerts-near-me?loc={{ location_seo_param | escape }}">alerts in {{ location_seo_label | escape }}</a>
          <a href="/pages/missing-cases-near?loc={{ location_seo_param | escape }}">nearby missing cases</a>
        </div>
      {% endif %}
      <div class="ma-location-page__language" aria-label="Location page language">
        <a href="#" hreflang="en" data-location-language="en">English</a>
        <a href="#" hreflang="fr" data-location-language="fr">Français</a>
        <a href="#" hreflang="de" data-location-language="de">Deutsch</a>
        <a href="#" hreflang="es" data-location-language="es">Español</a>
        <a href="#" hreflang="it" data-location-language="it">Italiano</a>
        <a href="#" hreflang="ar" data-location-language="ar">Arabic</a>
      </div>
      <div class="ma-location-page__search">
        <label for="LocationSearch-{{ section.id }}">Search region, county, city or town</label>
        <input id="LocationSearch-{{ section.id }}" type="search" data-location-search-input placeholder="Search region, county, city or town">
      </div>
    </header>

    <div class="missing-alerts-ad-slot missing-alerts-ad-slot--top" aria-label="Advertisement"></div>

    <section class="ma-location-page__panel ma-location-page__server-seo" aria-label="Server-rendered location guidance">
      <p class="ma-location-page__eyebrow">SERVER-RENDERED LOCATION CONTEXT</p>
      <h2>Missing people in {{ location_seo_label | escape }}</h2>
      <p class="ma-location-page__intro">
        {{ location_seo_description | escape }} This source-rendered section is generated from the requested location path and appears before client-side location scripts run.
      </p>
      {% if location_seo_param != blank %}
        <div class="ma-location-page__links" aria-label="Server-rendered location links">
          {% if location_country_loc != blank %}
            <a href="/pages/missing-people-location-live?loc={{ location_country_loc | escape }}">Missing people in {{ location_country_label | escape }}</a>
          {% endif %}
          {% if location_region_loc != blank %}
            <a href="/pages/missing-people-location-live?loc={{ location_region_loc | escape }}">Missing people in {{ location_region_label | escape }}</a>
          {% endif %}
          <a href="/pages/missing-people-location-live?loc={{ location_seo_param | escape }}">Missing people in {{ location_seo_label | escape }}</a>
          <a href="/pages/missing-cases-near?loc={{ location_seo_param | escape }}">Nearby missing cases around {{ location_seo_label | escape }}</a>
          <a href="/pages/missing-alerts-near-me?loc={{ location_seo_param | escape }}">Local missing person alerts for {{ location_seo_label | escape }}</a>
        </div>
      {% endif %}
      <div class="ma-location-page__links" aria-label="Server-rendered advice links">
        <a href="/blogs/missing-person-advice/tagged/first-hour-search-steps">First hour missing person steps</a>
        <a href="/blogs/missing-person-advice/tagged/cctv-dashcam-doorbell-guidance">CCTV, dashcam and doorbell guidance</a>
        <a href="/blogs/missing-person-advice/tagged/safe-social-sharing">Safe public sharing advice</a>
        <a href="/blogs/missing-person-advice/tagged/witness-appeal-guidance">Witness appeal guidance</a>
      </div>
    </section>

    <section class="ma-location-page__intent-grid" aria-label="Missing people search answers">
      <article class="ma-location-page__answer">
        <h2>Are there missing people in <span data-location-name>{{ location_seo_label | escape }}</span>?</h2>
        <p data-location-answer-current>This page shows current alerts, nearby areas, and guidance on how to help in {{ location_seo_label | escape }}.</p>
      </article>
      <article class="ma-location-page__answer">
        <h2>Latest missing person alerts in <span data-location-name>{{ location_seo_label | escape }}</span></h2>
        <p data-location-answer-alerts>Live Missing Alerts case cards appear here when verified public appeals match this location or nearby areas.</p>
      </article>
      <article class="ma-location-page__answer">
        <h2>What to do if someone is missing in <span data-location-name>{{ location_seo_label | escape }}</span></h2>
        <p data-location-answer-report>Always contact local police or emergency services first, then share verified appeal information responsibly.</p>
      </article>
    </section>

    <section class="ma-location-page__engagement" aria-label="Location engagement and freshness">
      <span>Monitoring active in this area</span>
      <span>Updated: <strong data-location-last-updated>Today</strong></span>
      <span data-location-activity-indicator>Recent activity appears when verified cases match this area.</span>
      <span data-location-follow-count>Follows are managed through member alerts.</span>
      <span data-location-share-count>Shares tracked on this browser after sharing.</span>
    </section>

    {% if request.design_mode %}
    <aside class="ma-location-page__debug" data-location-debug-panel hidden>
      <h2>Location page debug</h2>
      <p data-location-debug-summary>Debug mode is loading.</p>
      <dl>
        <div><dt>Selected country</dt><dd data-location-debug-country>Not set</dd></div>
        <div><dt>Selected level</dt><dd data-location-debug-level>Not set</dd></div>
        <div><dt>Selected location</dt><dd data-location-debug-location>Not set</dd></div>
        <div><dt>Matched registry entry</dt><dd data-location-debug-entry>Not matched</dd></div>
        <div><dt>Matched case count</dt><dd data-location-debug-matched-count>0</dd></div>
        <div><dt>Found/resolved excluded count</dt><dd data-location-debug-excluded-count>0</dd></div>
        <div><dt>Registry file loaded</dt><dd data-location-debug-registry>Unknown</dd></div>
        <div><dt>Page template/section loaded</dt><dd data-location-debug-section>location-case-page loaded</dd></div>
      </dl>
      <ul data-location-debug-messages></ul>
    </aside>
    {% endif %}

    <div class="ma-location-page__layout">
      <main class="ma-location-page__main">
        <section class="ma-location-page__panel ma-location-page__snapshot">
          <h2>Area snapshot</h2>
          <div class="ma-location-page__stats">
            <div class="ma-location-page__stat"><strong>Country</strong><span data-location-country-name>Country</span></div>
            <div class="ma-location-page__stat"><strong>Region/state/province</strong><span data-location-admin1>Not listed</span></div>
            <div class="ma-location-page__stat"><strong>County/district/local authority</strong><span data-location-admin2>Not listed</span></div>
            <div class="ma-location-page__stat"><strong>Population</strong><span data-location-population>Not listed</span></div>
            <div class="ma-location-page__stat"><strong>Coordinates</strong><span data-location-coordinates>Not listed</span></div>
            <div class="ma-location-page__stat"><strong>Active in this location</strong><span data-location-exact-count>0</span></div>
            <div class="ma-location-page__stat"><strong>Nearby active appeals</strong><span data-location-nearby-active-count>0</span></div>
            <div class="ma-location-page__stat"><strong>Recently resolved nearby</strong><span data-location-resolved-count>0</span></div>
          </div>
        </section>

        <section class="ma-location-page__map ma-location-page__map--wide">
          <div class="ma-location-page__map-header">
            <h2>Location map and case intelligence</h2>
            <p>Map markers use the selected registry location and approved case location fields where available.</p>
          </div>
          <iframe title="General area map with selected location pin" loading="lazy" data-location-map></iframe>
          <a href="https://www.openstreetmap.org" target="_blank" rel="noopener" data-location-map-link>Open broad area map</a>
          <p class="ma-location-page__map-status" data-location-map-status>This area is monitored. Nearby areas may have active alerts.</p>
          <div class="ma-location-page__map-pins" data-location-map-pins></div>
        </section>

        <section class="ma-location-page__panel ma-location-page__conversion-panel">
          <h2>Stay updated on missing people in <span data-location-name>this location</span></h2>
          <p>Stay informed, get alerts instantly, and help share information safely when verified public appeals are connected to this area.</p>
          <div class="ma-location-page__trust-line">
            <span>Always contact police first</span>
            <span>No spam</span>
            <span>Only important updates</span>
          </div>
          <div class="ma-location-page__actions ma-location-page__actions--inline">
            <button class="ma-location-page__cta ma-location-page__cta--button" type="button" data-location-follow-button>Follow this area for updates</button>
          </div>
        </section>

        <section class="ma-location-page__panel ma-location-page__mode-panel ma-location-page__mode-panel--alert">
          <h2>Follow this area for updates</h2>
          <p>Follow <span data-location-name>this location</span> so this page can connect your member account to future location updates when the notification system is enabled.</p>
          <p>If someone may be in immediate danger, contact police or emergency services first. Public sharing should support official appeals and avoid speculation.</p>
          <div id="LocationAlertSignupForm" class="ma-location-page__signup-form ma-location-page__follow-placeholder">
            <button class="ma-location-page__cta ma-location-page__cta--button" type="button" data-location-follow-button>Follow this area for updates</button>
            <p class="ma-location-page__form-message" data-location-follow-status>Sign in to follow this area and receive updates.</p>
            {% unless customer %}
              <a class="ma-location-page__cta ma-location-page__cta--secondary" href="{{ routes.account_login_url }}?return_url={{ request.path | url_encode }}">Sign in to follow</a>
            {% endunless %}
          </div>
        </section>

        <section class="ma-location-page__panel ma-location-page__mode-panel ma-location-page__mode-panel--guide">
          <h2>Search and safety guide for <span data-location-name>this location</span></h2>
          <p>This area guide helps residents think about geography, transport movement, urban and rural search challenges, and safe public sharing.</p>
          <p>Useful public help can include checking the time and direction of a sighting, transport stops, shops, parks, workplace routes, CCTV and doorbell footage where relevant to an official appeal.</p>
          <p>Do not approach someone if there is risk. Contact emergency services first, then share information through the official route listed on the appeal.</p>
        </section>

        {% render 'related-safety-products',
          heading: 'Safety product guides for this location',
          limit: 3
        %}

        <div class="missing-alerts-ad-slot missing-alerts-ad-slot--mid" aria-label="Advertisement"></div>

        <section class="ma-location-page__panel ma-location-page__mode-panel ma-location-page__mode-panel--directory">
          <h2>Directory links for <span data-location-name>this location</span></h2>
          <p>Use this directory to move between the country, regional hubs, nearby cities and local alert pages without leaving verified registry paths.</p>
          {% if location_seo_param != blank %}
            <div class="ma-location-page__links" aria-label="Related location pages">
              <a href="/pages/missing-alerts-near-me?loc={{ location_seo_param | escape }}">Get alerts for missing people in {{ location_seo_label | escape }}</a>
              <a href="/pages/missing-person-search-guide?loc={{ location_seo_param | escape }}">Learn how to help find missing people in {{ location_seo_label | escape }}</a>
              <a href="/pages/missing-cases-near?loc={{ location_seo_param | escape }}">View nearby missing cases around {{ location_seo_label | escape }}</a>
            </div>
          {% endif %}
          <div class="ma-location-page__links" data-location-related-page-types></div>
            <div class="ma-location-page__links" aria-label="Popular Missing Alerts Locations">
            <a href="/pages/missing-people-location?loc=united-kingdom/england/london">London</a>
            <a href="/pages/missing-people-location?loc=united-states/new-york/new-york-city">New York</a>
            <a href="/pages/missing-people-location?loc=france/ile-de-france/paris">Paris</a>
            <a href="/pages/missing-people-location?loc=india/maharashtra/mumbai">Mumbai</a>
          </div>
          <div class="ma-location-page__links ma-location-page__priority-links" data-location-priority-links aria-label="Popular Missing Alerts Locations"></div>
        </section>

        <section class="ma-location-page__panel ma-location-page__mode-panel ma-location-page__mode-panel--no-case">
          <h2>No active missing cases currently listed in <span data-location-name>this location</span></h2>
          <p>This monitored area page remains useful when there are no active appeals listed. It gives residents a local status page, nearby active areas, parent-region navigation and alert signup.</p>
          <p>Missing Alerts does not replace police reporting. If someone is missing now or may be at immediate risk, contact emergency services first.</p>
          <div class="ma-location-page__links" data-location-related-page-types></div>
        </section>

        <section class="ma-location-page__panel ma-location-page__mode-panel ma-location-page__mode-panel--near-me">
          <h2>Missing people near <span data-location-name>this location</span></h2>
          <p>This page focuses on nearby active appeals, area map context, parent locations and neighbouring towns so local users can move quickly through verified place pages.</p>
          <p>Use the case links and map as awareness support only. Send sightings or urgent information through official reporting routes.</p>
        </section>

        <section class="ma-location-page__panel" data-location-near-you>
          <h2>Missing people near you</h2>
          <p>Nearby location pages help you check neighbouring areas without relying on unverified information.</p>
          <div class="ma-location-page__links" data-location-nearby-links></div>
        </section>

        <section class="ma-location-page__panel ma-location-page__mode-panel ma-location-page__mode-panel--recent">
          <h2>Recent missing case activity in <span data-location-name>this location</span></h2>
          <p>Recent activity combines active appeals, nearby updates and resolved case history where verified case fields connect to this area.</p>
          <p>When no recent activity is listed, this page still provides monitoring status, nearby areas and alert signup for future verified appeals.</p>
        </section>

        <section class="ma-location-page__panel ma-location-page__mode-panel ma-location-page__mode-panel--help">
          <h2>Help find missing people in <span data-location-name>this location</span></h2>
          <p>Useful public help can include checking recent sightings, transport routes, shops, parks, workplaces, CCTV and doorbell footage where relevant to an official appeal.</p>
          <p>Share verified appeals carefully, avoid speculation, and contact police or emergency services first if there is immediate risk.</p>
        </section>

        <section class="ma-location-page__panel">
          <h2>MISSING PERSON ACTIVITY IN <span data-location-name>Location</span></h2>
          <p class="ma-location-page__intro">
            <span data-location-case-count>0</span> active missing person appeals currently match this location or verified nearby area fields.
          </p>
          <div class="ma-location-page__empty" data-location-empty hidden>
            This area is monitored. Nearby areas may have active alerts.
          </div>
          <div class="ma-location-page__cards" data-location-case-results>
            {%- assign missing_blog = blogs['missing-persons'] -%}
            {%- if missing_blog != blank -%}
              {%- paginate missing_blog.articles by 200 -%}
                {%- for article in missing_blog.articles -%}
                  {%- liquid
                    assign case_status = article.metafields.custom.case_status.value | default: article.metafields.custom.case_status | downcase | strip
                    assign alternate_status = article.metafields.custom.status.value | default: article.metafields.custom.status | downcase | strip
                    assign tags_downcase = article.tags | join: ',' | downcase
                    assign status_scope = case_status | append: ' ' | append: alternate_status | append: ' ' | append: tags_downcase
                    assign is_found_case = false
                    if status_scope contains 'found safe' or status_scope contains 'found-safe' or status_scope contains 'resolved' or status_scope contains 'located' or status_scope contains 'closed' or status_scope contains 'found'
                      assign is_found_case = true
                    endif

                    assign case_country_code = article.metafields.custom.country_code.value | default: article.metafields.custom.country_code | strip | downcase
                    assign case_country_label = article.metafields.custom.country.value | default: article.metafields.custom.country | strip
                    for article_tag in article.tags
                      assign tag_downcase = article_tag | downcase | strip
                      if tag_downcase contains 'country:'
                        assign case_country_code = tag_downcase | split: ':' | last | strip
                        break
                      endif
                    endfor
                    if case_country_code == 'uk'
                      assign case_country_code = 'gb'
                    endif
                    if case_country_code == blank
                      assign case_country_code = case_country_label | handleize
                    endif
                    if case_country_code == 'united-kingdom' or case_country_code == 'great-britain' or case_country_code == 'england' or case_country_code == 'scotland' or case_country_code == 'wales' or case_country_code == 'northern-ireland'
                      assign case_country_code = 'gb'
                    elsif case_country_code == 'united-states' or case_country_code == 'usa' or case_country_code == 'america'
                      assign case_country_code = 'us'
                    endif
                    if case_country_label == blank
                      assign case_country_label = case_country_code | upcase
                    endif

                    assign case_state = article.metafields.custom.state.value | default: article.metafields.custom.state | default: article.metafields.custom.state_region.value | default: article.metafields.custom.state_region | strip
                    assign case_province = article.metafields.custom.province.value | default: article.metafields.custom.province | strip
                    assign case_region = article.metafields.custom.region.value | default: article.metafields.custom.region | default: case_state | default: case_province | strip
