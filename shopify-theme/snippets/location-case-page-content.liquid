            <div class="ma-location-page__stat"><strong>Registry entries</strong><span data-location-registry-count>0</span></div>
            <div class="ma-location-page__stat"><strong>Approx. population</strong><span data-location-population>Not listed</span></div>
            <div class="ma-location-page__stat"><strong>Coordinates</strong><span data-location-coordinates>Not listed</span></div>
            <div class="ma-location-page__stat"><strong>Visible cases</strong><span data-location-case-count>0</span></div>
            <div class="ma-location-page__stat"><strong>Last updated</strong><span data-location-last-updated>Today</span></div>
          </div>
          <div class="location-last-updated" data-location-freshness>Updated: {{ 'now' | date: '%Y-%m-%dT%H:%M:%SZ' }}</div>
          <p data-location-description></p>
        </section>

        <section class="ma-location-page__panel ma-location-page__reporting">
          <h2>Reporting information</h2>
          <p data-location-reporting>If someone is at immediate risk, contact local emergency services first.</p>
        </section>

        <section class="ma-location-page__panel">
          <h2>Support this location</h2>
          <p>Share verified appeals, submit a missing-person case, or create member alerts for this area.</p>
          <div class="ma-location-page__actions">
            <button class="ma-location-page__cta ma-location-page__cta--button" type="button" data-location-share-button>Share this page</button>
            <a class="ma-location-page__cta" href="/pages/submit-case">Submit a case</a>
            <a class="ma-location-page__cta" href="/pages/member-area">Set member alerts</a>
          </div>
        </section>
      </aside>
    </div>
  </div>
</section>

<script>
  window.addEventListener('DOMContentLoaded', function() {
    var root = document.querySelector('[data-location-advice]');
    if (!root) return;

    var params = new URLSearchParams(window.location.search);
    var country = (params.get('country') || params.get('country_code') || '').toLowerCase();
    if (country === 'uk') country = 'gb';
    if (country === 'united-kingdom') country = 'gb';
    if (country === 'usa') country = 'us';

    var countryNames = {
      gb: 'United Kingdom',
      us: 'United States',
      ca: 'Canada',
      au: 'Australia',
      nz: 'New Zealand',
      ie: 'Ireland'
    };
    if (countryNames[country]) {
      Array.prototype.slice.call(root.querySelectorAll('[data-location-country-name]')).forEach(function(label) {
        label.textContent = countryNames[country];
      });
    }

    var cards = Array.prototype.slice.call(root.querySelectorAll('[data-location-advice-card]'));
    var empty = root.querySelector('[data-location-advice-empty]');
    var visible = 0;

    cards.forEach(function(card, index) {
      var tags = (card.getAttribute('data-tags') || '').toLowerCase();
      var isGlobal = tags.indexOf('global-advice') !== -1 || tags.indexOf('applies-all-countries') !== -1;
      var isCountry = country && tags.indexOf('country:' + country) !== -1;
      var show = false;

      if (!country || country === 'global') {
        show = isGlobal || index < 6;
      } else {
        show = isCountry || isGlobal;
      }

      card.hidden = !show;
      if (show) visible += 1;
    });

    if (empty) empty.hidden = visible !== 0;
  });
</script>
