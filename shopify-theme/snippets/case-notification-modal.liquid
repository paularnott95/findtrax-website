<div
  id="case-notification-modal"
  class="case-notification-modal"
  data-case-notification-modal
  data-customer-logged-in="{% if customer %}true{% else %}false{% endif %}"
  data-login-url="{{ routes.account_login_url }}"
  hidden
>
  <div class="case-notification-modal__backdrop" data-case-notification-close></div>
  <div
    class="case-notification-modal__dialog"
    role="dialog"
    aria-modal="true"
    aria-labelledby="case-notification-modal-title"
    aria-describedby="case-notification-modal-subtitle"
  >
    <button
      type="button"
      class="case-notification-modal__close"
      aria-label="Close notification options"
      data-case-notification-close
    >
      ×
    </button>

    <div class="case-notification-modal__eyebrow">Premium Case Alerts</div>
    <h2 id="case-notification-modal-title" class="case-notification-modal__title">⚠️ GET ALERTS FOR THIS CASE</h2>
    <p id="case-notification-modal-subtitle" class="case-notification-modal__subtitle">
      Follow updates for <span data-case-notification-title>this case</span>.
    </p>

    <div class="case-notification-modal__options">
      <article class="case-notification-option case-notification-option--featured">
        <div class="case-notification-option__badge">Best value</div>
        <h3 class="case-notification-option__title">FREE MEMBER ALERTS</h3>
        <p class="case-notification-option__copy">
          Get free updates sent to your Missing Alerts member panel when this case is updated, found, or changed.
        </p>
        <a
          href="{{ routes.account_login_url }}"
          class="case-notification-option__button case-notification-option__button--primary"
          data-case-notification-free
          data-alert-type="free-member"
        >
          Follow free in member panel
        </a>
      </article>

      <article class="case-notification-option">
        <h3 class="case-notification-option__title">ONE-OFF MOBILE ALERTS</h3>
        <p class="case-notification-option__copy">
          Get mobile updates for this specific case only. Fast checkout. No full membership required.
        </p>
        <a
          href="#mobile-case-alerts-coming-soon"
          class="case-notification-option__button"
          data-alert-type="one-off-mobile"
        >
          Get mobile case alerts
        </a>
      </article>

      <article class="case-notification-option">
        <h3 class="case-notification-option__title">LOCAL AREA ALERTS</h3>
        <p class="case-notification-option__copy">
          Get alerts when someone goes missing near your chosen area, county, state, or region. Best value with membership.
        </p>
        <a
          href="/pages/community-membership"
          class="case-notification-option__button"
          data-alert-type="local-area"
        >
          Set up local alerts
        </a>
      </article>
    </div>
  </div>
</div>
