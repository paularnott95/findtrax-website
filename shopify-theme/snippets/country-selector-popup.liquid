<div
  id="missing-alerts-country-popup"
  class="missing-alerts-country-popup"
  hidden
  aria-hidden="true"
>
  <div class="missing-alerts-country-popup__overlay" data-country-popup-close></div>
  <div
    class="missing-alerts-country-popup__dialog"
    role="dialog"
    aria-modal="true"
    aria-labelledby="missing-alerts-country-popup-title"
  >
    <button
      type="button"
      class="missing-alerts-country-popup__close"
      data-country-popup-close
      aria-label="Close country selector"
    >
      ×
    </button>

    <div class="missing-alerts-country-popup__eyebrow">Missing Alerts country view</div>
    <h2 id="missing-alerts-country-popup-title" class="missing-alerts-country-popup__title">
      SELECT YOUR COUNTRY
    </h2>
    <p class="missing-alerts-country-popup__copy">
      We’ll show active appeals, boosted cases and local guidance for your country.
    </p>

    <div class="missing-alerts-country-wheel" data-country-wheel>
      <button type="button" class="missing-alerts-country-wheel__arrow" data-country-wheel-prev aria-label="Previous country">‹</button>
      <div class="missing-alerts-country-wheel__viewport" data-country-wheel-viewport tabindex="0" aria-label="Choose country">
        <div class="missing-alerts-country-wheel__track" data-country-wheel-track></div>
      </div>
      <button type="button" class="missing-alerts-country-wheel__arrow" data-country-wheel-next aria-label="Next country">›</button>
    </div>

    <div class="missing-alerts-country-popup__selected" data-country-wheel-selected>
      Select a country to personalise the homepage.
    </div>

    <div class="missing-alerts-country-popup__actions">
      <button type="button" class="missing-alerts-country-popup__button missing-alerts-country-popup__button--primary" data-country-save>
        Confirm country
      </button>
      <a class="missing-alerts-country-popup__button missing-alerts-country-popup__button--global" href="/pages/country-intelligence" data-country-intelligence-link>
        View all country intelligence
      </a>
    </div>
  </div>
</div>
