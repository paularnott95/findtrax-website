<aside class="case-page-rail case-page-rail--left case-page-left-sidebar ma-case-sidebar-left" data-case-left-sidebar aria-label="Map and related cases">
  <section class="case-page-card case-page-card--padded sidebar-card">
    {% render 'boosted-sidebar', fill_mode: true, fill_limit: 3 %}
  </section>

  {% render 'case-location-map', article: article, blog: blog %}

  {% render 'organise-search-box', article: article, blog: blog, found_safe: found_safe %}

  {% render 'case-cctv-check', article: article, blog: blog, found_safe: found_safe %}

  {% render 'case-comments-sidebar', article: article, blog: blog, found_safe: found_safe %}

  <section class="case-page-card case-page-card--padded sidebar-card">
    <div class="case-page-card__eyebrow">Similar and Local</div>
    <h3 class="case-page-card__title">More cases needing attention</h3>
    <div class="case-page-related-stack">
      {% assign related_count = 0 %}
      {% for related_article in blog.articles %}
        {% if related_article.id != article.id and related_count < 3 %}
          <div class="case-page-related-stack__item">
            {% render 'article-card', blog: blog, article: related_article, show_image: true, show_date: true, show_author: false, show_excerpt: false, lazy_load: true %}
          </div>
          {% assign related_count = related_count | plus: 1 %}
        {% endif %}
      {% endfor %}
      {% if related_count == 0 %}
        <p class="case-page-muted">No similar cases available yet.</p>
      {% endif %}
    </div>
  </section>

  <section class="case-page-card case-page-card--padded sidebar-card">
    <div class="case-page-card__eyebrow">Public Impact</div>
    <h3 class="case-page-card__title">Live visibility signals</h3>
    <div class="case-page-stat-list">
      <div class="case-page-stat">
        <span class="case-page-stat__label">Boosts</span>
        <span class="case-page-stat__value">{{ article.metafields.custom.total_boosts.value | default: 0 }}</span>
      </div>
      <div class="case-page-stat">
        <span class="case-page-stat__label">Boost Points</span>
        <span class="case-page-stat__value">{{ article.metafields.custom.boost_points.value | default: 0 }}</span>
      </div>
      <div class="case-page-stat">
        <span class="case-page-stat__label">Comments</span>
        <span class="case-page-stat__value">{{ article.comments_count }}</span>
      </div>
      <div class="case-page-stat">
        <span class="case-page-stat__label">Published</span>
        <span class="case-page-stat__value">{{ article.published_at | date: '%d %b %Y' }}</span>
      </div>
    </div>
  </section>

  <section class="case-page-ad sidebar-card" aria-label="Advertisement">
    <div class="case-page-ad__label">Advertisement</div>
    <div class="case-page-ad__body">Compact left-rail ad slot reserved for approved network or sponsor inventory.</div>
  </section>
</aside>
