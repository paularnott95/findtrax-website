.mpa-status-title{
  display:flex;
  flex-direction:column;
  align-items:center;
  justify-content:center;
  color:#ffffff;
  font-weight:900;
  letter-spacing:0.5px;
  text-transform:uppercase;
  white-space:nowrap;
  line-height:1.1;
}

.mpa-status-title small{
  font-size:9px;
  font-weight:900;
  letter-spacing:1px;
  opacity:0.8;
