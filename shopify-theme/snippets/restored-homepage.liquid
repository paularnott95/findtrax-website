<script>
  (function() {
    if (window.__maHomepageGridCompactApplied) return;
    window.__maHomepageGridCompactApplied = true;

    var selectedCountryKeys = [
      'selectedCountryCode',
      'missingAlertsSelectedCountryCode',
      'selectedCountry',
      'missingAlertsSelectedCountry'
    ];
    var countryAliasMap = {
      gb: ['gb', 'uk', 'united-kingdom', 'england', 'scotland', 'wales', 'northern-ireland'],
      us: ['us', 'usa', 'united-states', 'united-states-of-america'],
      ca: ['ca', 'canada'],
      au: ['au', 'australia'],
      nz: ['nz', 'new-zealand'],
      ie: ['ie', 'ireland'],
      sg: ['sg', 'singapore'],
      za: ['za', 'south-africa']
    };

    function normaliseCountry(value) {
      return (value || '').toString().trim().toLowerCase();
    }

    function getSelectedCountryTokens() {
      var selected = '';
      for (var i = 0; i < selectedCountryKeys.length; i += 1) {
        var nextValue = window.localStorage.getItem(selectedCountryKeys[i]);
        if (nextValue) {
          selected = normaliseCountry(nextValue);
          break;
        }
      }
      if (!selected) return [];
      if (countryAliasMap[selected]) return countryAliasMap[selected];
      var matchedKey = Object.keys(countryAliasMap).find(function(key) {
        return countryAliasMap[key].indexOf(selected) !== -1;
      });
      return matchedKey ? countryAliasMap[matchedKey] : [selected];
    }

    function getCardNode(item) {
      if (!item) return null;
      if (item.classList && item.classList.contains('mpa-case-card')) return item;
      return item.querySelector('.mpa-case-card');
    }

    function syncCountryData(item, card) {
      if (!item || !card) return;
      [
        'countryScope',
        'countryCode',
        'countrySlug',
        'countryName',
        'region',
        'status',
        'boostActive',
        'boostScore',
        'sourceVerified'
      ].forEach(function(key) {
        var attributeName = 'data-' + key.replace(/[A-Z]/g, function(match) { return '-' + match.toLowerCase(); });
        if (!item.getAttribute(attributeName) && card.getAttribute(attributeName)) {
          item.setAttribute(attributeName, card.getAttribute(attributeName));
        }
      });
    }

    function isActiveCard(card) {
      if (!card) return false;
      var status = normaliseCountry(card.getAttribute('data-status') || card.getAttribute('data-case-status'));
      return status.indexOf('found') === -1 &&
        status.indexOf('resolved') === -1 &&
        status.indexOf('located') === -1 &&
        status.indexOf('returned') === -1 &&
        status.indexOf('closed') === -1;
    }

    function matchesSelectedCountry(card, selectedTokens) {
      if (!card || !selectedTokens.length) return true;
      var exactTokens = [
        normaliseCountry(card.getAttribute('data-country-code')),
        normaliseCountry(card.getAttribute('data-country-slug')),
        normaliseCountry(card.getAttribute('data-country-scope')),
        normaliseCountry(card.getAttribute('data-country-name'))
      ].filter(Boolean);
      if (!exactTokens.length) return true;
      return exactTokens.some(function(token) {
        return selectedTokens.indexOf(token) !== -1;
      });
    }

    function applyGridLimits() {
      var selectedTokens = getSelectedCountryTokens();
      document.querySelectorAll('.mpa-cases-grid').forEach(function(grid) {
        var isLatestGrid = !!grid.closest('.mpa-latest-layout');
        var visibleCount = 0;
        Array.from(grid.children).forEach(function(item) {
          var card = getCardNode(item);
          if (!card) return;
          syncCountryData(item, card);
          var shouldShow = isActiveCard(card);
          if (shouldShow && isLatestGrid) {
            shouldShow = matchesSelectedCountry(card, selectedTokens);
          }
          if (shouldShow && visibleCount < 6) {
            item.style.display = '';
            item.hidden = false;
            visibleCount += 1;
          } else {
            item.style.display = 'none';
            item.hidden = true;
          }
        });
      });
    }

    document.addEventListener('DOMContentLoaded', applyGridLimits);
    window.addEventListener('storage', applyGridLimits);
    window.addEventListener('missingalerts:country-change', applyGridLimits);
    setTimeout(applyGridLimits, 150);
    setTimeout(applyGridLimits, 1200);
    setTimeout(applyGridLimits, 3200);
  })();
</script>
