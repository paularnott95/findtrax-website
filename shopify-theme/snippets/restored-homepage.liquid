}

.mpa-ticker{
  flex:1;
  overflow:hidden;
  white-space:nowrap;
}

.mpa-ticker-track{
  display:inline-block;
  animation:scrollTicker 40s linear infinite;
  will-change:transform;
}

.mpa-ticker-track span{
  margin-right:28px;
  color:#ffffff;
  font-weight:700;
  opacity:0.95;
}

