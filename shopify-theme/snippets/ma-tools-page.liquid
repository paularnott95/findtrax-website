{% liquid
  assign product_key = product | default: 'overview'
  assign product_label = 'Missing Alerts tools'
  assign product_intro = 'Professional Missing Alerts tools for coordinating public appeals, case information, and outreach workflows.'
  assign product_positioning = 'A product suite for teams and supporters who need clearer, safer ways to organise missing-person visibility work.'
  assign product_audience = 'Families, public appeal coordinators, community search organisers, professional supporters, and Missing Alerts operators.'
  assign features = 'Search coordination|Case intelligence|Controlled outreach|Public/private field separation|Source-backed updates|Release-day alerts'

  if product_key == 'findtrax'
    assign product_label = 'FindTrax'
    assign product_intro = 'FindTrax is a Missing Alerts tool for coordinating search activity around a live missing-person appeal.'
    assign product_positioning = 'FindTrax helps Missing Alerts teams organise searches without scattering search areas, sightings, volunteer updates, and field notes across chats and spreadsheets.'
    assign product_audience = 'Search coordinators, trusted volunteers, family liaison teams, field organisers, and Missing Alerts operators.'
    assign features = 'Search planning|Map-based search zones|Volunteer and team assignment|Route and coverage tracking|Field status updates|Tip and sighting organisation|Search logs|Location notes|Command overview|Case-linked summaries'
  elsif product_key == 'intelpro'
    assign product_label = 'IntelPro'
    assign product_intro = 'IntelPro is the Missing Alerts intelligence workspace for organising complex case information.'
    assign product_positioning = 'IntelPro keeps case facts, people, leads, timelines, documents, and review notes structured so information is easier to assess and hand over professionally.'
    assign product_audience = 'Case reviewers, professional supporters, charity teams, researchers, advocacy coordinators, and Missing Alerts case operators.'
    assign features = 'Case dashboard|Person and case records|Lead management|Timeline building|Evidence and document organisation|Relationship mapping|Task tracking|Review workflow|Priority flags|Professional handover readiness'
  elsif product_key == 'mediareach'
    assign product_label = 'MediaReach'
    assign product_intro = 'MediaReach is the Missing Alerts media and outreach tool for controlled public visibility.'
    assign product_positioning = 'MediaReach helps build accurate appeals, press-ready summaries, campaign updates, and shareable outreach without exposing private investigation details.'
    assign product_audience = 'Family support teams, appeal coordinators, media contacts, charity communications teams, and Missing Alerts outreach operators.'
    assign features = 'Appeal building|Press-ready summaries|Social and media templates|Outreach coordination|Shareable campaign publishing|Update workflow|Messaging controls|Audience and reach visibility|Partner contact organisation|Release-ready media kits'
  endif

  assign feature_items = features | split: '|'
%}

<section class="ma-tools-page" data-ma-tools-page="{{ product_key | escape }}">
  <style>
    .ma-tools-page{background:#07080a;color:#fff;padding:42px 18px 72px;margin:0 calc(50% - 50vw);width:100vw;box-sizing:border-box}
    .ma-tools-page *{box-sizing:border-box}
    .ma-tools-page__inner{max-width:1180px;margin:0 auto}
    .ma-tools-page__hero{display:grid;grid-template-columns:minmax(0,1.04fr) minmax(320px,.96fr);gap:28px;align-items:center;padding:30px;border:1px solid rgba(255,255,255,.08);border-radius:22px;background:radial-gradient(circle at 18% 8%,rgba(220,38,38,.22),transparent 32%),linear-gradient(135deg,#17191f,#090a0d 62%,#1d070b);box-shadow:0 28px 70px rgba(0,0,0,.38)}
    .ma-tools-page__eyebrow{display:inline-flex;padding:7px 11px;border-radius:999px;background:rgba(220,38,38,.14);border:1px solid rgba(248,113,113,.24);color:#fecaca;font-size:11px;font-weight:900;letter-spacing:.14em;text-transform:uppercase}
    .ma-tools-page h1{margin:16px 0 12px;font-size:clamp(34px,5vw,62px);line-height:1.02;letter-spacing:0;font-weight:950}
    .ma-tools-page__intro,.ma-tools-page__copy{margin:0;color:rgba(255,255,255,.78);font-size:17px;line-height:1.62;max-width:760px}
    .ma-tools-page__copy{font-size:15px}
    .ma-tools-page__actions{display:flex;flex-wrap:wrap;gap:12px;margin-top:24px}
    .ma-tools-page__button{display:inline-flex;align-items:center;justify-content:center;min-height:46px;padding:0 18px;border-radius:12px;text-decoration:none;font-weight:900;font-size:13px;letter-spacing:.04em;text-transform:uppercase;border:1px solid rgba(255,255,255,.12);color:#fff;background:#b91c1c}
    .ma-tools-page__button--ghost{background:rgba(255,255,255,.06)}
    .ma-tools-page__visual{min-height:370px;border-radius:18px;border:1px solid rgba(255,255,255,.1);background:linear-gradient(180deg,#12151b,#07080a);padding:18px;display:grid;gap:12px;align-content:start;box-shadow:inset 0 1px 0 rgba(255,255,255,.05)}
    .ma-tools-page__window{border-radius:14px;background:#0e1117;border:1px solid rgba(255,255,255,.08);padding:14px}
    .ma-tools-page__window-top{display:flex;justify-content:space-between;gap:10px;color:#fca5a5;font-size:11px;font-weight:900;text-transform:uppercase;letter-spacing:.12em;margin-bottom:12px}
    .ma-tools-page__preview-grid{display:grid;grid-template-columns:1fr 1fr;gap:10px}
    .ma-tools-page__preview-card{min-height:86px;border-radius:12px;background:linear-gradient(135deg,rgba(255,255,255,.06),rgba(255,255,255,.02));border:1px solid rgba(255,255,255,.07);padding:12px}
    .ma-tools-page__preview-card strong{display:block;font-size:13px;margin-bottom:8px}
    .ma-tools-page__preview-card span{display:block;color:rgba(255,255,255,.62);font-size:12px;line-height:1.35}
    .ma-tools-page__section{margin-top:28px;padding:26px;border-radius:20px;border:1px solid rgba(255,255,255,.08);background:#0d0f13}
    .ma-tools-page__section h2{margin:0 0 16px;font-size:28px;line-height:1.15}
    .ma-tools-page__cards{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:14px}
    .ma-tools-page__card{border-radius:14px;border:1px solid rgba(255,255,255,.08);background:rgba(255,255,255,.04);padding:16px;min-height:112px}
    .ma-tools-page__card strong{display:block;margin-bottom:8px}
    .ma-tools-page__card p{margin:0;color:rgba(255,255,255,.68);font-size:14px;line-height:1.5}
    .ma-tools-page__feature-list{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:10px;margin:0;padding:0;list-style:none}
    .ma-tools-page__feature-list li{padding:12px;border-radius:12px;background:rgba(255,255,255,.045);border:1px solid rgba(255,255,255,.07);font-weight:800;font-size:13px}
    .ma-tools-page__launch{margin-top:28px;padding:26px;border-radius:20px;background:linear-gradient(135deg,#1d0709,#0b0c0f);border:1px solid rgba(248,113,113,.24);text-align:center}
    .ma-tools-page__launch-title{font-size:24px;font-weight:950;margin-bottom:14px;text-transform:uppercase;letter-spacing:.04em}
    .ma-tools-countdown{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:10px;max-width:620px;margin:0 auto 22px}
    .ma-tools-countdown__unit{padding:14px 10px;border-radius:14px;background:rgba(255,255,255,.055);border:1px solid rgba(255,255,255,.09)}
    .ma-tools-countdown__value{display:block;font-size:30px;line-height:1;font-weight:950}
    .ma-tools-countdown__label{display:block;margin-top:7px;color:#fecaca;font-size:11px;font-weight:900;letter-spacing:.12em;text-transform:uppercase}
    .ma-tools-page__form{display:flex;gap:10px;justify-content:center;flex-wrap:wrap}
    .ma-tools-page__form input[type=email]{min-width:260px;height:46px;border-radius:12px;border:1px solid rgba(255,255,255,.18);padding:0 14px;background:#fff;color:#111}
    .ma-tools-page__form button{height:46px;border:0;border-radius:12px;background:#dc2626;color:#fff;padding:0 18px;font-weight:950;text-transform:uppercase;letter-spacing:.04em}
    .ma-tools-page__notice{margin-top:10px;color:#fecaca;font-size:13px}
    .ma-tools-page__success{margin:12px auto 0;max-width:560px;padding:10px 12px;border-radius:12px;background:rgba(22,163,74,.16);border:1px solid rgba(74,222,128,.24);color:#dcfce7;font-weight:800}
    .ma-tools-page__error{margin:12px auto 0;max-width:560px;padding:10px 12px;border-radius:12px;background:rgba(220,38,38,.16);border:1px solid rgba(248,113,113,.24);color:#fecaca;font-weight:800}
    @media(max-width:900px){.ma-tools-page__hero{grid-template-columns:1fr}.ma-tools-page__cards,.ma-tools-page__feature-list{grid-template-columns:1fr}.ma-tools-page__visual{min-height:auto}.ma-tools-countdown{grid-template-columns:repeat(2,minmax(0,1fr))}}
  </style>

  <div class="ma-tools-page__inner">
    {% if product_key == 'overview' %}
      <div class="ma-tools-page__hero">
        <div>
          <span class="ma-tools-page__eyebrow">Missing Alerts tools</span>
          <h1>Professional tools for safer public missing-person work.</h1>
          <p class="ma-tools-page__intro">FindTrax, IntelPro, and MediaReach are Missing Alerts tools designed to support search coordination, case organisation, and controlled public outreach.</p>
          <div class="ma-tools-page__actions">
            <a class="ma-tools-page__button" href="/tools/findtrax">FindTrax</a>
            <a class="ma-tools-page__button ma-tools-page__button--ghost" href="/tools/intelpro">IntelPro</a>
            <a class="ma-tools-page__button ma-tools-page__button--ghost" href="/tools/mediareach">MediaReach</a>
          </div>
        </div>
        <div class="ma-tools-page__visual" aria-label="Missing Alerts product suite preview">
          <div class="ma-tools-page__window">
            <div class="ma-tools-page__window-top"><span>Suite overview</span><span>Missing Alerts</span></div>
            <div class="ma-tools-page__preview-grid">
              <div class="ma-tools-page__preview-card"><strong>FindTrax</strong><span>Search areas, volunteers, sightings, coverage, and field updates.</span></div>
              <div class="ma-tools-page__preview-card"><strong>IntelPro</strong><span>Facts, leads, timelines, files, relationships, and review workflows.</span></div>
              <div class="ma-tools-page__preview-card"><strong>MediaReach</strong><span>Public appeals, media kits, sharing controls, and update publishing.</span></div>
              <div class="ma-tools-page__preview-card"><strong>Privacy controls</strong><span>Keep public appeal details separate from private working information.</span></div>
            </div>
          </div>
        </div>
      </div>
      <div class="ma-tools-page__section">
        <h2>Built for Missing Alerts workflows</h2>
        <div class="ma-tools-page__cards">
          <article class="ma-tools-page__card"><strong>Search coordination</strong><p>Plan search zones, routes, sightings, coverage, and volunteer activity around live public appeals.</p></article>
          <article class="ma-tools-page__card"><strong>Case intelligence</strong><p>Keep facts, leads, people, files, and timelines organised for review and professional handover.</p></article>
          <article class="ma-tools-page__card"><strong>Controlled outreach</strong><p>Publish accurate public appeals and updates without exposing private case details.</p></article>
        </div>
      </div>
    {% else %}
      <div class="ma-tools-page__hero">
        <div>
          <span class="ma-tools-page__eyebrow">Missing Alerts tool</span>
          <h1>{{ product_label }}</h1>
          <p class="ma-tools-page__intro">{{ product_intro }}</p>
          <p class="ma-tools-page__copy">{{ product_positioning }}</p>
          <div class="ma-tools-page__actions"><a class="ma-tools-page__button" href="#tool-signup-{{ product_key }}">SIGN UP FOR RELEASE DAY</a><a class="ma-tools-page__button ma-tools-page__button--ghost" href="/tools">All tools</a></div>
        </div>
        <div class="ma-tools-page__visual" aria-label="{{ product_label }} UI preview">
          <div class="ma-tools-page__window">
            <div class="ma-tools-page__window-top"><span>{{ product_label }}</span><span>Preview</span></div>
            <div class="ma-tools-page__preview-grid">
              <div class="ma-tools-page__preview-card"><strong>Case linked</strong><span>Connects work to a Missing Alerts public case.</span></div>
              <div class="ma-tools-page__preview-card"><strong>Reviewable</strong><span>Structured updates and notes stay easier to assess.</span></div>
              <div class="ma-tools-page__preview-card"><strong>Controlled visibility</strong><span>Separate public appeal fields from private working notes.</span></div>
              <div class="ma-tools-page__preview-card"><strong>Release ready</strong><span>Product updates begin before public launch.</span></div>
            </div>
          </div>
        </div>
      </div>
      <div class="ma-tools-page__section"><h2>Core features</h2><ul class="ma-tools-page__feature-list">{% for item in feature_items %}<li>{{ item }}</li>{% endfor %}</ul></div>
      <div class="ma-tools-page__section"><h2>How it works</h2><div class="ma-tools-page__cards"><article class="ma-tools-page__card"><strong>Set up the case</strong><p>Start from a verified Missing Alerts appeal and keep public information source-backed.</p></article><article class="ma-tools-page__card"><strong>Coordinate the work</strong><p>Organise activity into structured updates instead of scattered chats, files, and posts.</p></article><article class="ma-tools-page__card"><strong>Publish safely</strong><p>Share only approved public updates while protecting family, investigative, and private information.</p></article></div></div>
      <div class="ma-tools-page__section"><h2>Who it is for</h2><p class="ma-tools-page__intro">{{ product_audience }}</p></div>
      <div class="ma-tools-page__section"><h2>Trust and privacy</h2><p class="ma-tools-page__intro">Each product is designed around source-backed case information, role-aware collaboration, and public/private field separation. Missing Alerts does not publish private family contact information or unverified sensitive claims in public product surfaces.</p></div>
    {% endif %}

    <div id="tool-signup-{{ product_key }}" class="ma-tools-page__launch">
      <div class="ma-tools-page__launch-title">COMING ON 1ST JULY 2026</div>
      <div class="ma-tools-countdown" data-ma-tools-countdown data-target="2026-07-01T00:00:00+01:00" aria-live="polite">
        <div class="ma-tools-countdown__unit"><span class="ma-tools-countdown__value" data-countdown-days>000</span><span class="ma-tools-countdown__label">Days</span></div>
        <div class="ma-tools-countdown__unit"><span class="ma-tools-countdown__value" data-countdown-hours>00</span><span class="ma-tools-countdown__label">Hours</span></div>
        <div class="ma-tools-countdown__unit"><span class="ma-tools-countdown__value" data-countdown-minutes>00</span><span class="ma-tools-countdown__label">Minutes</span></div>
        <div class="ma-tools-countdown__unit"><span class="ma-tools-countdown__value" data-countdown-seconds>00</span><span class="ma-tools-countdown__label">Seconds</span></div>
      </div>
      <h2>SIGN UP FOR RELEASE DAY</h2>
      <p class="ma-tools-page__notice">Be first to know when this tool goes live.</p>
      {% form 'customer', class: 'ma-tools-page__form' %}
        <input type="hidden" name="contact[tags]" value="tool-release-day,{{ product_label | handleize }}">
        <input type="email" name="contact[email]" required placeholder="Email address" aria-label="Email address">
        <button type="submit">SIGN UP FOR RELEASE DAY</button>
        {% if form.posted_successfully? %}
          <div class="ma-tools-page__success">You’re on the list. We’ll let you know on release day.</div>
        {% endif %}
        {% if form.errors %}
          <div class="ma-tools-page__error">{{ form.errors | default_errors }}</div>
        {% endif %}
      {% endform %}
    </div>
  </div>

  <script src="{{ 'tools-countdown.js' | asset_url }}" defer="defer"></script>
</section>
