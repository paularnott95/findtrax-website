{% liquid
  assign source_blog = blogs['missing-persons']
  assign context_country = country | default: ''
  if context_country == blank and article != blank
    assign context_country = article.metafields.custom.country.value | default: article.metafields.custom.country | default: article.metafields.custom.country_name.value | default: article.metafields.custom.country_name | strip
    if context_country == blank
      for article_tag in article.tags
        assign tag_downcase = article_tag | downcase | strip
        if tag_downcase contains 'country:'
          assign context_country = article_tag | split: ':' | last | strip
          break
        endif
      endfor
    endif
  endif
  assign context_label = context_country | default: 'Global'
  assign context_match = context_country | downcase | strip
  if context_match == 'uk'
    assign context_match = 'united kingdom'
  endif
  assign shown_count = 0
%}

<section class="ma-spotlight-bar" data-ma-country-context="{{ context_label | escape }}">
  <style>
    .ma-spotlight-bar{max-width:1220px;margin:18px auto;padding:16px;border-radius:18px;background:radial-gradient(circle at 18% 0,rgba(220,38,38,.18),transparent 30%),linear-gradient(135deg,#101217,#08090b);border:1px solid rgba(255,255,255,.08);box-shadow:0 18px 44px rgba(0,0,0,.28)}
    .ma-spotlight-bar__head{display:flex;justify-content:space-between;gap:14px;align-items:end;margin-bottom:13px}
    .ma-spotlight-bar__eyebrow{color:#fca5a5;font-size:11px;font-weight:950;letter-spacing:.14em;text-transform:uppercase}
    .ma-spotlight-bar h2{margin:4px 0 0;color:#fff;font-size:22px;line-height:1.1}
    .ma-spotlight-bar__note{color:rgba(255,255,255,.62);font-size:12px;font-weight:800;text-align:right}
    .ma-spotlight-bar__grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:10px}
    .ma-spotlight-card{min-height:118px;border-radius:14px;overflow:hidden;text-decoration:none;color:#fff;display:flex;align-items:flex-end;position:relative;background:#15171d;border:1px solid rgba(255,255,255,.08)}
    .ma-spotlight-card:before{content:"";position:absolute;inset:0;background:linear-gradient(180deg,rgba(0,0,0,.08),rgba(0,0,0,.82));z-index:1}
    .ma-spotlight-card img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;filter:saturate(.92);transform:scale(1.01)}
    .ma-spotlight-card__body{position:relative;z-index:2;padding:12px;min-width:0}
    .ma-spotlight-card__tag{display:inline-flex;margin-bottom:6px;padding:4px 7px;border-radius:999px;background:rgba(220,38,38,.78);font-size:10px;font-weight:950;letter-spacing:.08em;text-transform:uppercase}
    .ma-spotlight-card__title{margin:0;font-size:13px;line-height:1.18;font-weight:950;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden}
    .ma-spotlight-card__meta{margin:5px 0 0;color:rgba(255,255,255,.72);font-size:11px;line-height:1.25;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
    .ma-spotlight-card--fallback{background:linear-gradient(135deg,#211114,#0d0f14)}
    @media(max-width:900px){.ma-spotlight-bar__grid{display:flex;overflow-x:auto;scroll-snap-type:x mandatory}.ma-spotlight-card{min-width:230px;scroll-snap-align:start}.ma-spotlight-bar__head{align-items:flex-start;flex-direction:column}.ma-spotlight-bar__note{text-align:left}}
  </style>
  <div class="ma-spotlight-bar__head">
    <div>
      <div class="ma-spotlight-bar__eyebrow">Country spotlight</div>
      <h2>{% if context_label == 'Global' %}Global priority public appeals{% else %}Priority appeals for {{ context_label | escape }}{% endif %}</h2>
    </div>
    <div class="ma-spotlight-bar__note">Showing active public Missing Alerts cases. Fallback appears only when local cases are unavailable.</div>
  </div>
  <div class="ma-spotlight-bar__grid">
    {% if source_blog != blank %}
      {% for case_article in source_blog.articles %}
        {% liquid
          assign tag_blob = case_article.tags | join: ',' | downcase
          assign case_country = case_article.metafields.custom.country.value | default: case_article.metafields.custom.country | default: case_article.metafields.custom.country_name.value | default: case_article.metafields.custom.country_name | downcase | strip
          if case_country == blank
            for case_tag in case_article.tags
              assign tag_downcase = case_tag | downcase | strip
              if tag_downcase contains 'country:'
                assign case_country = case_tag | split: ':' | last | downcase | strip
                break
              endif
            endfor
          endif
          assign case_status = case_article.metafields.custom.case_status.value | default: case_article.metafields.custom.case_status | downcase
          assign exclude_case = false
          if tag_blob contains 'found-safe' or tag_blob contains 'closed' or tag_blob contains 'located' or tag_blob contains 'private' or tag_blob contains 'draft' or case_status contains 'found' or case_status contains 'closed' or case_status contains 'located'
            assign exclude_case = true
          endif
          assign matches_context = true
          if context_match != blank and context_match != 'global'
            assign matches_context = false
            if case_country contains context_match or tag_blob contains context_match
              assign matches_context = true
            endif
          endif
        %}
        {% if shown_count < 4 and exclude_case == false and matches_context %}
          {% assign shown_count = shown_count | plus: 1 %}
          <a class="ma-spotlight-card" href="{{ case_article.url }}">
            {% if case_article.image %}<img src="{{ case_article.image | image_url: width: 500, height: 340, crop: 'center' }}" width="500" height="340" alt="{{ case_article.title | escape }}">{% endif %}
            <span class="ma-spotlight-card__body"><span class="ma-spotlight-card__tag">{% if tag_blob contains 'urgent' %}Urgent{% else %}Verified{% endif %}</span><strong class="ma-spotlight-card__title">{{ case_article.title | escape }}</strong><span class="ma-spotlight-card__meta">{{ case_country | default: context_label }}</span></span>
          </a>
        {% endif %}
      {% endfor %}
      {% if shown_count == 0 %}
        {% for case_article in source_blog.articles limit: 4 %}
          {% assign tag_blob = case_article.tags | join: ',' | downcase %}
          {% unless tag_blob contains 'found-safe' or tag_blob contains 'closed' or tag_blob contains 'located' %}
            <a class="ma-spotlight-card ma-spotlight-card--fallback" href="{{ case_article.url }}">
              {% if case_article.image %}<img src="{{ case_article.image | image_url: width: 500, height: 340, crop: 'center' }}" width="500" height="340" alt="{{ case_article.title | escape }}">{% endif %}
              <span class="ma-spotlight-card__body"><span class="ma-spotlight-card__tag">Global fallback</span><strong class="ma-spotlight-card__title">{{ case_article.title | escape }}</strong><span class="ma-spotlight-card__meta">No local spotlight available yet</span></span>
            </a>
          {% endunless %}
        {% endfor %}
      {% endif %}
    {% endif %}
  </div>
</section>
