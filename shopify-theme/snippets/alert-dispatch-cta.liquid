{% liquid
  assign alert_dispatch_product = all_products['alert-dispatch']
  assign alert_dispatch_variant_id = ''
  if alert_dispatch_product and alert_dispatch_product.selected_or_first_available_variant
    assign alert_dispatch_variant_id = alert_dispatch_product.selected_or_first_available_variant.id
  endif
  if alert_dispatch_variant_id == blank
    assign alert_dispatch_variant_id = '56973589381280'
  endif
  assign alert_dispatch_entity_type = entity_type | default: 'case'
  assign alert_dispatch_entity_id = entity_id | default: article.id | default: ''
  assign alert_dispatch_entity_handle = entity_handle | default: article.handle | default: ''
  assign alert_dispatch_entity_title = entity_title | default: article.title | default: 'Missing Alerts appeal'
  assign alert_dispatch_country = country | default: article.metafields.custom.country.value | default: article.metafields.custom.country | default: ''
  assign alert_dispatch_region = region | default: article.metafields.custom.state_region.value | default: article.metafields.custom.state_region | default: article.metafields.custom.region.value | default: article.metafields.custom.region | default: ''
  assign alert_dispatch_city = city | default: article.metafields.custom.city_town.value | default: article.metafields.custom.city_town | default: article.metafields.custom.city.value | default: article.metafields.custom.city | default: ''
  assign alert_dispatch_owner_email = case_owner_email | default: ''
%}

<section class="alert-dispatch-cta sidebar-card" aria-label="ALERT DISPATCH">
  <div class="alert-dispatch-cta__eyebrow">Visibility upgrade</div>
  <h3 class="alert-dispatch-cta__title">ALERT DISPATCH</h3>
  <p class="alert-dispatch-cta__body">Send this appeal through Missing Alerts’ social, media, email and local alert channels to help increase visibility.</p>
  <p class="alert-dispatch-cta__body alert-dispatch-cta__body--small">Free alerts remain live. Dispatch is an optional visibility upgrade.</p>

  {% if alert_dispatch_variant_id != blank %}
    <form method="post" action="{{ routes.cart_add_url }}" class="alert-dispatch-cta__form">
      <input type="hidden" name="id" value="{{ alert_dispatch_variant_id }}">
      <input type="hidden" name="quantity" value="1">
      <input type="hidden" name="properties[feature_key]" value="alert_dispatch">
      <input type="hidden" name="properties[entity_type]" value="{{ alert_dispatch_entity_type | escape }}">
      <input type="hidden" name="properties[entity_id]" value="{{ alert_dispatch_entity_id | escape }}">
      <input type="hidden" name="properties[entity_handle]" value="{{ alert_dispatch_entity_handle | escape }}">
      <input type="hidden" name="properties[entity_title]" value="{{ alert_dispatch_entity_title | escape }}">
      <input type="hidden" name="properties[country]" value="{{ alert_dispatch_country | escape }}">
      <input type="hidden" name="properties[region]" value="{{ alert_dispatch_region | escape }}">
      <input type="hidden" name="properties[city]" value="{{ alert_dispatch_city | escape }}">
      <input type="hidden" name="properties[case_owner_email]" value="{{ alert_dispatch_owner_email | escape }}">
      <input type="hidden" name="properties[reply_to_email]" value="{{ alert_dispatch_owner_email | escape }}">
      <button type="submit" class="alert-dispatch-cta__button">Dispatch alert</button>
    </form>
  {% else %}
    <button type="button" class="alert-dispatch-cta__button alert-dispatch-cta__button--disabled" disabled>Dispatch alert</button>
    <p class="alert-dispatch-cta__body alert-dispatch-cta__body--small">Alert Dispatch checkout is not configured yet.</p>
  {% endif %}
</section>

<style>
  .alert-dispatch-cta{margin:16px 0;padding:18px;border:1px solid rgba(255,255,255,.10);border-radius:18px;background:linear-gradient(180deg,rgba(255,255,255,.055),rgba(255,255,255,.02)),linear-gradient(180deg,#170609,#0b0304);color:#fff}
  .alert-dispatch-cta__eyebrow{margin:0 0 8px;color:#ffb8b8;font-size:11px;font-weight:900;letter-spacing:.12em;text-transform:uppercase}
  .alert-dispatch-cta__title{margin:0 0 8px;color:#fff;font-size:24px;line-height:1;font-weight:900;letter-spacing:.04em}
  .alert-dispatch-cta__body{margin:0 0 10px;color:rgba(255,255,255,.78);font-size:13px;line-height:1.5}
  .alert-dispatch-cta__body--small{font-size:12px;color:rgba(255,255,255,.64)}
  .alert-dispatch-cta__form{margin:12px 0 0}
  .alert-dispatch-cta__button{width:100%;min-height:48px;border:0;border-radius:14px;background:linear-gradient(180deg,#ff4141,#9f0d12);color:#fff;font-size:13px;font-weight:900;letter-spacing:.08em;text-transform:uppercase;cursor:pointer}
  .alert-dispatch-cta__button--disabled{opacity:.55;cursor:not-allowed}
</style>
