{% if mode == 'compact' %}
  <div
    id="missing-alerts-country-top-bar"
    class="missing-alerts-country-top-bar__inner"
    data-country-section
    data-country-scope="all"
  >
    <div class="missing-alerts-country-top-bar__status">
      <span class="missing-alerts-country-top-bar__pulse" aria-hidden="true"></span>
      <span data-country-topbar-text>Showing Missing Alerts for your selected country</span>
    </div>
    <div class="missing-alerts-country-top-bar__actions">
      <button type="button" class="missing-alerts-country-top-bar__button" data-country-change>
        Change country
      </button>
      <a class="missing-alerts-country-top-bar__link" href="/pages/country-intelligence" data-country-topbar-intelligence>
        View country intelligence
      </a>
    </div>
  </div>
{% endif %}
